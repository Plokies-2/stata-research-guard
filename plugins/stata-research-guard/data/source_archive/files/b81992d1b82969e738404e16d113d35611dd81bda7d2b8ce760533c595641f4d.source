********************************************************************************
/*
This program constructs the final dataset for the electoral analysis:
*    ${final_data_folder}/voting_data.dta (electoral)

*/
********************************************************************************
**# 0. Setup
********************************************************************************
clear all

********************************************************************************
**# 1. Construction of voting dataset excluding municipalities 56 and 18
********************************************************************************

*==============================================================================*
**## Base dataset: individual-level clientelism dataset 
*==============================================================================*
use "${final_data_folder}/clientelism_individual_data.dta", clear

replace c_mun_id = mun_id


** Drop respondents who did not vote in their assigned section and location
drop if c_vote_here_ == 0

** Drop municipalities (to be cleaned in next section)
drop if inlist(c_mun_id, 56, 18)


save "${gen_data_folder}/voting_data_unadjusted.dta", replace


*==============================================================================*
**## Merge TSE data 
*==============================================================================*

** 2012 Voting Section stats
use "${source_data_folder}/electoral/tse_section_stats_2012.dta", clear
sort c_mun_id c_voter_section_no_, stable


** Merge 2012 Prefeito Candidate TSE Dataset
merge 1:1 c_mun_id zone_number c_voter_section_no_ using "${source_data_folder}/electoral/tse_cand_stats_2012.dta"
drop _merge
sort c_mun_id c_voter_section_no_, stable


** Merge 2008 Sections TSE Dataset
merge 1:m c_mun_id zone_number c_voter_section_no_ using "${source_data_folder}/electoral/tse_section_stats_2008.dta"
drop if _merge == 2
drop _merge
sort c_mun_id c_voter_section_no_, stable


** Merge 2008 Prefeito Candidate TSE Dataset
merge m:1 c_mun_id zone_number c_voter_section_no_ using "${source_data_folder}/electoral/tse_candidate_stats_2008.dta"
drop if _merge == 2
drop _merge
sort c_mun_id c_voter_section_no_, stable


** Drop municipalities 56 and 18 (to be cleaned in next section)
drop if inlist(c_mun_id, 56, 18)


** Merge to clientelism data
sort c_mun_id c_voter_section_no_, stable                 
duplicates drop c_mun_id c_voter_section_no_, force    


* As of now, c_mun_id c_voter_section_no_ is a unique identifier for all municipalities 
* Here, we drop individuals whose reported section number does not correspond to any in the TSE dataset
sort c_mun_id c_voter_section_no_, stable
merge 1:m c_mun_id c_voter_section_no_ using "${gen_data_folder}/voting_data_unadjusted.dta"
drop if _merge == 2                                
drop _merge


/* 
GENERATING LOCATION ID'S FOR PEOPLE VOTING IN DIFFERENT SECTIONS IN THE SAME LOCATION
*/
preserve 
use "${source_data_folder}/electoral/TSE_LOCATIONS_SECTIONS_2012.dta", clear
drop if inlist(c_mun_id, 56, 18)
save "${gen_data_folder}/temp_2012_sections_data.dta", replace 
restore

sort c_mun_id c_voter_section_no_, stable
merge m:1 c_mun_id c_voter_section_no_ using "${gen_data_folder}/temp_2012_sections_data.dta"
keep if _merge == 3
drop _merge


** Keep all sections for our respondents' voting locations
sort c_mun_id location_id c_voter_section_no_
gen temp = location_id if treatment != .
bysort location_id (temp): replace temp = temp[1]

replace location_id = temp if temp != .
drop if temp == .


save "${gen_data_folder}/voting_data_unadjusted.dta", replace
erase "${gen_data_folder}/temp_2012_sections_data.dta"


********************************************************************************
**# 2. Construction of voting dataset for municipality 56
********************************************************************************

use "${final_data_folder}/clientelism_individual_data.dta", clear

replace c_mun_id = mun_id


** Drop respondents who did not vote in their assigned section and location
drop if c_vote_here_ == 0

** Keep municipality 56
keep if c_mun_id == 56

