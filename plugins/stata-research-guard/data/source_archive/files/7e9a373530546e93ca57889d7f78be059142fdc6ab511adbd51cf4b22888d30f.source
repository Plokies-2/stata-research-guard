/////////////////////////
/// Write LaTeX table ///
/////////////////////////
esttab TWFE_SMALL JWDID_SMALL TWFE_MEDIUM JWDID_MEDIUM TWFE_LARGE JWDID_LARGE using "${path_tables}/Table_1.tex", se label ///
			star(* 0.10 ** 0.05 *** 0.01) drop(_cons) ///
			replace substitute(\_ _) nonotes noobs b(%9.3f) se(%9.3f) ///
			mtitle("TWFE" "ETWFE" "TWFE" "ETWFE" "TWFE" "ETWFE") ///
			scalars("Sample_name Sample" "N_all \hline  Observations" "N_E Exporters" "N_I Importers" "N_T Years" "N_coef Coefficients" "p_test \hline p-value H0:TWFE=ETWFE" "B_jack \hline \$ RTA_{ij,t} \$ (jackknife)" "SE_jack \hspace{0.5cm}" "Exporter_Importer \hline Exporter \$\times\$ importer FE" "Exporter_Year Exporter \$\times\$ year FE" "Importer_Year Importer \$\times\$ year FE" "Intra_Year Cross-border \$\times\$ year FE") ///
			sfmt(%12.0gc %9.0gc %9.0gc %9.0gc %9.0gc %9.0gc %4.3f) ///
		coef(RTA_3 "\$ RTA_{ij,t}\$")


