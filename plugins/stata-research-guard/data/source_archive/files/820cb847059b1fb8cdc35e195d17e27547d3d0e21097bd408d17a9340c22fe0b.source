`q' "tratar a saude em recife" | `q' "EXAME MEDICO" | `q' "cistetrna" | `q' "trazendo o carro pipa" | `q' "DINHEIRO" | ///
`q' "DINHEIRO PARA COMBUSTIVEL" |`q' "MAQUINA PARA CAVAR BARRAGEM" |`q' "MAQUINA PARA FAZER UM SEFVIÇO AQUI  NA " | ///
`q' "PAGAMENTO DE CONTA DE AGUA"| `q' "SEMENTE" |`q' "construiu um barreirinho" |`q' "dinheiro"|`q' "oculos" | ///
`q' "um valor em dinheiro"|`q' "uma casa"

replace rec_priv_myr_hlp_2013 = 1 if e_rec_hlp_myr_wtr_post == 1 | e_rec_hlp_myr_bldmtrl_post == 1 | e_rec_hlp_myr_medicine_post == 1 |  ///
e_rec_hlp_myr_schl_post == 1 | e_rec_hlp_myr_elecbl_post == 1 | e_rec_hlp_myr_medtrt_post == 1 | e_rec_hlp_myr_food_post == 1 | ///
e_rec_hlp_myr_empl_post == 1


** Any private good, excluding water
gen rec_priv_myr_hlp_nowater_2013 = 0 if !missing(e_rec_hlp_myr_)

replace rec_priv_myr_hlp_nowater_2013 = 1 if `q' "DEU PEIXE NA SEMANA SANTA" | `q' "Um Bolo pra formatura" | `q' "uma casa" | ///
`q' "tratar a saude em recife" | `q' "EXAME MEDICO" | `q' "cistetrna" | `q' "trazendo o carro pipa" | `q' "DINHEIRO" | ///
`q' "DINHEIRO PARA COMBUSTIVEL" |`q' "MAQUINA PARA CAVAR BARRAGEM" |`q' "MAQUINA PARA FAZER UM SEFVIÇO AQUI  NA " | ///
`q' "PAGAMENTO DE CONTA DE AGUA"|`q' "SEMENTE" |`q' "construiu um barreirinho" |`q' "dinheiro"|`q' "oculos" |`q' "um valor em dinheiro"

replace rec_priv_myr_hlp_nowater_2013 = 1 if e_rec_hlp_myr_bldmtrl_post == 1 | e_rec_hlp_myr_medicine_post == 1 | ///
e_rec_hlp_myr_schl_post == 1 | e_rec_hlp_myr_elecbl_post == 1 | e_rec_hlp_myr_medtrt_post == 1 | e_rec_hlp_myr_food_post == 1 | ///
e_rec_hlp_myr_empl_post == 1


** Any public good
gen rec_comm_myr_hlp_2013 = 0 if !missing(e_rec_hlp_myr_)
replace rec_comm_myr_hlp_2013 = 1 if `q' "Colocar benheiros no sitio" | `q' "MELHORIA DA ESTRADA"
replace rec_comm_myr_hlp_2013 = 1 if e_rec_hlp_myr_wtr_comm_post == 1 | e_rec_hlp_myr_roads_post == 1 | ///
e_rec_hlp_myr_health_post == 1 | e_rec_hlp_myr_schlcomm_post == 1 | e_rec_hlp_myr_elec_post == 1

gen rec_public_mayor_help_2013 = rec_comm_myr_hlp_2013


*==============================================================================*
**## Received help from Mayor or City Councillor (2013)
*==============================================================================*
** Any private good
gen rec_priv_pol_hlp_2013 = 1 if rec_priv_ver_hlp_2013 == 1 | rec_priv_myr_hlp_2013 == 1
replace rec_priv_pol_hlp_2013 = 0 if rec_priv_ver_hlp_2013 == 0 & rec_priv_myr_hlp_2013 == 0


** Any private good, excluding water 
gen rec_priv_pol_hlp_nowater_2013 = 1 if rec_priv_ver_hlp_nowater_2013 == 1 | rec_priv_myr_hlp_nowater_2013 == 1
replace rec_priv_pol_hlp_nowater_2013 = 0 if rec_priv_ver_hlp_nowater_2013 == 0 & rec_priv_myr_hlp_nowater_2013 == 0


** Any public good
