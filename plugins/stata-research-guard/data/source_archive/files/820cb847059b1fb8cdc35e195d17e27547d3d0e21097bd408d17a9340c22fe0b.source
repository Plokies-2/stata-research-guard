********************************************************************************
/*
This program constructs the final individual-level and household-level datasets for the clientelism analysis:
*    ${final_data_folder}/clientelism_individual_data.dta (individual)
*    ${final_data_folder}/clientelism_household_data.dta (household)
*    ${final_data_folder}/clientelism_individual_data_stacked.dta (individual)


Table of Contents

Sections:
0. Setup
1. Rainfall Measures
2. Infrequent Interactor Variables 
3. Incumbency Variables 
4. Survey Variables (2012)
5. Asking Variables 
6. Other Individual-Level Variables 
7. Household-Level Variables
8. Final datasets

*/
********************************************************************************
**# 0. Setup 
********************************************************************************
clear all

use "${gen_data_folder}/clean_indiv_V6_V16.dta", clear


********************************************************************************
**# 1. Rainfall Measure for 2011-2013
********************************************************************************

*==============================================================================*
**## Rainfall Measure for 2012 and 2013
*==============================================================================*
local months "01 02 03 04 05 06 07 08 09 10 11 12"
local years "1986 1987 1988 1989 1990 1991 1992 1993 1994 1995 1996 1997 1998 1999 2000 2001 2002 2003 2004 2005 2006 2007 2008 2009 2010 2011"
local study_years "2012 2013"

*------------------------------------------------------------------------------*
* Annual average rainfall for each municipality-month in the period 1986-2011
*------------------------------------------------------------------------------*
foreach month of local months {
	gen temp_`month' = 0
	
	foreach year of local years {
		replace temp_`month' = temp_`month' + rainfall_`year'_`month'
	}
	
	* Annual average for each month across 26 years
	gen rainfall_long_run_average_`month' = temp_`month' / 26
}


*------------------------------------------------------------------------------*
* Monthly standard deviation of rainfall for each municipality in the period 1986-2011
*------------------------------------------------------------------------------*
gen temp = 0

foreach year of local years {
	foreach month of local months {
		replace temp = temp + rainfall_`year'_`month'
	}
}

* Monthly average over 312 (26 years x 12 months) months
gen rainfall_long_run_average = temp / 312

gen temp_2 = 0

foreach month of local months {
	foreach year of local years {
	    
		* Municipality-level variance of rainfall for each month-year
		gen temp_`year'_`month' = (rainfall_`year'_`month' - rainfall_long_run_average) ^ 2
		
		* Create sum of variances across all month-years
		replace temp_2 = temp_2 + temp_`year'_`month'
	}
}

* Municipality-level monthly standard deviation of rainfall
gen rainfall_long_run_sd = (temp_2 / 311) ^ 0.5

drop temp*


*------------------------------------------------------------------------------*
* Monthly Standardized Rainfall measure
*------------------------------------------------------------------------------*
foreach month of local months {
	foreach year of local study_years {
	    
		* Normalized measure using annual average rainfall for each month
		gen rainfall_diff_`year'_`month' = rainfall_`year'_`month' - rainfall_long_run_average_`month'
		gen rainfall_std_`year'_`month' = rainfall_diff_`year'_`month' / rainfall_long_run_sd	
	}
}


*------------------------------------------------------------------------------*
* Aggregate rainfall measures : monthly average in 2012 and 2013
*------------------------------------------------------------------------------*
foreach year of local study_years {
	
	
	** Standardized values
	gen rainfall_`year'_std = (rainfall_std_`year'_01 + rainfall_std_`year'_02 + rainfall_std_`year'_03 + rainfall_std_`year'_04 + 								 rainfall_std_`year'_05 + rainfall_std_`year'_06 + rainfall_std_`year'_07 + rainfall_std_`year'_08 + 							   rainfall_std_`year'_09) / 9

	label variable rainfall_`year'_std "Rainfall `year': Jan-Sep"
}


*==============================================================================*
**## Rainfall Measure for 2011
*==============================================================================*
local months2 "01 02 03 04 05 06 07 08 09 10 11 12"
local years2 "1986 1987 1988 1989 1990 1991 1992 1993 1994 1995 1996 1997 1998 1999 2000 2001 2002 2003 2004 2005 2006 2007 2008 2009 2010"
local study_years2 "2011"

*------------------------------------------------------------------------------*
* Annual average rainfall for each municipality-month in the period 1986-2010
*------------------------------------------------------------------------------*
foreach month of local months2 {
	gen temp_`month' = 0
	
	foreach year of local years2 {
		replace temp_`month' = temp_`month' + rainfall_`year'_`month'
	}
	
	* Annual average for each month across 25 years
	gen rainfall_long_run_average_`month'2 = temp_`month' / 25
}


*------------------------------------------------------------------------------*
* Monthly standard deviation of rainfall for each municipality in the period 1986-2010
*------------------------------------------------------------------------------*
gen temp = 0

foreach year of local years2 {
	foreach month of local months2 {
		replace temp = temp + rainfall_`year'_`month'
	}
}

* Monthly average over 300 (25 years x 12 months) months
gen rainfall_long_run_average2 = temp / 300

gen temp_2 = 0

foreach month of local months2 {
	foreach year of local years2 {
	    
		* Municipality-level variance of rainfall for each month-year
		gen temp_`year'_`month' = (rainfall_`year'_`month' - rainfall_long_run_average2) ^ 2
		
		* Create sum of variances across all month-years
		replace temp_2 = temp_2 + temp_`year'_`month'
	}
}

* Municipality-level monthly standard deviation of rainfall
gen rainfall_long_run_sd2 = (temp_2 / 299) ^ 0.5

drop temp*


*------------------------------------------------------------------------------*
* Monthly Standardized Rainfall measure
*------------------------------------------------------------------------------*
foreach month of local months2 {
	foreach year of local study_years2 {
	    
		* Normalized measure using annual average rainfall for each month
		gen rainfall_diff_`year'_`month' = rainfall_`year'_`month' - rainfall_long_run_average_`month'2
		gen rainfall_std_`year'_`month' = rainfall_diff_`year'_`month' / rainfall_long_run_sd2
	}
}


*------------------------------------------------------------------------------*
* Aggregate rainfall measures : monthly average in 2011
*------------------------------------------------------------------------------*

** Standardized measure 
gen rainfall_2011_std = (rainfall_std_2011_01 + rainfall_std_2011_02 + rainfall_std_2011_03 + rainfall_std_2011_04) / 4

/* 
rainfall_2011_std uses only Jan-Apr because we use rainfall measures before we conducted the survey. 
For 2012 and 2013, we conducted the survey >= Oct. For 2011, we conducted the localization survey in May.
*/
label variable rainfall_2011_std "Rainfall 2011: Jan-Apr"
						

*==============================================================================*
**## Final Rainfall Measures
*==============================================================================*

** Original measures (Jan - Apr for 2011; Jan - Sep for 2012 and 2013)
forval year = 2011(1)2013 {
			
	** Normalize standardized rainfall measures to have mean 0 and standard deviation 1
	rename rainfall_`year'_std rainfall_`year'_std_og
	egen rainfall_`year'_std = std(rainfall_`year'_std_og)
}

label var rainfall_2011_std "Rainfall 2011: Jan-Apr (standardized)"
label var rainfall_2012_std "Rainfall 2012: Jan-Sep (standardized)"
label var rainfall_2013_std "Rainfall 2013: Jan-Sep (standardized)"


********************************************************************************
**# 2. Infrequent Interactor Variables
********************************************************************************

*==============================================================================*
**## Frequency of talking with mayor (2012, before election), categorical
*==============================================================================*
gen c_talked_mayor_freq_2012_before = 0 if c_talk_pre_ == 0
replace c_talked_mayor_freq_2012_before =  0 if c_talk_pre_before_ == 5

replace c_talked_mayor_freq_2012_before = 1 if inlist(c_talk_pre_before_other_, "1", "1 vez", "1 vezes", "2", "2 VAZES", "2 vezes", 																			   "2 vezes antes da politica")
replace c_talked_mayor_freq_2012_before = 1 if inlist(c_talk_pre_before_other_, "3", "3 vezes", "4", "5", "Apenas uma", "Raramente.", 																				 "somente uma vez", "uma vez",  "umas duas vezes")
replace c_talked_mayor_freq_2012_before = 1 if c_talk_pre_before_ == 4

replace c_talked_mayor_freq_2012_before = 2 if c_talk_pre_before_ == 3
replace c_talked_mayor_freq_2012_before = 3 if c_talk_pre_before_ == 2
replace c_talked_mayor_freq_2012_before = 4 if c_talk_pre_before_ == 1


*==============================================================================*
**## Frequency of talking with city councillor (2012, before election), categorical
*==============================================================================*
gen c_talked_ver_freq_2012_before = 0 if c_talk_ver_ == 0
replace c_talked_ver_freq_2012_before = 0 if c_talk_ver_before_ == 5

replace c_talked_ver_freq_2012_before = 1 if inlist(c_talk_ver_before_other_, "1", "1 VEZ", "1 vez", "1 vez\", "2", "2 VEZES", "2 veze")
replace c_talked_ver_freq_2012_before = 1 if inlist(c_talk_ver_before_other_, "2 vezes", "3", "3 vezes", "4", "5", 																			  "Uma vez com cada candidato", "so uma vez", "uma vez")
replace c_talked_ver_freq_2012_before = 1 if c_talk_ver_before_ == 4

replace c_talked_ver_freq_2012_before = 2 if inlist(c_talk_ver_before_other_, "10", "10 vezes", "15 vezes", "6 vezes", "de 15 em 15 dias", 																				"de 15 em 15 dias", "A cada 15 dias")
replace c_talked_ver_freq_2012_before  = 2 if c_talk_ver_before_ == 3

replace c_talked_ver_freq_2012_before  = 3 if inlist(c_talk_ver_before_other_, "Quase todo fim de semana", "2 ou 3 vezes por semana")
replace c_talked_ver_freq_2012_before  = 3 if c_talk_ver_before_ == 2

replace c_talked_ver_freq_2012_before  = 4 if c_talk_ver_before_ == 1


*==============================================================================*
**## Frequency of talking with any politician (2012, before election), categorical and dummies
*==============================================================================*

** Categorical 
egen c_talked_poli_freq_2012_before = rowmax(c_talked_mayor_freq_2012_before c_talked_ver_freq_2012_before)

** Dummies 
gen talk_pol_atleastonce_2012_bef = (c_talked_poli_freq_2012_before >= 1) if !missing(c_talked_poli_freq_2012_before)
gen talk_pol_atleastmonthly_2012_bef = (c_talked_poli_freq_2012_before >= 2) if !missing(c_talked_poli_freq_2012_before)
gen talk_pol_atleastweekly_2012_bef = (c_talked_poli_freq_2012_before >= 3) if !missing(c_talked_poli_freq_2012_before)
gen talk_pol_atleastdaily_2012_bef = (c_talked_poli_freq_2012_before == 4) if !missing(c_talked_poli_freq_2012_before)

gen c_often_talked_poli_2012_before = talk_pol_atleastweekly_2012_bef

label variable talk_pol_atleastmonthly_2012_bef "Interact With Politician At Least Monthly Before Campaign"					


*==============================================================================*
**## Infrequent interactor with any politician (2012, before election), dummies
*==============================================================================*

recode talk_pol_atleastonce_2012_bef (0 = 1)(1 = 0), gen(infrequent_interact_2012_o)
recode talk_pol_atleastmonthly_2012_bef (0 = 1)(1 = 0), gen(infrequent_interact_2012_m)
recode talk_pol_atleastweekly_2012_bef (0 = 1)(1 = 0), gen(infrequent_interact_2012_w)
recode talk_pol_atleastdaily_2012_bef (0 = 1)(1 = 0), gen(infrequent_interact_2012_d)


label variable infrequent_interact_2012_o "Infrequent Interactor (At Least Once) with Politician"
label variable infrequent_interact_2012_m "Infrequent Interactor (Monthly) with Politician"
label variable infrequent_interact_2012_w "Infrequent Interactor (Weekly) with Politician"
label variable infrequent_interact_2012_d "Infrequent Interactor (Daily) with Politician"

		

********************************************************************************
**# 3. INCUMBENCY VARIABLES  
********************************************************************************

* Whether incumbent mayor ran for re-election in 2012
gen incumbent_ran = 1 if inlist(mun_id, 27, 1, 6, 22, 56, 7, 24, 32, 41, 44, 2, 4, 12, 13, 18, 42, 11, 5, 8, 34, 55)

* Whether incumbent mayor ran for re-election in 2012 & came in first place
gen incumbent_was_cand_a = 1 if inlist(mun_id, 22, 56, 24, 41, 18, 11, 8, 55)

* Whether incumbent mayor ran for re-election in 2012 & came in second place 
gen incumbent_was_cand_b = 1 if inlist(mun_id, 27, 1, 6, 7, 32, 44, 2, 4, 12, 13, 5, 34)

* Whether incumbent mayor ran for re-election in 2012 & came in third place 
gen incumbent_was_cand_c = 1 if mun_id == 42

* Whether incumbent party came in first place in 2012 election 
gen incumbent_party_was_cand_a = incumbent_was_cand_a
replace incumbent_party_was_cand_a = 1 if inlist(mun_id, 50, 51, 32)

* Whether incumbent party came in second place in 2012 election 
gen incumbent_party_was_cand_b = incumbent_was_cand_b
replace incumbent_party_was_cand_b = 1 if inlist(mun_id, 45, 28, 26, 54)

* Whether incumbent party came in third place in 2012 election
gen incumbent_party_was_cand_c = incumbent_was_cand_c
replace incumbent_party_was_cand_c = 1 if mun_id == 10


* Whether incumbent is from PT party
gen mayor_pt = inlist(mun_id, 56, 45, 2, 53, 55)


********************************************************************************
**# 4. 2012 Survey Variables
********************************************************************************

*------------------------------------------------------------------------------*
* Candidate gave help? (Q817)
*------------------------------------------------------------------------------*

* gift_campaign_visit_2012:  Did R receive gift during a campaign visit?
* Note: This variable is 0 if respondent did not receive a campaign visit.
gen c_gift_campaign_visit_2012 = (c_candidate_delivered_ == 1) if (!missing(c_candidate_delivered_) | c_candidate_visits_num_times_ == 0)



********************************************************************************
**# 5. Asking Variables
********************************************************************************

*==============================================================================*
**## Ask help from City Councillor (2012)
*==============================================================================*

local q "c_ask_help_other_spec_ver_=="

*------------------------------------------------------------------------------*
* Help with public goods
*------------------------------------------------------------------------------*
** Water
replace c_ask_water_c_ver_ = 1 if `q' "AJEITAR O POÇO DA COMUNIDADE QUE DEU PROBLEMA" |`q' "Ajeitar o açude" | ///
`q' "ESCAVADEIRA PARA CAVAR UM CACIMBÃO" |`q' "pediu para furarem um poço aqui na comunidade"


** Roads
replace c_ask_help_road_ver_ = 1 if `q' "PEDIU BUERO (TAMBOR) PARA COLOCAR NAS ESTRADAS PARA TER ACESSO AOS RIACHOS"


** Health
replace c_ask_help_health_c_ver_ = 1 if `q' "agente de sa,ude" |`q' "Melhorar a saúde"


** Electricity
replace c_ask_help_electricity_c_ver_ = 1 if `q' "Colocar um poste com iluminação" |`q' "um poste de energia"


** Other
gen c_ask_help_other_community_ver_ = 1 if `q' "Máquina para fazer uma barragem" | `q' "construir uma ponte" | ///
`q' "Fiscaliza mais os trabalhos da Prefeitura" | `q' "Pediu para melhorar a vida da comunidade" | `q' "patrocinar um evento promovido." | ///
`q' "obraço para a luiz do poste" | `q' "UM CARRO ESCOLAR PRA COMUNIDADE" | `q' "um patrocínio para um evento" | ///
`q' "Ativar a associação de moradores"


** Any public good
gen c_ask_public_vereador_postcoded = 0 if !missing(c_talk_pre_) | !missing(c_talk_ver_)
replace c_ask_public_vereador_postcoded  = 1 if c_ask_water_c_ver_ == 1 | c_ask_help_road_ver_ == 1 | c_ask_help_edu_c_ver_ == 1 | ///
c_ask_help_electricity_c_ver_ == 1 | c_ask_help_health_c_ver_ == 1 | c_ask_help_other_community_ver_ == 1


*------------------------------------------------------------------------------*
* Help with private goods
*------------------------------------------------------------------------------*
** Water
replace c_ask_help_water_f_ver_ = 1 if `q' "Canos" |`q' "Cisterna" |`q' "Conseguir a cisterna" |`q' "Trazer a cisterna" | ///
`q' "cisterna" |`q' "um poço" |`q' "Materias para encanaçao" |`q' "caixa dgua" |`q' "Uma cisterna" | `q' "Ajuda pra onstruir um açude." | ///
`q' "Pediu dinheiro pra construir uma cisterna" |`q' "um poço" |`q' "CAIXA DÁGUA" |`q' "encanamento para casa" | ///
`q' "uma caixa de água." |`q' "pagar a conta de água" |`q' "pagamento de agua" |`q' "água encanada" |`q' "Um tambo pra carregar agua." | ///
`q' "Encanaçao" | `q' "cavar uma cacimba" |`q' "uma maquina para fazer uma barragem" |`q' "construção de um barreiro" | ///
`q' "Tirar a lama do tanque." | `q' "POÇO ARTESIANO" |`q' "Pediu ajuda pra terminar de construir o açude." |`q' "Construir uma cisterna." | ///
`q' "construir um poço artesiano" |`q' "construir um poço artesiano." |`q' "Instalacao de um poço artesiano."


** Construction
replace c_ask_help_construction_ver_ = 1 if `q' "passar o trator na minha barragem pequena" |`q' "cimentos" | ///
`q' "TRATOR PARA LIMPAR O AÇUDE DA PROPRIEDADE." |`q' "UM BANHEIRO" |`q' "Pediu ajuda pra construir um barreiro"


** Electricity
replace c_ask_help_electricity_f_ver_ = 1 if `q' "Instalação da eletricidade (energia)." |`q' "ELETRIFICAÇÃO PARA SUA CASA" | ///
`q' "PARA COLOCAR ENERGIA EM UMA CASA NO BAIRRO BELA VISTA DO POVOADO DE POÇOS"


** Medical treatment
replace c_ask_help_med_ver_ = 1 if `q' "Remedio para minha filha." |`q' "Dinheiro para comprar medicamento para o filho." | ///
`q' "receita de remedio" |`q' "Dinheiro para comprar remédio" |`q' "remedio" |`q' "remedios" |`q' "REMEDIO"


** Food basket
replace c_ask_help_basket_ver_ = 1 if `q' "pediu uma cesta básica"


** Job
replace c_ask_help_job_ver_ = 1 if `q' "para conseguir um emprego" |`q' "um emprego para a filha"


** Money
gen c_ask_money_ver = 1 if `q' "dinheiro" |`q' "um valor em dinheiro." |`q' "Dinheiro" |`q' "DINHEIRO" |`q' "AJUDA FINACEIRA" | ///
`q' "dinheiro 70  reais" |`q' "Dinheiro 50 reais" |`q' "dinheiro." |`q' "Dinheiro." |`q' "Pediu dinheiro" |`q' "ajuda em dinheiro" | ///
`q' "Pediu R$ 300,00"


** Medicine
replace c_ask_help_health_f_ver_ = 1 if `q' "EXAME MÉDICO" |`q' "Foi pedido óculos de grau" | `q' "pedipara ele pagar um exame" | ///
`q' "pedi um odontólogo para fazer canal dentário" |`q' "uma cirurgia de ligadura de trompas." |`q' "um tratamento médico" | ///
`q' "AJUDA PARA UMA CONSULTA MEDICA (OCULISTA) PRA O MEU FILHO" |`q' "pedi um exame de vista." | `q' "estrair os dentes" | ///
`q' "Exame Médico - Ressonância Magnética" | `q' "pediu uma ultra-som e um raio-x" |`q' "exames" |`q' "Exame Médico" | ///
`q' "cirurgia no tornozelo." |`q' "transporte para tratamento em Aracaju" |`q' "Óculos de grau." |`q' "exame médico" | ///
`q' "Transporte para tratamento médico" |`q' "Exame." |`q' "UM TRANSPORTE PARA LEVAR MINHA FILHA PARA O HOSPITAL EM ARACI" | ///
`q' "passagem para tratamento médico" |`q' "conseguir um transporte para o recife prá um tratemento médico." | ///
///
`q' "Ajuda pra conseguir transportar seu filho ao RECIFE pra fazer consulta." |`q' "tranporte para ir ao hospital" | ///
`q' "Transporte para ir ao tratamento médico com o filho em Fortaleza." |`q' "Cirurgia de vesicula." | `q' "FAZER UM ÓCULOS DE GRAU" | ///
`q' "conseguir exame de vista  para meu filho" | `q' "Um carro para leva o filho para o hospital" |`q' "Viagem ao hospital" | ///
`q' "UM TRANSPORTE PARA VOLTAR PARA CASA DO HOSPITAL EM SANTA LUZ COM O MEU FILHO" |`q' "transporte( carro pra ir ao medico)" | ///
`q' "TRANSPORTE PARA IR ATE BEZERROS FAZER CIRURGIA" |`q' "Da o transporte pra fazer tratamento médico em caruaru" | ///
`q' "óculos, transporte" |`q' "UM TRANSPORTE PARA O HOSPITAL EM CAMPO FORMOSO (QUEBREI A PERNA EM AGOSTO/12)" | ///
`q' "Exames (ressonância, hemograma completo, eletrocardiograma) para o marido e carro para levar ele no dia da realização." | ///
///
`q' "exames" |`q' "cirurgia da esposa." |`q' "PROTESE DENTARIA" |`q' "OCULOS DE GRAU" | `q' "EXAMES MEDICOS" | ///
`q' "PEDI UMA AJUDA EM DINHEIRO PARA PAGAR A MINHA CIRURGIA(LAQUEADURA) QUE FOI PARTICULAR NO HOSPITAL EM SERRINHA" | ///
`q' "UM TRANSPORTE PARA O HOSPITAL EM CAMPO FORMOSO" |`q' "tomografia" |`q' "Um carro pra levar uma criança doente" | ///
`q' "uma ajuda pra fazer um tratamento" |`q' "Exame oftalmologico." |`q' "UM OCULOS COMPLETO" | `q' "Oculos de grau" | ///
`q' "Passagem pra ir no médico de campina grande" |`q' "TRANSPORTE PRA IR SE CONSULTAR EM CARUARU." | `q' "EXAME DE VISTA" | ///
`q' "Dinheiro para levar o filho ao médico e remedio." |`q' "pediu para ele levar p/ fazer exame em pesqueira no carro dele" | ///
`q' "transporte para levar o marido para fazer um tratamento médico" |`q' "um carro pra ir ao hospital" |`q' "EXAME DE VISTA" | ///
`q' "Prótese dentária." |`q' "pediu um carro para pegá-la na maternidade" |`q' "dinheiro pra pagar o plano de saúde do filho" 


** Other
gen c_ask_help_other_private_ver_ = 1 if `q' "Ajuda pra pagar habilitação" |`q' "AJUDA PARA PAGUAR UMA MOTO" |`q' "pneus da moto" | ///
`q' "Para mim Aposentar." |`q' "bateria para mot0." |`q' "aposentadoria" |`q' "Pneu para meu carro." |`q' "Emplacamento da moto" | ///
`q' "Pagar o sindicato que estava sem condições de pagar." |`q' "comprar o leite da criança" |`q' "tirar documentos que foram perdidos" | ///
`q' "Dinheiro para consertar a moto." |`q' "para ele fazer a preparação da aposentadoria da mesma" |`q' "Documento de Habilitaçao." | ///
`q' "Merenda da escola" |`q' "Regularizar documento do carro da família." |`q' "pagar o sindicato" |`q' "BOTIJÃO DE GÁS" | ///
`q' "Pneu da moto" | `q' "ajuda pra conseguir documento de habilitaçao." |`q' "Para aposentar omarido dela." |`q' "casa" | ///
`q' "Salário-maternidade" |`q' "Regularizar a documentação do carro da família." |`q' "conserto da geladeira" |`q' "Uma chuteia." | ///
///
`q' "aposentadoria" |`q' "pedi um par de luvas, pois sou atleta(goleiro)." |`q' "sapato para jogar" |`q' "ajudar a tirar documentos" | ///
`q' "uma cama com colchao" |`q' "Dinheiro para pagar o sindicato." |`q' "chuteira" |`q' "3 PNEUS" | ///
`q' "pedir um carro para ir buscar meu avõ em campina grande" |`q' "rEGISTRO (DOCUMENTO)" |`q' "Conserto da moto" | ///
`q' "Uma ajuda nos estudos." |`q' "Dinheiro para combustível" |`q' "Um carro para ir a Aracaju." |`q' "foi de um pneu para á moto." | ///
`q' "Dinheiro para comprar carne e 2 pneus para moto." |`q' "bujão" |`q' "arrumar um advogado ele pagou ao advogado" | ///
`q' "AJUDA PARA PAGAR O CINDICATO" |`q' "AJUDA FINACEIRA" |`q' "tira registro e identidade" | ///
`q' "alugar um carro para pegar algumas coisas" |`q' "ajuda de transporte" |`q' "Pedio um carro para ir buscar a menina na escola." | ///
///
`q' "Dinheiro para comprar um botijão de gás." |`q' "dinheiro para transporte" |`q' "Conserto da moto" | ///
`q' "Cavar 3 buracos para cisternas para sua família." |`q' "Pediu ajuda pra ir a fortaleza com o pessoal da igreja." | ///
`q' "ASSISTENCIA FUNERARIA" |`q' "viajem pra aracaju" |`q' "PRECISEI DE UM ADVOGADO" |`q' "Um botijão de gás" | ///
`q' "SEGUNDA VIA DOS REGISTROS DE TRÊS PESSOAS" | `q' "uma chuteira" |`q' "um frete para pegar a mudança do filho" |`q' "Botijão de gás" | ///
`q' "maquina de costura" |`q' "um butijão de gás" |`q' "transporte para deslocamento intermunicipal" | ///
`q' "tirar a moto que estava presa por infraçao  de transito" |`q' "Ajuda para transporte" | `q' "deu uma seresta" | ///
`q' "UM TRANSPORTE PARA LEVAR A MINHA FILHA PRA O SAC (TIRAR OS DOCUMENTOS, RG, CPF E O TÍTULO DE ELEITOR" | ///
///
`q' "Um carro para socorrer a filha." |`q' "pedio pra quebar as pedras da porta de casa" | `q' "um carro pra pode servi minha familia" | ///
`q' "passagem para ir a fortaleza" |`q' "uma chuteira ,porque  eu jogo futebol" |`q' "gasolina" | `q' "Conserto da moto" | ///
`q' "DINHEIRO PARA TIRAR A CERTIDÃO DE NASCIMENTO DO MEU FILHO" |`q' "amortecedor para moto" |`q' "transporte para Caruaru" | ///
`q' "pedi um pneu para minha moto." |`q' "comprar um butijao de gas" |`q' "trazer um transporte no dia da eleição,para levar ás pessoas" | ///
`q' "carro para pega uma produto em Quixadá." |`q' "um bolo de aniversário" |`q' "Dinheiro para pagar contas (80 reais)." | ///
`q' "tranporte para outras cidades" |`q' "PASSAGEM DE ÔNIBUS(NÃO FOI EM DINHEIRO)" |`q' "Um carro para me levar para rua."


** Any private good
gen c_ask_private_vereador_postcoded = 0 if !missing(c_talk_pre_) | !missing(c_talk_ver_)
replace c_ask_private_vereador_postcoded  = 1 if c_ask_help_water_f_ver_ == 1 | c_ask_help_construction_ver_ == 1 | ///
c_ask_help_edu_f_ver_ == 1 | c_ask_help_electricity_f_ver_ == 1 | c_ask_help_med_ver_ == 1 | c_ask_help_basket_ver_ == 1 | ///
c_ask_help_job_ver_ == 1 | c_ask_money_ver == 1 | c_ask_help_health_f_ver_ == 1 | c_ask_help_other_private_ver_ == 1


** Any private good, excluding water
gen c_ask_priv_vereador_nowater_post = 0 if !missing(c_talk_pre_) | !missing(c_talk_ver_)
replace c_ask_priv_vereador_nowater_post  = 1 if  c_ask_help_construction_ver_ == 1 | c_ask_help_edu_f_ver_ == 1 | ///
c_ask_help_electricity_f_ver_ == 1 | c_ask_help_med_ver_ == 1 | c_ask_help_basket_ver_ == 1 | c_ask_help_job_ver_ == 1 | ///
c_ask_money_ver == 1 | c_ask_help_health_f_ver_ == 1 | c_ask_help_other_private_ver_ == 1


*==============================================================================*
**## Ask help from Mayor (2012)
*==============================================================================*

local q "c_ask_help_other_spec_pre_=="

*------------------------------------------------------------------------------*
* Help with public goods
*------------------------------------------------------------------------------*
** Education
replace c_ask_help_edu_c_pre_ = 1 if `q' "Trazer uma escola, pois não tem escola nesse sítio"


** Other
gen c_ask_help_other_community_pre_ = 1 if `q' "Ativar a associação de moradores" |`q' "patrocinar um evento promovido por min."


** Any public good
gen c_ask_public_prefeito_postcoded = 0 if !missing(c_talk_pre_) | !missing(c_talk_ver_)
replace c_ask_public_prefeito_postcoded  = 1 if c_ask_water_c_pre_ == 1 | c_ask_help_road_pre_ == 1 | c_ask_help_edu_c_pre_ == 1 | ///
c_ask_help_electricity_c_pre_ == 1 | c_ask_help_health_c_pre_ == 1 | c_ask_help_other_community_pre_ == 1


*------------------------------------------------------------------------------*
* Help with private goods
*------------------------------------------------------------------------------*
** Water
replace c_ask_help_water_f_pre_ = 1 if `q' "construção de um barreiro" |`q' "Para construir um poço d'água." | ///
`q' "pediu para construir a cisterna e poste com luz para a comunidade" |`q' "tirar lama da barragem"  |`q' "um poço"


** Construction
replace c_ask_help_construction_pre_ = 1 if `q' "Construção de uma casa" |`q' "construir minha casa" | ///
`q' "HORAS DE TRATOR PARA CONSTRUIR UM BARREIRO"


** Electricity
replace c_ask_help_electricity_f_pre_ = 1 if `q' "pediu para pagar uma conta de energia"


** Job
replace c_ask_help_job_pre_ = 1 if `q' "Conseguir emprego" |`q' "Emprego" |`q' "emprego" |`q' "EMPREGO PRO MARIDO" | ///
`q' "pediu emprego para a filha" |`q' "um emprego."


** Money
gen c_ask_money_pre = 1 if `q' "AJUDA FINACEIRA" |`q' "ajuda finaceira" |`q' "dinheiro" |`q' "Dinheiro" |`q' "DINHEIRO" | ///
`q' "dinheiro também." |`q' "Dinheiro." |`q' "foi em dinheiro." |`q' "Pediu dinheiro R$ 80,00"


** Medicine
replace c_ask_help_health_f_pre_ = 1 if `q' "Aparelho de medir a PRESSAO." |`q' "cadeira de roda eletrica" |`q' "Cirurgia para o filho" | ///
`q' "Exame médico - Ressonância magnética" |`q' "Exames médicos" |`q' "transportacajue para tratamento medico em Aracaju." | ///
`q' "transporte para levar o marido ao tratamento médico" |`q' "Ttamento Medicora" |`q' "Um exame médico" | ///
`q' "Uma cirurgia para o filho" |`q' "UMA PASSAGEM PARA IR NA CIDADE DE IRECÊ-BA (MINHA MULHER FAZER EXAMES NA CABEÇA)"


** Other
gen c_ask_help_other_private_pre_ = 1 if `q' "ASSISTENCIA FUNERARIA" |`q' "casa" | `q' "concertar a minha moto" |`q' "concertar a moto"| ///
`q' "cobrir a cisterna do vizinho que era aberta e as crianças corria o risco de cair dentro" |`q' "concerto da moto" | /// 
`q' "Conserto da sua moto" |`q' "dinheiro para inteirar passagem de ônibus para outro município" |`q' "Dinheiro pra pagar as contas" | ///
`q' "Leite para o filho" |`q' "Pae São Paulo para Adustinassagem d" |`q' "pagar taxa do sindicato" | ///
`q' "Passagem de São Paulo para Adustina" |`q' "pediu a carteira nacional de habilitação" |`q' "pediu para limpar o barreiro" | ///
`q' "Pediu pra tirar documentos" |`q' "PEDIU QUE AJUDASSE NA APOSENTADORIA." |`q' "pneu para a moto" |`q' "Pneu para meu carro." | ///
`q' "residuo para os animais" |`q' "tirar 2 via de documentos perdidos" |`q' "transporte"


** Any private good
gen c_ask_private_prefeito_postcoded = 0 if !missing(c_talk_pre_) | !missing(c_talk_ver_)
replace c_ask_private_prefeito_postcoded = 1 if c_ask_help_water_f_pre_ == 1 | c_ask_help_construction_pre_ == 1 | ///
c_ask_help_edu_f_pre_ == 1 | c_ask_help_electricity_f_pre_ == 1 | c_ask_help_med_pre_ == 1 | c_ask_help_basket_pre_ == 1 | ///
c_ask_help_job_pre_ == 1 | c_ask_money_pre == 1 | c_ask_help_health_f_pre_ == 1 | c_ask_help_other_private_pre_ == 1


** Any private good, excluding water
gen c_ask_priv_prefeito_nowater_post = 0 if !missing(c_talk_pre_) | !missing(c_talk_ver_)
replace c_ask_priv_prefeito_nowater_post = 1 if c_ask_help_construction_pre_ == 1 | c_ask_help_edu_f_pre_ == 1 | ///
c_ask_help_electricity_f_pre_ == 1 | c_ask_help_med_pre_ == 1 | c_ask_help_basket_pre_ == 1 | c_ask_help_job_pre_ == 1 | ///
c_ask_money_pre == 1 | c_ask_help_health_f_pre_ == 1 | c_ask_help_other_private_pre_ == 1



*==============================================================================*
**## Ask help from Mayor or City Councillor (2012)
*==============================================================================*

*------------------------------------------------------------------------------*
* Help with public goods
*------------------------------------------------------------------------------*
** Any public good
gen c_ask_public_pol_postcoded = 1 if c_ask_public_vereador_postcoded == 1 | c_ask_public_prefeito_postcoded == 1
replace c_ask_public_pol_postcoded = 0 if c_ask_public_vereador_postcoded == 0 & c_ask_public_prefeito_postcoded == 0


*------------------------------------------------------------------------------*
* Help with private goods
*------------------------------------------------------------------------------*
** Any private good
gen c_ask_private_pol_postcoded = 1 if c_ask_private_vereador_postcoded == 1 | c_ask_private_prefeito_postcoded == 1
replace c_ask_private_pol_postcoded = 0 if c_ask_private_vereador_postcoded == 0 & c_ask_private_prefeito_postcoded == 0


** Any private good, excluding water
gen c_ask_priv_pol_nowater_post = 1 if c_ask_priv_vereador_nowater_post == 1 | c_ask_priv_prefeito_nowater_post == 1
replace c_ask_priv_pol_nowater_post = 0 if c_ask_priv_vereador_nowater_post == 0 & c_ask_priv_prefeito_nowater_post == 0


*==============================================================================*
**## Ask and received help for public goods from Mayor or City Councillor (2012)
*==============================================================================*

*------------------------------------------------------------------------------*
* Any public good
*------------------------------------------------------------------------------*
** Any public good from councillor
gen c_ver_askrec_pub_post = 0 if !missing(c_ask_help_gen_ver_)
replace c_ver_askrec_pub_post = 1 if c_ask_public_vereador_postcoded == 1 & c_receive_help_ver_ == 1


** Any public good from mayor
gen c_pre_askrec_pub_post = 0 if !missing(c_ask_help_gen_ver_)      			// note - ver, not pre, else will drop too many observations
replace c_pre_askrec_pub_post = 1 if c_ask_public_prefeito_postcoded == 1 & c_receive_help_pre_ == 1


** Any public good from mayor or councillor
gen c_pol_askrec_pub_post = 1 if c_ver_askrec_pub_post == 1 | c_pre_askrec_pub_post == 1
replace c_pol_askrec_pub_post = 0 if c_ver_askrec_pub_post == 0 & c_pre_askrec_pub_post == 0


*==============================================================================*
**## Ask and received help for private goods from Mayor or City Councillor (2012)
*==============================================================================*

*------------------------------------------------------------------------------*
* Any private good
*------------------------------------------------------------------------------*
** Any private good from councillor
gen c_ver_askrec_priv_post = 0 if !missing(c_ask_help_gen_ver_)
replace c_ver_askrec_priv_post = 1 if c_ask_private_vereador_postcoded == 1 & c_receive_help_ver_ == 1


** Any private good from mayor
gen c_pre_askrec_priv_post = 0 if !missing(c_ask_help_gen_ver_) 				// note - ver, not pre, else will drop too many observations
replace c_pre_askrec_priv_post = 1 if c_ask_private_prefeito_postcoded == 1 & c_receive_help_pre_ == 1


** Any private good from mayor or councillor
gen c_pol_askrec_priv_post = 1 if c_ver_askrec_priv_post == 1 | c_pre_askrec_priv_post == 1
replace c_pol_askrec_priv_post = 0 if c_ver_askrec_priv_post == 0 & c_pre_askrec_priv_post == 0


*------------------------------------------------------------------------------*
* Any private good, excluding water
*------------------------------------------------------------------------------*
** Any private good from councillor, excluding water
gen c_ver_askrec_priv_nowater_post = 0 if !missing(c_ask_help_gen_ver_)
replace c_ver_askrec_priv_nowater_post = 1 if c_ask_priv_vereador_nowater_post == 1 & c_receive_help_ver_ == 1


** Any private good from mayor, excluding water 
gen c_pre_askrec_priv_nowater_post = 0 if !missing(c_ask_help_gen_ver_) 		// note - ver, not pre, else will drop too many observations  
replace c_pre_askrec_priv_nowater_post = 1 if c_ask_priv_prefeito_nowater_post == 1 & c_receive_help_pre_ == 1


** Any private good from mayor or councillor, excluding water
gen c_pol_askrec_priv_nowater_post = 1 if  c_ver_askrec_priv_nowater_post == 1 | c_pre_askrec_priv_nowater_post == 1
replace c_pol_askrec_priv_nowater_post = 0 if c_ver_askrec_priv_nowater_post == 0 & c_pre_askrec_priv_nowater_post == 0



*==============================================================================*
**## Received help from City Councillor (2013)
*==============================================================================*

foreach x of varlist e_rec_hlp_*{
	gen `x'post = `x'
}

local q "e_rec_hlp_cnclr_spec_=="


** Water 
replace e_rec_hlp_cnclr_wtr_post = 1 if `q' "bomba de agua" | `q' "maquina para carvar a cisterna"


** Building material
replace e_rec_hlp_cnclr_bldmtrl_post = 1 if `q' "SACO DE ADUBO" | `q' "areia" |`q' "uam porta para minha casa"


** Medicine
replace e_rec_hlp_cnclr_medicine_post = 1 if `q' "REMÉDIO" | `q' "Remedios" | `q' "medicamento" | `q' "medicamento(remedios)"| ///
`q' "remedio" | `q' "remedios"


** Medical treatment
replace e_rec_hlp_cnclr_medtrt_post = 1 if `q' "A CONSULTA DO OCULISTA E O OCULOS." | `q' "Deu dinheiro para fazer um exame partic" | ///
`q' "EXAMES" | `q' "TRANSPORTE MEDICO" | `q' "TRANSPORTE PARA O HOSPITAL" | `q' "VIAGEM COM PESSOA DOENTE" | ///
`q' "conduçao para deixar a esposa no hospit" | `q' "consulta para meu filho no psicologo" | ///
`q' "deu uma consulta do meu filho e exame q" | `q' "exame medico"| `q' "exames medicos"| `q' "levou meu irmão pro hospital" | ///
`q' "pagou exame medico" | `q' "resebe uma ajuda medica" | `q' "tratamento de saude em recife"


** Any private good
gen rec_priv_ver_hlp_2013 = 0 if !missing(e_rec_hlp_cnclr_)
replace rec_priv_ver_hlp_2013 = 1 if e_rec_hlp_cnclr_spec_ != "" & e_rec_hlp_cnclr_spec_ != "construção de um açude"
replace rec_priv_ver_hlp_2013 = 1 if e_rec_hlp_cnclr_wtr_post == 1 | e_rec_hlp_cnclr_bldmtrl_post == 1 | ///
e_rec_hlp_cnclr_medicine_post == 1 | e_rec_hlp_cnclr_schl_post == 1 | e_rec_hlp_cnclr_elecbl_post == 1 | ///
e_rec_hlp_cnclr_medtrt_post == 1 | e_rec_hlp_cnclr_food_post == 1 | e_rec_hlp_cnclr_empl_post == 1


** Any private good, excluding water
gen rec_priv_ver_hlp_nowater_2013 = 0 if !missing(e_rec_hlp_cnclr_)
replace rec_priv_ver_hlp_nowater_2013 = 1 if e_rec_hlp_cnclr_spec_ != "" & e_rec_hlp_cnclr_spec_ != "construção de um açude"
replace rec_priv_ver_hlp_nowater_2013 = 1 if  e_rec_hlp_cnclr_bldmtrl_post == 1 | e_rec_hlp_cnclr_medicine_post == 1 | ///
e_rec_hlp_cnclr_schl_post == 1 | e_rec_hlp_cnclr_elecbl_post == 1 | e_rec_hlp_cnclr_medtrt_post == 1 | ///
e_rec_hlp_cnclr_food_post == 1 | e_rec_hlp_cnclr_empl_post == 1


** Any public good
gen rec_comm_ver_hlp_2013 = 0 if !missing(e_rec_hlp_cnclr_)
replace rec_comm_ver_hlp_2013 = 1 if `q' "construção de um açude"
replace rec_comm_ver_hlp_2013 = 1 if e_rec_hlp_cnclr_wtr_comm_post == 1 | e_rec_hlp_cnclr_roads_post == 1 | ///
e_rec_hlp_cnclr_health_post == 1 | e_rec_hlp_cnclr_schlcomm_post == 1 | e_rec_hlp_cnclr_elec_post == 1

gen rec_public_ver_help_2013 = rec_comm_ver_hlp_2013


*==============================================================================*
**## Received help from Mayor (2013)
*==============================================================================*

local q "e_rec_hlp_myr_spec_=="


** Water
replace e_rec_hlp_myr_wtr_post = 1 if `q' "cistetrna" | `q' "trazendo o carro pipa"


