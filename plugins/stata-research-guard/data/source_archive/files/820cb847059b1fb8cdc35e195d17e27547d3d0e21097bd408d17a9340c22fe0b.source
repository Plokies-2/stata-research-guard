replace rec_comm_pol_hlp_2013 = 0 if rec_comm_ver_hlp_2013 == 0 & rec_comm_myr_hlp_2013 == 0


*==============================================================================*
**## Ask help from City Councillor (2013)
*==============================================================================*

local q "e_ask_cnclr_spec_=="


** Other goods (1: private; 0: public; missing: not applicable)
gen ask_ver_other_private_2013 = 1 if e_ask_cnclr_spec_ != ""
replace ask_ver_other_private_2013 = 0 if `q' "CHUTEIRA PRA JOGAR BOLA" | `q' "Praça" | `q' "LAMPADA PARA O POSTE" | ///
`q' "MELHORIA DO TRANSPORTE" | `q' "construção de açude comunitário" | `q' "cortador de mato para o colegio"  | ///
`q' "melhoria pra Associação Comunitária" | `q' "melhoria pro campo de futebol" | `q' "pediu carro de som, para divulgar event" | ///
`q' "sobre a dificuldades da regiao" | `q' "um poste de iluminação público"


** Water (public)
gen e_ask_cnclr_wtr_comm_post =  e_ask_cnclr_wtr_comm_
replace e_ask_cnclr_wtr_comm_post = 1 if `q' "construção de açude comunitário"

** Roads (public)
gen e_ask_cnclr_roads_post =  e_ask_cnclr_roads_

** Health (public)
gen e_ask_cnclr_health_post =  e_ask_cnclr_health_

** School (public)
gen e_ask_cnclr_schlcomm_post =  e_ask_cnclr_schlcomm_

** Electricity (public)
gen e_ask_cnclr_elec_post =  e_ask_cnclr_elec_
replace e_ask_cnclr_elec_post = 1 if `q' "LAMPADA PARA O POSTE" | `q' "um poste de iluminação público"


** Water (private)
gen e_ask_cnclr_wtr_post =  e_ask_cnclr_wtr_
replace e_ask_cnclr_wtr_post = 1 if `q' "caixa d gua" | `q' "uma cavadeira para cavarn a cisterna" | `q' "UMA MAQUINA DE CAVAR CISTERNAS"


** Building Materials (private)
gen e_ask_cnclr_bldmtrl_post =  e_ask_cnclr_bldmtrl_
replace e_ask_cnclr_bldmtrl_post = 1 if `q' "madeiras para colocar no barco" | `q' "pediu dinheiro para comprar cimento" | ///
`q' "UMA CAÇAMBA DE PIÇARRO (TERRA)" | `q' "Uma Retroescavadeira pra aterramento" | `q' "areia" | `q' "cimento" | ///
`q' "pediu dinheiro para comprar cimento" | `q' "trator de esteira para ajeitar o campo"


** Medicine (private)
gen e_ask_cnclr_medicine_post =  e_ask_cnclr_medicine_
replace e_ask_cnclr_medicine_post  = 1 if `q' "REMERDIO" | `q' "Remedio" | `q' "TRANSPORTE E REMÉDIO" | `q' "comprar remedios" | ///
`q' "medicamento" | `q' "remedio" | `q' "remedio para meu pai" | `q' "remedios"


** Electricity (private)
gen e_ask_cnclr_elecbl_post =  e_ask_cnclr_elecbl_
replace e_ask_cnclr_elecbl_post = 1 if `q' "dinheiro para comprar bujao"


** Medical treatment (private)
gen e_ask_cnclr_medtrt_post =  e_ask_cnclr_medtrt_
replace e_ask_cnclr_medtrt_post = 1 if `q' "Ajudou agente conseguir Cirurgia do meu" | `q' "CONSULTA MEDICA E O OCULOS" | `q' "DENTADURA" | ///
`q' "DINHEIRO PRA FAZER UM EXAME EM GARANHUN" | `q' "LEVA DE CARRO PRA MATERNIDADE,ESTAVA GR" | `q' "TRANSPORTE PARA OS DOENTES" | ///
`q' "transporte para ir pro hospital"| `q' "200 reais para fazer um tratamento medi"| `q' "AJUDA PARA PROBLEMA DE SAUDE" | ///
`q' "Dinheiro para fazer um exame, particula" | `q' "TRANSPORTE MEDICO" | `q' "cadeira de rodas para o filho"| `q' "exame medico" | ///
`q' "exames" | `q' "levou pra recife para se consultar"| `q' "o medico para meu filho" | `q' "para fazer um exame"| ///
`q' "transpoete para campina grande/tratamen"


** Food (private)
gen e_ask_cnclr_food_post = e_ask_cnclr_food_


** Job (private)
gen e_ask_cnclr_empl_post =  e_ask_cnclr_empl_
replace e_ask_cnclr_empl_post = 1 if `q' "emprego"


*------------------------------------------------------------------------------*
* Aggregate measures 
*------------------------------------------------------------------------------*

/* 
NOTE: These measures are the same whether they use the updated "_post" variables or the original survey variables, 
because the "_post" variable updates are encapsulated in the ask_ver_other_private_2013 variable in aggregate. 
*/

** Any private good
gen ask_ver_private_2013 = 0 if e_ask_cnclr_ != .
replace ask_ver_private_2013 = 1 if e_ask_cnclr_wtr_ == 1 | e_ask_cnclr_bldmtrl_ == 1 | e_ask_cnclr_medicine_ == 1 | ///
e_ask_cnclr_elecbl_ == 1 | e_ask_cnclr_medtrt_ == 1 | e_ask_cnclr_food_ == 1 | e_ask_cnclr_empl_ == 1 | e_ask_cnclr_schl_ == 1 | ///
ask_ver_other_private_2013 == 1


** Any private good, excluding water
gen ask_ver_private_nowater_2013 = 0 if e_ask_cnclr_ != .
replace ask_ver_private_nowater_2013 = 1 if e_ask_cnclr_bldmtrl_ == 1 | e_ask_cnclr_medicine_ == 1 | e_ask_cnclr_elecbl_ == 1 | ///
e_ask_cnclr_medtrt_ == 1 | e_ask_cnclr_food_ == 1 | e_ask_cnclr_empl_ == 1 | e_ask_cnclr_schl_ == 1 | ask_ver_other_private_2013 == 1


** Any public good
gen ask_ver_community_2013 = 0 if e_ask_cnclr_ != .
replace ask_ver_community_2013 = 1 if e_ask_cnclr_wtr_comm_ == 1 | e_ask_cnclr_roads_ == 1 | e_ask_cnclr_health_ == 1 | ///
e_ask_cnclr_schlcomm_ == 1 | e_ask_cnclr_elec_ == 1 | ask_ver_other_private_2013 == 0

gen ask_ver_public_2013 = ask_ver_community_2013


*==============================================================================*
**## Ask help from Mayor (2013)
*==============================================================================*

local q "e_ask_myr_spec_=="


** Other goods (1: private; 0: public; missing: not applicable)
gen ask_mayor_other_private_2013 = 1 if e_ask_myr_spec_ != ""
replace ask_mayor_other_private_2013 = 0 if `q' "banheiros que falta no sitio" | `q' "TIRAR A LAMA DA BARRAGEM"


** Water (private)
gen e_ask_myr_wtr_post = e_ask_myr_wtr_
replace e_ask_myr_wtr_post = 1 if `q' "pedir um poço arteziano" | `q' "cisterna"


** Building materials (private)
gen e_ask_myr_bldmtrl_post = e_ask_myr_bldmtrl_
replace e_ask_myr_bldmtrl_post = 1 if `q' "consertar aminha casa" |  `q' "pediu um trator emprestado para afundar" | ///
`q' "trator" |  `q' "uma retroescavadeira"
 
 
** Medicine (private) 
gen e_ask_myr_medicine_post = e_ask_myr_medicine_
replace e_ask_myr_medicine_post = 1 if `q' "REMEDIO"  |  `q' "remedios"


** Electricity (private)
gen e_ask_myr_elecbl_post = e_ask_myr_elecbl_


** Medical treatment (private)
gen e_ask_myr_medtrt_post = e_ask_myr_medtrt_
replace e_ask_myr_medtrt_post = 1 if `q' "DENTADURA" |  `q' "exames médicos" | `q' "CARRO PARA IR AO MÉDICO" | ///
`q' "EXAME MEDICO" | `q' "ajuda de custo para exame medico"


** Food (private)
gen e_ask_myr_food_post = e_ask_myr_food_


** Job (private)
gen e_ask_myr_empl_post = e_ask_myr_empl_


*------------------------------------------------------------------------------*
* Aggregate measures 
*------------------------------------------------------------------------------*

/* 
NOTE: These measures are the same whether they use the updated "_post" variables or the original survey variables, 
because the "_post" variable updates are encapsulated in the ask_ver_other_private_2013 variable in aggregate. 
*/


** Any private good
gen ask_mayor_private_2013 = 0 if e_ask_myr_ != .
replace ask_mayor_private_2013 = 1 if e_ask_myr_wtr_ == 1 | e_ask_myr_bldmtrl_ == 1 | e_ask_myr_medicine_ == 1 | e_ask_myr_schl_ == 1| ///
e_ask_myr_elecbl_ == 1 | e_ask_myr_medtrt_ == 1 | e_ask_myr_food_ == 1 | e_ask_myr_empl_ == 1 | ask_mayor_other_private_2013 == 1


** Any private good, excluding water
gen ask_mayor_private_nowater_2013 = 0 if e_ask_myr_ != .
replace ask_mayor_private_nowater_2013 = 1 if e_ask_myr_bldmtrl_ == 1 | e_ask_myr_medicine_ == 1 | e_ask_myr_schl_ == 1| ///
e_ask_myr_elecbl_ == 1 | e_ask_myr_medtrt_ == 1 | e_ask_myr_food_ == 1 | e_ask_myr_empl_ == 1 | ask_mayor_other_private_2013 == 1


** Any public good
gen ask_mayor_community_2013 = 0 if e_ask_myr_ != .
replace ask_mayor_community_2013 = 1 if e_ask_myr_wtr_comm_ == 1 | e_ask_myr_roads_ == 1 | e_ask_myr_health_ == 1 | ///
e_ask_myr_schlcomm_ == 1 | ask_mayor_other_private_2013 == 0

gen ask_mayor_public_2013 = ask_mayor_community_2013


*==============================================================================*
**## Ask help from Mayor or City Councillor (2013)
*==============================================================================*

** Measures using updated survey variables, any private goods (private, private_nowater); any public goods (community, public)
foreach var in "private" "private_nowater" "community" "public" {
	
	gen ask_pol_`var'_2013 = 1 if ask_ver_`var'_2013 == 1 | ask_mayor_`var'_2013 == 1
	replace ask_pol_`var'_2013 = 0 if ask_ver_`var'_2013 == 0 & ask_mayor_`var'_2013 == 0
}


*==============================================================================*
**## Ask and receive help from mayor or city councillor (2013), private goods
*==============================================================================*

*------------------------------------------------------------------------------*
/* Any private good : ask for any private good and receive any private good (may not be requested good)
				    + receive question was asked earlier in the survey, before the ask question */
*------------------------------------------------------------------------------*
** Any private good from councillor
gen askrec_ver_private_2013 = 0 if !missing(ask_ver_private_2013)
replace askrec_ver_private_2013 = 1 if ask_ver_private_2013 == 1 & rec_priv_ver_hlp_2013 == 1


** Any private good from mayor
gen askrec_mayor_private_2013 = 0 if !missing(ask_mayor_private_2013)
replace askrec_mayor_private_2013 = 1 if ask_mayor_private_2013 == 1 & rec_priv_myr_hlp_2013 == 1


** Any private good from mayor or councillor
gen askrec_pol_private_2013 = 1 if askrec_ver_private_2013 == 1 | askrec_mayor_private_2013 == 1
replace askrec_pol_private_2013 = 0 if askrec_ver_private_2013 == 0 & askrec_mayor_private_2013 == 0


*------------------------------------------------------------------------------*
/* Any private good, excluding water : ask for any private good and receive any private good (may not be requested good)
									 + receive question was asked earlier in the survey, before the ask question */
*------------------------------------------------------------------------------*
** Any private good from councillor, excluding water
gen askrec_ver_private_nowater_2013 = 0 if !missing(ask_ver_private_2013)
replace askrec_ver_private_nowater_2013 = 1 if ask_ver_private_nowater_2013 == 1 & rec_priv_ver_hlp_nowater_2013 == 1


** Any private good from mayor, excluding water
gen askrec_myr_private_nowater_2013 = 0 if !missing(ask_mayor_private_2013)
replace askrec_myr_private_nowater_2013 = 1 if ask_mayor_private_nowater_2013 == 1 & rec_priv_myr_hlp_nowater_2013 == 1


** Any private good from mayor or councillor, excluding water
gen askrec_pol_private_nowater_2013 = 1 if askrec_ver_private_nowater_2013 == 1 | askrec_myr_private_nowater_2013 == 1
replace askrec_pol_private_nowater_2013 = 0 if askrec_ver_private_nowater_2013 == 0 & askrec_myr_private_nowater_2013 == 0


*==============================================================================*
**## Ask and receive help from mayor or city councillor (2013), public goods
*==============================================================================*

*------------------------------------------------------------------------------*
/* Any public good  : received the requested public good 
                    + was asked later in survey, after and conditional on the ask question. 
*/
*------------------------------------------------------------------------------*
** Any public good from councillor 
gen askrec_ver_pub_same_2013 = 0 if !missing(ask_ver_public_2013)
replace askrec_ver_pub_same_2013 = 1 if e_askrec_cnclr_wtr_comm_ == 1 | e_askrec_cnclr_roads_ == 1 | ///
e_askrec_cnclr_health_ == 1 | e_askrec_cnclr_schlcomm_ == 1 | e_askrec_cnclr_elec_ == 1 | ///
(e_askrec_cnclr_spec_ == 1 & ask_ver_other_private_2013 == 0)


** Any public good from mayor 
gen askrec_mayor_pub_same_2013 = 0 if !missing(ask_mayor_public_2013)
replace askrec_mayor_pub_same_2013 = 1 if e_askrec_myr_wtr_comm_ == 1 | e_askrec_myr_roads_ == 1 | ///
e_askrec_myr_health_ == 1 | e_askrec_myr_schlcomm_ == 1 | e_askrec_myr_elec_ == 1 | ///
(e_askrec_myr_spec_ == 1 & ask_mayor_other_private_2013 == 0)


** Any public good from mayor or councillor 
gen askrec_pol_pub_same_2013 = 1 if askrec_ver_pub_same_2013 == 1 | askrec_mayor_pub_same_2013 == 1
replace askrec_pol_pub_same_2013 = 0 if askrec_ver_pub_same_2013 == 0 & askrec_mayor_pub_same_2013 == 0


*------------------------------------------------------------------------------*
/* Any public good  : ask for any public good and receive any public good (may not be requested good)
				    + receive question was asked earlier in the survey, before the ask question */
*------------------------------------------------------------------------------*
** Any public good from councillor
gen askrec_ver_public_2013 = 0 if !missing(ask_ver_public_2013)
replace askrec_ver_public_2013 = 1 if ask_ver_public_2013 == 1 & rec_public_ver_help_2013 == 1


** Any public good from mayor
gen askrec_mayor_public_2013 = 0 if !missing(ask_mayor_public_2013)
replace askrec_mayor_public_2013 = 1 if ask_mayor_public_2013 == 1 & rec_public_mayor_help_2013 == 1


** Any public good from mayor or councillor
gen askrec_pol_public_2013 = 1 if askrec_ver_public_2013 == 1 | askrec_mayor_public_2013 == 1
replace askrec_pol_public_2013 = 0 if askrec_ver_public_2013 == 0 & askrec_mayor_public_2013 == 0


*==============================================================================*
**## Ask, Receive, and Ask & Receive by Incumbency Status 
*==============================================================================*

*------------------------------------------------------------------------------*
* 2012 Private Goods
*------------------------------------------------------------------------------*
foreach status in "incumbent" "nonincumbent" {
	
	if "`status'" == "incumbent" local val = 1
	else local val = 0
	
	
	** Ask for private goods, councillor 
	gen c_ask_`status'_ver = 0 if c_ask_private_pol_postcoded != .
	replace c_ask_`status'_ver = 1 if c_ask_private_vereador_postcoded == 1 & c_incumbant_ver_ == `val'
	
	
	** Ask for private goods, mayor
	gen c_ask_`status'_pre = 0 if c_ask_private_pol_postcoded != .
	replace c_ask_`status'_pre = 1 if c_ask_private_prefeito_postcoded == 1 & c_incumbant_pre_ == `val'

	
	** Ask for private goods, mayor or councillor 
	gen ask_private_`status'_2012  = 1 if c_ask_`status'_ver == 1 | c_ask_`status'_pre == 1
	replace ask_private_`status'_2012  = 0 if c_ask_`status'_ver == 0 & c_ask_`status'_pre == 0
	
	
	** Ask for and receive private goods, councillor 
	gen c_askrec_`status'_ver = 0 if c_pol_askrec_priv_post != .
	replace c_askrec_`status'_ver = 1 if c_ver_askrec_priv_post == 1 & c_incumbant_ver_ == `val'
	
	
	** Ask for and receive private goods, mayor 
	gen c_askrec_`status'_pre = 0 if c_pol_askrec_priv_post != .
	replace c_askrec_`status'_pre = 1 if c_pre_askrec_priv_post == 1 & c_incumbant_pre_ == `val'
	
	
	** Ask for and receive private goods, mayor or councillor 
	gen askrec_private_`status'_2012 = 1 if c_askrec_`status'_ver == 1 | c_askrec_`status'_pre == 1
	replace askrec_private_`status'_2012 = 0 if c_askrec_`status'_ver == 0 & c_askrec_`status'_pre == 0
}


*------------------------------------------------------------------------------*
* 2013 Private Goods, Non-Incumbent
*------------------------------------------------------------------------------*

** Ask for private goods, councillor
gen e_ask_nonincumbent_ver = 0 if !missing(e_ask_cnclr_lost_)

replace e_ask_nonincumbent_ver = 1 if e_ask_cnclr_lost_wtr_ == 1 | e_ask_cnclr_lost_bldmtrl_ == 1 | e_ask_cnclr_lost_medicine_ == 1 | ///
e_ask_cnclr_lost_schl_ == 1 | e_ask_cnclr_lost_elecbl_ == 1 | e_ask_cnclr_lost_medtrt_ == 1 | e_ask_cnclr_lost_food_ == 1 | ///
e_ask_cnclr_lost_empl_ == 1 | e_ask_cnclr_lost_oth_ == 1

replace e_ask_nonincumbent_ver = 1 if inlist(e_ask_cnclr_lost_spec_, "minha filha para o hospital", "DINHEIRO", "carro de som", "dinheiro",												"remedio", "remedio para meu pai", "uma escavadeira para cavar um buraco para fazer a cisterna")


** Ask for private goods, mayor 
gen e_ask_nonincumbent_pre = 0 if !missing(e_ask_myr_lost_)

replace e_ask_nonincumbent_pre = 1 if e_ask_myr_lost_wtr_ == 1 | e_ask_myr_lost_bldmtrl_ == 1 | e_ask_myr_lost_medicine_ == 1 | ///
e_ask_myr_lost_schl_ == 1 | e_ask_myr_lost_elecbl_ == 1 | e_ask_myr_lost_medtrt_ == 1 | e_ask_myr_lost_food_ == 1 | ///
e_ask_myr_lost_empl_ == 1 | e_ask_myr_lost_oth_ == 1 | e_ask_myr_lost_spec_ == "dinheiro"


** Ask for private goods, mayor or councillor
gen ask_private_nonincumbent_2013  = 1 if e_ask_nonincumbent_ver == 1 | e_ask_nonincumbent_pre == 1
replace ask_private_nonincumbent_2013  = 0 if e_ask_nonincumbent_ver == 0 & e_ask_nonincumbent_pre == 0



** Ask for private goods excluding water, councillor 
gen e_ask_nonincumbent_ver_nowater = 0 if !missing(e_ask_cnclr_lost_)

replace e_ask_nonincumbent_ver_nowater = 0 if e_ask_cnclr_lost_bldmtrl_ == 1 | e_ask_cnclr_lost_medicine_ == 1 | ///
e_ask_cnclr_lost_schl_ == 1 | e_ask_cnclr_lost_elecbl_ == 1 | e_ask_cnclr_lost_medtrt_ == 1 | e_ask_cnclr_lost_food_ == 1 | ///
e_ask_cnclr_lost_empl_ == 1 | e_ask_cnclr_lost_oth_ == 1

replace e_ask_nonincumbent_ver_nowater = 1 if inlist(e_ask_cnclr_lost_spec_, "minha filha para o hospital", "DINHEIRO", "carro de som", "dinheiro",												"remedio", "remedio para meu pai", "uma escavadeira para cavar um buraco para fazer a cisterna")


** Ask for private goods excluding water, mayor 
gen e_ask_nonincumbent_pre_nowater = 0 if !missing(e_ask_myr_lost_)

replace e_ask_nonincumbent_pre_nowater = 1 if e_ask_myr_lost_bldmtrl_ == 1 | e_ask_myr_lost_medicine_ == 1 | ///
e_ask_myr_lost_schl_ == 1 | e_ask_myr_lost_elecbl_ == 1 | e_ask_myr_lost_medtrt_ == 1 | e_ask_myr_lost_food_ == 1 | ///
e_ask_myr_lost_empl_ == 1 | e_ask_myr_lost_oth_ == 1 | e_ask_myr_lost_spec_ == "dinheiro"


** Ask for private goods excluding water, mayor or councillor 
gen ask_priv_nonincumb_nowater_2013  = 1 if e_ask_nonincumbent_ver_nowater == 1 | e_ask_nonincumbent_pre_nowater == 1
replace ask_priv_nonincumb_nowater_2013  = 0 if e_ask_nonincumbent_ver_nowater == 0 & e_ask_nonincumbent_pre_nowater == 0



** Ask for and receive private goods, councillor
gen e_askrec_nonincumbent_ver = 0 if !missing(e_ask_cnclr_lost_)

replace e_askrec_nonincumbent_ver = 1 if e_askrec_cnclr_lost_wtr_ == 1 | e_askrec_cnclr_lost_bldmtrl_ == 1 | ///
e_askrec_cnclr_lost_medicine_ == 1 | e_askrec_cnclr_lost_schl_ == 1 | e_askrec_cnclr_lost_elecbl_ == 1 | ///
e_askrec_cnclr_lost_medtrt_ == 1 | e_askrec_cnclr_lost_food_ == 1 | e_askrec_cnclr_lost_empl_ == 1 | e_askrec_cnclr_lost_spec_ == 1


** Ask for and receive private goods, mayor
gen e_askrec_nonincumbent_pre = 0 if !missing(e_ask_myr_lost_)

replace e_askrec_nonincumbent_pre = 1 if e_askrec_myr_lost_wtr_ == 1 | e_askrec_myr_lost_bldmtrl_ == 1 | ///
e_askrec_myr_lost_medicine_ == 1 | e_askrec_myr_lost_schl_ == 1 | e_askrec_myr_lost_elecbl_ == 1 | e_askrec_myr_lost_medtrt_ == 1 | ///
e_askrec_myr_lost_food_ == 1 | e_askrec_myr_lost_empl_ == 1 | e_askrec_myr_lost_spec_ == 1


** Ask for and receive private goods, mayor or councillor
gen askrec_private_nonincumbent_2013  = 1 if e_askrec_nonincumbent_ver == 1 | e_askrec_nonincumbent_pre == 1
replace askrec_private_nonincumbent_2013  = 0 if e_askrec_nonincumbent_ver == 0 & e_askrec_nonincumbent_pre == 0


*------------------------------------------------------------------------------*
* 2013 Private Goods, Incumbent
*------------------------------------------------------------------------------*

** Existing measures apply to the incumbent - rename these variables for clarity
rename ask_pol_private_2013 ask_private_incumbent_2013
rename askrec_pol_private_2013 askrec_private_incumbent_2013
rename ask_pol_private_nowater_2013 ask_priv_incumb_nowater_2013
rename ask_pol_public_2013 ask_public_incumb_2013


*------------------------------------------------------------------------------*
* 2013 Private Goods, Incumbent or Nonincumbent
*------------------------------------------------------------------------------*
foreach spec in "ask" "askrec" {
	
	** From mayor or councillor 
	gen `spec'_pol_private_2013 = 1 if `spec'_private_incumbent_2013 == 1 | `spec'_private_nonincumbent_2013 == 1
	replace `spec'_pol_private_2013 = 0 if `spec'_private_incumbent_2013 == 0 & `spec'_private_nonincumbent_2013 == 0

	
	** From mayor, 2012 goods 
	gen c_`spec'_private_any_mayor = 1 if c_`spec'_incumbent_pre == 1 | c_`spec'_nonincumbent_pre == 1
	replace c_`spec'_private_any_mayor = 0 if c_`spec'_incumbent_pre == 0 & c_`spec'_nonincumbent_pre == 0
	
	
	** From mayor, 2013 goods 
	gen e_`spec'_private_any_mayor = 1 if `spec'_mayor_private_2013 == 1 | e_`spec'_nonincumbent_pre == 1
	replace e_`spec'_private_any_mayor = 0 if `spec'_mayor_private_2013 == 0 & e_`spec'_nonincumbent_pre == 0
}


* Requests for private goods excluding water, 2013 
gen ask_pol_private_nowater_2013 = 1 if ask_priv_incumb_nowater_2013 == 1 | ask_priv_nonincumb_nowater_2013 == 1
replace ask_pol_private_nowater_2013 = 0 if ask_priv_incumb_nowater_2013 == 0 & ask_priv_nonincumb_nowater_2013 == 0


*------------------------------------------------------------------------------*
* 2013 Public Goods, Incumbent or Non-Incumbent
*------------------------------------------------------------------------------*

** Ask for public goods, non-incumbent councillor
gen e_ask_pub_nonincumb_ver = 0 if !missing(e_ask_cnclr_lost_)
replace e_ask_pub_nonincumb_ver = 1 if e_ask_cnclr_lost_wtr_comm_ == 1 | e_ask_cnclr_lost_roads_ == 1 | e_ask_cnclr_lost_health_ == 1 | ///
e_ask_cnclr_lost_schlcomm_ == 1 


** Ask for public goods, non-incumbent mayor
gen e_ask_pub_nonincumb_pre = 0 if !missing(e_ask_myr_lost_)
replace e_ask_pub_nonincumb_pre = 1 if e_ask_myr_lost_wtr_comm_ == 1 | e_ask_myr_lost_roads_ == 1 | e_ask_myr_lost_health_ == 1 | ///
e_ask_myr_lost_schlcomm_ == 1 


** Ask for public goods, non-incumbent councillor or mayor 
gen ask_public_nonincumb_2013  = 1 if e_ask_pub_nonincumb_ver == 1 | e_ask_pub_nonincumb_pre == 1
replace ask_public_nonincumb_2013  = 0 if e_ask_pub_nonincumb_ver == 0 & e_ask_pub_nonincumb_pre == 0


** Ask for public goods, incumbent or non-incumbent 
gen ask_pol_public_2013 = 1 if ask_public_incumb_2013 == 1 | ask_public_nonincumb_2013 == 1
replace ask_pol_public_2013 = 0 if ask_public_incumb_2013 == 0 & ask_public_nonincumb_2013 == 0


********************************************************************************
**# 6. Other Individual-Level Variables 
********************************************************************************

** Sex
gen respondent_male = (b_male_ != 2)                                            
recode respondent_male (0 = 1) (1 = 0), gen(resp_female)


** Education 
replace b_curr_grade_ = b_last_grade_ if b_curr_grade_ == .	
replace b_curr_grade_ = 0 if b_curr_grade_ == .


** Voting coordination
rename e_vote_cnclr_myr_2012_smprty_ vote_same_party
rename c_vote_together_house_pref_ vote_together					
						

*==============================================================================*
**## Declaration of Support for Candidate 
*==============================================================================*
** MEASURE 1 - Declared Dummy
gen c_declared_dummy = 1 if c_declare_shirt_campaign_ == 1 | c_declare_rally_support_ == 1 | c_declare_house_flag == 1 | ///
c_declare_house_paint == 1

replace c_declared_dummy = 0 if c_declared_dummy != 1 & (!missing(c_declare_shirt_campaign) | !missing(c_declare_rally_) | ///
!missing(c_declare_house_flag) | !missing(c_declare_house_paint))


** Declaration measure subcategories
gen declare_body = 0 if c_declared_dummy != .
replace declare_body = 1 if (c_declare_shirt_campaign_ == 1 | c_declare_shirt_electionday_ == 1)

gen declare_house = 0 if c_declared_dummy != .
replace declare_house = 1 if (c_declare_house_flag == 1 | c_declare_house_paint == 1)

gen declare_rally = 0 if c_declared_dummy != .
replace declare_rally = 1 if c_declare_rally_support_ == 1


*==============================================================================*
**## Frequent interactor 
*==============================================================================*
gen frequent_interactor = (infrequent_interact_2012_m == 0) if !missing(infrequent_interact_2012_m)

** If anybody in a given household interacts frequently with a politician, then that household is assigned to the frequent interactor category
egen temp_interactor = max(frequent_interactor), by(num_domicilio_from_loc)  


*==============================================================================*
**## Receive visits and gifts from candidates
*==============================================================================*
gen c_candidate_visit = (c_candidate_visits_num_times_ >= 1) if !missing(c_candidate_visits_num_times_)


** From any candidate 
replace c_candidate_visit = 0 if missing(c_candidate_visit) & !missing(c_mun_id)


*==============================================================================*
**## Other clientelism variables 
*==============================================================================*
** CONSTRUCT "OFFERED HANDOUT IN 2012 CAMPAIGN BASED ON QUESTIONS ASKED IN 2013 SURVEY"
gen e_offered_handout = 0 if e_cand_offerred_truckwtr_ != .

foreach var in e_cand_offerred_truckwtr_ e_cand_offerred_clothes_ e_cand_offerred_food_ e_cand_offerred_medicine_ e_cand_offerred_money_ e_cand_offerred_empl_ e_cand_offerred_oth_ {
	
	replace  e_offered_handout = 1 if `var' == 1
}


*==============================================================================*
**## Other political engagement variables 
*==============================================================================*
foreach var in "c" "e" {	
	replace `var'_ever_commun_president = 0 if `var'_ever_commun_president == .
}


********************************************************************************
**# 7. Generate Variables at the Household Level
********************************************************************************

** Generate total no. of adults per household 
gen adult = (b_age_ >= 16) if !missing(b_age_)
egen total_adults = total(adult), by(num_dom)


** Clean miscellaneous household variables 
gen owns_house = 0
replace owns_house = 1 if b_owns_house == 1

gen elec_access = 0
replace elec_access = 1 if b_elec_w_acc == 1

replace a_hectares = 0 if a_hectares == .

rename b_total_neighbors tot_neigh

rename b_neighbor_has_cistern neigh_cist
replace neigh_cist = 0 if neigh_cist == 2

rename b_last_grade_hoh last_grade_hoh


** Within each household, the household head (or, if not available, next closest relation) is sorted first
sort num_domicilio_from_loc d_row_num_ ind_id


save "${final_data_folder}/clientelism_individual_data.dta", replace


** Keep only household head (or, if not available, next closest relation) from each household
drop if num_domicilio_from_loc == num_domicilio_from_loc[_n-1]
		
	
*==============================================================================*
**## Measures of Wealth
*==============================================================================*

*------------------------------------------------------------------------------*
* Net Savings
*------------------------------------------------------------------------------*
foreach wave in "b" "d" {
    
	** Total Savings
	egen `wave'_tot_liquid_asset = rowtotal(`wave'_liq_savings `wave'_cash `wave'_lent_money `wave'_ag_stocks), missing
			
	** Total Loans
	egen `wave'_tot_loans = rowtotal(`wave'_fam_loan `wave'_shark_loan `wave'_bank_loan `wave'_store_loan `wave'_gov_loan 									  `wave'_other_loan), missing
		
	** Net Savings = Total Savings - Total Loans
	gen `wave'_net_savings = `wave'_tot_liquid_asset - `wave'_tot_loans
}		
		
		
*------------------------------------------------------------------------------*
* Value of Property
*------------------------------------------------------------------------------*

** Replace missing (owned) house values with respective community-median house value
foreach var in value_house value_anoth_plot {
	
	foreach wave in "b" "d" {
		egen `wave'_comm_`var' = median(`wave'_`var'), by(mun_id) 
		order `wave'_comm_`var', after(`wave'_`var') 
		replace `wave'_`var' = . if `wave'_`var' == .b | `wave'_`var' == .c 
		replace `wave'_`var' = `wave'_comm_`var' if `wave'_owns_house == 1 & `wave'_`var' == . 
		replace `wave'_`var' = `wave'_comm_`var' if `wave'_owns_house == 2 & `wave'_`var' == . 
	}
} 
			
				
*------------------------------------------------------------------------------*
* Value of Livestock and Durables (Winsorized)
*------------------------------------------------------------------------------*

local livestock "p_cow p_steer p_calve p_horse p_donkey p_fem_goat p_male_goat p_sheep p_adult_sheep p_pig p_chicken p_duck p_turkey p_goose p_rabbit p_fish p_animal_other"

local durables "p_car p_truck p_motorcycle p_fridge p_stove p_wash_mach p_sew_mach p_tv p_dvd p_cell_phone p_pc p_phone p_satellite p_good_other value_house value_anoth_plot"

foreach var in `livestock' `durables' {

	foreach wave in "b" "d" {
	    replace `wave'_`var' = . if `wave'_`var' == 0 

		** Left-censor at the 5th percentile and right-censor at the 95th percentile
		_pctile `wave'_`var', nq(1000) 			
		replace `wave'_`var' = r(r50) if `wave'_`var' < r(r50) & `wave'_`var' != . 
		replace `wave'_`var' = r(r950) if `wave'_`var' > r(r950) & `wave'_`var' != . 
	}			
} 


*------------------------------------------------------------------------------*
* Generate Wealth Indices
*------------------------------------------------------------------------------*
				
** Use personal and municipality-level prices to define the value of assets
local livestock "cow steer calve horse donkey fem_goat male_goat sheep adult_sheep pig chicken duck turkey goose rabbit fish animal_other animal_ns animal_nr"

local durables "car truck motorcycle fridge stove wash_mach sew_mach tv dvd cell_phone pc phone satellite good_other good_ns good_nr"


foreach var in `livestock' `durables' {	
    
	foreach wave in "b" "d" {
	    replace `wave'_p_`var' = . if `wave'_p_`var' == 0 

		** Define the municipality-level price of each good as the median of personal prices in that municipality.
		egen `wave'_p_comm_`var' = median(`wave'_p_`var'), by(mun_id) 
		
		** If respondents have at least one of the good, replace missing personal prices with the municipality-level price
		replace `wave'_p_`var' = `wave'_p_comm_`var' if `wave'_num_`var' != 0 & `wave'_p_`var' == . 

		** Value of assets using personal prices: number of assets * personal price of assets
		gen `wave'_val_`var' = `wave'_num_`var' * `wave'_p_`var' 
		
		** Value of assets using municipality-level prices: number of assets * municipality-level price of assets
		gen `wave'_val_comm_`var' = `wave'_num_`var' * `wave'_p_comm_`var' 
	}
} 


** Construct aggregate wealth indices
foreach wave in "b" "d" {
    
	** Value of Durables
	egen `wave'_total_durables = rowtotal(`wave'_val_car `wave'_val_truck `wave'_val_motorcycle `wave'_val_fridge `wave'_val_stove 											`wave'_val_wash_mach `wave'_val_sew_mach `wave'_val_tv `wave'_val_dvd `wave'_val_cell_phone 										 `wave'_val_pc `wave'_val_phone `wave'_val_satellite `wave'_val_good_other `wave'_val_good_ns 										   `wave'_val_good_nr), missing
	
	** Value of Livestock
	egen `wave'_total_livestock = rowtotal(`wave'_val_cow `wave'_val_steer `wave'_val_calve `wave'_val_horse `wave'_val_donkey 											 `wave'_val_fem_goat `wave'_val_male_goat `wave'_val_sheep `wave'_val_adult_sheep `wave'_val_pig 										   `wave'_val_chicken `wave'_val_duck `wave'_val_turkey `wave'_val_goose `wave'_val_rabbit 											 `wave'_val_fish `wave'_val_animal_other `wave'_val_animal_ns `wave'_val_animal_nr), missing
	
	** Value of Property
	egen `wave'_value_tot_property = rowtotal(`wave'_value_house `wave'_value_anoth_plot), missing
	
	
	** Total Wealth = Value of Durables + Value of Livestock + Value of Property + Net Savings
	egen `wave'_tot_Wealth = rowtotal(`wave'_total_durables `wave'_total_livestock `wave'_value_tot_property `wave'_net_savings), missing
}


*==============================================================================*
**## Vulnerability Indices
*==============================================================================*

*------------------------------------------------------------------------------*
*	Health Index - Specifically: SRHS
*------------------------------------------------------------------------------*

foreach wave in "b" "d" {
    
	** To add the Self Reported Health Status (SRHS), we first remove DK and DA observations:
	replace `wave'_srhs_nm = . if `wave'_srhs_nm == 5 | `wave'_srhs_nm == 6
			
	/* Since SRHS asked respondents how BAD their health is (from 1 to 4, 4 being worst), we take the negative of this.
	   Thus a higher index means better SRHS. */
	gen `wave'_neg_srhs = `wave'_srhs_nm * (-1)	
	
	** Make index strictly positive
	recode `wave'_neg_srhs (-1 = 4) (-2 = 3) (-3 = 2) (-4 = 1), gen(`wave'_Health)
	
	** Normalize new index to create a measure with mean 0 and standard deviation 1
	egen `wave'_Health_norm = std(`wave'_Health)
}


*------------------------------------------------------------------------------*
*	Child Food Security Index
*------------------------------------------------------------------------------*
foreach wave in "b" "d" {	
	foreach var in iac_lack iac_ateless iac_hunger iac_atelessq iac_notvaried iac_limited {
	    
		** Reverse index such that higher values mean more food security
		gen `wave'_neg_`var' = `wave'_`var' * (-1) 
	}
		
	** Aggregate food security index
	egen `wave'_Child_Food_Security = rowtotal(`wave'_neg_iac_lack `wave'_neg_iac_ateless `wave'_neg_iac_hunger 										   	  	`wave'_neg_iac_atelessq `wave'_neg_iac_notvaried `wave'_neg_iac_limited), missing
	
	** Aggregate food security index (standardized)
	egen `wave'_Child_Food_Security_norm = std(`wave'_Child_Food_Security)
}
			

*------------------------------------------------------------------------------*
*	Happiness Index
*------------------------------------------------------------------------------*
foreach wave in "b" "d"	{
    foreach var in sem_animo solitario sem_dormir triste {
	
		** Reverse index such that higher values mean more happiness (less depression)
		recode `wave'_`var' (4 = 1) (3 = 2) (2 = 3) (1 = 4), gen(`wave'_neg_`var')
	}
	
	** Aggregate happiness index
	egen `wave'_Happiness = rowmean(`wave'_neg_sem_animo `wave'_neg_solitario `wave'_neg_sem_dormir `wave'_neg_triste `wave'_feliz)	
	
	** Normalize to create a measure with mean 0 and standard deviation 1
	egen `wave'_Happiness_norm = std(`wave'_Happiness)
}


*------------------------------------------------------------------------------*
*	Expenditure
*------------------------------------------------------------------------------*

* Total household expenditure
rename a_total_exp a_Household_Expenditure

* Household expenditure per capita
gen b_percap_exp = b_total_exp / b_total_members

* Household wealth per capita
gen b_percap_wealth = b_tot_Wealth / b_total_members


*------------------------------------------------------------------------------*
*   Overall Index
*------------------------------------------------------------------------------*

** 2012 Overall Index - unweighted mean of normalized Health, Happiness, and Child Food Security indices	
egen b_Overall_index = rowmean(b_Health_norm b_Happiness_norm b_Child_Food_Security_norm)

** 2013 Overall Index - unweighted mean of normalized Health, Happiness, and Child Food Security indices	
egen d_Overall_index = rowmean(d_Health_norm d_Happiness_norm d_Child_Food_Security_norm)


*==============================================================================*
**## Organize miscellaneous household variables
*==============================================================================*

** If anybody in a given household interacts frequently with a politician, then that household is assigned to the frequent interactor category
replace frequent_interactor = temp_interactor
drop temp_interactor

quietly compress
save "${final_data_folder}/clientelism_household_data.dta", replace


********************************************************************************
**# 8. Final datasets
********************************************************************************

*==============================================================================*
**# 8.1 Stacked dataset 
*==============================================================================*

use "${final_data_folder}/clientelism_individual_data.dta", clear


** Fill stacked variables with 2012 values
save "${final_data_folder}/clientelism_individual_data_stacked.dta", replace
gen year2012 = 1

gen ask_private_stacked = c_ask_private_pol_postcoded
gen ask_nowater_private_stacked = c_ask_priv_pol_nowater_post
gen askrec_private_stacked = c_pol_askrec_priv_post
gen ask_public_stacked = c_ask_public_pol_postcoded

gen rainfall_std_stacked = rainfall_2012_std
gen rainfall_std_stacked_og = rainfall_2012_std_og

* Controls for citizen engagement for supplementary table
gen mem_assoc = c_mem_assoc_comunitaria
gen pres_assoc = c_ever_commun_president


** Fill stacked variables with 2013 values
append using "${final_data_folder}/clientelism_individual_data_stacked.dta"
replace year2012 = 0 if missing(year2012)
recode year2012 (0 = 1)(1 = 0), gen(year2013)

replace ask_private_stacked = ask_pol_private_2013 if year2013 == 1
replace ask_nowater_private_stacked = ask_pol_private_nowater_2013 if year2013 == 1
replace askrec_private_stacked = askrec_pol_private_2013 if year2013 == 1
replace ask_public_stacked = ask_pol_public_2013 if year2013 == 1

replace rainfall_std_stacked = rainfall_2013_std if year2013 == 1
replace rainfall_std_stacked_og = rainfall_2013_std_og if year2013 == 1

* Controls for citizen engagement
replace mem_assoc = e_mem_assoc_comunitaria_ if year2013 == 1
replace pres_assoc = e_ever_commun_president if year2013 == 1


** Keep only observations for which we have data on interactions with politicians
keep if frequent_interactor != .


** Keep only variables needed for stacked regressions 
keep ask_private_stacked askrec_private_stacked ask_nowater_private_stacked ask_public_stacked ///
mun_id c_mun_id year2012 year2013 b_clusters ///
treatment rainfall_std_stacked rainfall_std_stacked_og frequent_interactor mem_assoc pres_assoc b_voted


** Variable labels 
label var ask_private_stacked "Asked politician for private good"
label var askrec_private_stacked "Asked politician for private good and received it"
label var ask_nowater_private_stacked "Asked politician for private good excluding water"
label var ask_public_stacked "Asked politician for public good"
label var year2012 "Year 2012 dummy"
label var year2013 "Year 2013 dummy"
label var frequent_interactor "Frequent interactions with politician outside campaign"
label var mem_assoc "Household member is/was member of community association"
label var pres_assoc "Household member is/was president of community association"
label var rainfall_std_stacked "Rainfall shock (standardized)"
label var rainfall_std_stacked_og "Rainfall shock"


quietly compress
save "${final_data_folder}/clientelism_individual_data_stacked.dta", replace


*==============================================================================*
**# 8.2 Individual-level dataset (non-stacked)
*==============================================================================*

use "${final_data_folder}/clientelism_individual_data.dta", clear

