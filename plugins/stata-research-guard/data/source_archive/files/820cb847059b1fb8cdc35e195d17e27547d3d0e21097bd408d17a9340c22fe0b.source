keep num_domicilio_from_loc ind_id treatment c_mun_id e_mun_id mun_id b_clusters frequent_interactor ///
rainfall_2011_std rainfall_2012_std rainfall_2013_std ///
vote_same_party vote_together c_candidate_visit c_declared_dummy declare_body declare_house declare_rally ///
