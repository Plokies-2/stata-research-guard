** -----------------------------------------------------------------------------
**# Figure A.4: Teacher-assigned grades vs. blindly-graded, standardized test
*				scores by subject
** -----------------------------------------------------------------------------
use "$data_final/AlesinaCarlanaLaFerraraPinotti_fieldexperiment.dta",clear
drop invalsi 
********************************* math *************************************
preserve
	
	* Restrict sample *******************************************
	keep if subject_math==1 & grade_8!=. & invalsi_8!=. &  stdIAT!=.
	*************************************************************
	xtile invalsi= invalsi_8, nq(5)
	
	gen obs=1
	count
	collapse (mean) grade_8  (sd)sdgrade_8 = grade_8 (sum) obs, by(immigrant invalsi)
	
	foreach var in grade_8 {
		
		generate up$_var = $_var + invttail(obs-1,0.05)*(sd$_var / sqrt(obs))
		generate down$_var = $_var - invttail(obs-1,0.05)*(sd$_var / sqrt(obs))
		
	}
	twoway (rcap upgrade_8 downgrade_8 invalsi if immigrant==0, lcolor(green)) ///
		   (line grade_8 invalsi if immigrant==0, lcolor(green)) ///
		   (scatter grade_8 invalsi if immigrant==0, mcolor(green)) ///
		   (rcap upgrade_8 downgrade_8 invalsi if immigrant==1, lcolor(red)) ///
		   (line grade_8 invalsi if immigrant==1, lcolor(red)) ///
		   (scatter grade_8 invalsi if immigrant==1, mcolor(red) msymbol(circle_hollow)), ///
		   legend(order(3 "Italians" 6 "Immigrants"))  xlabel(1(1)5) title("Mathematics")  ///
		   xtitle("Blind test score (INVALSI), quintiles") ytitle("Teacher-assigned grades")
	graph copy grade_mat8, replace
	
restore
********************************* italian *************************************
preserve
	* Restrict sample *******************************************
	keep if subject_math==0 & grade_8!=. & invalsi_8!=. &  stdIAT!=.
	*************************************************************
	
	xtile invalsi= invalsi_8, nq(5)
	
	gen obs=1
	count
	collapse (mean) grade_8  (sd)sdgrade_8 = grade_8 (sum) obs, by(immigrant invalsi)
	foreach var in grade_8 {
		
		generate up$_var = $_var + invttail(obs-1,0.05)*(sd$_var / sqrt(obs))
		generate down$_var = $_var - invttail(obs-1,0.05)*(sd$_var / sqrt(obs))
		
	}
	twoway (rcap upgrade_8 downgrade_8 invalsi if immigrant==0, lcolor(green)) ///
		   (line grade_8 invalsi if immigrant==0, lcolor(green)) ///
		   (scatter grade_8 invalsi if immigrant==0, mcolor(green)) ///
		   (rcap upgrade_8 downgrade_8 invalsi if immigrant==1, lcolor(red)) ///
		   (line grade_8 invalsi if immigrant==1, lcolor(red)) ///
		   (scatter grade_8 invalsi if immigrant==1, mcolor(red) msymbol(circle_hollow)), ///
		   legend(order(3 "Italians" 6 "Immigrants"))  xlabel(1(1)5) title("Literature")  ///
		   xtitle("Blind test score (INVALSI), quintiles") ytitle("Teacher-assigned grades")
	graph copy grade_ita8, replace
	
restore
graph combine grade_mat8 grade_ita8, cols(2) scale(.7) ysize(4) xsize(7) title("")
graph save  "$figuresAppendix/AF4graph_bias_by_subject",replace
graph export "$figuresAppendix/AF4graph_bias_by_subject.pdf", replace

** -----------------------------------------------------------------------------
**# Figure A.6: Permutation test
** -----------------------------------------------------------------------------

u 	"$data_final/AlesinaCarlanaLaFerraraPinotti_fieldexperiment.dta", clear

	* Restrict sample *****************
	keep if IAT!=.
	keep if grade_genIII!=.
	drop if school_id==101 
	keep if randomization_feedback!=.
	keep if grade_genIII!=.
	keep if iat_done==1
	***********************************
	
compress

* Delete temporary datasets and estimation
eststo clear
estimates drop _all
cap erase "$data_temp/permutation/dataset_permutation_test2.dta"
cap erase "$data_temp/permutation/dataset_permutation_test_estimates2.dta"

* Permute treatment variable = randomization_feedback
ritest randomization_feedback _b[1.randomization_feedback#1.immigrant], seed(123456789) kdensity reps(1000) cluster(school_id) saving("$data_temp/permutation/dataset_permutation_test_estimates2")   : reg grade_genIII randomization_feedback##immigrant $controls $tech_controls , robust  cluster (school_id)																														
	
	* Save graph
	graph save "kdens_permutation" , replace
	* Modify before export
	graph use kdens_permutation
	gr_edit .xaxis1.title.text = {"IAT Feedback*Immigrant"}
	
* Export graph
graph export "$figuresAppendix/AF6Permutation_graph.pdf", replace
shell del "kdens_permutation.gph"


** -----------------------------------------------------------------------------
**# Table A.1: Country of birth of immigrant students (school year 2016-2017)
** -----------------------------------------------------------------------------

** NA

** -----------------------------------------------------------------------------
**# Table A.2: Balance between schools in the sample and out of the sample
** -----------------------------------------------------------------------------
	
	* Load data
	u "$data_other/Invalsi_math_1112_1617", replace
	***
	
	global variables_school "female immigrant immigrant_first immigrant_second test_score_gr_8   low_edu_mother med_edu_mother high_edu_mother low_edu_father med_edu_father high_edu_father low_occ_mother med_occ_mother high_occ_mother low_occ_father med_occ_father high_occ_father n_stud_prev"

	
	
	*** BALANCE TABLE SETUP ************************************
	local filename balance_table_sample_all_v2
	local varlist $variables_school
	local byvar school_in_selprov_sample
	local byvar0 "Not in sample" // N.B. USE PACKAGE MAKECELL IN LATEX PREAMBLE
	local byvar1 "Exp. sample"
	************************************************************
	
	* Open file
cap file close sumstat
	file open  sumstat using "$tablesAppendix/A2`filename'.tex", write replace
	file write sumstat 	"\begin{tabular}{lccccc}  \\ \toprule "  _n     // table header
	
	* Create header for experiment 1
	file write sumstat	"  & (1) & (2) & (3) & (4) & (5) \\  " _n 
	file write sumstat 	"\midrule " _n
	file write sumstat  "\multirow{2}{*}{} & \multirow{2}{*}{All students in Italy} & \multicolumn{2}{c}{  Students in 5 provinces in Northern Italy  } & \multirow{2}{*}{ \makecell{p-value \\ (3)-(2)} } & \multirow{2}{*}{ \makecell{Std. Diff.\\ (3)-(2)}} \\\cline{3-4}" _n 
	file write sumstat "& & `byvar0' &`byvar1' &&\\" _n
	file write sumstat 	"\midrule " _n 	

local i=1

	foreach var in `varlist' {
		
		cap drop stand_diff
		
		di "Calculating stats for variable: `var'"
		
		* Store label
		local varlab: variable label `var' 
		
		* Ttest
		ttest `var', by(`byvar')
				
		* Store byvar == 0 values
		local controlmean: di %7.3f `r(mu_1)'
		local 	controlsd: di %7.3f `r(sd_1)'
				
		* Store byvar == 1 values
		local treatmean:  di %7.3f `r(mu_2)'
		local 	treatsd:  di %7.3f `r(sd_2)'	

		* Store pvalue
		local pvalue: di %7.3f `r(p)'	
		
		* Standard difference
		gen   stand_diff = (`treatmean'-`controlmean')/ (sqrt((`treatsd'^2)+(`controlsd'^2)))
		sum   stand_diff
		local stand_diff: di %7.3f `r(mean)'
		
		sum `var' 
		local totalmean: di %7.3f `r(mean)'	
		local 	totalsd: di %7.3f `r(sd)'
		
		count if `byvar'==1 & !mi(female) // count sample only when a significative variable is defined
		local treat: di %7.0fc `r(N)'

		count if `byvar'==0 & !mi(female)
		local control: di %9.0fc `r(N)'
		
		count if !mi(`var')
		local total: di %9.0fc `r(N)'
		
		* For total number of observation, we take a variable always defined
		
		count if !mi(female)
		local totalobs: di %9.0fc `r(N)'
		
		foreach x in treatsd controlsd totalsd  { // remove leading blanks in parentheses
		
			local `x'=trim(string(``x'',"%7.3f"))
				
			}
	

		file write sumstat "`varlab' & `totalmean' &  `controlmean' & `treatmean' & `pvalue' & `stand_diff'  \\ " _n  
		file write sumstat "  		 &  (`totalsd') &  (`controlsd')  & (`treatsd') &   &   \\     " _n 
		
		drop stand_diff
		
		local ++i

		}
	
	file write sumstat "\midrule " _n 
	file write sumstat "Observations & `totalobs' & `control' & `treat' &   & \\   " _n 
	file write sumstat "\bottomrule" _n           // table footer
	file write sumstat "\end{tabular}" _n
	file close sumstat



** -----------------------------------------------------------------------------
**# Table A.3: Balance table - Teacher characteristics (Firel experiment)
** -----------------------------------------------------------------------------
use "$data_final/AlesinaCarlanaLaFerraraPinotti_fieldexperiment_teachers.dta",clear

	* Restrict sample ******
	drop if d_score_race==.
	keep if !mi(final_sample)
		lab var d_score_race "Immigrant-Native IAT"
	************************
	
	*** BALANCE TABLE SETUP ************************************

	local byvar_exp2 final_sample
	local byvar0_exp2 "Not in the Sample"
	local byvar1_exp2 "Final Sample"

	************************************************************
	
* Open file
cap file close sumstat
	file open sumstat using  "$tablesAppendix/A3balance_table_sample_exp1_v2.tex", write replace
	file write sumstat 	"\begin{tabular}{lccccc}  \\ \toprule "  _n     // table header

	
	* Create header for experiment 2
		file write sumstat 	"\midrule " _n 
	file write sumstat	"  & (1) & (2) & (3) & (4) & (5) \\  " _n 
	file write sumstat	"  & Full sample & `byvar0_exp2' & `byvar1_exp2' & p-value & Std. Diff. \\  " _n
	file write sumstat 	"\midrule " _n 
	***
	

local i=1

	foreach var in $tchr_variables{
		
		cap drop stand_diff
		
		di "Calculating stats for variable: `var'"
		
		* Store label
		local varlab: variable label `var'  
		
		* Ttest
		ttest `var', by(`byvar_exp2')
				
		* Store byvar == 0 values
		local controlmean: di %7.3f `r(mu_1)'
		local 	controlsd: di %7.3f `r(sd_1)'
				
		* Store byvar == 1 values
		local treatmean: di %7.3f `r(mu_2)'
		local 	treatsd:  di %7.3f `r(sd_2)'	

		* Store pvalue for clustered data **********************
		reg `var' `byvar_exp2', vce(cluster school_id)
		test `byvar_exp2'
		local pvalue: di %7.3f `r(p)'	
		********************************************************	
		
		* Standard difference
		gen stand_diff = (`treatmean'-`controlmean')/ (sqrt((`treatsd'^2)+(`controlsd'^2)))
		sum stand_diff
		local stand_diff: di %7.3f `r(mean)'
		
		sum `var' 
		local totalmean: di %7.3f `r(mean)'	
		local 	totalsd: di %7.3f `r(sd)'
		
		count if `byvar_exp2'==1 
		local treat: di %7.0fc `r(N)'

		count if `byvar_exp2'==0 
		local control: di %7.0fc `r(N)'
		
		count if !mi(`var')
		local total: di %7.0g `r(N)'

		file write sumstat "`varlab' & `totalmean' &  `controlmean' & `treatmean' & `pvalue' & `stand_diff'  \\ " _n  
		file write sumstat "  		 &  (`totalsd') &  (`controlsd')  & (`treatsd') &   &   \\     " _n 
		
		drop stand_diff
		
		local ++i

		}
	
	file write sumstat "\midrule " _n 
	file write sumstat "Observations & `total' & `control' & `treat' &   & \\   " _n 
	file write sumstat "\bottomrule" _n           // table footer
	file write sumstat "\end{tabular}" _n
	file close sumstat

	

