** -----------------------------------------------------------------------------
**# Figure A.2: Correlation between Bias in Grading and IAT
** -----------------------------------------------------------------------------


*PANEL A : Correlation IAT Bias in Grading naive approach
** -----------------------------------------------------------------------------
 * Load data
use "$data_final/AlesinaCarlanaLaFerraraPinotti_fieldexperiment.dta",clear
*** Cleaning
		
	* Restrict sample
	keep if grade_8!=.
	keep if invalsi_8!=.
	keep if teacher_id!=.
	** Keep only who has at least one italian and one immigrant
	g 		no_immigrant = immigrant == 0
	replace no_immigrant = . if mi(immigrant)
	bys 	teacher_id: egen count_stud_imm=sum(immigrant) // 621 obs == 0
	bys 	teacher_id: egen count_stud_ita=sum(no_immigrant) // 13 obs == 0
	levelsof teacher_id if (count_stud_imm == 0 | count_stud_ita == 0)
		di `r(r)' // display number of distinct teachers who do not have immigrants OR italian
		di `r(N)' // display total nr of students we'll drop
	keep if count_stud_imm >= 3   // 2,372 drop with 3 and 3
	
	g count_stud=count_stud_imm+count_stud_ita
	keep if count_stud>10
	
	
*** Generate Bias in grading at teacher level
	
	foreach grade in std_grade_8 std_invalsi_8 {
		
		bys  teacher_id: egen temp_avg_`grade'_nat = mean(`grade') if immigrant == 0
		bys  teacher_id: egen avg_`grade'_nat = max(temp_avg_`grade'_nat )
		
		bys  teacher_id: egen  temp_avg_`grade'_imm = mean(`grade') if immigrant == 1
		bys  teacher_id: egen avg_`grade'_imm = max(temp_avg_`grade'_imm )
		
		drop temp_*
	}
	
	g bias_grading_did = (avg_std_grade_8_nat-avg_std_invalsi_8_nat)-(avg_std_grade_8_imm-avg_std_invalsi_8_imm)
		
	count if !mi(bias_grading_did)
	
*** Graph
preserve
	duplicates drop teacher_id, force
	drop if mi(teacher_id)
	reg bias_grading_did IAT
	corr bias_grading_did IAT
	
		binscatter bias_grading_did IAT, msymbol(circle) mcolor(maroon%20) lcolor(maroon) ///
					   ytitle("Bias in grading (Difference in Differences)", margin(right)) ///
					   xtitle("IAT", margin(top)) scheme(small) nbins(20) ///
					   graphregion(color(white)) name(bias_IAT, replace)
	
restore
	
	contract teacher_id bias_grading_did
	drop _freq
	graph copy A2A, replace



*PANEL B : Correlation IAT Bias in Grading Bayesian approach
** -----------------------------------------------------------------------------
	
use "$data_final/AlesinaCarlanaLaFerraraPinotti_fieldexperiment.dta",clear

	* Merge Empirical Bayes Estimates
	merge m:1 teacher_id using "$data_temp/EBE_tomerge"
	drop if _m == 2
	drop _m
	
	* Bias in grading
	gen bias_grading=-std_EBE 
		
	lab var bias_grading "Bias Grading"


	*Correlation IAT Bias in Grading
	preserve
	
		duplicates drop teacher_id, force
		reg bias_grading IAT
		binscatter bias_grading IAT
		
		binscatter bias_grading IAT, msymbol(circle) mcolor(maroon%20) lcolor(maroon) ///
				   ytitle("Bias in grading (Bayesian)", margin(right)) ///
				   xtitle("IAT", margin(top)) scheme(small) nbins(20) ///
				   graphregion(color(white)) name(bias_IAT, replace)

		graph copy A2B, replace
	restore

	
	graph combine A2A A2B, col(2) xsize(5) ysize(1.8) scale(1.2)
	graph export "$figuresAppendix/AF2bias_IAT.pdf", replace 


