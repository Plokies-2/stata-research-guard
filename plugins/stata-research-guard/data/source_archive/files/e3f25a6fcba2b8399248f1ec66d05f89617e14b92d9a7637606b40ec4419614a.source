***** EXPERIMENT 2

use  "$data_final/AlesinaCarlanaLaFerraraPinotti_onlineexperiment.dta", replace
	
	* Restrict sample *****************
	duplicates drop teacher_id,force
	keep if student_id!=""
	keep if IAT!=.
	***********************************
	
	* Clean
	drop wvs // create new version of WVS
	gen wvs=(m_Q21_jobs_scarsity==1)
	lab var wvs "WVS Immigrants' Rights to Job"
	replace Q04_teaching_years=Q04_teaching_years/10
	lab var Q04_teaching_years "Experience/10 years"
	
local i = 1
	
	*Experience
	xi:reg IAT female_teacher iscongruentfirst,  cluster(school_code)
	
	local beta_`i'  = _b[female_teacher]
	local sigma_`i' = _se[female_teacher]
	local beta_`i' : di %8.3f `beta_`i''
	local sigma_`i' : di %8.3f `sigma_`i''
	local N`i' =  e(N)
	local R`i' = e(r2) 
	local R`i' : di %8.3f `R`i''
	matrix rtable = r(table)
		local pvalue  = rtable[4,1]  
		local star`i' = ""
		if `pvalue' < 0.1 local star`i'= "*" 
		if `pvalue' < 0.05 local star`i' = "**" 
		if `pvalue' < 0.01 local star`i' = "***"
	

	xi:reg IAT regionborn_3  iscongruentfirst,  cluster(school_code)
	
	local ++i
	local beta_`i'  = _b[regionborn_3]
	local sigma_`i' = _se[regionborn_3]
	local beta_`i' : di %8.3f `beta_`i''
	local sigma_`i' : di %8.3f `sigma_`i''
	local N`i' =  e(N)
	local R`i' = e(r2) 
	local R`i' : di %8.3f `R`i''
	matrix rtable = r(table)
	local pvalue  = rtable[4,1]  
		local star`i' = ""
		if `pvalue' < 0.1 local star`i'= "*" 
		if `pvalue' < 0.05 local star`i' = "**" 
		if `pvalue' < 0.01 local star`i' = "***" 
		

	xi:reg IAT Q04_teaching_years  iscongruentfirst,  cluster(school_code)
	
	local ++i
	local beta_`i'  = _b[Q04_teaching_years]
	local sigma_`i' = _se[Q04_teaching_years]
	local beta_`i' : di %8.3f `beta_`i''
	local sigma_`i' : di %8.3f `sigma_`i''
	local N`i' =  e(N)
	local R`i' = e(r2) 
	local R`i' : di %8.3f `R`i''
	matrix rtable = r(table)
	local pvalue  = rtable[4,1]  
		local star`i' = ""
		if `pvalue' < 0.1 local star`i'= "*" 
		if `pvalue' < 0.05 local star`i' = "**" 
		if `pvalue' < 0.01 local star`i' = "***" 
	

	xi:reg IAT wvs  iscongruentfirst, cluster(school_code)
	
	local ++i
	local beta_`i'  = _b[wvs]
	local sigma_`i' = _se[wvs]
	local beta_`i' : di %8.3f `beta_`i''
	local sigma_`i' : di %8.3f `sigma_`i''
	local N`i' =  e(N)
	local R`i' = e(r2) 
	local R`i' : di %8.3f `R`i''
	matrix rtable = r(table)
	local pvalue  = rtable[4,1]  
		local star`i' = ""
		if `pvalue' < 0.1 local star`i'= "*" 
		if `pvalue' < 0.05 local star`i' = "**" 
		if `pvalue' < 0.01 local star`i' = "***" 

	xi:reg IAT female_teacher regionborn_3 Q04_teaching_years wvs iscongruentfirst,  cluster(school_code)
	
	
	local ++i
	local beta1_`i'  = _b[female_teacher]
	local sigma1_`i' = _se[female_teacher]
	local beta1_`i' : di %8.3f `beta1_`i''
	local sigma1_`i' : di %8.3f `sigma1_`i''
	matrix rtable = r(table)
	
	local pvalue1_`i'  = rtable[4,1]  
		local star`i' = ""
		if `pvalue1_`i'' < 0.1 local star1_`i'= "*" 
		if `pvalue1_`i'' < 0.05 local star1_`i' = "**" 
		if `pvalue1_`i'' < 0.01 local star1_`i' = "***" 

	local beta2_`i'  = _b[regionborn_3]
	local sigma2_`i' = _se[regionborn_3]
	local beta2_`i' : di %8.3f `beta2_`i''
	local sigma2_`i' : di %8.3f `sigma2_`i''
	matrix rtable = r(table)
		local pvalue2_`i'  = rtable[4,2]  
		local star`i' = ""
		if `pvalue2_`i'' < 0.1 local star2_`i'= "*" 
		if `pvalue2_`i'' < 0.05 local star2_`i' = "**" 
		if `pvalue2_`i'' < 0.01 local star2_`i' = "***" 
			
	local beta3_`i'  = _b[Q04_teaching_years]
	local sigma3_`i' = _se[Q04_teaching_years]
	local beta3_`i' : di %8.3f `beta3_`i''
	local sigma3_`i' : di %8.3f `sigma3_`i''
	matrix rtable = r(table)
	local pvalue3_`i'  = rtable[4,3]  
		local star`i' = ""
		if `pvalue3_`i'' < 0.1 local star3_`i'= "*" 
		if `pvalue3_`i'' < 0.05 local star3_`i' = "**" 
		if `pvalue3_`i'' < 0.01 local star3_`i' = "***" 

	local beta4_`i'  = _b[wvs]
	local sigma4_`i' = _se[wvs]
	local beta4_`i' : di %8.3f `beta4_`i''
	local sigma4_`i' : di %8.3f `sigma4_`i''
	matrix rtable = r(table)
	local pvalue4_`i'  = rtable[4,4]  
		local star`i' = ""
		if `pvalue4_`i'' < 0.1 local star4_`i'= "*" 
		if `pvalue4_`i'' < 0.05 local star4_`i' = "**" 
		if `pvalue4_`i'' < 0.01 local star4_`i' = "***" 

		local N`i' =  e(N)
		local R`i' = e(r2) 
		local R`i' : di %8.3f `R`i''

	reg IAT female_teacher regionborn_3 Q04_teaching_years wvs     iscongruentfirst i.school,  cluster(school_code)
	
	local ++i
	local beta1_`i'  = _b[female_teacher]
	local sigma1_`i' = _se[female_teacher]
	local beta1_`i' : di %8.3f `beta1_`i''
	local sigma1_`i' : di %8.3f `sigma1_`i''
	matrix rtable = r(table)
	
	local pvalue1_`i'  = rtable[4,1]  
		local star`i' = ""
		if `pvalue1_`i'' < 0.1 local star1_`i'= "*" 
		if `pvalue1_`i'' < 0.05 local star1_`i' = "**" 
		if `pvalue1_`i'' < 0.01 local star1_`i' = "***" 

	local beta2_`i'  = _b[regionborn_3]
	local sigma2_`i' = _se[regionborn_3]
	local beta2_`i' : di %8.3f `beta2_`i''
	local sigma2_`i' : di %8.3f `sigma2_`i''
	matrix rtable = r(table)
		local pvalue2_`i'  = rtable[4,2]  
		local star`i' = ""
		if `pvalue2_`i'' < 0.1 local star2_`i'= "*" 
		if `pvalue2_`i'' < 0.05 local star2_`i' = "**" 
		if `pvalue2_`i'' < 0.01 local star2_`i' = "***" 
			
	local beta3_`i'  = _b[Q04_teaching_years]
	local sigma3_`i' = _se[Q04_teaching_years]
	local beta3_`i' : di %8.3f `beta3_`i''
	local sigma3_`i' : di %8.3f `sigma3_`i''
	matrix rtable = r(table)
	local pvalue3_`i'  = rtable[4,3]  
		local star`i' = ""
		if `pvalue3_`i'' < 0.1 local star3_`i'= "*" 
		if `pvalue3_`i'' < 0.05 local star3_`i' = "**" 
		if `pvalue3_`i'' < 0.01 local star3_`i' = "***" 

	local beta4_`i'  = _b[wvs]
	local sigma4_`i' = _se[wvs]
	local beta4_`i' : di %8.3f `beta4_`i''
	local sigma4_`i' : di %8.3f `sigma4_`i''
	matrix rtable = r(table)
	local pvalue4_`i'  = rtable[4,4]  
		local star`i' = ""
		if `pvalue4_`i'' < 0.1 local star4_`i'= "*" 
		if `pvalue4_`i'' < 0.05 local star4_`i' = "**" 
		if `pvalue4_`i'' < 0.01 local star4_`i' = "***" 
		
	local N`i' =  e(N)
	local R`i' = e(r2) 
	local R`i' : di %8.3f `R`i''
	
	file write soutput " Female  						& `beta_1' &  &  &  &  &  &  `beta1_5' &  					`beta1_6'    \\" _n
	file write soutput "   								& (`sigma_1') &  &  &  &  &  	 &  (`sigma1_5')		   &  (`sigma1_6')      \\" _n
	file write soutput " Born in the North  			&  & `beta_2' &  &  &  &  &  `beta2_5' &  					`beta2_6'    \\" _n
	file write soutput "   								&  & (`sigma_2') &  &  &  &  	 &  (`sigma2_5')		   &  (`sigma2_6')      \\" _n
	file write soutput " Experience/10 years  			&  &  & `beta_3' &  &  &  &  `beta3_5' &  					`beta3_6'    \\" _n
	file write soutput "   								&  &  & (`sigma_3') &  &  &  	 &  (`sigma3_5')		   &  (`sigma3_6')      \\" _n
	file write soutput " WVS Immigrants' Rights to Job  &  &  &  &`beta_4'  &  &  &  `beta4_5' &  					`beta4_6'    \\" _n
	file write soutput "   								&  &  &  & (`sigma_4') &  &  	 &  (`sigma4_5')		   &  (`sigma4_6')      \\" _n
	file write soutput"\midrule"  _n
	file write soutput " School FE						& No & No & No & No &  &  & No &  Yes      \\" _n
	file write soutput"\midrule"  _n
	file write soutput " Obs  & `N1' &  `N2' &  `N3' &   `N4'    &    &    &  `N5'  &   `N6'    \\" _n
	file write soutput " R$^2$  & `R1' & `R2' & `R3' &  `R4'    &    &  & `R5'  & `R6'    \\" _n

	file write soutput "  \hline \hline" _n
	file write soutput "\end{tabular}" _n
	file close soutput

** -----------------------------------------------------------------------------
**# Table 3: Bias in Grading and Teachers' IAT scores
** -----------------------------------------------------------------------------

use "$data_final/AlesinaCarlanaLaFerraraPinotti_fieldexperiment.dta",clear
	
eststo clear
est drop _all



foreach outcome in grade_8  {
	
	*1
	reghdfe `outcome'  immigrant  $invalsi3 $cohort if IAT!=., absorb(i.teacher_id)  cluster(teacher_id) 

		estadd local fe 				"Yes"
		estadd local invalsi3			"Yes"
		estadd local stu_control		"No"
		estadd local stu_control_imm	"No"
		estadd local tcr_control_imm	"No"
	
	est store `outcome'_1
	
	*2
	reghdfe `outcome'  imm_IAT immigrant  $invalsi3 $cohort if IAT!=. , absorb(i.teacher_id)  cluster(teacher_id) 

		estadd local fe 				"Yes"
		estadd local invalsi3			"Yes"
		estadd local stu_control		"No"
		estadd local stu_control_imm	"No"
		estadd local tcr_control_imm	"No"
		
	est store `outcome'_2	
	
	*3
	reghdfe `outcome'  imm_IAT immigrant  $invalsi3 $cohort $controls $tech_controls if IAT!=. , absorb(i.teacher_id)  cluster(teacher_id)

		estadd local fe 				"Yes"
		estadd local invalsi3			"Yes"
		estadd local stu_control		"Yes"
		estadd local stu_control_imm	"Yes"
		estadd local tcr_control_imm	"Yes"
		
	est store `outcome'_3
	
	*4
	reghdfe `outcome'  immigrant  $invalsi3 $cohort if IAT!=. & invalsi>2, absorb(i.teacher_id)  cluster(teacher_id) 

		estadd local fe 				"Yes"
		estadd local invalsi3			"Yes"
		estadd local stu_control		"No"
		estadd local stu_control_imm	"No"
		estadd local tcr_control_imm	"No"
		
	est store `outcome'_4
	
	*5
	reghdfe `outcome'  imm_IAT immigrant  $invalsi3 $cohort if IAT!=. & invalsi>2 , absorb(i.teacher_id)  cluster(teacher_id) 
	
		estadd local fe 				"Yes"
		estadd local invalsi3			"Yes"
		estadd local stu_control		"No"
		estadd local stu_control_imm	"No"
		estadd local tcr_control_imm	"No"
		
	est store `outcome'_5	
	
	*6
	reghdfe `outcome'  imm_IAT immigrant  $invalsi3 $cohort $controls $tech_controls if IAT!=. & invalsi>2 , absorb(i.teacher_id)  cluster(teacher_id) 
	
		estadd local fe 				"Yes"
		estadd local invalsi3			"Yes"
		estadd local stu_control		"Yes"
		estadd local stu_control_imm	"Yes"
		estadd local tcr_control_imm	"Yes"
		
	est store `outcome'_6
	
	*7
	reghdfe `outcome' immigrant  $invalsi3 $cohort if IAT!=. & invalsi<3, absorb(i.teacher_id)  cluster(teacher_id)
	
		estadd local fe 				"Yes"
		estadd local invalsi3			"Yes"
		estadd local stu_control		"No"
		estadd local stu_control_imm	"No"
		estadd local tcr_control_imm	"No"
		
	est store `outcome'_7
	
	*8
	reghdfe `outcome'  imm_IAT immigrant  $invalsi3 $cohort if IAT!=. & invalsi<3, absorb(i.teacher_id)  cluster(teacher_id) 
	
		estadd local fe 				"Yes"
		estadd local invalsi3			"Yes"
		estadd local stu_control		"No"
		estadd local stu_control_imm	"No"
		estadd local tcr_control_imm	"No"
		
	est store `outcome'_8	
	
	*9
	reghdfe `outcome'  imm_IAT immigrant  $invalsi3 $cohort $controls $tech_controls if IAT!=. & invalsi<3 , absorb(i.teacher_id)  cluster(teacher_id) 
	
		estadd local fe 				"Yes"
		estadd local invalsi3			"Yes"
		estadd local stu_control		"Yes"
		estadd local stu_control_imm	"Yes"
		estadd local tcr_control_imm	"Yes"
		
	est store `outcome'_9  

* PANEL A
esttab  `outcome'_1 `outcome'_2 `outcome'_3 using "$tables/T3bias_grading_subject_`outcome'.tex", /// 
prehead("\begin{tabular}{lccc} \toprule \multicolumn{4}{l}{\textbf{Dependent Variable: Teacher Grade}} \\ \midrule") ///
posthead("\hline \textit{Panel A: All} \\") ///
cells(b(fmt(3)) se(par fmt(3))) ///
stats(N r2, labels("\hline Obs." "\(R^{2}\)") fmt(0 3)) nostar ///
keep(imm_IAT immigrant)  ///
collabels(none) ///
fragment ///
nolines noomitted noobs noconstant nomtitles ///
label ///
replace

* PANEL B
 
esttab `outcome'_4 `outcome'_5 `outcome'_6 using "$tables/T3bias_grading_subject_`outcome'.tex", ///
posthead("\midrule \textit{Panel B: High Ability} \\") ///
cells(b(fmt(3)) se(par fmt(3))) ///
stats(N r2 , labels("\hline Obs." "\(R^{2}\)") fmt(0 3)) nostar ///
keep(imm_IAT immigrant)  ///
fragment ///
append ///
collabels(none) ///
nomtitles nonumbers nolines noomitted nobaselevels noobs noconstant ///
label
* PANEL C
 
esttab `outcome'_7 `outcome'_8 `outcome'_9 using "$tables/T3bias_grading_subject_`outcome'.tex", ///
posthead("\midrule \textit{Panel C: Low Ability} \\") ///
cells(b(fmt(3)) se(par fmt(3))) ///
stats(N r2 fe invalsi3 stu_control stu_control_imm tcr_control_imm, labels("\hline Obs." "\(R^{2}\)" "\midrule Teacher FE" "INVALSI cubic" "Student Controls" "Student Controls*Imm" "Teacher Controls*Imm") fmt(0 3)) ///
keep(imm_IAT immigrant)  ///
nostar ///
fragment ///
append ///
collabels(none) ///
nomtitles nonumbers nolines noomitted noobs nobaselevels noconstant ///
postfoot("\bottomrule \end{tabular}}") ///
label
		  
}


** -----------------------------------------------------------------------------
**# Table 4: Impact of revealing stereotypes to teachers on grades and on the 
* 			 probability of failing students
** -----------------------------------------------------------------------------

use "$data_final/AlesinaCarlanaLaFerraraPinotti_fieldexperiment.dta",clear


 lab var randomization_feedback "IAT Feedback"
  lab var imm_randomization_feedback "IAT Feedback*Immigrant"
	
	* Restrict sample *****************
	keep if IAT!=.
	keep if grade_genIII!=.
	drop if school_id==101 
	keep if randomization_feedback!=.
	keep if grade_genIII!=.
	keep if iat_done==1
	***********************************

	cap file close soutput
	
	file open soutput using "$tables/T4teacher_revealbias.tex", write replace
	file write soutput "\begin{tabular}{lcccccc}"_n
	file write soutput "\toprule"_n
	file write soutput "& (1) & (2) & (3) & (4) & (5) & (6) \\"_n
	file write soutput "\hline"_n
	file write soutput "\multicolumn{7}{l}{\textbf{Panel A: Intention to Treat}} \\"_n
	file write soutput "\midrule \\"_n
	file write soutput "\multicolumn{1}{l}{\textbf{Dependent Variable:}} & \multicolumn{3}{c}{\textbf{Grade}} & \multicolumn{3}{c}{\textbf{Fail (Grade $<$ 6)}}\\"_n
	file write soutput "\cmidrule(lr){2-4} \cmidrule(lr){5-7}"_n

	
	local i = 1
*** Experiment 1

	* 1) 
	reg grade_genIII imm_randomization_feedback immigrant randomization_feedback, robust  cluster (school_id)
	
	local beta1_`i'  = _b[imm_randomization_feedback]
	local sigma1_`i' = _se[imm_randomization_feedback]
	local beta1_`i' : di %8.3f `beta1_`i''
	local sigma1_`i' : di %8.3f `sigma1_`i''
	matrix rtable = r(table)
	
	local pvalue1_`i'  = rtable[4,1]  
		local star`i' = ""
		if `pvalue1_`i'' < 0.1 local star1_`i'= "*" 
		if `pvalue1_`i'' < 0.05 local star1_`i' = "**" 
		if `pvalue1_`i'' < 0.01 local star1_`i' = "***" 

	local beta2_`i'  = _b[immigrant]
	local sigma2_`i' = _se[immigrant]
	local beta2_`i' : di %8.3f `beta2_`i''
	local sigma2_`i' : di %8.3f `sigma2_`i''
