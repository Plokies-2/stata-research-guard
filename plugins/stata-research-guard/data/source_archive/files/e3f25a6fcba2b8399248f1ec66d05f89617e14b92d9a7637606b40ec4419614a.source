	* Create header for experiment 2
		file write sumstat 	"\midrule " _n 
	file write sumstat	"  & (1) & (2) & (3) & (4) & (5) \\  " _n 
	file write sumstat	"  & Full sample & `byvar0_exp2' & `byvar1_exp2' & p-value & Std. Diff. \\  " _n
	file write sumstat 	"\midrule " _n 
	***
	

local i=1

	foreach var in $stud_variables{
		
		cap drop stand_diff
		
		di "Calculating stats for variable: `var'"
		
		* Store label
		local varlab: variable label `var'  
		
