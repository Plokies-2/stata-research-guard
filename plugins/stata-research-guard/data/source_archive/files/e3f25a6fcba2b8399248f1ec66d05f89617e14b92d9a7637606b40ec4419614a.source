	* 8) 
	xi:reg d_score_race female t_N t_exp wvs_imm share_imm dif_invalsi $order_iat t_exp_miss t_N_miss wvs_imm_miss D25_miss,  cluster(mecc_code_plesse) absorb(mecc_code_plesse)
	
