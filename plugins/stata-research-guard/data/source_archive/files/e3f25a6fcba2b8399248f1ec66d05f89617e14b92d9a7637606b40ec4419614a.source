** -----------------------------------------------------------------------------
**# Table A.7: Balance table - Student characteristics (FIELD EXPERIMENT)
** -----------------------------------------------------------------------------
preserve

	*** BALANCE TABLE SETUP ************************************
	local filename balance_table_students_v2
	local varlist_stu $varc
	local byvar randomization_feedback
	local byvar0 "Control"
	local byvar1 "Treated"
	************************************************************
	
* Open file
cap file close sumstat
	file open sumstat using "$tablesAppendix/A7`filename'.tex", write replace
	file write sumstat 	"\begin{tabular}{lccccc}  \\ \toprule "  _n     // table header
	
	* LOAD DATASET FOR STUDENT BALANCE TABLE
	
	use "$data_final/AlesinaCarlanaLaFerraraPinotti_fieldexperiment.dta",clear
	
	* Restrict sample **********************
	keep if IAT!=.
	keep if grade_genIII!=.
	drop if school_id==101 
	keep if final_sample == 1
	duplicates drop anon_stud_id, force
	****************************************
	
	* Create header for experiment 1
	file write sumstat 	"\midrule " _n 
	file write sumstat	"  & (1) & (2) & (3) & (4) & (5) \\  " _n 
	file write sumstat	"  & Full sample & `byvar0' & `byvar1' & p-value & Norm. Diff. \\  " _n
	file write sumstat 	"\midrule " _n 

local i=1

	foreach var in `varlist_stu' {
		
		cap drop stand_diff
		
		di "Calculating stats for variable: `var'"
		
		* Put intermediate lines
		if `i'== 4 | `i'== 8 | `i'== 13 {
			
			file write sumstat "\midrule " _n 
		}
		
		* Store label
		local varlab: variable label `var'  
		
		* Ttest
		ttest `var', by(`byvar')
				
		* Store byvar == 0 values
		local controlmean: di %7.3f `r(mu_1)'
		local 	controlsd: di %7.3f `r(sd_1)'
				
		* Store byvar == 1 values
		local treatmean: di %7.3f `r(mu_2)'
		local 	treatsd:  di %7.3f `r(sd_2)'	

		* Store pvalue for clustered data **********************
		reg `var' `byvar', vce(cluster school_id)
		test randomization_feedback
		local pvalue: di %7.3f `r(p)'	
		********************************************************	
		
		* Standard difference
		gen stand_diff = (`treatmean'-`controlmean')/ (sqrt((`treatsd'^2)+(`controlsd'^2)))
		sum stand_diff
		local stand_diff: di %7.3f `r(mean)'
		
		sum `var' 
		local totalmean: di %7.3f `r(mean)'	
		local 	totalsd: di %7.3f `r(sd)'
		
		count if `byvar'==1 
		local treat: di %7.0fc `r(N)'

		count if `byvar'==0 
		local control: di %7.0fc `r(N)'
		
		count if !mi(`var')
		local total: di %7.0g `r(N)'

		file write sumstat "`varlab' & `totalmean' &  `controlmean' & `treatmean' & `pvalue' & `stand_diff'  \\ " _n  
		file write sumstat "  		 &  (`totalsd') &  (`controlsd')  & (`treatsd') &   &   \\     " _n 
		
		drop stand_diff
		
		local ++i

		}
	
	file write sumstat "\midrule " _n 
	file write sumstat "Observations & `total' & `control' & `treat' &   & \\   " _n 
	file write sumstat "\bottomrule" _n           // table footer
	file write sumstat "\end{tabular}" _n
	file close sumstat
	
restore



** -----------------------------------------------------------------------------
**# Table A.8: Bias in Grading and Teachers' IAT scores
** -----------------------------------------------------------------------------

use "$data_final/AlesinaCarlanaLaFerraraPinotti_fieldexperiment.dta",clear
	
eststo clear
est drop _all

rename first_difference_std_grade first_diff_std_grade

foreach outcome in  first_diff_std_grade {
	
	*1
	reghdfe `outcome'  immigrant  $invalsi3 $cohort if IAT!=., absorb(i.teacher_id)  cluster(teacher_id) 

		estadd local fe 				"Yes"
		estadd local invalsi3			"Yes"
		estadd local stu_control		"No"
		estadd local stu_control_imm	"No"
		estadd local tcr_control_imm	"No"
	
	est store `outcome'_1
	
	*2
	reghdfe `outcome'  imm_IAT immigrant  $invalsi3 $cohort if IAT!=. , absorb(i.teacher_id)  cluster(teacher_id) 

		estadd local fe 				"Yes"
		estadd local invalsi3			"Yes"
		estadd local stu_control		"No"
		estadd local stu_control_imm	"No"
		estadd local tcr_control_imm	"No"
		
	est store `outcome'_2	
	
	*3
	reghdfe `outcome'  imm_IAT immigrant  $invalsi3 $cohort $controls $tech_controls if IAT!=. , absorb(i.teacher_id)  cluster(teacher_id)

		estadd local fe 				"Yes"
		estadd local invalsi3			"Yes"
		estadd local stu_control		"Yes"
		estadd local stu_control_imm	"Yes"
		estadd local tcr_control_imm	"Yes"
		
	est store `outcome'_3
	
	*4
	reghdfe `outcome'  immigrant  $invalsi3 $cohort if IAT!=. & invalsi>2, absorb(i.teacher_id)  cluster(teacher_id) 

		estadd local fe 				"Yes"
		estadd local invalsi3			"Yes"
		estadd local stu_control		"No"
		estadd local stu_control_imm	"No"
		estadd local tcr_control_imm	"No"
		
	est store `outcome'_4
	
	*5
	reghdfe `outcome'  imm_IAT immigrant  $invalsi3 $cohort if IAT!=. & invalsi>2 , absorb(i.teacher_id)  cluster(teacher_id) 
	
		estadd local fe 				"Yes"
		estadd local invalsi3			"Yes"
		estadd local stu_control		"No"
		estadd local stu_control_imm	"No"
		estadd local tcr_control_imm	"No"
		
	est store `outcome'_5	
	
	*6
	reghdfe `outcome'  imm_IAT immigrant  $invalsi3 $cohort $controls $tech_controls if IAT!=. & invalsi>2 , absorb(i.teacher_id)  cluster(teacher_id) 
	
		estadd local fe 				"Yes"
		estadd local invalsi3			"Yes"
		estadd local stu_control		"Yes"
		estadd local stu_control_imm	"Yes"
		estadd local tcr_control_imm	"Yes"
		
	est store `outcome'_6
	
	*7
	reghdfe `outcome' immigrant  $invalsi3 $cohort if IAT!=. & invalsi<3, absorb(i.teacher_id)  cluster(teacher_id)
	
		estadd local fe 				"Yes"
		estadd local invalsi3			"Yes"
		estadd local stu_control		"No"
		estadd local stu_control_imm	"No"
		estadd local tcr_control_imm	"No"
		
	est store `outcome'_7
	
	*8
	reghdfe `outcome'  imm_IAT immigrant  $invalsi3 $cohort if IAT!=. & invalsi<3, absorb(i.teacher_id)  cluster(teacher_id) 
	
		estadd local fe 				"Yes"
		estadd local invalsi3			"Yes"
		estadd local stu_control		"No"
		estadd local stu_control_imm	"No"
		estadd local tcr_control_imm	"No"
		
	est store `outcome'_8	
	
	*9
	reghdfe `outcome'  imm_IAT immigrant  $invalsi3 $cohort $controls $tech_controls if IAT!=. & invalsi<3 , absorb(i.teacher_id)  cluster(teacher_id) 
	
		estadd local fe 				"Yes"
		estadd local invalsi3			"Yes"
		estadd local stu_control		"Yes"
		estadd local stu_control_imm	"Yes"
		estadd local tcr_control_imm	"Yes"
		
	est store `outcome'_9
	  
	esttab `outcome'_* using "$tablesAppendix/A8bias_grading_subject_`outcome'.tex", 	///
		  b(3) se(3) label replace nomtitle nostar noomit booktabs collabels(none) noconstant ///
		  keep(imm_IAT immigrant) stats(N r2 fe invalsi3 stu_control stu_control_imm tcr_control_imm, ///
		  labels("Obs." "\(R^{2}\)" "\midrule Teacher FE" "INVALSI cubic" "Student Controls" "Student Controls*Imm" "Teacher Controls*Imm") fmt(0 3)) ///
		  prehead("\begin{tabular}{l*{9}{c}} \toprule \multicolumn{6}{c}{{\bf Outcome: First Difference, Std Grade-Std Test Score}} \\ \midrule \multicolumn{1}{c}{} & \multicolumn{3}{c}{All} & \multicolumn{3}{c}{High Ability} & \multicolumn{3}{c}{Low Ability} \\ \cmidrule(lr){2-4} \cmidrule(lr){5-7} \cmidrule(lr){8-10}") ///
		  postfoot("\bottomrule \end{tabular}")
	
}
					 
****************************************************************************************
**# Table A.9 Impact of revealing stereotypes to teachers on grades and the 
* 			   probability of failing students
****************************************************************************************

use "$data_final/AlesinaCarlanaLaFerraraPinotti_fieldexperiment.dta",clear

* Transition matrix

gen grade_genIII_transition=6 if grade_genIII==3 & immigrant==1
replace grade_genIII_transition=6.05 if grade_genIII==4 & immigrant==1
replace grade_genIII_transition=6.16 if grade_genIII==5 & immigrant==1
replace grade_genIII_transition=6.30 if grade_genIII==6 & immigrant==1
replace grade_genIII_transition=6.95 if grade_genIII==7 & immigrant==1
replace grade_genIII_transition=7.66 if grade_genIII==8 & immigrant==1
replace grade_genIII_transition=8.61 if grade_genIII==9 & immigrant==1
replace grade_genIII_transition=9.17 if grade_genIII==10 & immigrant==1
replace grade_genIII_transition=10 if grade_genIII==11 & immigrant==1

replace grade_genIII_transition=6 if grade_genIII==3 & immigrant==0
replace grade_genIII_transition=6.1 if grade_genIII==4 & immigrant==0
replace grade_genIII_transition=6.19 if grade_genIII==5 & immigrant==0
replace grade_genIII_transition=6.44 if grade_genIII==6 & immigrant==0
replace grade_genIII_transition=7.18 if grade_genIII==7 & immigrant==0
replace grade_genIII_transition=7.98 if grade_genIII==8 & immigrant==0
replace grade_genIII_transition=8.83 if grade_genIII==9 & immigrant==0
replace grade_genIII_transition=9.38 if grade_genIII==10 & immigrant==0
replace grade_genIII_transition=10 if grade_genIII==11 & immigrant==0


cap gen imm_randomization_feedback=immigrant*randomization_feedback
lab var imm_randomization_feedback "Early Feedback*Immigrant"
cap gen imm_rand_wvs=immigrant*randomization_feedback*wvs
lab var imm_rand_wvs "WVS*IAT Feedback*Immigrant"
cap gen rand_wvs=randomization_feedback*wvs
lab var rand_wvs "WVS* Early Feedback"
cap gen imm_rand_wvs_miss=immigrant*randomization_feedback*wvs_miss
cap gen rand_wvs_miss=randomization_feedback*wvs
cap gen imm_yesemailtreat=immigrant*yesemailtreat
cap gen imm_rand_IAT=immigrant*randomization_feedback*IAT
cap gen rand_IAT=randomization_feedback*IAT
lab var IAT "Teacher IAT"
lab var rand_IAT "Teacher IAT*IAT Feedback"
lab var imm_rand_IAT "Teacher IAT*IAT Feedback*Immigrant"

 lab var randomization_feedback "IAT Feedback"
  lab var imm_randomization_feedback "IAT Feedback*Immigrant"
keep if IAT!=.
keep if grade_genIII!=.
drop if school_id==101 
****************************************

foreach var in  grade_genIII_transition {
reg `var' imm_randomization_feedback immigrant randomization_feedback, robust  cluster (school_id)

	estadd local sc No
	estadd local tc No
	est store `var'1
	
reg `var' imm_randomization_feedback immigrant randomization_feedback $controls, robust cluster (school_id)
	
	estadd local sc Yes
	estadd local tc No
	est store `var'2
	
reg `var' imm_randomization_feedback immigrant randomization_feedback $controls $tech_controls , robust cluster (school_id)
	
	estadd local sc Yes
	estadd local tc Yes
	est store `var'3

}

esttab grade_genIII_transition1 grade_genIII_transition2 grade_genIII_transition3 using "$tablesAppendix/A9teacher_revealbias_transition.tex", label replace ///
 keep(imm_randomization_feedback immigrant randomization_feedback) order(imm_randomization_feedback immigrant randomization_feedback) ///
 b(3) se(3) stats(sc tc N r2, labels (`" Student Controls"' `"Teacher Controls"' `"\hline Obs."' `"\(R^{2}\)"' ) fmt(0 0 0 3)) ///
 nomtitle nostar noomit booktabs collabels(none) noconstant ///
 prehead("\begin{tabular}{l*{3}{c}} \toprule \multicolumn{6}{c}{{\bf Dependent Variable: Teacher-Assigned Grade (Transformed)}} \\ \midrule") ///
 postfoot("\bottomrule \end{tabular}")
 


** -----------------------------------------------------------------------------
**# Table A.10: Estimation of the impact of revealing stereotypes to teachers on 
*			 student grades
** -----------------------------------------------------------------------------

 u "$data_final/AlesinaCarlanaLaFerraraPinotti_fieldexperiment.dta", clear

 lab var randomization_feedback "IAT Feedback"
  lab var imm_randomization_feedback "IAT Feedback*Immigrant"
  lab var imm_rand_wvs "IAT Feedback*WVS*Immigrant"
  lab var rand_wvs "IAT Feedback*WVS"
  lab var imm_rand_gapprejudice "IAT Feedback*Reason Gap Prejudice*Immigrant"
  lab var rand_gapprejudice "IAT Feedback*Reason Gap Prejudice"
	* Restrict sample *********************
	keep if IAT!=.
	keep if grade_genIII!=.
	drop if school_id==101
	keep if randomization_feedback!=.
	keep if grade_genIII!=.
	keep if iat_done==1
	replace grade_genIII= grade_genIII-0.5
	*********************+*****************
	
eststo clear

*OLS

foreach var in   grade_genIII  {
	
	* 1)
	reg `var' imm_randomization_feedback immigrant randomization_feedback $controls $tech_controls , robust cluster (school_id)
	
** Store control means
	* Mean control natives
	su `var' if immigrant == 0 & randomization_feedback == 0
	local cnmean : di %8.2f `r(mean)' 
	estadd scalar cnmean `cnmean'
	
	* Mean control immigrants
	su `var' if immigrant == 1 & randomization_feedback == 0
	local cimean : di %8.2f `r(mean)' 
	estadd scalar cimean `cimean'
	
	estadd local sc 	"Yes"
	estadd local sc_i 	"Yes"
	estadd local tc 	"Yes"
	estadd local tc_i 	"Yes"
	est store `var'3
	
	* 2)
	reg `var' imm_randomization_feedback immigrant randomization_feedback $controls $tech_controls imm_rand_wvs rand_wvs wvs wvs_imm  wvs_miss wvs_imm_miss imm_rand_wvs_miss rand_wvs_miss, robust cluster (school_id)

** Store control means
	* Mean control natives
	su `var' if immigrant == 0 & randomization_feedback == 0
	local cnmean : di %8.2f `r(mean)' 
	estadd scalar cnmean `cnmean'
	
	* Mean control immigrants
	su `var' if immigrant == 1 & randomization_feedback == 0
	local cimean : di %8.2f `r(mean)' 
	estadd scalar cimean `cimean'
	
	estadd local sc 	"Yes"
	estadd local sc_i 	"Yes"
	estadd local tc 	"Yes"
	estadd local tc_i 	"Yes"
	est store `var'4
	
	* 3)
	reg `var' imm_randomization_feedback immigrant randomization_feedback $controls $tech_controls gapprejudice imm_rand_gapprejudice imm_rand_gapprejudice_miss gapprejudice_miss imm_gapprejudice imm_gapprejudice_miss rand_gapprejudice rand_gapprejudice_miss, robust cluster (school_id)
	estadd local sc 	"Yes"
	estadd local sc_i 	"Yes"
	estadd local tc 	"Yes"
	estadd local tc_i 	"Yes"
	est store `var'6
	
** Store control means
	* Mean control natives
	su `var' if immigrant == 0 & randomization_feedback == 0
	local cnmean : di %8.2f `r(mean)' 
	estadd scalar cnmean `cnmean'
	
	* Mean control immigrants
	su `var' if immigrant == 1 & randomization_feedback == 0
	local cimean : di %8.2f `r(mean)' 
	estadd scalar cimean `cimean'	
	
	* 4)  
	reg `var' imm_randomization_feedback immigrant randomization_feedback $controls $tech_controls imm_rand_IAT IAT imm_IAT rand_IAT , robust cluster (school_id)
	
	** Store control means
	* Mean control natives
	su `var' if immigrant == 0 & randomization_feedback == 0
	local cnmean : di %8.2f `r(mean)' 
	estadd scalar cnmean `cnmean'
	
	* Mean control immigrants
	su `var' if immigrant == 1 & randomization_feedback == 0
	local cimean : di %8.2f `r(mean)' 
	estadd scalar cimean `cimean'
	
	estadd local sc 	"Yes"
	estadd local sc_i 	"Yes"
	estadd local tc 	"Yes"
	estadd local tc_i 	"Yes"
	est store `var'5
	
	* 5)
	reg `var' imm_randomization_feedback immigrant randomization_feedback $controls $tech_controls imm_rand_IAT IAT imm_IAT rand_IAT if wvs==1 , robust cluster (school_id)
	
	** Store control means
	* Mean control natives
	su `var' if immigrant == 0 & randomization_feedback == 0
	local cnmean : di %8.2f `r(mean)' 
	estadd scalar cnmean `cnmean'
	
	* Mean control immigrants
	su `var' if immigrant == 1 & randomization_feedback == 0
	local cimean : di %8.2f `r(mean)' 
	estadd scalar cimean `cimean'
	
	estadd local sc 	"Yes"
	estadd local sc_i 	"Yes"
	estadd local tc 	"Yes"
	estadd local tc_i 	"Yes"
	est store `var'7
	
	* 6)
	
	reg `var' imm_randomization_feedback immigrant randomization_feedback $controls $tech_controls imm_rand_IAT IAT imm_IAT rand_IAT if wvs!=1, robust cluster (school_id)
	
	** Store control means
	* Mean control natives
	su `var' if immigrant == 0 & randomization_feedback == 0
	local cnmean : di %8.2f `r(mean)' 
	estadd scalar cnmean `cnmean'
	
	* Mean control immigrants
	su `var' if immigrant == 1 & randomization_feedback == 0
	local cimean : di %8.2f `r(mean)' 
	estadd scalar cimean `cimean'
	
	estadd local sc 	"Yes"
	estadd local sc_i 	"Yes"
	estadd local tc 	"Yes"
	estadd local tc_i 	"Yes"
	est store `var'8

}


		 
esttab   grade_genIII3 grade_genIII4 grade_genIII6     ///
		 using "$tablesAppendix/A10teacher_revealbias_grade_IAT_wvs.tex", ///
	     label replace  ///
		 nomtitle nostar noomit booktabs collabels(none) noconstant ///
		 keep(imm_randomization_feedback immigrant randomization_feedback imm_rand_wvs rand_wvs imm_rand_gapprejudice rand_gapprejudice) ///
		 b(3) se(3) ///
		 nogaps stats(N r2 cnmean cimean sc sc_i tc tc_i, labels (`"Obs."' `"\(R^{2}\)"' `"\midrule Mean Control Natives"' `"Mean Control Immigrants"' `"\midrule Student Controls"' `"Student Controls*Imm"' `"Teacher Controls"' `"Teacher Controls*Imm"') fmt(0 3 2 2)) ///
		 prehead("\textbf{Dependent Variable: Teacher Assigned Grades} \\ \midrule ") ///
		 posthead(" \cmidrule(lr){2-4} ") ///
		 postfoot("")


** -----------------------------------------------------------------------------
**# Table A.11: Impact of revealing stereotypes to teachers on grades (vs. general 
	*		 debiasing) in the Online Experiment
** -----------------------------------------------------------------------------


eststo clear
estimates drop _all

	u "$data_final/AlesinaCarlanaLaFerraraPinotti_onlineexperiment.dta", replace
	
	global student_covar2 "female_student class_*"
	global covariates1_2 "female_teacher regionborn_1 regionborn_2 regionborn_3   before_first_reminder"
	global covariates1_m2 ""
	
	la def la_imm 1 "Immigrant" 0 "Native"
	la val immigrant la_imm
	
	
	la def la_treat 1 "IAT Feedback" 0 "Generic Debiasing", modify
	la var treat
	la val treat la_treat
	
	la var IAT "IAT Score"
	la de la_underestimate_IAT 1 "Underestimate own IAT"
	la val underestimate_IAT la_underestimate_IAT
	lab var treat "IAT Feedback"
	
	la var IAT_imm "Immigrant x IAT Score"

	gen 	cat_IAT=3 if IAT>0.6
	replace cat_IAT=2 if IAT>0.35 & IAT<0.6
	replace cat_IAT=1 if IAT>0.15 & IAT<0.35
	replace cat_IAT=0 if IAT>-0.15 & IAT<0.15
	replace cat_IAT=-1 if IAT>-0.35 & IAT<-0.15
	replace cat_IAT=-2 if IAT>-0.6 & IAT<-0.35
	replace cat_IAT=-3 if IAT<-0.6 & IAT!=.
	
	gen cat_IAT2=cat_IAT
	replace cat_IAT2=0 if cat_IAT<0
	replace cat_IAT2=1 if cat_IAT>1
	*replace cat_IAT2=2 if cat_IAT>2
	lab var cat_IAT2 "IAT$>$0.15"
	
	gen cat_IAT3=(IAT>0.35)
	lab var cat_IAT3 "IAT$>$0.35"
	la def la_cat_IAT3 1 "Moderate/Severe IAT" 0 "", modify
	la var cat_IAT3
	la val cat_IAT3 la_cat_IAT3

	gen exp_cat_IAT=Q23_1_sortnames_diff_native-4	// put into same scale of IAT
	
	gen dif_exp_IAT=cat_IAT-exp_cat_IAT
	
	gen exp_cont_IAT=exp_cat_IAT
	replace exp_cont_IAT=-0.77 if exp_cat_IAT==-3 
	replace exp_cont_IAT=-0.475 if exp_cat_IAT==-2 //0
	replace exp_cont_IAT=-0.25 if exp_cat_IAT==-1 //-0.24
	replace exp_cont_IAT=0.25 if exp_cat_IAT==1 //0.30
	replace exp_cont_IAT=0.475 if exp_cat_IAT==2 //0.50
	replace exp_cont_IAT=1.01 if exp_cat_IAT==3
	
	
	gen dif_exp_cont_IAT=IAT-exp_cont_IAT
	lab var dif_exp_cont_IAT "(IAT-Expected IAT)"
	
	gen dif_exp_cont_IAT_miss=(dif_exp_cont_IAT==.)
	replace dif_exp_cont_IAT=0 if dif_exp_cont_IAT==.
	
	
	reg grade_tassigned treat##immigrant##c.IAT iscongruentfirst  Math_Science Italian_History_Geography English i.order_question i.grade_orig $student_covar2 $covariates1_2 $covariates1_m2  , cluster(school_code) robust
	
	su grade_tassigned if treat == 0
	estadd scalar cmean `r(mean)'
	estadd local fe Yes
	estadd local sc Yes
	estadd local tc Yes
	est store reg1
	
	* 2)
	reg grade_tassigned treat##immigrant##c.dif_exp_cont_IAT treat##immigrant##dif_exp_cont_IAT_miss  Math_Science Italian_History_Geography English i.order_question i.grade_orig $student_covar2 $covariates1_2 $covariates1_m2, cluster(school_code) robust
	
	su grade_tassigned if treat == 0
	estadd scalar cmean `r(mean)'
	estadd local fe Yes
	estadd local sc Yes
	estadd local tc Yes
	est store reg2
	
	* 3)
	reg grade_tassigned treat##immigrant##c.dif_exp_cont_IAT immigrant##c.IAT  treat##immigrant##dif_exp_cont_IAT_miss   Math_Science Italian_History_Geography English i.order_question i.grade_orig $student_covar2 $covariates1_2 $covariates1_m2, cluster(school_code) robust 
	
	su grade_tassigned if treat == 0
	estadd scalar cmean `r(mean)'
	estadd local fe Yes
	estadd local sc Yes
	estadd local tc Yes
	est store reg3

	* 4)
	reg grade_tassigned treat##immigrant##c.dif_exp_cont_IAT treat##immigrant##c.IAT  treat##immigrant##dif_exp_cont_IAT_miss   Math_Science Italian_History_Geography English i.order_question i.grade_orig $student_covar2 $covariates1_2 $covariates1_m2, cluster(school_code) robust 
	
	su grade_tassigned if treat == 0
	estadd scalar cmean `r(mean)'
	estadd local fe Yes
	estadd local sc Yes
	estadd local tc Yes
	est store reg4

			 
	esttab   reg1 reg2 reg3 reg4   ///
			 using "$tablesAppendix/A11results_experiment2_beliefupdating_2.tex", ///
			 label replace ///
		  nomtitle nostar noomit booktabs collabels(none) noconstant ///
			 drop(0.treat* 0.immigrant *.order_question *.grade_orig *miss* $student_covar2 $covariates1_2 $covariates1_m2 Math_Science Italian_History_Geography iscongruentfirst) ///
			 b(3) se(3) ///
			 stats(cmean N r2 fe sc tc, labels (`"Control Mean"' `"\midrule Obs."' `"\(R^{2}\)"' `"\midrule Subject, Order, Original Grade FE"' `"Student Controls"' `"Teacher Controls"') fmt(3 0 3)) ///
			 prehead("") postfoot("")

** -----------------------------------------------------------------------------
**# Table D.1 - PANELS A and B: Bias in Grading and Teachers' IAT scores
** -----------------------------------------------------------------------------

use "$data_final/AlesinaCarlanaLaFerraraPinotti_fieldexperiment.dta",clear
	
eststo clear
est drop _all

lab var imm_IAT_g "IAT Gender Specific * Immigrant"

rename first_difference_std_grade first_diff_std_grade 

foreach outcome in grade_8 first_diff_std_grade {   
	
	*1
	reghdfe `outcome'  immigrant  $invalsi3 $cohort if imm_IAT_g!=., absorb(i.teacher_id)  cluster(teacher_id) 

		estadd local fe 				"Yes"
		estadd local invalsi3			"Yes"
		estadd local stu_control		"No"
		estadd local stu_control_imm	"No"
		estadd local tcr_control_imm	"No"
	
	est store `outcome'_1
	
	*2
	reghdfe `outcome'  imm_IAT_g immigrant  $invalsi3 $cohort if imm_IAT_g!=. , absorb(i.teacher_id)  cluster(teacher_id) 

		estadd local fe 				"Yes"
		estadd local invalsi3			"Yes"
		estadd local stu_control		"No"
		estadd local stu_control_imm	"No"
		estadd local tcr_control_imm	"No"
		
	est store `outcome'_2	
	
	*3
	reghdfe `outcome'  imm_IAT_g immigrant  $invalsi3 $cohort $controls $tech_controls if imm_IAT_g!=. , absorb(i.teacher_id)  cluster(teacher_id)

		estadd local fe 				"Yes"
		estadd local invalsi3			"Yes"
		estadd local stu_control		"Yes"
		estadd local stu_control_imm	"Yes"
		estadd local tcr_control_imm	"Yes"
		
	est store `outcome'_3
	
	*4
	reghdfe `outcome'  immigrant  $invalsi3 $cohort if imm_IAT_g!=. & invalsi>2, absorb(i.teacher_id)  cluster(teacher_id) 

		estadd local fe 				"Yes"
		estadd local invalsi3			"Yes"
		estadd local stu_control		"No"
		estadd local stu_control_imm	"No"
		estadd local tcr_control_imm	"No"
		
	est store `outcome'_4
	
	*5
	reghdfe `outcome'  imm_IAT_g immigrant  $invalsi3 $cohort if imm_IAT_g!=. & invalsi>2 , absorb(i.teacher_id)  cluster(teacher_id) 
	
		estadd local fe 				"Yes"
		estadd local invalsi3			"Yes"
		estadd local stu_control		"No"
		estadd local stu_control_imm	"No"
		estadd local tcr_control_imm	"No"
		
	est store `outcome'_5	
	
	*6
	reghdfe `outcome'  imm_IAT_g immigrant  $invalsi3 $cohort $controls $tech_controls if imm_IAT_g!=. & invalsi>2 , absorb(i.teacher_id)  cluster(teacher_id) 
	
		estadd local fe 				"Yes"
		estadd local invalsi3			"Yes"
		estadd local stu_control		"Yes"
		estadd local stu_control_imm	"Yes"
		estadd local tcr_control_imm	"Yes"
		
	est store `outcome'_6
	
	*7
	reghdfe `outcome' immigrant  $invalsi3 $cohort if imm_IAT_g!=. & invalsi<3, absorb(i.teacher_id)  cluster(teacher_id)
	
		estadd local fe 				"Yes"
		estadd local invalsi3			"Yes"
		estadd local stu_control		"No"
		estadd local stu_control_imm	"No"
		estadd local tcr_control_imm	"No"
		
	est store `outcome'_7
	
	*8
	reghdfe `outcome'  imm_IAT_g immigrant  $invalsi3 $cohort if imm_IAT_g!=. & invalsi<3, absorb(i.teacher_id)  cluster(teacher_id) 
	
		estadd local fe 				"Yes"
		estadd local invalsi3			"Yes"
		estadd local stu_control		"No"
		estadd local stu_control_imm	"No"
		estadd local tcr_control_imm	"No"
		
	est store `outcome'_8	
	
	*9
	reghdfe `outcome'  imm_IAT_g immigrant  $invalsi3 $cohort $controls $tech_controls if imm_IAT_g!=. & invalsi<3 , absorb(i.teacher_id)  cluster(teacher_id) 
	
		estadd local fe 				"Yes"
		estadd local invalsi3			"Yes"
		estadd local stu_control		"Yes"
		estadd local stu_control_imm	"Yes"
		estadd local tcr_control_imm	"Yes"
		
	est store `outcome'_9
	
	if  `outcome' == grade_8 {
	esttab `outcome'_* using "$tablesAppendix/D1Abias_grading_subject_`outcome'_gs.tex", 	///
		  b(3) se(3) label replace nomtitle nostar noomit collabels(none) noconstant ///
		  keep(imm_IAT_g immigrant) stats(N r2 fe invalsi3 stu_control stu_control_imm tcr_control_imm, ///
		  labels("Obs." "\(R^{2}\)" "\midrule Teacher FE" "INVALSI cubic" "Student Controls" "Student Controls*Imm" "Teacher Controls*Imm") fmt(0 3)) ///
		  prehead("\multicolumn{10}{l}{\textbf{Panel A-- Outcome: Teacher Grade}} \\ \midrule \multicolumn{1}{c}{} & \multicolumn{3}{c}{All} & \multicolumn{3}{c}{High Ability} & \multicolumn{3}{c}{Low Ability} \\ \cmidrule(lr){2-4} \cmidrule(lr){5-7} \cmidrule(lr){8-10}") ///
		  postfoot("")
	}
	
	if  `outcome' == first_diff_std_grade {
	esttab `outcome'_* using "$tablesAppendix/D1Bbias_grading_subject_`outcome'_gs.tex", 	///
		  b(3) se(3) label replace nomtitle nostar noomit collabels(none) noconstant ///
		  keep(imm_IAT_g immigrant) stats(N r2 fe invalsi3 stu_control stu_control_imm tcr_control_imm, ///
		  labels("Obs." "\(R^{2}\)" "\midrule Teacher FE" "INVALSI cubic" "Student Controls" "Student Controls*Imm" "Teacher Controls*Imm") fmt(0 3)) ///
		  prehead("\\ \multicolumn{10}{l}{{\bf Panel B– Outcome: First Difference, Std Grade–Std Test Score}} \\ \midrule \multicolumn{1}{c}{} & \multicolumn{3}{c}{All} & \multicolumn{3}{c}{High Ability} & \multicolumn{3}{c}{Low Ability} \\ \cmidrule(lr){2-4} \cmidrule(lr){5-7} \cmidrule(lr){8-10}") ///
		  postfoot("")
		  
	}
		  
}


** -----------------------------------------------------------------------------
**# Table D.2 - The impact of revealing stereotypes in the field and online experiment, by teacher IAT
** -----------------------------------------------------------------------------

use "$data_final/AlesinaCarlanaLaFerraraPinotti_fieldexperiment.dta",clear

gen IAT_g=IAT_m 
replace IAT_g=IAT_f if female==1

	
	* Restrict sample *****************
	keep if IAT!=.
	keep if grade_genIII!=.
	drop if school_id==101 
	keep if randomization_feedback!=.
	keep if grade_genIII!=.
	keep if iat_done==1
	***********************************
	gen rand_IAT_g=randomization_feedback*IAT_g
	gen imm_rand_IAT_g=randomization_feedback*IAT_g*immigrant
	lab var IAT_g "IAT Gender Specific"	
	lab var imm_IAT_g "Immigrant $\times$ IAT Gender Specific"
	lab var rand_IAT_g "Feedback $\times$ IAT Gender Specific"
	lab var randomization_feedback "Feedback"
	lab var imm_randomization_feedback "Feedback $\times$ Immigrant"
	lab var imm_rand_IAT_g "Feedback $\times$ Immigrant $\times$ IAT Gender Specific"
	la def la_immigrant 1 "Immigrant" 0 "Native", modify
	la var immigrant
	la val immigrant la_immigrant
	lab var immigrant "Immigrant"

corr IAT_g imm_IAT_g if immigrant==0	
	
	reg grade_genIII imm_randomization_feedback immigrant randomization_feedback $controls $tech_controls , robust cluster (school_id)
	su grade_genIII if randomization_feedback == 0
	estadd scalar cmean `r(mean)'
	estadd local fe No
	estadd local sc Yes
	estadd local tc Yes
	est store reg1
	
	reg grade_genIII imm_randomization_feedback immigrant randomization_feedback $controls $tech_controls imm_rand_IAT_g IAT_g imm_IAT_g rand_IAT_g , robust cluster (school_id)
	su grade_genIII if randomization_feedback == 0
	estadd scalar cmean `r(mean)'
	estadd local fe No
	estadd local sc Yes
	estadd local tc Yes
	est store reg2

		
	esttab   reg1 reg2   ///
			 using "$tablesAppendix/D2results_experiments_gs.tex", ///
			 label replace ///
			 nomtitle nostar noomit booktabs collabels(none) noconstant ///
			 drop($controls $tech_controls) ///
			 b(3) se(3) ///
			 stats(cmean N r2  sc tc, labels (`"Control Mean"' `"\midrule Obs."' `"\(R^{2}\)"'  `"Student Controls"' `"Teacher Controls"') fmt(3 0 3)) ///
			 prehead("\multicolumn{5}{l}{ {\bf Dependent Variable: Teacher-Assigned Grade}} \\ \hline & \multicolumn{2}{l}{ {\bf Field Experiment}} \\ \cmidrule(lr){2-3}") postfoot("")
	


*********************
erase "$data_temp/EBE_tomerge.dta"
erase "$data_temp/AlesinaCarlanaLaFerraraPinotti_dataset_bayes.dta"
