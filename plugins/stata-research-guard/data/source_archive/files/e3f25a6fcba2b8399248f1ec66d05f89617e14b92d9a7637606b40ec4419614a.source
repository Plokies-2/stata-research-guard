** -----------------------------------------------------------------------------
**# Table 5: Impact of revealing stereotypes by IAT
** -----------------------------------------------------------------------------'

use "$data_final/AlesinaCarlanaLaFerraraPinotti_fieldexperiment.dta",clear
	
	* Restrict sample *****************
	keep if IAT!=.
	keep if grade_genIII!=.
	drop if school_id==101 
	keep if randomization_feedback!=.
	keep if grade_genIII!=.
	keep if iat_done==1
	***********************************
	
	la def la_immigrant 1 "Immigrant" 0 "Native", modify
	la val immigrant la_immigrant
	
	lab var immigrant "Immigrant"
	lab var randomization_feedback "IAT Feedback"
	lab var imm_randomization_feedback "IAT Feedback $\times$ Immigrant"
	lab var rand_IAT "IAT Feedback $\times$ IAT Score"
	lab var imm_rand_IAT "IAT Feedback $\times$ Immigrant $\times$ IAT Score"
	lab var IAT "IAT Score"
	lab var imm_IAT "Immigrant $\times$ IAT Score"
	
	preserve
	
	*IMMIGRANT								
											*immigrant
	*IAT FEEDBACK
		rename randomization_feedback 		treat 
	*IAT FEEDBACK x IMMIGRANT
		rename imm_randomization_feedback   treat_immigrant
	*IAT FEEDBACK x IAT SCORE
		rename rand_IAT 					treat_IAT
	*IAT FEEDBACK x IMMIGRANT x IAT SCORE
		rename imm_rand_IAT					treat_immigrant_IAT		
	*IAT SCORE								
											*IAT		
	*IMMIGRANT x IAT SCORE
		rename imm_IAT						immigrant_IAT

	lab var immigrant_IAT "Immigrant $\times$ IAT Score"

	*1)
	reg grade_genIII treat immigrant treat_immigrant  $controls $tech_controls , robust cluster (school_id)
	su grade_genIII if treat == 0
	estadd scalar cmean `r(mean)'
	estadd local fe No
	estadd local sc Yes
	estadd local tc Yes
	est store reg1
	
	*2)
	reg grade_genIII treat immigrant treat_immigrant $controls $tech_controls treat_immigrant_IAT IAT immigrant_IAT treat_IAT , robust cluster (school_id)
	su grade_genIII if treat == 0
	estadd scalar cmean `r(mean)'
	estadd local fe No
	estadd local sc Yes
	estadd local tc Yes
	est store reg2

	restore
	
	u "$data_final/AlesinaCarlanaLaFerraraPinotti_onlineexperiment.dta", replace
	
	
	global student_covar2 "female_student class_*"
	global covariates1_2 "female_teacher regionborn_1 regionborn_2 regionborn_3   before_first_reminder"
	global covariates1_m2 ""
	
	la def la_imm 1 "Immigrant" 0 "Native"
	la val immigrant la_imm
	
	la def la_treat 1 "IAT Feedback" 0 " ", modify
	la val treat la_treat
	
	la de la_underestimate_IAT 1 "Underestimate own IAT"
	la val underestimate_IAT la_underestimate_IAT
	
	gen fail=(grade_tassigned<6)
	replace fail=. if grade_tassigned==.
	
	*IMMIGRANT								immigrant
		lab var immigrant "Immigrant"
	*IAT FEEDBACK							treat
		lab var treat "IAT Feedback"
	*IAT SCORE								IAT		
		lab var IAT "IAT Score"
	*IMMIGRANT x IAT SCORE
		lab var IAT_imm "Immigrant $\times$ IAT Score"
	
	*IAT FEEDBACK x IMMIGRANT
		gen  treat_immigrant = treat*immigrant 
		lab var treat_immigrant "IAT Feedback $\times$ Immigrant"
	*IAT FEEDBACK x IAT SCORE
		gen  treat_IAT = treat*IAT 
		lab var treat_IAT "IAT Feedback $\times$ IAT Score"
	*IAT FEEDBACK x IMMIGRANT x IAT SCORE
		gen  treat_immigrant_IAT = treat*immigrant*IAT 
		lab var treat_immigrant_IAT "IAT Feedback $\times$ Immigrant $\times$ IAT Score"
				
		
preserve
	rename  IAT_imm immigrant_IAT
	lab var immigrant_IAT "Immigrant $\times$ IAT Score"

	
	* 3)
	reg fail treat immigrant treat_immigrant Math_Science Italian_History_Geography English i.order_question i.grade_orig $student_covar2 $covariates1_2 $covariates1_m2  , cluster(school_code) robust 
	reg fail treat immigrant IAT treat_immigrant treat_IAT immigrant_IAT treat_immigrant_IAT iscongruentfirst  Math_Science Italian_History_Geography English i.order_question i.grade_orig $student_covar2 $covariates1_2 $covariates1_m2  , cluster(school_code) robust

		
	reg grade_tassigned treat immigrant treat_immigrant Math_Science Italian_History_Geography English i.order_question i.grade_orig $student_covar2 $covariates1_2 $covariates1_m2  , cluster(school_code) robust 
	
	su grade_tassigned if treat == 0
	estadd scalar cmean `r(mean)'
	estadd local fe Yes
	estadd local sc Yes
	estadd local tc Yes
	est store reg3
	
		* 4)
	reg grade_tassigned treat immigrant IAT treat_immigrant treat_IAT immigrant_IAT treat_immigrant_IAT iscongruentfirst  Math_Science Italian_History_Geography English i.order_question i.grade_orig $student_covar2 $covariates1_2 $covariates1_m2  , cluster(school_code) robust
	
	su grade_tassigned if treat == 0
	estadd scalar cmean `r(mean)'
	estadd local fe Yes
	estadd local sc Yes
	estadd local tc Yes
	est store reg4
	 
esttab   reg1 reg2 reg3 reg4  ///
			 using "$tables/T5results_experiments.tex", label replace ///
		     nomtitle nostar noomit booktabs collabels(none) noconstant ///
			 keep(treat immigrant IAT treat_immigrant treat_IAT treat_immigrant_IAT  immigrant_IAT) order(immigrant treat treat_immigrant treat_IAT treat_immigrant_IAT IAT immigrant_IAT) ///
			 b(3) se(3)   ///
			 stats(cmean N r2 fe sc tc, labels (`"Control Mean"' `"\midrule Obs."' `"\(R^{2}\)"' `"\midrule Subject, Order, Original Grade FE"' `"Student Controls"' `"Teacher Controls"') fmt(3 0 3)) ///
			 prehead("\begin{tabular}{l*{4}{c}} \toprule \multicolumn{5}{l}{ {\bf Dependent Variable: Teacher-Assigned Grade}} \\ \cmidrule(lr){2-3}\cmidrule(lr){4-5} & \multicolumn{2}{l}{ {\bf Field Experiment}} & \multicolumn{2}{l}{ {\bf Online Experiment}} \\ \cmidrule(lr){2-3}\cmidrule(lr){4-5}") ///
		     postfoot("\bottomrule \end{tabular}")

restore

** -----------------------------------------------------------------------------
**# Table 6: Impact of revealing stereotypes to teachers on grades (vs. general 
	*		 debiasing) in the Online Experiment
** -----------------------------------------------------------------------------


eststo clear
estimates drop _all

	u "$data_final/AlesinaCarlanaLaFerraraPinotti_onlineexperiment.dta", replace
	
	global student_covar2 "female_student class_*"
	global covariates1_2 "female_teacher regionborn_1 regionborn_2 regionborn_3   before_first_reminder"
	global covariates1_m2 ""
	
	la def la_imm 1 "Immigrant" 0 "Native"
	la val immigrant la_imm
	
	
	la def la_treat 1 "IAT Feedback" 0 "Generic Debiasing", modify
	la var treat
	la val treat la_treat
	
	la var IAT "IAT Score"
	la de la_underestimate_IAT 1 "Underestimate own IAT"
	la val underestimate_IAT la_underestimate_IAT
	lab var treat "IAT Feedback"
	
	la var IAT_imm "Immigrant x IAT Score"

	gen 	cat_IAT=3 if IAT>0.6
	replace cat_IAT=2 if IAT>0.35 & IAT<0.6
	replace cat_IAT=1 if IAT>0.15 & IAT<0.35
	replace cat_IAT=0 if IAT>-0.15 & IAT<0.15
	replace cat_IAT=-1 if IAT>-0.35 & IAT<-0.15
	replace cat_IAT=-2 if IAT>-0.6 & IAT<-0.35
	replace cat_IAT=-3 if IAT<-0.6 & IAT!=.
	
	gen cat_IAT2=cat_IAT
	replace cat_IAT2=0 if cat_IAT<0
	replace cat_IAT2=1 if cat_IAT>1
	*replace cat_IAT2=2 if cat_IAT>2
	lab var cat_IAT2 "IAT$>$0.15"
	
	gen cat_IAT3=(IAT>0.35)
	lab var cat_IAT3 "IAT$>$0.35"
	la def la_cat_IAT3 1 "Moderate/Severe IAT" 0 "", modify
	la var cat_IAT3
	la val cat_IAT3 la_cat_IAT3

	gen cat_IAT4=cat_IAT
	replace cat_IAT4=0 if cat_IAT<0
	replace cat_IAT4=1 if cat_IAT>1
	replace cat_IAT4=2 if cat_IAT>2
	lab var cat_IAT4 "IAT (3 categories)"
	
	
	gen exp_cat_IAT=Q23_1_sortnames_diff_native-4	// put into same scale of IAT
	
	gen dif_exp_IAT=cat_IAT-exp_cat_IAT
	
	gen exp_cont_IAT=exp_cat_IAT
	replace exp_cont_IAT=-0.77 if exp_cat_IAT==-3 
	replace exp_cont_IAT=-0.475 if exp_cat_IAT==-2 //0
	replace exp_cont_IAT=-0.25 if exp_cat_IAT==-1 //-0.24
	replace exp_cont_IAT=0.25 if exp_cat_IAT==1 //0.30
	replace exp_cont_IAT=0.475 if exp_cat_IAT==2 //0.50
	replace exp_cont_IAT=1.01 if exp_cat_IAT==3
					
	gen dif_exp_IAT2=dif_exp_IAT
	replace dif_exp_IAT2=0 if dif_exp_IAT<0
	replace dif_exp_IAT2=1 if dif_exp_IAT>1

	gen dif_exp_IAT4=dif_exp_IAT
	replace dif_exp_IAT4=0 if dif_exp_IAT<0
	replace dif_exp_IAT4=1 if dif_exp_IAT==2
	replace dif_exp_IAT4=2 if dif_exp_IAT>2
	lab var dif_exp_IAT4 "Dif IAT-Exp IAT (3 categories)"
	
	gen dif_exp_cont_IAT=IAT-exp_cont_IAT
	lab var dif_exp_cont_IAT "Dif IAT-Exp IAT"
	
	gen dif_exp_cont_IAT_miss=(dif_exp_cont_IAT==.)
	replace dif_exp_cont_IAT=0 if dif_exp_cont_IAT==.
	
	gen dif_exp_IAT_miss=(dif_exp_IAT==.)
	replace dif_exp_IAT=0 if dif_exp_IAT==.
	
	
	
	
* 1)
	reg grade_tassigned treat##immigrant##cat_IAT3 iscongruentfirst  Math_Science Italian_History_Geography English i.order_question i.grade_orig $student_covar2 $covariates1_2 $covariates1_m2  , cluster(school_code) robust
	
	su grade_tassigned if treat == 0
	estadd scalar cmean `r(mean)'
	estadd local fe Yes
	estadd local sc Yes
	estadd local tc Yes
	est store reg1
	
	* 2)
	reg grade_tassigned treat##immigrant##underestimate_IAT treat##immigrant##underestimate_IAT_miss  Math_Science Italian_History_Geography English i.order_question i.grade_orig $student_covar2 $covariates1_2 $covariates1_m2, cluster(school_code) robust
	
	su grade_tassigned if treat == 0
	estadd scalar cmean `r(mean)'
	estadd local fe Yes
	estadd local sc Yes
	estadd local tc Yes
	est store reg2
	
	* 3)
	reg grade_tassigned treat##immigrant##underestimate_IAT immigrant##cat_IAT3  treat##immigrant##underestimate_IAT_miss   Math_Science Italian_History_Geography English i.order_question i.grade_orig $student_covar2 $covariates1_2 $covariates1_m2, cluster(school_code) robust 
	
	su grade_tassigned if treat == 0
	estadd scalar cmean `r(mean)'
	estadd local fe Yes
	estadd local sc Yes
	estadd local tc Yes
	est store reg3

	* 4)
	reg grade_tassigned treat##immigrant##underestimate_IAT treat##immigrant##cat_IAT3  treat##immigrant##underestimate_IAT_miss   Math_Science Italian_History_Geography English i.order_question i.grade_orig $student_covar2 $covariates1_2 $covariates1_m2, cluster(school_code) robust 
	
	su grade_tassigned if treat == 0
	estadd scalar cmean `r(mean)'
	estadd local fe Yes
	estadd local sc Yes
	estadd local tc Yes
	est store reg4

	esttab   reg1 reg2 reg3 reg4   ///
			 using "$tables/T6results_experiment2_beliefupdating.tex", ///
			 label replace  ///
		     nomtitle nostar noomit booktabs collabels(none) noconstant ///
			 keep(1.treat 1.immigrant 1.treat#1.immigrant 1.cat_IAT3 1.treat#1.cat_IAT3 1.immigrant#1.cat_IAT3 1.treat#1.immigrant#1.cat_IAT3 1.underestimate_IAT 1.treat#1.underestimate_IAT 1.immigrant#1.underestimate_IAT 1.treat#1.immigrant#1.underestimate_IAT) ///
			 b(3) se(3) ///
			 nogaps stats(cmean N r2 fe sc tc, labels (`"Control Mean"' `"\midrule Obs."' `"\(R^{2}\)"' `"\midrule Subject, Order, Original Grade FE"' `"Student Controls"' `"Teacher Controls"') fmt(3 0 3)) ///
			prehead("\begin{tabular}{l*{4}{c}} \toprule \multicolumn{6}{l}{ {\bf Dependent Variable: Teacher-Assigned Grade}} \\ \cmidrule(lr){2-5}") ///
		  postfoot("\bottomrule \end{tabular}")

