** -----------------------------------------------------------------------------
**# Figure 2: Distribution of the race IAT score across teachers
** -----------------------------------------------------------------------------

* Load dataset 1
use "$data_final/AlesinaCarlanaLaFerraraPinotti_onlineexperiment.dta", replace
	
	* Restrict sample *****************
	duplicates drop teacher_id,force
	keep if student_id!=""
	keep if IAT!=.
	rename IAT d_score_race
	rename Math_Science math
	***********************************
	
	ksmirnov d_score_race, by(math) exact
	
	* Graph
	twoway (kdensity d_score_race if math==1, color(green)) 				///
		   (kdensity d_score_race if math==0, xline(-0.15) xline(0.15) 		///
		   xline(0.35) xline(0.6) color(blue)), 							///
		   graphregion(color(white)) title("Online experiment") 					///
		   legend(order(1 "Math" 2 "Literature")) 							///
		   ytitle("kdensity d-score IAT") xtitle("Immigrant-Native Implicit Association Test") xlabel(-1.05(0.15)1.8) ///
		   note("P-value of Kolmogorov-Smirnov: 0.871")
	
	* Save intermediate graph
	graph copy exp2, replace

* Load dataset 2
use "$data_final/AlesinaCarlanaLaFerraraPinotti_fieldexperiment_teachers.dta",clear

	ksmirnov d_score_race, by(math) exact

	twoway (kdensity d_score_race if math==1, color(green)) 				///
		   (kdensity d_score_race if math==0, xline(-0.15) xline(0.15) 		///
		   xline(0.35) xline(0.6) color(blue)), 							///
		   graphregion(color(white)) title("Field experiment") 					///
		   legend(order(1 "Math" 2 "Literature")) 							///
		   ytitle("kdensity d-score IAT") xtitle("Immigrant-Native Implicit Association Test") xlabel(-1.05(0.15)1.8) ///
		   note("P-value of Kolmogorov-Smirnov: 0.920")
	
	* Save intermediate graph		   
	graph copy exp1, replace
	
	* Combine the two graphs
	graph combine exp1 exp2 , col(1) rows(2) 								///
							  title("") ///
							  graphregion(color(white)) 
	
	* Export graph
	graph export "$figures/F2dscore_sub_both.pdf", replace

** -----------------------------------------------------------------------------
**# Figure 3: Distribution of grades
** -----------------------------------------------------------------------------

* Load data
use "$data_final/AlesinaCarlanaLaFerraraPinotti_fieldexperiment.dta",clear
	
preserve
	
	* Modify variables for graph
	replace grade_8=3 if grade_8<3
	replace grade_8=grade_8+0.2 if immigrant==1
	replace grade_8=grade_8-0.2 if immigrant==0
	
	* Restrict sample ************************
	keep if grade_8!=. & invalsi_8!=. & IAT!=. 
	******************************************
	
	* Create graph
	twoway (kdensity invalsi_8  if immigrant==0, scheme(s1color) color(blue)  bwidth(5) ) ///
		   (kdensity invalsi_8  if immigrant==1, color(red*0.9)  bwidth(5) ), ///
			xtitle("") title("Standardized test scores")ytitle("kdensity")  ///
			legend(order(1 "Natives" 2 "Immigrants" ))
	
	* Save intermediate results
	graph copy invalsi, replace

	twoway (histogram grade_8  if immigrant==0, scheme(s1color) frac color(blue*0.8) width(0.2)) ///
		   (histogram grade_8  if immigrant==1, frac color(red*0.8) width(0.2)) ///
			, xtitle("")  title("Teacher-assigned grades")  ///
			legend(order(1 "Natives" 2 "Immigrants" )) xscale(range(2.8 10.2)) xlabel(3(1)10)
			
	* Save intermediate results		
	graph copy grade, replace
	
restore
	
	* Combine graphs to export
	graph combine  grade invalsi, col(2) scheme(s1color)
	
	* Export graph
	graph export "$figures/F3gradesblindnoblind.pdf", replace	

** -----------------------------------------------------------------------------
**# Figure 4: Teacher-assigned grades vs. blindly-graded, standardized test scores
** -----------------------------------------------------------------------------

* Load data
use "$data_final/AlesinaCarlanaLaFerraraPinotti_fieldexperiment.dta",clear

preserve
	
	* Restrict sample ************************
	keep if grade_8!=. & invalsi_8!=. & IAT!=. 
	******************************************
	
	gen obs=1
	
	collapse (mean) grade_8  (sd)sdgrade_8 = grade_8 (sum) obs, by(immigrant invalsi)
	
	foreach var in grade_8 {
		generate up$_var   = $_var + invttail(obs-1,0.05)*(sd$_var / sqrt(obs))
		generate down$_var = $_var - invttail(obs-1,0.05)*(sd$_var / sqrt(obs))
	}
	
	* Create graph
	twoway (rcap upgrade_8 downgrade_8 invalsi if immigrant==0, lcolor(green)) ///
		   (line grade_8 invalsi if immigrant==0, lcolor(green)) ///
		   (scatter grade_8 invalsi if immigrant==0, mcolor(green)) ///
		   (rcap upgrade_8 downgrade_8 invalsi if immigrant==1, lcolor(red)) ///
		   (line grade_8 invalsi if immigrant==1, lcolor(red)) ///
		   (scatter grade_8 invalsi if immigrant==1, ///
		   mcolor(red) msymbol(circle_hollow)), legend(order(3 "Natives" 6 "Immigrants"))  ///
		   xlabel(1(1)5) title("")  xtitle("Blind test score (INVALSI), quintiles") ///
		   ytitle("Teacher-assigned grades")
		   
	* Export graph
	graph export "$figures/F4graph_bias.pdf", replace

restore

** -----------------------------------------------------------------------------
**# Figure 5: The correlation between Teacher Assigned Grades and Implicit 
*			  Association Test for Immigrants and Natives
** -----------------------------------------------------------------------------
	
	eststo clear
	estimates drop _all
	
* Load data
use "$data_final/AlesinaCarlanaLaFerraraPinotti_fieldexperiment.dta",clear

	* Graphical evidence grade
	 reghdfe grade_8  $invalsi3 $cohort $controlsX  if IAT!=. , absorb(i.teacher_id)  resid
	 predict grade_hat, res

	* Create graph
	 twoway (lpolyci grade_hat IAT if immigrant==1,  n(100) ciplot(rline) pstyle(ci2) lcolor(lavender) lwidth(medthick)  blpattern(dash)  bwidth(.15) ) ///
			(lpolyci grade_hat IAT if immigrant==0,  n(20) ciplot(rline) pstyle(ci2)  lcolor(black) lwidth(medthick)  blpattern(dash)     bwidth(.15)), ///
			title("") scheme(s1color) xtitle("Teacher Immigrant-Native IAT") ytitle("Teacher Assigned Grade (Residual)") ///
			yscale(range(-0.1 0.2)) ylabel(-0.1(0.05)0.2) legend(order(4 "Natives(95% CI)" 2 "Immigrants(95% CI)" )) 

* Export graph
graph export "$figures/F5Figure_distribution_immigrant2.pdf", replace

** -----------------------------------------------------------------------------
**# Figure 6: Teacher-assigned grades vs. blindly-graded, standardized test 
*				scores by Teacher IAT (High vs. Low)
** -----------------------------------------------------------------------------
	
use "$data_final/AlesinaCarlanaLaFerraraPinotti_fieldexperiment.dta",clear
			
preserve
	
	* Restrict sample ************************
	keep if grade_8!=. & invalsi_8!=. & IAT!=. 
	keep if immigrant==1
	******************************************
	
	gen obs=1
	count
	collapse (mean) grade_8  (sd)sdgrade_8 = grade_8 (sum) obs, by(high_IAT invalsi)
	
	foreach var in grade_8 {
		generate up$_var = $_var + invttail(obs-1,0.05)*(sd$_var / sqrt(obs))
		generate down$_var = $_var - invttail(obs-1,0.05)*(sd$_var / sqrt(obs))
}

twoway (rcap upgrade_8 downgrade_8 invalsi if high_IAT==0, lcolor(navy)) ///
	   (line grade_8 invalsi if high_IAT==0, lcolor(navy)) ///
	   (scatter grade_8 invalsi if high_IAT==0, mcolor(navy)) ///
	   (rcap upgrade_8 downgrade_8 invalsi if high_IAT==1, lcolor(orange)) ///
	   (line grade_8 invalsi if high_IAT==1, lcolor(orange)) ///
	   (scatter grade_8 invalsi if high_IAT==1, mcolor(orange) msymbol(circle_hollow)), ///
	   legend(order(3 "Low IAT" 6 "High IAT"))  xlabel(1(1)5) title("Immigrants")  ///
	   xtitle("Blind test score (INVALSI), quintiles") ytitle("Teacher-assigned grades")
	   graph copy imm, replace

restore

preserve

	* Restrict sample ************************
	keep if grade_8!=. & invalsi_8!=. & IAT!=. 
	keep if immigrant==0
	******************************************
	gen obs=1
	count
	
	collapse (mean) grade_8  (sd)sdgrade_8 = grade_8 (sum) obs, by(high_IAT invalsi)
	
	foreach var in grade_8 {
		
		generate up$_var = $_var + invttail(obs-1,0.05)*(sd$_var / sqrt(obs))
		generate down$_var = $_var - invttail(obs-1,0.05)*(sd$_var / sqrt(obs))
	}
	
	* Graph
	twoway (rcap upgrade_8 downgrade_8 invalsi if high_IAT==0, lcolor(navy)) 			///
		   (line grade_8 invalsi if high_IAT==0, lcolor(navy)) 						///
		   (scatter grade_8 invalsi if high_IAT==0, mcolor(navy)) 					///
		   (rcap upgrade_8 downgrade_8 invalsi if high_IAT==1, lcolor(orange)) 		///
		   (line grade_8 invalsi if high_IAT==1, lcolor(orange)) 					///
	  	   (scatter grade_8 invalsi if high_IAT==1, mcolor(orange) msymbol(circle_hollow)), ///
		   legend(order(3 "Low IAT" 6 "High IAT"))  xlabel(1(1)5) title("Natives")  ///
		    xtitle("Blind test score (INVALSI), quintiles") ytitle("Teacher-assigned grades")
			graph copy nat, replace
	restore

	graph combine imm nat, cols(2) scale(.7) ysize(4) xsize(7) title("")

	graph save "$figures/F6graph_bias_by_IAT",replace
	graph export "$figures/F6graph_bias_by_IAT.pdf", replace
	
	   

** -----------------------------------------------------------------------------
**# Figure 7: Online Experiment: The impact of Revealing Stereotypes to teachers 
*			  on grading of immigrant and native students
** -----------------------------------------------------------------------------
* Panel A


clear all


use "$data_final/AlesinaCarlanaLaFerraraPinotti_fieldexperiment.dta",clear

		* Restrict sample *****************
	keep if IAT!=.
	keep if grade_genIII!=.
	drop if school_id==101 
	keep if randomization_feedback!=.
	keep if grade_genIII!=.
	keep if iat_done==1
	***********************************		*******************
		* Regression
	reg grade_genIII    $controlsX $tech_controlsX , robust cluster (school_id)
		predict test_hat, res

		* Generate variables based on predicted values
		gen test_hat_i=test_hat if immigrant==1
		replace test_hat_i=0 if test_hat_i==.

		gen test_hat_n=test_hat if immigrant==0
		replace test_hat_n=0 if test_hat_n==.
		
		bys teacher_id: egen num_imm=sum(immigrant) 
		bys teacher_id: egen num_stu=count(immigrant) 
		egen num_imm_tot=sum(immigrant) 
		egen num_stu_tot=count(immigrant) 
		gen share_imm_t=num_imm/num_imm_tot
		gen share_stu_t=num_stu/num_stu_tot		

		bys teacher_id: egen test_hat_imm=wmean(test_hat_i), weight(share_imm_t)
		bys teacher_id: egen test_hat_nat=wmean(test_hat_n), weight(share_imm_t)
		
		
		gen 	dif_test_hat_nat_imm=test_hat_nat-test_hat_imm
		lab var dif_test_hat_nat_imm "Native-Immigrant grade (residuals)"

		* Restrict sample ******************
		duplicates drop teacher_id, force
		*drop if IAT <-.65
		************************************
	gen control=1-randomization_feedback
	la def la_control 1 "Control" 0 "Generic Debiasing+Feedback", modify
	la var control
	la val control la_control
	
		* Graph
		twoway   lpolyci dif_test_hat_nat_imm IAT , by(control) bwidth(.25) yline(0)   ///
				xtitle("Immigrant-Native Implicit Association Test") 	 	  ///
				ytitle("Native-Immigrant teacher-assigned grade (residual)")   ///
				yscale(range(-0.2 0.3)) ylabel(-0.2(0.1)0.3) legend(off) 
		graph copy one, replace 
		graph export "$figures/F7Aresults_exp1_difference.pdf", replace

		
* Panel B



	u "$data_final/AlesinaCarlanaLaFerraraPinotti_onlineexperiment.dta", replace

		* Restrict sample *
		keep if grade_tassigned!=.
		*******************

		* Regression
		reg grade_tassigned Math_Science Italian_History_Geography English i.order_question i.grade_orig $student_covar2 $covariates1_2 $covariates1_m2, cluster(school_code)
		predict test_hat, res

		* Generate variables based on predicted values
		gen test_hat_i=test_hat if immigrant==1
		replace test_hat_i=0 if test_hat_i==.

		gen test_hat_n=test_hat if immigrant==0
		replace test_hat_n=0 if test_hat_n==.

		bys teacher_id: egen test_hat_imm=mean(test_hat_i) 
		bys teacher_id: egen test_hat_nat=mean(test_hat_n) 
		
		gen 	dif_test_hat_nat_imm=test_hat_nat-test_hat_imm
		lab var dif_test_hat_nat_imm "Native-Immigrant grade (residuals)"

		* Restrict sample ******************
		duplicates drop teacher_id, force
		drop if IAT <-.65
		************************************
	gen control=1-treat

	la def la_control 1 "Generic Debiasing" 0 "Generic Debiasing+Feedback", modify
	la var control
	la val control la_control
		* Graph
		twoway   lpolyci dif_test_hat_nat_imm IAT , by(control) bwidth(.25) yline(0)  ///
				xtitle("Immigrant-Native Implicit Association Test") 			  ///
				ytitle("Native-Immigrant teacher-assigned grade (residual)")   ///
				yscale(range(-0.7 0.5)) ylabel(-0.7(0.1)0.5) legend(off) 
		graph copy two, replace 	
		graph export "$figures/F7Bresults_exp2_difference.pdf", replace

	graph combine one, title("Panel A: Field Experiment")
	graph copy a, replace

	graph combine two, title("Panel B: Online Experiment")
	graph copy b, replace
		
graph combine a b, xsize(3) ysize(4) col(1) scale(1) title("") graphregion(color(white)) 


graph export "$figures/F7results_exp_difference.pdf", replace




** -----------------------------------------------------------------------------
**# Table 1: Balance table - Teacher characteristics
** -----------------------------------------------------------------------------

preserve

	*** BALANCE TABLE SETUP ************************************
	local filename balance_table_teacher_char

	* Experiment 1
	local varlist_exp1 $variables_exp1
	local byvar_exp1 randomization_feedback
	local byvar0_exp1 "Control"
	local byvar1_exp1 "Treated"

	* Experiment 2
	local varlist_exp2 $variables_exp2
	local byvar_exp2 treat
	local byvar0_exp2 "Control"
	local byvar1_exp2 "Treated"
	*************************************************************
	
* Open file
cap file close sumstat
	file open  sumstat using "$tables/T1`filename'.tex", write replace
	file write sumstat 	"\begin{tabular}{lccccc}  \\ \toprule "  _n     // table header

	* Create header for experiment 1
	file write sumstat "\multicolumn{6}{l}{\textbf{Panel A: Teachers in the Field Experiment}}\\  " _n
	file write sumstat 	"\midrule " _n 
	file write sumstat	"  & (1) & (2) & (3) & (4) & (5) \\  " _n 
	file write sumstat	"  & Full sample & `byvar0_exp1' & `byvar1_exp1' & p-value & Norm. Diff. \\  " _n
	file write sumstat 	"\midrule " _n 
	
	* LOAD DATASET FOR EXPERIMENT 1
	use "$data_final/AlesinaCarlanaLaFerraraPinotti_fieldexperiment_teachers.dta",clear
		
		* Restrict sample **********
		keep if final_sample == 1
		drop if d_score_race==.
		****************************
		
		
		lab var d_score_race "IAT"
	
local i=1

	foreach var in `varlist_exp1' {
		
		cap drop stand_diff
		
		di "Calculating stats for variable: `var'"
		
		* Store label
		local varlab: variable label `var'  
		
		* Ttest
		ttest `var', by(`byvar_exp1')
				
		* Store byvar == 0 values
		local controlmean: di %7.3f `r(mu_1)'
		local 	controlsd: di %7.3f `r(sd_1)'
				
		* Store byvar == 1 values
		local treatmean: di %7.3f `r(mu_2)'
		local 	treatsd:  di %7.3f `r(sd_2)'	

		* Store pvalue for clustered data **********************
		reg `var' `byvar_exp1', vce(cluster school_id)
		test `byvar_exp1'
		local pvalue: di %7.3f `r(p)'	
		********************************************************	
		
		* Standard difference
		gen stand_diff = (`treatmean'-`controlmean')/ (sqrt((`treatsd'^2)+(`controlsd'^2)))
		sum stand_diff
		local stand_diff: di %7.3f `r(mean)'
		
		sum `var' 
		local totalmean: di %7.3f `r(mean)'	
		local 	totalsd: di %7.3f `r(sd)'
		
		count if `byvar_exp1'==1 
		local treat: di %7.0fc `r(N)'

		count if `byvar_exp1'==0 
		local control: di %7.0fc `r(N)'
		
		count if !mi(`var')
		local total: di %7.0g `r(N)'

		file write sumstat "`varlab' & `totalmean' &  `controlmean' & `treatmean' & `pvalue' & `stand_diff'  \\ " _n  
		file write sumstat "  		 &  (`totalsd') &  (`controlsd')  & (`treatsd') &   &   \\     " _n 
		
		drop stand_diff
		
		local ++i

		}
	
	file write sumstat "\midrule " _n 
	file write sumstat "Observations & `total' & `control' & `treat' &   & \\   " _n 
	file write sumstat "\bottomrule" _n           
	
	* Create header for experiment 2
	file write sumstat "\multicolumn{6}{l}{\textbf{Panel B: Teachers in the Online Experiment}}\\  " _n
	file write sumstat 	"\midrule " _n 
	file write sumstat	"  & (1) & (2) & (3) & (4) & (5) \\  " _n 
	file write sumstat	"  & Full sample & `byvar0_exp2' & `byvar1_exp2' & p-value & Norm. Diff. \\  " _n
	file write sumstat 	"\midrule " _n 
	***
	
	* LOAD DATASET FOR EXPERIMENT 2
	use  "$data_final/AlesinaCarlanaLaFerraraPinotti_onlineexperiment.dta", replace
	
	* Restrict sample *****************
	duplicates drop teacher_id,force
	keep if student_id!=""
	keep if IAT!=.
	***********************************
	
	drop wvs // generate a new version of wvs
	gen wvs=(m_Q21_jobs_scarsity==1|m_Q21_jobs_scarsity)
	lab var wvs 						"WVS Immigrants' Rights to Job"
	
	* Label for exporting
	lab var female_teacher 				"Female"
	lab var regionborn_3 				"Born in the North"
	lab var Q04_teaching_years 			"Experience"
	lab var Math_Science 				"Teaching Math"
	lab var Italian_History_Geography 	"Teaching Italian"
	lab var IAT 						"IAT"

local i=1

	foreach var in `varlist_exp2' {
		
		cap drop stand_diff
		
		di "Calculating stats for variable: `var'"
		
		* Store label
		local varlab: variable label `var'  
		
		* Ttest
		ttest `var', by(`byvar_exp2')
				
		* Store byvar == 0 values
		local controlmean: di %7.3f `r(mu_1)'
		local 	controlsd: di %7.3f `r(sd_1)'
				
		* Store byvar == 1 values
		local treatmean: di %7.3f `r(mu_2)'
		local 	treatsd:  di %7.3f `r(sd_2)'	

		* Store pvalue for clustered data **********************
		reg `var' `byvar_exp2', vce(cluster school_code)
		test `byvar_exp2'
		local pvalue: di %7.3f `r(p)'	
		********************************************************	
		
		* Standard difference
		gen stand_diff = (`treatmean'-`controlmean')/ (sqrt((`treatsd'^2)+(`controlsd'^2)))
		sum stand_diff
		local stand_diff: di %7.3f `r(mean)'
		
		sum `var' 
		local totalmean: di %7.3f `r(mean)'	
		local 	totalsd: di %7.3f `r(sd)'
		
		count if `byvar_exp2'==1 
		local treat: di %7.0fc `r(N)'

		count if `byvar_exp2'==0 
		local control: di %7.0fc `r(N)'
		
		count if !mi(`var')
		local total: di %7.0g `r(N)'

		file write sumstat "`varlab' & `totalmean' &  `controlmean' & `treatmean' & `pvalue' & `stand_diff'  \\ " _n  
		file write sumstat "  		 &  (`totalsd') &  (`controlsd')  & (`treatsd') &   &   \\     " _n 
		
		drop stand_diff
		
		local ++i

		}
	
	file write sumstat "\midrule " _n 
	file write sumstat "Observations & `total' & `control' & `treat' &   & \\   " _n 
	file write sumstat "\bottomrule" _n           // table footer
	file write sumstat "\end{tabular}" _n

	file close sumstat

restore

** -----------------------------------------------------------------------------
**# Table 2: Correlation between teachers characteristics and IAT
** -----------------------------------------------------------------------------

***** EXPERIMENT 1

	use "$data_final/AlesinaCarlanaLaFerraraPinotti_fieldexperiment_teachers.dta",clear

	cap file close soutput
	
	file open soutput using "$tables/T2Correlation_iat_characteristics_v2.tex", write replace
	file write soutput "\begin{tabular}{lcccccccc}  \\ \hline "  _n
    file write soutput "& (1) & (2) & (3) & (4) & (5) & (6) & (7) & (8) \\  \hline " _n
	file write soutput "\multicolumn{9}{l}{\textbf{Panel A. Dependent Variable: IAT Score (stereotypes against immigrants) in Field Experiment}} \\  \hline "
	file write soutput "\midrule"  _n
	
	local i = 1
	
	* 1) 
	xi:reg d_score_race female $order_iat,  cluster(mecc_code_plesse)
	
	local beta_`i'  = _b[female]
	local sigma_`i' = _se[female]
	local beta_`i' : di %8.3f `beta_`i''
	local sigma_`i' : di %8.3f `sigma_`i''
	local N`i' =  e(N)
	local R`i' = e(r2) 
	local R`i' : di %8.3f `R`i''
	matrix rtable = r(table)
	local pvalue  = rtable[4,1]  
		local star`i' = ""
		if `pvalue' < 0.1 local star`i'= "*" 
		if `pvalue' < 0.05 local star`i' = "**" 
		if `pvalue' < 0.01 local star`i' = "***" 
	
	* 2)
	xi:reg d_score_race t_N  $order_iat,  cluster(mecc_code_plesse)
	
	local ++i
	local beta_`i'  = _b[t_N]
	local sigma_`i' = _se[t_N]
	local beta_`i' : di %8.3f `beta_`i''
	local sigma_`i' : di %8.3f `sigma_`i''
	local N`i' =  e(N)
	local R`i' = e(r2) 
