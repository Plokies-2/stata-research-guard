		local N = `r(ndistinct)'
		sum `e(depvar)' if e(sample)
		local mean = `r(mean)'
		distinct mkt_5km if e(sample) == 1
		local N2 = `r(ndistinct)'
		$out adds(# of Schools, `N', # of markets, `N2', Mean Dep Var, `mean', pvalue a + b = 0, `pval') addtext(Year FE, Yes, School FE, Yes, School Market-Year , Yes) ctitle("5km")
		
	reghdfe SDall_fe_prin_2wayfe PostChangePpal_ADP PostChangePpal if t>=-4 & t <= 3 & year >= 2009 & year <= 2016 & sample == 1, a(year rbd i.mkt_6km#i.year)  vce(cluster rbd)
		test _b[PostChangePpal_ADP] + _b[PostChangePpal] = 0
		local pval = `r(p)'
		distinct rbd if e(sample) == 1
		local N = `r(ndistinct)'
		sum `e(depvar)' if e(sample)
		local mean = `r(mean)'
		distinct mkt_6km if e(sample) == 1
		local N2 = `r(ndistinct)'
		$out adds(# of Schools, `N', # of markets, `N2', Mean Dep Var, `mean', pvalue a + b = 0, `pval') addtext(Year FE, Yes, School FE, Yes, School Market-Year , Yes) ctitle("6km")
		
	reghdfe SDall_fe_prin_2wayfe PostChangePpal_ADP PostChangePpal if t>=-4 & t <= 3 & year >= 2009 & year <= 2016 & sample == 1, a(year rbd i.mkt_7km#i.year)  vce(cluster rbd)
		test _b[PostChangePpal_ADP] + _b[PostChangePpal] = 0
		local pval = `r(p)'
		distinct rbd if e(sample) == 1
		local N = `r(ndistinct)'
		sum `e(depvar)' if e(sample)
		local mean = `r(mean)'
		distinct mkt_7km if e(sample) == 1
		local N2 = `r(ndistinct)'
		$out adds(# of Schools, `N', # of markets, `N2', Mean Dep Var, `mean', pvalue a + b = 0, `pval') addtext(Year FE, Yes, School FE, Yes, School Market-Year , Yes) ctitle("7km")		
}	

********************
*** Table A.11: Principal Selection, GPA, and School Attendance
********************	
{	
