
// Controls	
	global Xs "ShPoor_11 matricula_total_11 prom_lect4b_rbd_11 prom_mate4b_rbd_11"
	global Xm "hm_extpoor_rate_11 h_ypchtot_11 unempl_rate_11 esc_11 literacy_rate_11"
		
*******************
** Table 2: Principal Selection and Principal Effectiveness	
*******************	
{	
	* Load dataset
	use "Data/clean/DataForRegressionsADP.dta", clear
		
	global out outreg2 using "Tables/Table2",  label tex(frag) bdec(3) sdec(3) keep(PostChangePpal_ADP PostChangePpal) nocons nonotes 	
		
	* Baseline
	local append replace
	reghdfe SDall_fe_prin_2wayfe PostChangePpal_ADP PostChangePpal if t>=-4 & t <= 3 & year >= 2009 & year <= 2016 & sample == 1, a(year rbd )  vce(cluster rbd)
		test _b[PostChangePpal_ADP] + _b[PostChangePpal] = 0
		local pval = `r(p)'
		distinct rbd if e(sample) == 1
		local N = `r(ndistinct)'
		sum `e(depvar)' if e(sample)
		local mean = `r(mean)'		 
		$out `append' adds(# of Schools, `N', Mean Dep Var, `mean', pvalue a + b = 0, `pval') addtext(Year FE, Yes, School FE, Yes, School controls, No, Municipality controls, No) 		
		local append append

	* Add School controls
	reghdfe SDall_fe_prin_2wayfe PostChangePpal_ADP PostChangePpal if t>=-4 & t <= 3 & year >= 2009 & year <= 2016 & sample == 1, a(c.($Xs)#year year rbd)  vce(cluster rbd)
		test _b[PostChangePpal_ADP] + _b[PostChangePpal] = 0
		local pval = `r(p)'
		distinct rbd if e(sample) == 1
		local N = `r(ndistinct)'
		sum `e(depvar)' if e(sample)
		local mean = `r(mean)'
		$out `append' adds(# of Schools, `N', Mean Dep Var, `mean', pvalue a + b = 0, `pval') addtext(Year FE, Yes, School FE, Yes, School controls, Yes, Municipality controls, No) 		
			
	* Add Municipality controls 
	reghdfe SDall_fe_prin_2wayfe PostChangePpal_ADP PostChangePpal if t>=-4 & t <= 3 & year >= 2009 & year <= 2016 & sample == 1, a(c.($Xm)#year year rbd)  vce(cluster rbd)
		test _b[PostChangePpal_ADP] + _b[PostChangePpal] = 0
		local pval = `r(p)'
		distinct rbd if e(sample) == 1
		local N = `r(ndistinct)'
		sum `e(depvar)' if e(sample)
		local mean = `r(mean)'
		$out `append' adds(# of Schools, `N', Mean Dep Var, `mean', pvalue a + b = 0, `pval') addtext(Year FE, Yes, School FE, Yes, School controls, No, Municipality controls, Yes)
		
	* Add Municipality and School controls 
	reghdfe SDall_fe_prin_2wayfe PostChangePpal_ADP PostChangePpal if t>=-4 & t <= 3 & year >= 2009 & year <= 2016 & sample == 1, a(c.($Xm $Xs)#year year rbd)  vce(cluster rbd)
		test _b[PostChangePpal_ADP] + _b[PostChangePpal] = 0
		local pval = `r(p)'
		distinct rbd if e(sample) == 1
		local N = `r(ndistinct)'
		sum `e(depvar)' if e(sample)
		local mean = `r(mean)'
		$out `append' adds(# of Schools, `N', Mean Dep Var, `mean', pvalue a + b = 0, `pval') addtext(Year FE, Yes, School FE, Yes, School controls, Yes, Municipality controls, Yes)
		
	* Increasing overlap
	reghdfe SDall_fe_prin_2wayfe PostChangePpal_ADP PostChangePpal if t>=-4 & t <= 3 & year >= 2009 & year <= 2016 & sample == 1 & pscore > 0.082 & pscore < 0.918, a(year rbd)  vce(cluster rbd)
		test _b[PostChangePpal_ADP] + _b[PostChangePpal] = 0
		local pval = `r(p)'
		distinct rbd if e(sample) == 1
		local N = `r(ndistinct)'
		sum `e(depvar)' if e(sample)
		local mean = `r(mean)'
		$out `append' adds(# of Schools, `N', Mean Dep Var, `mean', pvalue a + b = 0, `pval') addtext(Year FE, Yes, School FE, Yes, School controls, No, Municipality controls, No)
		
	* Only Public
	reghdfe SDall_fe_prin_2wayfe PostChangePpal_ADP if t>=-4 & t <= 3 & year >= 2009 & year <= 2016 & Dmun == 1, a(year rbd)  vce(cluster rbd)
		distinct rbd if e(sample) == 1
		local N = `r(ndistinct)'
		sum `var' if e(sample)
		local mean = `r(mean)'
		$out `append' adds(# of Schools, `N', Mean Dep Var, `mean') addtext(Year FE, Yes, School FE, Yes, School controls, No, Municipality controls, No)
						
	* Only Public: PLACEBO
	rename PostChangePpal aux
	rename PostChangePpal_pre PostChangePpal
	reghdfe SDall_fe_prin_2wayfe PostChangePpal if t_pla_pre>=-4 & t_pla_pre <= 3 & year >= 2009 & year <= 2012 & Dmun == 1 , a(year rbd)  vce(cluster rbd)
		distinct rbd if e(sample) == 1
		local N = `r(ndistinct)'
		sum `e(depvar)' if e(sample)
		local mean = `r(mean)'
		codebook rbd if e(sample) == 1 & PostChangePpal == 1
		$out `append' adds(# of Schools, `N', Mean Dep Var, `mean') addtext(Year FE, Yes, School FE, Yes, School controls, No, Municipality controls, No)
	rename PostChangePpal PostChangePpal_pre 
	rename aux PostChangePpal 
		
	* Only Private
	reghdfe SDall_fe_prin_2wayfe PostChangePpal if t>=-4 & t <= 3 & year >= 2009 & year <= 2016 & Dmun == 0, a(year rbd)  vce(cluster rbd)
		distinct rbd if e(sample) == 1
		local N = `r(ndistinct)'
		sum `e(depvar)' if e(sample)
		local mean = `r(mean)'
		codebook rbd if e(sample) == 1 & PostChangePpal == 1
		$out `append' adds(# of Schools, `N', Mean Dep Var, `mean') addtext(Year FE, Yes, School FE, Yes, School controls, No, Municipality controls, No)
	
	***** Columns 7: Need to add them by hand 
	use "Data/clean/Base_ADPAnalysis.dta", clear
	
	keep cod_com_rbd rbd year SDall_fe_prin_2wayfe rbd year adp
		
	keep if year >= 2009 & year <= 2016	
			
	twowayfeweights SDall_fe_prin_2wayfe rbd year adp,  type(feTR)
	di 265/3694 	
				
	local w = 3
	local w1 = 3	
	did_multiplegt SDall_fe_prin_2wayfe rbd year adp, placebo(`w1') breps(20) robust_dynamic dynamic(`w') cluster(rbd)	jointtestplacebo covariances seed(1111001) average_effect

	** Values in the table
	g avg = e(effect_average)
	g se_avg = `e(se_effect_average)'
	g tstat_avg = avg / se_avg
	sum avg tstat_avg se_avg
		
	***** Columns 8: Need to add them by hand from R code CallawayAndSantAna.R
	/*
	Outcome from the R code:	
	Overall summary of ATT's based on event-study/dynamic aggregation:  
    ATT    Std. Error    
	0.0399        0.0228 
	*/
}	


*******************	
** Table 3: Principal Selection and Principal Effectiveness: Other measures	
*******************	
{	
	* Load dataset
	use "Data/clean/DataForRegressionsADP.dta", clear
	
	global out outreg2 using "Tables/Table_3",  label tex(frag) bdec(3) sdec(3) keep(PostChangePpal_ADP PostChangePpal) nonotes 
		
	reghdfe SDall_fe_prin_attendance PostChangePpal_ADP PostChangePpal if t>=-4 & t <= 3 & year >= 2009 & year <= 2016 & sample == 1, a(year rbd)  vce(cluster rbd)
		test _b[PostChangePpal_ADP] + _b[PostChangePpal] = 0
		local pval = `r(p)'
		distinct rbd if e(sample) == 1
		local N = `r(ndistinct)'
		sum `e(depvar)' if e(sample)
		local mean = `r(mean)'
		$out adds(# of Schools, `N', Mean Dep Var, `mean', pvalue a + b = 0, `pval') nocons addtext(Year FE, Yes, School FE, Yes) replace

	reghdfe SDall_fe_prin_testcre PostChangePpal_ADP PostChangePpal if t>=-4 & t <= 3 & year >= 2009 & year <= 2016 & sample == 1, a(year rbd)  vce(cluster rbd)
		test _b[PostChangePpal_ADP] + _b[PostChangePpal] = 0
		local pval = `r(p)'
		distinct rbd if e(sample) == 1
		local N = `r(ndistinct)'
