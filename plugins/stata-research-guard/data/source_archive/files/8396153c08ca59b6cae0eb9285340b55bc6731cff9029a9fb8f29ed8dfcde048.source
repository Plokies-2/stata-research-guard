		local mean = `r(mean)'
		distinct mkt_4km if e(sample) == 1
		local N2 = `r(ndistinct)'
		$out adds(# of Schools, `N', # of markets, `N2', Mean Dep Var, `mean', pvalue a + b = 0, `pval') addtext(Year FE, Yes, School FE, Yes, School Market-Year , Yes) ctitle("4km")	
		
	reghdfe SDall_fe_prin_2wayfe PostChangePpal_ADP PostChangePpal if t>=-4 & t <= 3 & year >= 2009 & year <= 2016 & sample == 1, a(year rbd i.mkt_5km#i.year)  vce(cluster rbd)
		test _b[PostChangePpal_ADP] + _b[PostChangePpal] = 0
