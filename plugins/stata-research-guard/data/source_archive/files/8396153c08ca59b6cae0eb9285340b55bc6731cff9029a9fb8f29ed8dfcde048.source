*******************	
*** Table 5: Principal Selection and School Staff	
*******************	
{
	* Load dataset
	use "Data/clean/DataForRegressionsADP.dta", clear
	
	global out outreg2 using "Tables/Table_5",  label tex(frag) bdec(3) sdec(3) keep(PostChangePpal_ADP PostChangePpal) nocons nonotes addtext(Year FE, Yes, School FE, Yes, School controls, Yes, Municipality controls, Yes)  
	
	global MainTeacher "Dfired_sup_20501 Dhired_sup_20501 Dfired_teach DFhired_teach Dfired_teach_bad DFhired_teach_bad"
		
	local replace replace
	foreach var in $MainTeacher {
		reghdfe `var' PostChangePpal_ADP PostChangePpal if t>=-4 & t <= 3 & year >= 2009 & year <= 2016 & sample == 1, a(c.($Xm $Xs)#year year rbd )  vce(cluster rbd)
			test _b[PostChangePpal_ADP] + _b[PostChangePpal] = 0
			local pval = `r(p)'
			distinct rbd if e(sample) == 1
			local N = `r(ndistinct)'
			sum `var' if e(sample)
			local mean = `r(mean)'
			$out `replace' adds(# of Schools, `N', Mean Dep Var, `mean', pvalue a + b = 0, `pval')
			local replace append	
	}	
}	



