**********************
*** Table A.2: Manager Effectiveness and Observable Characteristics
**********************
{
	use "Data/clean/ADPREG_TEMP.dta", clear
	
	gen Edad2=Edad*Edad
	
	label var Edad 					"Age"
	label var Edad2 				"Age2"
	label var Female 				"Female"
	label var Perm  				"Perm. Contract"
	label var Hours 				"Hours Contract"
	label var CollegeDegree			"College Degree"
	label var EverTeacher 			"Ever Teacher"
	label var EverSupportWorker 	"Ever Admin. Supp. Worker"
	label var EverAdministrative 	"Ever Admin Worker"
	
	global out outreg2 using "Tables/Table_A_2", label tex(frag) bdec(3) sdec(3) nocons nonotes 
	
	reghdfe SDall_fe_prin_2wayfe Edad Edad2 Female Perm Hours CollegeDegree, a(cod_com_rbd year)
	distinct rbd if e(sample) == 1
	local N = `r(ndistinct)'
	sum SDall_fe_prin_2wayfe if e(sample)
	local mean = `r(mean)'
	$out replace adds(# of Schools, `N', Mean Dep Var, `mean') 
	
	reghdfe SDall_fe_prin_2wayfe Edad Edad2 Female Perm Hours CollegeDegree EverTeacher EverSupportWorker EverAdministrative, a(cod_com_rbd year)
	distinct rbd if e(sample) == 1
	local N = `r(ndistinct)'
	sum SDall_fe_prin_2wayfe if e(sample)
	local mean = `r(mean)'
	distinct rbd if e(sample) == 1
	local N = `r(ndistinct)'
	sum SDall_fe_prin_2wayfe if e(sample)
	local mean = `r(mean)'
	$out append adds(# of Schools, `N', Mean Dep Var, `mean') 
	
	reghdfe SDall_fe_prin_2wayfe Edad Edad2 Female Perm Hours CollegeDegree EverTeacher EverSupportWorker EverAdministrative if Public==1, a(cod_com_rbd year)
	distinct rbd if e(sample) == 1
	local N = `r(ndistinct)'
	sum SDall_fe_prin_2wayfe if e(sample)
	local mean = `r(mean)'
	distinct rbd if e(sample) == 1
	local N = `r(ndistinct)'
	sum SDall_fe_prin_2wayfe if e(sample)
	local mean = `r(mean)'
	$out append adds(# of Schools, `N', Mean Dep Var, `mean') 

	reghdfe SDall_fe_prin_2wayfe Edad Edad2 Female Perm Hours CollegeDegree EverTeacher EverSupportWorker EverAdministrative if Public==0, a(cod_com_rbd year)
	distinct rbd if e(sample) == 1
	local N = `r(ndistinct)'
	sum SDall_fe_prin_2wayfe if e(sample)
	local mean = `r(mean)'
	distinct rbd if e(sample) == 1
	local N = `r(ndistinct)'
	sum SDall_fe_prin_2wayfe if e(sample)
	local mean = `r(mean)'
	$out append adds(# of Schools, `N', Mean Dep Var, `mean') 
	
}

**********************
*** Table A.6: Principal Selection and Principal Effectiveness: Weighted least squares		
**********************
{		
	* Load dataset	
	use "Data/clean/DataForRegressionsADP.dta", clear
	g se_fe_prin = sqrt(se2_fe_prin)
	g wt = 1/se_fe_prin
	
	global out outreg2 using "Tables/Table_A_6",  label tex(frag) bdec(3) sdec(3) nocons nonotes keep(PostChangePpal_ADP PostChangePpal) 
	
	local append replace
	* SDall_fe_prin_2wayfe SDall_fe_prin_2wayfe_nonadj
	reghdfe SDall_fe_prin_2wayfe PostChangePpal_ADP PostChangePpal if t>=-4 & t <= 3 & year >= 2009 & year <= 2016 & sample == 1 [aw=wt], a(year rbd )  vce(cluster rbd)
		test _b[PostChangePpal_ADP] + _b[PostChangePpal] = 0
		local pval = `r(p)'
		distinct rbd if e(sample) == 1
		local N = `r(ndistinct)'
		sum `e(depvar)' if e(sample)
		local mean = `r(mean)'
		$out `append' adds(# of Schools, `N', Mean Dep Var, `mean', pvalue a + b = 0, `pval')  addtext(Year FE, Yes, School FE, Yes, School controls, No, Municipality controls, No)  
		local append append

	* Add School controls
	reghdfe SDall_fe_prin_2wayfe PostChangePpal_ADP PostChangePpal if t>=-4 & t <= 3 & year >= 2009 & year <= 2016 & sample == 1 [aw=wt], a(c.($Xs)#year year rbd)  vce(cluster rbd)
		test _b[PostChangePpal_ADP] + _b[PostChangePpal] = 0
		local pval = `r(p)'
		distinct rbd if e(sample) == 1
		local N = `r(ndistinct)'
		sum `e(depvar)' if e(sample)
		local mean = `r(mean)'
		$out `append' adds(# of Schools, `N', Mean Dep Var, `mean', pvalue a + b = 0, `pval') addtext(Year FE, Yes, School FE, Yes, School controls, Yes, Municipality controls, No) 
	
	* Add Municipality controls 
	reghdfe SDall_fe_prin_2wayfe PostChangePpal_ADP PostChangePpal if t>=-4 & t <= 3 & year >= 2009 & year <= 2016 & sample == 1 [aw=wt], a(c.($Xm)#year year rbd)  vce(cluster rbd)
		test _b[PostChangePpal_ADP] + _b[PostChangePpal] = 0
		local pval = `r(p)'
		distinct rbd if e(sample) == 1
		local N = `r(ndistinct)'
		sum `e(depvar)' if e(sample)
		local mean = `r(mean)'
		$out `append' adds(# of Schools, `N', Mean Dep Var, `mean', pvalue a + b = 0, `pval') addtext(Year FE, Yes, School FE, Yes, School controls, No, Municipality controls, Yes)  
		
	* Add Municipality and School controls 
	reghdfe SDall_fe_prin_2wayfe PostChangePpal_ADP PostChangePpal if t>=-4 & t <= 3 & year >= 2009 & year <= 2016 & sample == 1 [aw=wt], a(c.($Xm $Xs)#year year rbd)  vce(cluster rbd)
		test _b[PostChangePpal_ADP] + _b[PostChangePpal] = 0
		local pval = `r(p)'
		distinct rbd if e(sample) == 1
		local N = `r(ndistinct)'
		sum `e(depvar)' if e(sample)
		local mean = `r(mean)'
		$out `append' adds(# of Schools, `N', Mean Dep Var, `mean', pvalue a + b = 0, `pval') addtext(Year FE, Yes, School FE, Yes, School controls, Yes, Municipality controls, Yes) 
}	
		
**********************
*** Table A.7: Principal Selection and Principal Effectiveness by Rurality
**********************
{	
	* Load dataset	
	use	"Data/clean/DataForRegressionsADP.dta", clear
			
	*** Panel A: Based on school status
	global out outreg2 using "Tables/Table_A_7_A", label tex(frag) bdec(3) sdec(3) keep(PostChangePpal_ADP PostChangePpal)  nonotes 	
	
	reghdfe SDall_fe_prin_2wayfe PostChangePpal_ADP PostChangePpal if rural_rbd == 1 & t>=-4 & t <= 3 & year >= 2009 & year <= 2016 & sample == 1, a(year rbd)  vce(cluster rbd)
		test _b[PostChangePpal_ADP] + _b[PostChangePpal] = 0
		local pval = `r(p)'
		distinct rbd if e(sample) == 1
		local N = `r(ndistinct)'
		sum SDall_fe_prin_2wayfe if e(sample)
		local mean = `r(mean)'
		$out replace adds(# of Schools, `N', Mean Dep Var, `mean', pvalue a + b = 0, `pval')  addtext(Year FE, Yes, School FE, Yes) ctitle("Rural")
	
	reghdfe SDall_fe_prin_2wayfe PostChangePpal_ADP PostChangePpal if rural_rbd == 0 & t>=-4 & t <= 3 & year >= 2009 & year <= 2016 & sample == 1, a(year rbd)  vce(cluster rbd)
		test _b[PostChangePpal_ADP] + _b[PostChangePpal] = 0
		local pval = `r(p)'
		distinct rbd if e(sample) == 1
		local N = `r(ndistinct)'
		sum SDall_fe_prin_2wayfe if e(sample)
		local mean = `r(mean)'
		$out append adds(# of Schools, `N', Mean Dep Var, `mean', pvalue a + b = 0, `pval')  addtext(Year FE, Yes, School FE, Yes) ctitle("Urban")
	
	* pvalue difference: column 1-2 panel A, Take the value for the PostChangePpal_ADP_rural coefficient
	g PostChangePpal_ADP_rural = PostChangePpal_ADP * rural_rbd
	g PostChangePpal_rural = PostChangePpal * rural_rbd
	
	reghdfe SDall_fe_prin_2wayfe PostChangePpal_ADP_rural PostChangePpal_ADP PostChangePpal PostChangePpal_rural if  t>=-4 & t <= 3 & year >= 2009 & year <= 2016 & sample == 1, a(year#i.rural_rbd rbd)  vce(cluster rbd)

	
	* Only Public
	reghdfe SDall_fe_prin_2wayfe PostChangePpal_ADP if rural_rbd == 1 & t>=-4 & t <= 3 & year >= 2009 & year <= 2016 & Dmun == 1, a(year rbd)  vce(cluster rbd)
		distinct rbd if e(sample) == 1
		local N = `r(ndistinct)'
		sum SDall_fe_prin_2wayfe if e(sample)
		local mean = `r(mean)'
		$out append adds(# of Schools, `N', Mean Dep Var, `mean', pvalue a + b = 0, `pval')  addtext(Year FE, Yes, School FE, Yes) ctitle("Rural")
				
	reghdfe SDall_fe_prin_2wayfe PostChangePpal_ADP if rural_rbd == 0 & t>=-4 & t <= 3 & year >= 2009 & year <= 2016 & Dmun == 1, a(year rbd)  vce(cluster rbd)
		distinct rbd if e(sample) == 1
		local N = `r(ndistinct)'
		sum SDall_fe_prin_2wayfe if e(sample)
		local mean = `r(mean)'
		$out append adds(# of Schools, `N', Mean Dep Var, `mean', pvalue a + b = 0, `pval')  addtext(Year FE, Yes, School FE, Yes) ctitle("Urban")
	
	* pvalue difference: column 3-4 panel A, Take the value for the PostChangePpal_ADP_rural coefficient
	reghdfe SDall_fe_prin_2wayfe PostChangePpal_ADP_rural PostChangePpal_ADP if  t>=-4 & t <= 3 & year >= 2009 & year <= 2016 & Dmun == 1, a(year#i.rural_rbd rbd)  vce(cluster rbd)	
	
	
	
	*** PANEL B: Based on municipality characteristic
	global out outreg2 using "Tables/Table_A_7_B",  label tex(frag) bdec(3) sdec(3) keep(PostChangePpal_ADP PostChangePpal)  nonotes 	
	
	reghdfe SDall_fe_prin_2wayfe PostChangePpal_ADP PostChangePpal if Rural_p50 == 1 & t>=-4 & t <= 3 & year >= 2009 & year <= 2016 & sample == 1, a(year rbd)  vce(cluster rbd)
		test _b[PostChangePpal_ADP] + _b[PostChangePpal] = 0
		local pval = `r(p)'
		distinct rbd if e(sample) == 1
		local N = `r(ndistinct)'
		sum SDall_fe_prin_2wayfe if e(sample)
		local mean = `r(mean)'
		$out replace adds(# of Schools, `N', Mean Dep Var, `mean', pvalue a + b = 0, `pval')  addtext(Year FE, Yes, School FE, Yes) ctitle("Rural")
	
	reghdfe SDall_fe_prin_2wayfe PostChangePpal_ADP PostChangePpal if Rural_p50 == 0 & t>=-4 & t <= 3 & year >= 2009 & year <= 2016 & sample == 1, a(year rbd)  vce(cluster rbd)
		test _b[PostChangePpal_ADP] + _b[PostChangePpal] = 0
		local pval = `r(p)'
		distinct rbd if e(sample) == 1
		local N = `r(ndistinct)'
		sum SDall_fe_prin_2wayfe if e(sample)
		local mean = `r(mean)'
		$out append adds(# of Schools, `N', Mean Dep Var, `mean', pvalue a + b = 0, `pval')  addtext(Year FE, Yes, School FE, Yes) ctitle("Urban")
	
	* pvalue difference: column 1-2 panel B, Take the value for the PostChangePpal_ADP_rural coefficient
	cap drop PostChangePpal_ADP_rural
	cap drop PostChangePpal_rural
	g PostChangePpal_ADP_rural = PostChangePpal_ADP * Rural_p50
	g PostChangePpal_rural = PostChangePpal * Rural_p50
	
	reghdfe SDall_fe_prin_2wayfe PostChangePpal_ADP_rural PostChangePpal_ADP PostChangePpal_rural PostChangePpal if t>=-4 & t <= 3 & year >= 2009 & year <= 2016 , a(year#i.Rural_p50 rbd)  vce(cluster rbd)
	
	* Only Public
	reghdfe SDall_fe_prin_2wayfe PostChangePpal_ADP if Rural_p50 == 1 & t>=-4 & t <= 3 & year >= 2009 & year <= 2016 & Dmun == 1, a(year rbd)  vce(cluster rbd)
		distinct rbd if e(sample) == 1
		local N = `r(ndistinct)'
		sum SDall_fe_prin_2wayfe if e(sample)
		local mean = `r(mean)'
		$out append adds(# of Schools, `N', Mean Dep Var, `mean', pvalue a + b = 0, `pval')  addtext(Year FE, Yes, School FE, Yes) ctitle("Rural")

	reghdfe SDall_fe_prin_2wayfe PostChangePpal_ADP if Rural_p50 == 0 & t>=-4 & t <= 3 & year >= 2009 & year <= 2016 & Dmun == 1, a(year rbd)  vce(cluster rbd)
		distinct rbd if e(sample) == 1
		local N = `r(ndistinct)'
		sum SDall_fe_prin_2wayfe if e(sample)
		local mean = `r(mean)'
		$out append adds(# of Schools, `N', Mean Dep Var, `mean', pvalue a + b = 0, `pval')  addtext(Year FE, Yes, School FE, Yes) ctitle("Urban")
	
	* pvalue difference: column 3-4 panel B, Take the value for the PostChangePpal_ADP_rural coefficient
	reghdfe SDall_fe_prin_2wayfe PostChangePpal_ADP_rural PostChangePpal_ADP if t>=-4 & t <= 3 & year >= 2009 & year <= 2016 & Dmun == 1, a(year#i.Rural_p50 rbd)  vce(cluster rbd)	
}
	
**********************
*** Table A.8: School and Municipality Characteristics, by ADP Adoption 
**********************
{
	use "Data/clean/Base_ADPAnalysis.dta", clear
		
	global Xs "ShPoor_11 matricula_total_11 prom_lect4b_rbd_11 prom_mate4b_rbd_11"
	global Xm "hm_extpoor_rate_11 h_ypchtot_11 unempl_rate_11 esc_11 literacy_rate_11"
	
	xtset rbd year
	foreach k in matricula_total liquido_pago_student rural_rbd  porc_conc_DatosAbiertos ///
				prom_lect4b_rbd prom_mate4b_rbd PSU_leng PSU_mat{
		gen Del`k' = d.`k'			
	}
	
	gen ADP2014_post = (min_adp > 2013 )
	replace ADP2014_post = . if EverADP == 0
		
	* Columns 1 to 6	
	balancetable (mean if EverADP == 0) (mean if EverADP == 1) (diff EverADP)  (mean if ADP2014_post == 0) (mean if ADP2014_post == 1) (diff ADP2014_post if ADP2014_post != .) ///
				matricula_total Delmatricula_total rural_rbd liquido_pago_student Delliquido_pago_student   ///
				porc_conc_DatosAbiertos Delporc_conc_DatosAbiertos prom_lect4b_rbd Delprom_lect4b_rbd ///
				prom_mate4b_rbd Delprom_mate4b_rbd PSU_leng DelPSU_leng PSU_mat	DelPSU_mat ///   
				if year==2011  using "Tables/Table_A_8_A.tex", replace varla pval ctitles("Never ADP" "Ever ADP" "Difference" "Early ADP" "Later ADP" "Difference") 

	balancetable (mean if EverADP == 0) (mean if EverADP == 1) (diff EverADP)  (mean if ADP2014_post == 0) (mean if ADP2014_post == 1) (diff ADP2014_post if ADP2014_post != .) ///
				hm_extpoor_rate h_ypchtot unempl_rate esc  ///
				if year==2011  using "Tables/Table_A_8_B.tex", replace varla pval ctitles("Never ADP" "Ever ADP" "Difference" "Early ADP" "Later ADP" "Difference") 
				
	* Column 7 
	use "Data/clean/DataForRegressionsADP.dta", clear
	
	xtset rbd year
	foreach k in matricula_total liquido_pago_student rural_rbd  porc_conc_DatosAbiertos ///
				prom_lect4b_rbd prom_mate4b_rbd  PSU_leng PSU_mat {
		g Del`k' = d.`k'			
	}
	sum matricula_total Delmatricula_total rural_rbd liquido_pago_student Delliquido_pago_student   ///
		porc_conc_DatosAbiertos Delporc_conc_DatosAbiertos prom_lect4b_rbd Delprom_lect4b_rbd ///
		prom_mate4b_rbd Delprom_mate4b_rbd PSU_leng DelPSU_leng PSU_mat	DelPSU_mat ///  
		if Dmun == 0 & year == 2011	
		
	sum hm_extpoor_rate h_ypchtot unempl_rate esc if Dmun == 0	& year == 2011
	
	codebook rbd if  Dmun == 0	& year == 2011
	
}

	
**********************
*** Table A.9: Principal Selection and Principal Effectiveness: Placebos
**********************
{
	/*
	Observations: The number of observations in columns 1 and 2 in this table 
		are the same as the in Table column 9, and for columns 3 and 4 the number 
		of observations are the ones from column 10 of Table 2.	
	*/
	
	* Column 1	
	****** DATASET: Keep public
	use "Data/clean/Base_ADPAnalysis.dta", clear
	
	* Placebo treatment	
	rename PostChangePpal PostChangePpal_pre
	rename t_pla t_pla_pre
	rename MinYearPpalChange MinYearPpalChange_pre
		
	keep if t_pla_pre>=-4 & t_pla_pre <= 3 & year >= 2009 & year <= 2012 & Dmun == 1
	drop min_adp	
	g min_adp = year if t_pla_pre == 0
	spread min_adp, by(rbd)
	
	keep SDall_fe_prin_2wayfe PostChangePpal_pre rbd year min_adp
	
	twowayfeweights SDall_fe_prin_2wayfe rbd year PostChangePpal_pre,  type(feTR)
	di 192/555
	* Sum of negative weights  -.01237145
		
	local w = 1
	local w1 = 1
	did_multiplegt SDall_fe_prin_2wayfe rbd year PostChangePpal_pre, placebo(`w1') breps(20) robust_dynamic dynamic(`w') cluster(rbd) covariances seed(1111001) average_effect
	
	* Column 2: See R code CallawayAndSantAna.R
	/*
	Overall summary of ATT's based on event-study/dynamic aggregation:  
    ATT    Std. Error    
	0.0213        0.1097    
	*/
	
		
	* Column 3	
	****** DATASET: Keep private	
	use "Data/clean/ADPREG_TEMP.dta", clear	
	
	keep if Dmun == 0

	xtset rbd year
	g change_ppal = 1 if id_prin != l.id_prin
	g YearPpalChange = year if change_ppal == 1 & year >= 2012
	bys rbd: egen MinYearPpalChange = min(YearPpalChange)
	spread MinYearPpalChange, by(rbd)
	g t_pla = year - MinYearPpalChange
	
	g EverChange = (MinYearPpalChange != .)
 
	g PostChangePpal = 1 if (year >= MinYearPpalChange) 
	replace PostChangePpal = 0 if PostChangePpal == .
	cap drop t
	g t = year - MinYearPpalChange
	replace t = 0 if EverChange == 0
			
	keep if t>=-4 & t <= 3 & year >= 2009 & year <= 2016 & Dmun == 0
			
	keep SDall_fe_prin_2wayfe PostChangePpal rbd year MinYearPpalChange
	rename MinYearPpalChange min_adp
	replace min_adp = 0 if min_adp == 2017 | min_adp == .
	
	twowayfeweights SDall_fe_prin_2wayfe rbd year PostChangePpal,  type(feTR)
	di 804/ 5195
	* Sum of negative weights  -.0658051
		
	local w = 3
	local w1 = 3	
	did_multiplegt SDall_fe_prin_2wayfe rbd year PostChangePpal, placebo(`w1') breps(20) robust_dynamic dynamic(`w') cluster(rbd)	jointtestplacebo covariances seed(1111001) average_effect
		
	g avg = e(effect_average)
	g se_avg = `e(se_effect_average)'
	g tstat_avg = avg / se_avg
	g pval_pre = `e(p_jointplacebo)'
	sum avg tstat_avg se_avg pval_pre
			
	* Column 4: See R code CallawayAndSantAna.R
	/*
		Overall summary of ATT's based on event-study/dynamic aggregation:  
		ATT    Std. Error     
		-0.0268        0.0361    
	*/

			
}	
		
**********************
*** Table A.10: Principal Selection and Principal Effectiveness: Controlling for school markets
**********************
{	
	* Load dataset		
	use	"Data/clean/DataForRegressionsADP.dta", clear
	
	global out outreg2 using "Tables/Table_A_10",  label tex(frag) bdec(3) sdec(3) keep(PostChangePpal_ADP PostChangePpal) nonotes 
	
	reghdfe SDall_fe_prin_2wayfe PostChangePpal_ADP PostChangePpal if t>=-4 & t <= 3 & year >= 2009 & year <= 2016 & sample == 1, a(year rbd i.cod_com_rbd#i.year)  vce(cluster rbd)
		test _b[PostChangePpal_ADP] + _b[PostChangePpal] = 0
		local pval = `r(p)'
		distinct rbd if e(sample) == 1
		local N = `r(ndistinct)'
		sum `e(depvar)' if e(sample)
		local mean = `r(mean)'
		distinct cod_com_rbd if e(sample) == 1
		local N2 = `r(ndistinct)'
		$out adds(# of Schools, `N', # of markets, `N2', Mean Dep Var, `mean', pvalue a + b = 0, `pval') addtext(Year FE, Yes, School FE, Yes, School Market-Year , Yes) ctitle("Municipality") replace
	
	reghdfe SDall_fe_prin_2wayfe PostChangePpal_ADP PostChangePpal if t>=-4 & t <= 3 & year >= 2009 & year <= 2016 & sample == 1, a(year rbd i.mkt_4km#i.year)  vce(cluster rbd)
