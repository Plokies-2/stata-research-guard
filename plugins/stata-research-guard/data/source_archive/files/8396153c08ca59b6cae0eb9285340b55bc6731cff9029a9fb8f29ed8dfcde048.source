********************
*** Table A.14: Principals' Characteristics by ADP Status 
********************	
{
	use "Data/clean/Base_ADPAnalysis.dta", clear
			
	xtset rbd year
	
	gen ADP2014_post = (min_adp > 2013 )
	replace ADP2014_post = . if EverADP == 0			
	
	g EverAnyAdmin = (EverSupportWorker + EverAdministrative > 0)
		
	collapse (max) EverTeacher EverAnyAdmin SDall_fe_prin_2wayfe Edad Female CollegeDegree EverPrivate (max) adp SenioritySystem, by(id_prin)
		
	label var EverTeacher				"Teacher before"
	label var EverAnyAdmin				"Administrative before"
	label var SDall_fe_prin_2wayfe 		"Principal effectiveness"
	label var EverPrivate				"Worked in private sector"
	label var CollegeDegree 			"College degree"
	label var Edad 						"Age"
	label var Female 					"Female"
	label var SenioritySystem			"Experience in public sector"
		
	keep if SDall_fe_prin_2wayfe!=.
	balancetable adp EverTeacher EverAnyAdmin EverPrivate CollegeDegree Edad Female	///
		using "Tables/Table_A_14.tex", replace varla pval ctitles("Not ADP" "ADP" "Difference") 
		
	** Column 4	
	use "Data/clean/DataForRegressionsADP.dta", clear
	
	keep if Dmun == 0	
	collapse (max) EverTeacher EverAnyAdmin SDall_fe_prin_2wayfe Edad Female CollegeDegree EverPrivate , by(id_prin)
		
	keep if SDall_fe_prin_2wayfe!=.
	sum EverTeacher EverAnyAdmin EverPrivate CollegeDegree Edad Female	
	
}	

********************
*** Table A.15: Market Level Treatments and Principal's Characteristics
********************	
{
	* Load dataset		
	use	"Data/clean/DataForRegressionsADP.dta", clear

	*** PANEL A: County
	preserve
		bys cod_com_rbd: egen min_year_adp = min(year) if PostChangePpal_ADP == 1
		spread min_year_adp , by(cod_com_rbd)
		drop if Dmun == 1
		keep if sample == 1
		
		g PostADPMarket = 1 if year > min_year_adp & min_year_adp != .
		tab min_year_adp
		codebook cod_com_rbd if min_year_adp == .
		codebook cod_com_rbd if min_year_adp != .
		replace PostADPMarket = 0 if PostADPMarket == .
		
		label var PostADPMarket "Post ADP turnouver in the market"
		
		global out outreg2 using "Tables/Table_A_15_A",  label tex(frag) bdec(3) sdec(3) keep(PostADPMarket) nocons addtext(Year FE, Yes, School FE, Yes) nonotes
		
		local append replace		
		foreach var in EverTeacher EverAnyAdmin EverPrincipal EverPrivate Edad Female CollegeDegree{
			reghdfe `var' PostADPMarket if sample==1, a(year rbd)  vce(cluster rbd)
			sum `e(depvar)' if e(sample) == 1
			$out `append' adds(Mean dep var, `r(mean)') 
			local append append
		}	
	restore
	
	*** PANEL B: School Market
	preserve
		bys mkt_7km: egen min_year_adp = min(year) if PostChangePpal_ADP == 1
		spread min_year_adp , by(mkt_7km)
		drop if Dmun == 1
		keep if sample == 1
		
		g PostADPMarket = 1 if year > min_year_adp & min_year_adp != .
		tab min_year_adp
		codebook mkt_7km if min_year_adp == .
		codebook mkt_7km if min_year_adp != .
		replace PostADPMarket = 0 if PostADPMarket == .
		
		label var PostADPMarket "Post ADP turnouver in the market"
		
		global out outreg2 using "Tables/Table_A_15_B",  label tex(frag) bdec(3) sdec(3) keep(PostADPMarket) nocons addtext(Year FE, Yes, School FE, Yes) nonotes
		
		local append replace
		foreach var in EverTeacher EverAnyAdmin EverPrincipal EverPrivate Edad Female CollegeDegree{
			reghdfe `var' PostADPMarket if sample==1, a(year rbd)  vce(cluster rbd)
			sum `e(depvar)' if e(sample) == 1
			$out `append' adds(Mean dep var, `r(mean)') 
			local append append
		}	
	restore		
}
	
********************
*** Table A.16: Characteristics of Origin and Destination Schools of ADP principals 
********************	
{
	use "Data/clean/ADPREG_TEMP.dta", clear	
		
	global contS "ShPoor mean_test matricula_total liquido_pago_student rural_rbd"
	global contM "h_ypchtot esc hm_extpoor_rate literacy_rate unempl_rate "
	
		gen aux_EverADPppal = 1 if adp == 1
		egen EverADPppal = min(aux_EverADPppal), by(id_prin) 
		drop aux_EverADPppal
		keep if EverADPppal == 1 
		
		** # of ADP principals
		codebook id_prin 
		** # of ADP principals that worked before in the pub sector
		codebook id_prin if adp == 0 
		
		gen aux_Pre  = 1 if adp == 0 
		gen aux_Post = 1 if adp == 1
		
		egen Pre=min(aux_Pre), by(id_prin)
		egen Post=min(aux_Post), by(id_prin)
		
		drop aux_Pre aux_Post
		
		replace Pre = 0 if Pre == .
		replace Post = 0 if Post == .
		
		gen Both = Pre * Post
		keep if Both == 1
		
		collapse (mean) WageSchool WagePrin $contS $contM , by(adp id_prin)
				
		label var WageSchool			"Average Wage"
		label var WagePrin				"Average Principal Wage"
		label var ShPoor				"Share of Disadvantaged Students"
		label var matricula_total 		"School Size"
		label var mean_test 			"Average Test Score"
		label var liquido_pago_student	"Income per student"
		label var rural_rbd         	"Rural School"
		
		label var h_ypchtot				"Average Income"
		label var esc					"Average Years of Education"
		label var literacy_rate			"Literacy Rate"
		label var hm_extpoor_rate		"Poverty Rate"
		label var unempl_rate			"Unemployment Rate"
		
		balancetable adp WagePrin WageSchool $contS hm_extpoor_rate h_ypchtot unempl_rate esc	///
			using "Tables/Table_A_16.tex", replace varla ctitles("Origin" "Destination" "Difference") 
	
}	
