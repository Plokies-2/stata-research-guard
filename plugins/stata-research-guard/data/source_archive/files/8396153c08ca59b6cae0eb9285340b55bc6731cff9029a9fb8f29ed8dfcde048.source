		local mean = `r(mean)'
		$out adds(# of Schools, `N', Mean Dep Var, `mean', pvalue a + b = 0, `pval') nocons addtext(Year FE, Yes, School FE, Yes) append
			
	reghdfe SDall_fe_prin_adj_contGPA PostChangePpal_ADP PostChangePpal if t>=-4 & t <= 3 & year >= 2009 & year <= 2016 & sample == 1 , a(year rbd)  vce(cluster rbd)
		test _b[PostChangePpal_ADP] + _b[PostChangePpal] = 0
		local pval = `r(p)'
		distinct rbd if e(sample) == 1
		local N = `r(ndistinct)'
		sum `e(depvar)' if e(sample)
		local mean = `r(mean)'
		$out adds(# of Schools, `N', Mean Dep Var, `mean', pvalue a + b = 0, `pval') nocons addtext(Year FE, Yes, School FE, Yes) append

	reghdfe SDall_fe_prin_adj_contGPA_noTFE PostChangePpal_ADP PostChangePpal if t>=-4 & t <= 3 & year >= 2009 & year <= 2016 & sample == 1, a(year rbd)  vce(cluster rbd)
		test _b[PostChangePpal_ADP] + _b[PostChangePpal] = 0
		local pval = `r(p)'
		distinct rbd if e(sample) == 1
		local N = `r(ndistinct)'
		sum `e(depvar)' if e(sample)
		local mean = `r(mean)'
		$out adds(# of Schools, `N', Mean Dep Var, `mean', pvalue a + b = 0, `pval') nocons addtext(Year FE, Yes, School FE, Yes) append
}

*******************		
*** Table 4: Principal Selection, SIMCE and College Admissions Scores	
*******************		
{	
	* Load dataset
	use "Data/clean/DataForRegressionsADP.dta", clear
	
	global out outreg2 using "Tables/Table_4",  label tex(frag) bdec(3) sdec(3) keep(PostChangePpal_ADP PostChangePpal) nocons addtext(Year FE, Yes, School FE, Yes, School controls, Yes, Municipality controls, Yes) nonotes
	
	local replace replace
	reghdfe beta_corr_gpa_test PostChangePpal_ADP PostChangePpal if t>=-4 & t <= 3 & year >= 2009 & year <= 2016 [aweight=weight], a(c.($Xm $Xs)#year year rbd)  vce(cluster rbd)
		test _b[PostChangePpal_ADP] + _b[PostChangePpal] = 0
		local pval = `r(p)'
		distinct rbd if e(sample) == 1
		local N = `r(ndistinct)'
		sum `e(depvar)' [aweight=weight] if e(sample)
		local mean = `r(mean)' 
		$out `replace' adds(# of Schools, `N', Mean Dep Var, `mean', pvalue a + b = 0, `pval') 
		local replace append
		
	reghdfe beta_corr_gpa_test PostChangePpal_ADP PostChangePpal if t>=-4 & t <= 3 & year >= 2009 & year <= 2016, a(c.($Xm $Xs)#year year rbd)  vce(cluster rbd)
		test _b[PostChangePpal_ADP] + _b[PostChangePpal] = 0
