		sum `e(depvar)' if e(sample)
		local mean = `r(mean)' 
		$out `replace' adds(# of Schools, `N', Mean Dep Var, `mean', pvalue a + b = 0, `pval') 

	reghdfe SimceIndex PostChangePpal_ADP PostChangePpal if t>=-4 & t <= 3 & year >= 2009 & year <= 2016, a(c.($Xm)#year year rbd)  vce(cluster rbd)
		test _b[PostChangePpal_ADP] + _b[PostChangePpal] = 0
