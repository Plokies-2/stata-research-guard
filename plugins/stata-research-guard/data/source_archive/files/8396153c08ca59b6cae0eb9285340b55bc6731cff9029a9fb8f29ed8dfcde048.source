		$out `replace' adds(# of Schools, `N', Mean Dep Var, `mean', pvalue a + b = 0, `pval') 

	reghdfe sd_mate_actual PostChangePpal_ADP PostChangePpal if t>=-4 & t <= 3 & year >= 2009 & year <= 2016, a(c.($Xm)#year year rbd)  vce(cluster rbd)
		test _b[PostChangePpal_ADP] + _b[PostChangePpal] = 0
		local pval = `r(p)'
		distinct rbd if e(sample) == 1
		local N = `r(ndistinct)'
		sum `e(depvar)' if e(sample)
		local mean = `r(mean)'
		$out `replace' adds(# of Schools, `N', Mean Dep Var, `mean', pvalue a + b = 0, `pval') 
		
	reghdfe sd_lyc_actual PostChangePpal_ADP PostChangePpal if t>=-4 & t <= 3 & year >= 2009 & year <= 2016, a(c.($Xm)#year year rbd)  vce(cluster rbd)
		test _b[PostChangePpal_ADP] + _b[PostChangePpal] = 0
		local pval = `r(p)'
		distinct rbd if e(sample) == 1
		local N = `r(ndistinct)'
		sum `e(depvar)' if e(sample)
		local mean = `r(mean)'
		$out `replace' adds(# of Schools, `N', Mean Dep Var, `mean', pvalue a + b = 0, `pval') 
		
	reghdfe AvgPSU PostChangePpal_ADP PostChangePpal if t>=-4 & t <= 3 & year >= 2009 & year <= 2016, a(c.($Xm)#year year rbd)  vce(cluster rbd)
		test _b[PostChangePpal_ADP] + _b[PostChangePpal] = 0
		local pval = `r(p)'
		distinct rbd if e(sample) == 1
		local N = `r(ndistinct)'
		sum `e(depvar)' if e(sample)
		local mean = `r(mean)'
		$out `replace' adds(# of Schools, `N', Mean Dep Var, `mean', pvalue a + b = 0, `pval') 
		
	reghdfe sd_puntaje PostChangePpal_ADP PostChangePpal if t>=-4 & t <= 3 & year >= 2009 & year <= 2016, a(c.($Xm)#year year rbd)  vce(cluster rbd)
		test _b[PostChangePpal_ADP] + _b[PostChangePpal] = 0
