ES log_emptot , indvar(county_vul_own_1990) version("baseline") spec("full") scaled("yes") baseyear(1993) pos(7)
graph export "$results/log_emp_init_vul_interact_baseline_1by1_ext.pdf", replace 
save "$results/log_emp_init_vul_interact_baseline_1by1_ext_coef.dta", replace 

   

/*----------------------------------------------------*/
   /* [>   Appendix Figure 8    <] */ 
/*----------------------------------------------------*/
use "$working_data/master_county_year_final.dta", clear
keep if inrange(year,1986,2008)
keep if !missing(log_emp_nonmanutot)
ES log_emp_manuftot , indvar(county_vul_own_1990) version("baseline") spec("two") scaled("no") baseyear(1993) pos(7)
rename (estimate_styr min95_styr max95_styr) (estimate_styr_manu min95_styr_manu max95_styr_manu)
tempfile manu 
save `manu'

use "$working_data/master_county_year_final.dta", clear
keep if inrange(year,1986,2008)
keep if !missing(log_emp_manuftot)
ES log_emp_nonmanutot , indvar(county_vul_own_1990) version("baseline") spec("two") scaled("no") baseyear(1993) pos(7)
merge 1:1 year using `manu', nogen
gen year1 = year + 0.15

twoway  (connected estimate_styr_manu year1, mcolor(dkorange) lcolor(dkorange) msize(small) msymbol(circle) lpattern(dash) yline(0, lstyle(dot)) xline(1997.5, lstyle(dot))) /// 
(connected estimate_styr year, mcolor(green) lcolor(green) msymbol(plus) msize(small) lpattern(solid) yline(0, lstyle(dot)) xline(1993, lstyle(dot))) /// 
(rcap min95_styr_manu max95_styr_manu year1 if year~=1993, lcolor(dkorange)) (rcap min95_styr max95_styr year if year~=1993, lcolor(green)) /// 
(pcarrowi 0.9 1998 0.7 1997.6 (3) "Change from SIC to NAICS", mcolor(black) lcolor(black) mlabcolor(black)), /// 
legend(on order(1 "Dep. var. : Log manufac. employment, with county, year, state x year FEs" 2 "Dep. var. : Log non-manufac. employment, with county, year, state x year FEs") cols(1) ring(2) size(small)) ///
