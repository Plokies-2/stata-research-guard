/*----------------------------------------------------*/
   /* [>   Figure 7   <] */ 
/*----------------------------------------------------*/
use "$working_data/anes_cumul_cleaned.dta", clear 

****Gen year var for graphs (v slightly offset so graphs are less cluttered) 
gen year_graph= (1970 + _n)/4  
egen tag_year_graph=tag(year_graph) 

**** Set various lists of controls
local controls_demog "white hisp_yes male hs_top coll_grad ln_fam_inc ln_fam_inc_dummy age " 
local controls_issues "weekly_attend abortion_clean abortion_dummy mostly_trust_gov mostly_trust_gov_dummy bl_th_cumul bl_th_cumul_dummy welf_th_cumul welf_th_cumul_dummy" 
local controls_imm "inc_imm"

local counter=0 
  foreach spec in none demog issues plus_imm { 
    di "`spec'"
  if "`spec'"=="none" { 
    local controls "" 
  } 
  else if "`spec'"=="demog" { 
    local controls  "`controls_demog'" 
  } 
  else if "`spec'"=="issues" { 
    local controls  " `controls_demog' `controls_issues' " 
  }   
  else if "`spec'"=="plus_imm" { 
  local controls  " `controls_demog' `controls_issues' `controls_imm' " 
} 
  gen coeff_`spec'=. 
  gen u_`spec'=. 
  gen l_`spec'=. 

foreach y in 1986 1988 1992 1996 1998 2000 2004 2008 2012 { 
  if !(`y'==1998 & inlist("`spec'","issues", "plus_imm") ) & !(`y'<1992 & "`spec'"=="plus_imm")  { 
  di "year=`y'" 
  di `"spec="`spec'""' 
  reg partyid_inc_repub favor_limits `controls' if all==1 & year==`y' 
  replace coeff_`spec'=_b[favor_limits] if year_graph>`y' + (`counter'/4) - .0001 & year_graph < `y' + (`counter'/4) + .0001  
  replace u_`spec'=_b[favor_limits] + 2*_se[favor_limits] if year_graph>`y' + (`counter'/4) - .0001 & year_graph < `y' + (`counter'/4) + .0001 
  replace l_`spec'=_b[favor_limits] - 2*_se[favor_limits] if year_graph>`y' + (`counter'/4) - .0001 & year_graph < `y' + (`counter'/4) + .0001 
  } 
} 

  local counter=`counter'+1 
  } 

  sort year 

  //ES PLOT

twoway (scatter coeff_none coeff_demog coeff_issues coeff_plus_imm year_graph, mc(red midblue navy dkgreen) ///
  m(circle_hollow triangle_hollow square_hollow diamond_hollow) mlw(medium medium medium medium))  ///
(rcap u_none l_none year_graph, lc(red) lw(medthick)) (rcap u_demog l_demog year_graph, lc(midblue) lw(medthick)) ///
(rcap u_issues l_issues year_graph, lc(navy) lw(medthick)) ///
(rcap u_plus_imm l_plus_imm year_graph, lc(dkgreen) lw(medthick)) ///
 if tag_year_graph==1 & year_graph>1985 & year_graph<2013 ,  ///
 legend(on order(1 2 3 4) subtitle("Controls", size(medsmall)) label(1 "None") label(2 "Demographics") ///
  label(3 "Demographics," "other issues") label(4 "Demog, other" "issues, plus immig.") ///
  pos(10) ring(0) col(1) region(lstyle(none))) ///
 xti("") xlabel(1986(2)2012) yline(0, lc(gray)) xline(1994, lc(red) lp(dash)) 

graph export "$results/partyid_inc_repub_lim_imports_e_s.pdf", replace
 
  
 
/*----------------------------------------------------*/
   /* [>   Figure 8  <] */ 
/*----------------------------------------------------*/
use "$working_data/anes_cumul_cleaned", clear 

**** Set various lists of controls
local controls_demog "white  hisp_yes male hs_top coll_grad ln_fam_inc ln_fam_inc_dummy age " 
local controls_issues "abortion_clean abortion_dummy mostly_trust_gov bl_th_cumul bl_th_cumul_dummy " 
 
foreach var of varlist favor_limits favor_limits_ex_dk  { 
  gen `var'_aft=`var'*(year>1992) 
} 

label var favor_limits_aft "Favor import limits x After 1992" 
label var favor_limits "Favor import limits" 

reg partyid_inc_repub favor_limits_aft favor_limits `controls_demog' `controls_issues' i.year if year<2016, robust cl(state)  
****Save this coefficient as the baseline
local baseline_beta_aft=_b[favor_limits_aft] 

local counter=0 
local counter2=0 
gen graph_cat=_n  if _n<30 
gen coeff=. 
gen upper=. 
gen lower=. 

foreach cond in "white" "white==1 & male==1" "white==1 & coll_grad==0" "south==1 " "(abortion_clean==1 | abortion_clean==2 | abortion_clean==3)" "weekly_attend==1"  { 

local counter=`counter' + 1  
local counter2=21 - 3*`counter' 

reg partyid_inc_repub favor_limits_aft favor_limits `controls_demog' `controls_issues' i.year if year<2016 & (`cond'), robust cl(state) 

replace coeff=_b[favor_limits_aft] if graph_cat>`counter2' - .001 & graph_cat<`counter2' + .0001 
replace upper=_b[favor_limits_aft] + 2*_se[favor_limits_aft] if graph_cat>`counter2' - .001 & graph_cat<`counter2' + .0001 
replace lower=_b[favor_limits_aft] - 2*_se[favor_limits_aft] if graph_cat>`counter2' - .001 & graph_cat<`counter2' + .0001 

reg partyid_inc_repub favor_limits_aft favor_limits `controls_demog' `controls_issues' i.year if year<2016 & ~(`cond'), robust cl(state) 

replace coeff=_b[favor_limits_aft] if graph_cat>`counter2' - 1 - .001 & graph_cat<`counter2' - 1 + .0001 
replace upper=_b[favor_limits_aft] + 2*_se[favor_limits_aft] if graph_cat>`counter2' -1 - .001 & graph_cat<`counter2' -1 + .0001 
replace lower=_b[favor_limits_aft] - 2*_se[favor_limits_aft] if graph_cat>`counter2' -1  - .001 & graph_cat<`counter2' -1 + .0001 

} 

****Label categories 
label define graph_cat 18 "Whites" 17 "Non-whites"  15 "White men" 14 "Not white men" 12 "White, no coll deg." 11 "Not white & no coll. deg." ///
9 "South" 8 "Other regions" 6 "Opposes Abortion" 5 "Not opposed" 3 "Weekly religious attendance" 2 "Less than weekly" 
label values graph_cat graph_cat 

local baseline_beta_aft_plus_delta = `baseline_beta_aft' + .06 

#d;
twoway 
(rcap upper lower graph_cat if graph_cat==18, horizontal color(red) lw(medium)) 
(scatter  graph_cat coeff  if graph_cat==18,  color(red) m(circle_hollow) mlw(medium))
(rcap upper lower graph_cat if graph_cat==17, horizontal color(midblue) lw(medium)) 
(scatter  graph_cat coeff  if graph_cat==17,  color(midblue) m(circle_hollow)mlw(medium) )
 
(rcap upper lower graph_cat if graph_cat==15, horizontal color(red) lw(medium)) 
(scatter  graph_cat coeff  if graph_cat==15,  color(red) m(circle_hollow) mlw(medium))
(rcap upper lower graph_cat if graph_cat==14, horizontal color(midblue) lw(medium)) 
(scatter  graph_cat coeff  if graph_cat==14,  color(midblue) m(circle_hollow)mlw(medium) )
  
(rcap upper lower graph_cat if graph_cat==12, horizontal color(red) lw(medium)) 
(scatter  graph_cat coeff  if graph_cat==12,  color(red) m(circle_hollow) mlw(medium))
(rcap upper lower graph_cat if graph_cat==11, horizontal color(midblue) lw(medium)) 
(scatter  graph_cat coeff  if graph_cat==11,  color(midblue) m(circle_hollow) mlw(medium)) 
 
(rcap upper lower graph_cat if graph_cat==9, horizontal color(red) lw(medium)) 
(scatter  graph_cat coeff  if graph_cat==9,  color(red) m(circle_hollow) mlw(medium))
(rcap upper lower graph_cat if graph_cat==8, horizontal color(midblue) lw(medium))
(scatter  graph_cat coeff  if graph_cat==8,  color(midblue) m(circle_hollow) mlw(medium))
 
(rcap upper lower graph_cat if graph_cat==6, horizontal color(red) lw(medium)) 
(scatter  graph_cat coeff  if graph_cat==6,  color(red) m(circle_hollow) mlw(medium))
(rcap upper lower graph_cat if graph_cat==5, horizontal color(midblue) lw(medium)) 
(scatter  graph_cat coeff  if graph_cat==5,  color(midblue) m(circle_hollow) mlw(medium)) 

(rcap upper lower graph_cat if graph_cat==3, horizontal color(red) lw(medium) ) 
(scatter  graph_cat coeff  if graph_cat==3,  color(red) m(circle_hollow) mlw(medium))
(rcap upper lower graph_cat if graph_cat==2, horizontal color(midblue) lw(medium)) 
(scatter  graph_cat coeff  if graph_cat==2,  color(midblue) m(circle_hollow) mlw(medium))

(rcap upper lower graph_cat if graph_cat==0, horizontal color(red) lw(medium) ) 
(scatter  graph_cat coeff  if graph_cat==0,  color(red) m(circle_hollow) mlw(medium))
(rcap upper lower graph_cat if graph_cat==-1, horizontal color(midblue) lw(medium)) 
(scatter  graph_cat coeff  if graph_cat==-1,  color(midblue) m(circle_hollow) mlw(medium))
 
 
 , xline(`baseline_beta_aft') xline(0, lc(gray) lp(shortdash)) 
 
 ylabel(18 17 15 14 12 11 9 8 6 5 3 2 , valuelabel angle(0)) xti("95% conf interval, coeff. on {it:Favor import limits} x {it:After 1992}") yti("") xlabel(-.1(.1).7) 
 legend(off)
 /***Text***/ 
 text(5 `baseline_beta_aft_plus_delta'  "Solid, red, vertical line is" "point-estimate from full sample", place(east) justification(left))
 ;
 #d cr
graph export "$results/anes_cumul_hetero.pdf", replace
  
/*------------------------------------ End of SECTION 1 ------------------------------------*/


/**********************************************************************/
/*  SECTION 2: Tables        
    Notes: */
/**********************************************************************/
 
/*----------------------------------------------------*/
   /* [>   Table 1   <] */ 
/*----------------------------------------------------*/
use "$working_data/master_county_year_final", clear 
keep if year == 1990
xtile county_quartile=county_vul_own, n(4)
keep county county_quartile
merge 1:m county using "$working_data/master_county_year_final", nogen
tempfile quartiles 
save `quartiles', replace

*pre-period vote shares
bysort county: egen pres_rep_share_pre = mean(tot_pres_rep_share / inlist(year, 1980,1984,1988)) 
bysort county: egen pres_dem_share_pre = mean(tot_pres_dem_share / inlist(year, 1980,1984,1988))
bysort county: egen tp_house_rep_share_pre = mean(tp_house_rep_share / inlist(year, 1980, 1982, 1984, 1986, 1988, 1990))

keep if year == 1990
*convert to thousands 
replace n_petitions_pc_ctyr = n_petitions_pc_ctyr * 1000
replace n_certified_pc_ctyr = n_certified_pc_ctyr * 1000
replace n_app_di = n_app_di / workage_pop * 1000
replace n_fin_di = n_fin_di / workage_pop * 1000
replace cty_pop = cty_pop / 1000
replace workage_pop = workage_pop / 1000
replace emptot = emptot / 1000 
replace county_income_1989 = county_income_1989 / 1000 

* 1990 population county weights

// Unweighted counts
preserve
collapse (mean) cty_pop workage_pop emptot emp_to_pop county_vul_own (count) year , by(county_quartile)
tempfile unweighted
save 	`unweighted', replace
restore 

// Weighted shares
collapse (mean) county_income_1989 share_white manu_share_1990 ///
  share_colgrad_1990 pres_rep_share_pre pres_dem_share_pre tp_house_rep_share_pre n_petitions_pc_ctyr ///
   n_certified_pc_ctyr n_app_di n_fin_di d_tradeotch_pw_lag [fweight=cty_pop_1990], by(county_quartile)
merge 1:1 county_quartile using `unweighted'

drop if missing(county_quartile)

order cty_pop workage_pop county_income_1989 emptot emp_to_pop share_white manu_share_1990 ///
  share_colgrad_1990 pres_rep_share_pre pres_dem_share_pre tp_house_rep_share_pre n_petitions_pc_ctyr ///
   n_certified_pc_ctyr n_app_di n_fin_di county_vul_own d_tradeotch_pw_lag
   
forvalues i = 1/4 {
  foreach v of varlist cty_pop- d_tradeotch_pw_lag {
    local `v'_`i' = string(`v'[`i'], "%9.3f") 
  }
  local year_`i' = year[1]
}


texdoc init "$results/summ_stat_by_cty_quartile_nosd.tex", replace force

tex    & \multicolumn{4}{c}{Quartile (lower quartile : less vulnerable)} \\
tex        & 1 & 2 & 3 & 4 \\ \hline  \vspace*{3mm}
tex  \textit{Demographics (1990)} & & & & \\ 
tex  Population (in thousands) & `cty_pop_1' & `cty_pop_2' & `cty_pop_3' & `cty_pop_4' \\
tex  Working-age population (in thousands) & `workage_pop_1' & `workage_pop_2' & `workage_pop_3' & `workage_pop_4' \\
tex  Household income (in thousands) & `county_income_1989_1' & `county_income_1989_2' & `county_income_1989_3' & `county_income_1989_4' \\
tex  Number of jobs (in thousands) & `emptot_1' & `emptot_2' & `emptot_3' & `emptot_4' \\
tex  Emp-to-Pop ratio & `emp_to_pop_1' & `emp_to_pop_2' & `emp_to_pop_3' & `emp_to_pop_4' \\
tex  White share of population & `share_white_1' & `share_white_2' & `share_white_3' & `share_white_4' \\
tex  Manufacturing share of employment & `manu_share_1990_1' & `manu_share_1990_2' & `manu_share_1990_3' & `manu_share_1990_4' \\
tex  College-grad share of population & `share_colgrad_1990_1' & `share_colgrad_1990_2' & `share_colgrad_1990_3' & `share_colgrad_1990_4' \\
tex  &&&& \\ 
tex  \textit{Political preference (1980-1990) } &&&&\\
tex  Republican House two-party vote share & `tp_house_rep_share_pre_1' & `tp_house_rep_share_pre_2' & `tp_house_rep_share_pre_3' & `tp_house_rep_share_pre_4' \\ 
tex  Republican Presidential vote share & `pres_rep_share_pre_1' & `pres_rep_share_pre_2' & `pres_rep_share_pre_3' & `pres_rep_share_pre_4' \\ 
tex  Democratic Presidential vote share & `pres_dem_share_pre_1' & `pres_dem_share_pre_2' & `pres_dem_share_pre_3' & `pres_dem_share_pre_4' \\ 
tex  &&&& \\
tex  \textit{DI and TAA takeup per thousand (1990) } &&&& \\
tex  TAA petition  & `n_petitions_pc_ctyr_1' & `n_petitions_pc_ctyr_2' & `n_petitions_pc_ctyr_3' & `n_petitions_pc_ctyr_4' \\
tex  TAA certification  & `n_certified_pc_ctyr_1' & `n_certified_pc_ctyr_2' & `n_certified_pc_ctyr_3' & `n_certified_pc_ctyr_4' \\
tex  DI application  & `n_app_di_1' & `n_app_di_2' & `n_app_di_3' & `n_app_di_4' \\
tex  DI awards  & `n_fin_di_1' & `n_fin_di_2' & `n_fin_di_3' & `n_fin_di_4' \\
tex  &&&& \\
tex  \textit{NAFTA vulnerability} &&&& \\
tex  Vulnerability based on tariff in 1990 & `county_vul_own_1' & `county_vul_own_2' & `county_vul_own_3' & `county_vul_own_4'  \\
tex &&&& \\
tex  \textit{Exposure to Chinese imports} &&&&\\
tex  ADH (2013) China shock measure (IV) & `d_tradeotch_pw_lag_1' & `d_tradeotch_pw_lag_2' & `d_tradeotch_pw_lag_3' & `d_tradeotch_pw_lag_4' \\
tex  &&&& \\
tex  \hline
tex  Number of counties & `year_1' & `year_2' & `year_3' & `year_4' \\

texdoc close
 
/*----------------------------------------------------*/
   /* [>   Table 2   <] */ 
/*----------------------------------------------------*/
  
use "$working_data/nafta_views_state_vul.dta", clear
//survey FE
tab data_orig_name, gen(ddd) 

gen nafta_yes=nafta_clean==1 if !missing(nafta_clean)
gen nafta_yes_01 = nafta_clean==1 if nafta_clean<3 
 
****Add regions dummies 

gen district=1 if inlist(state_fips, 9, 23, 25, 33, 44, 50) 
replace district=2 if inlist(state_fips, 34, 36, 42) 
replace district=3 if inlist(state_fips, 18, 17, 26, 39, 55)
replace district=4 if inlist(state_fips, 19, 20, 27, 29, 31, 38, 46)
replace district=5 if inlist(state_fips, 10, 11, 12, 13, 24, 37, 45, 51, 54)
replace district=6 if inlist(state_fips, 1, 21, 28, 47)
replace district=7 if inlist(state_fips, 5, 22, 40, 48)
replace district=8 if inlist(state_fips, 4, 8, 16, 35, 30, 49, 32, 56)
replace district=9 if inlist(state_fips, 2, 6, 15, 41, 53)

label define union_l 1 "Self in union" 2 "Spouse or other HH member in union" ///
  3 "Self and spouse/HH member in union" 4 "No one in HH in union" ///
  9 "Don't know/no answer"
label values union_clean union_l

****Create race dummies 
gen white=race_clean==1 if inrange(race_clean, 1,4)
gen black=race_clean==2 if inrange(race_clean, 1,4) 
gen no_coll=1-coll_grad 
gen ln_inc_clean = ln(income_clean) 

gen union=union_clean!=4 if union_clean<. & union_clean!=9
replace union=union_hh if union==. 

eststo clear 

gen nafta_yes_100 = nafta_yes*100
gen nafta_yes_01_100 = nafta_yes_01*100

*scaling*
preserve 
reg nafta_yes state_1990_vul  ddd* if nafta_clean<. & year<2016, cl(state_fips)   
gen samp = e(sample) 
keep if samp == 1  
bys state_fips: keep if _n == 1 
xtile state_quartile=state_1990_vul, n(4) 
sum state_1990_vul if state_quartile == 4 
local high = `r(mean)' 
sum state_1990_vul if state_quartile == 1 
local diff = `high' - `r(mean)' 
di "`diff'" 
restore 

replace state_1990_vul = state_1990_vul / `diff'

eststo: reg nafta_yes state_1990_vul  ddd* if nafta_clean<. & year<2016, cl(state_fips) 
qui sum `e(depvar)' if e(sample)==1 
estadd scalar dmean=`r(mean)' 
estadd local division "No" 
estadd local ex_idk "No" 
estadd local ex_miss_covars "No" 

gen age_clean_100 = age_clean/100 

***Establish fixed sample 
local controls "white black male no_coll ln_inc_clean union age_clean_100" 
qui reg nafta_yes state_1990_vul `controls' ddd* if nafta_clean<. & year<2016, cl(state_fips) 
gen fix_samp=e(sample) 

eststo: reg nafta_yes state_1990_vul ddd* if nafta_clean<. & year<2016 & fix_samp==1, cl(state_fips) 
qui sum `e(depvar)' if e(sample)==1 
estadd scalar dmean=`r(mean)' 
estadd local division "No" 
estadd local ex_idk "No" 
estadd local ex_miss_covars "Yes" 

eststo: reg nafta_yes state_1990_vul `controls'  ddd* if nafta_clean<. & year<2016 & fix_samp==1, cl(state_fips) 
qui sum `e(depvar)' if e(sample)==1 
estadd scalar dmean=`r(mean)' 
estadd local division "No" 
estadd local ex_idk "No" 
estadd local ex_miss_covars "Yes" 

eststo: reg nafta_yes state_1990_vul `controls' ddd* i.district if nafta_clean<. & year<2016 & fix_samp==1, cl(state_fips) 
qui sum `e(depvar)' if e(sample)==1 
estadd scalar dmean=`r(mean)' 
estadd local division "Yes" 
estadd local ex_idk "No" 
estadd local ex_miss_covars "Yes" 

eststo: reg nafta_yes_01 state_1990_vul `controls'  ddd* i.district if nafta_clean<. & year<2016 & fix_samp==1, cl(state_fips) 
qui sum `e(depvar)' if e(sample)==1 
estadd scalar dmean=`r(mean)' 
estadd local division "Yes" 
estadd local ex_idk "Yes" 
estadd local ex_miss_covars "Yes" 

***Labels 
label var white "White" 
label var no_coll "No college degree" 
label var male "Male" 
label var union "Union household" 
label var state_1990_vul "State-level vulnerability" 
label var ln_inc_clean "Log family income" 
label var black "Black" 
label var age_clean_100 "Age / 100" 
label var coll_grad "College grad." 

local controls "white black male no_coll ln_inc_clean union age_clean_100" 
local est_cmd `"order(state_1990_vul  `controls' ) keep(state_1990_vul  `controls' ) se(%8.3f) brackets nostar stats(dmean ex_miss_covars division ex_idk N, label("Dept. var. mean" "Drop if missing covars" "Division FE" "Ex. DK" "Observations")) nomtitles label wrap  "'  

esttab , `est_cmd' 
esttab est1 est2 est3 est4 est5  using "$results/nafta_views_state_vul.tex", `est_cmd' fragment replace booktabs  varwidth(25) ///
  mgroups("Dept. var: Supports NAFTA", pattern(1 0 0 0 0 0 0 0) ///
  prefix(\multicolumn{@span}{c}{ ) suffix(}) span erepeat(\cmidrule(lr){@span}) ) nomtitle nogaps 

  

/*----------------------------------------------------*/
   /* [>   Table 3   <] */ 
/*----------------------------------------------------*/
use "$working_data/anes_cumul_cleaned", clear 
 
**** Set various lists of controls
local controls_demog "white hisp_yes male hs_top coll_grad ln_fam_inc ln_fam_inc_dummy age"
local controls_issues "abortion_clean abortion_dummy mostly_trust_gov bl_th_cumul bl_th_cumul_dummy"
 
foreach var of varlist favor_limits favor_limits_ex_dk  { 
  gen `var'_aft=`var'*(year>1992) 
} 

***Create after variables for demog & issues controls 
local controls_demog_aft  "" 

foreach var of varlist `controls_demog'{ 
gen `var'_aft = `var'*(year>1992) 
local controls_demog_aft "`controls_demog_aft' `var'_aft" 
} 
local controls_issues_aft ""
foreach var of varlist `controls_issues' { 
gen `var'_aft = `var'*(year>1992) 
local controls_issues_aft "`controls_issues_aft' `var'_aft" 
} 

label var favor_limits_aft "Favor import limits x After 1992" 
label var favor_limits "Favor import limits" 

qui: reg partyid_inc_repub favor_limits_aft favor_limits `controls_demog' `controls_issues' i.year if year<2016, robust cl(state)  
gen fsample=e(sample)==1 

eststo clear 

eststo: reg partyid_inc_repub favor_limits_aft favor_limits i.year if year<2016 & fsample==1, robust cl(state) 
sum `e(depvar)' if e(sample)==1 
estadd scalar dmean = `r(mean)' 
estadd local demog = "No" 
estadd local stFE ="No" 
estadd local issues ="No" 
estadd local demog_aft ="No" 
estadd local issues_aft ="No" 
estadd local ex_dk ="No" 

eststo: areg partyid_inc_repub favor_limits_aft favor_limits i.year if year<2016  & fsample==1, abs(state) robust cl(state) 
sum `e(depvar)' if e(sample)==1 
estadd scalar dmean = `r(mean)' 
estadd local demog "No" 
estadd local stFE "Yes" 
estadd local issues "No" 
estadd local demog_aft "No" 
estadd local issues_aft "No" 
estadd local ex_dk "No" 

eststo: reg partyid_inc_repub favor_limits_aft favor_limits `controls_demog' i.year if year<2016, robust cl(state)  
sum `e(depvar)' if e(sample)==1 
estadd scalar dmean = `r(mean)' 
estadd local demog "Yes" 
estadd local stFE "No" 
estadd local issues "No" 
estadd local demog_aft "No" 
estadd local issues_aft "No" 
estadd local ex_dk "No" 

eststo: reg partyid_inc_repub favor_limits_aft favor_limits `controls_demog' `controls_issues' i.year if year<2016, robust cl(state)  
sum `e(depvar)' if e(sample)==1 
estadd scalar dmean = `r(mean)' 
estadd local demog "Yes" 
estadd local stFE "No" 
estadd local issues "Yes" 
estadd local demog_aft "No" 
estadd local issues_aft "No" 
estadd local ex_dk "No" 

****Save this coefficient as the baseline, the one that we plot in the heterogeneity graph 
//local baseline_beta_aft=_b[favor_limits_aft] 

eststo: reg partyid_inc_repub favor_limits_aft favor_limits `controls_demog' `controls_issues' i.year if year<2016 & dk_limits==0, robust cl(state)  
sum `e(depvar)' if e(sample)==1 
estadd scalar dmean = `r(mean)' 
estadd local demog "Yes" 
estadd local stFE "No" 
estadd local issues "Yes" 
estadd local demog_aft "No" 
estadd local issues_aft "No" 
estadd local ex_dk "Yes" 

eststo: reg partyid_inc_repub favor_limits_aft favor_limits `controls_demog' `controls_issues' `controls_demog_aft' `controls_issues_aft' i.year if year<2016, robust cl(state)  
sum `e(depvar)' if e(sample)==1 
estadd scalar dmean = `r(mean)' 
estadd local demog "Yes" 
estadd local stFE "No" 
estadd local issues "Yes" 
estadd local demog_aft "Yes" 
estadd local issues_aft "Yes" 
estadd local ex_dk "No" 

esttab using "$results/anes_cumul_table.tex", replace fragment booktabs keep(favor_limits_aft favor_limits) /// 
nostar se brackets nomtitles label  wrap varwidth(23) ///
mgroups("Dep't var.: Party ID (1-7, increasing in Republican dir)", pattern(1 0 0 0 0)  ///
prefix(\multicolumn{@span}{c}{) suffix(}) span erepeat(\cmidrule(lr){@span}))  ///
stats(dmean  blank demog stFE issues  demog_aft issues_aft ex_dk r2 N,  ///
  fmt(%9.3f 0  0 0 0 0 0 0 %9.3f  %9.0f ) ///
label("Dept. var. mean"  "Controls" "--Demographic" "--State FE" "--Issues" "--Demogr. x Aft" "--Issues x Aft" "Ex. DK" "R-squared" "Observations"))
 
  

/*----------------------------------------------------*/
   /* [>   Table 4   <] */ 
/*----------------------------------------------------*/
use "$working_data/anes_92_97.dta", clear

replace fipstate = state_1996 if missing(fipstate)
replace fipstate = state_1994 if missing(fipstate)
replace fipstate = state_1992 if missing(fipstate)

recode  help_blacks_1992_clean (5 6 7=1) (0 1 2 3 4=0)
recode  role_gov_1992_clean (5 6 7=1) (0 1 2 3 4=0)
recode  abortion_1992_clean (4=1) (0 1 2 3=0)
recode  health_reform_1992_clean (5 6 7=1) (0 1 2 3 4=0)

*****Table 
eststo clear 
local controls_demog "white_1992 black_1992 male_1992 yrs_ed age_1992 ln_fam_inc_1992 ln_fam_inc_1992_dummy rural CC " 
local controls_issues_classic "help_blacks_1992_clean role_gov_1992_clean abortion_1992_clean weekly_relig inc_imm_1992" 
local controls_issues_recent "oppose_gays_military health_reform_1992_clean favor_term_limit" 

***Label vars for the table 
label var favor_limits_1992_dk "Favor import limits" 
label var coll_grad_1992 "College grad" 
label var union_hh_1992 "Union household (dummy)" 

gen move_right_92_94_100=move_right_92_94*100 
label var move_right_92_94_100 "Moved right between 1992, 1993 (x 100)" 

eststo clear 

eststo: reg move_right_92_94_100 favor_limits_1992_dk  [pw = V923008] if move_right_92_94<. , robust cluster(fipstate) 
sum `e(depvar)' if e(sample)==1 
estadd scalar dmean = `r(mean)' 
estadd local year "1992-94" 
estadd local ex_dk "No" 
estadd local stfe "No" 
estadd local demog "No" 

eststo: reg move_right_92_94_100 favor_limits_1992_dk  [pw = V923008] if move_right_92_94<. & dk_limits_1992==0 , robust cluster(fipstate) 
sum `e(depvar)' if e(sample)==1 
estadd scalar dmean = `r(mean)' 
estadd local year "1992-94" 
estadd local ex_dk "Yes" 
estadd local stfe "No" 
estadd local demog "No" 

eststo: reg move_right_92_94_100 favor_limits_1992_dk `controls_demog'  [pw = V923008] if move_right_92_94<.  , robust cluster(fipstate) 
sum `e(depvar)' if e(sample)==1 
estadd scalar dmean = `r(mean)' 
estadd local year "1992-94" 
estadd local ex_dk "No" 
estadd local stfe "No" 
estadd local demog "Yes" 

eststo: reg move_right_92_94_100 favor_limits_1992_dk `controls_demog' `controls_issues_classic'  [pw = V923008] if move_right_92_94<.  , robust cluster(fipstate) 
sum `e(depvar)' if e(sample)==1 
estadd scalar dmean = `r(mean)' 
estadd local year "1992-94" 
estadd local ex_dk "No" 
estadd local stfe "No" 
estadd local demog "Yes" 

eststo: reg move_right_92_94_100 favor_limits_1992_dk `controls_demog' `controls_issues_classic' `controls_issues_recent' [pw = V923008]  if move_right_92_94<.  , robust cluster(fipstate) 
sum `e(depvar)' if e(sample)==1 
estadd scalar dmean = `r(mean)' 
estadd local year "1992-94" 
estadd local ex_dk "No" 
estadd local stfe "No" 
estadd local demog "Yes" 

local baseline_beta_limits = _b[favor_limits_1992_dk] 

eststo: areg move_right_92_94_100 favor_limits_1992_dk `controls_demog' `controls_issues_classic' `controls_issues_recent' [pw = V923008]  if move_right_92_94<.  , absorb(fipstate) robust cluster(fipstate) 
sum `e(depvar)' if e(sample)==1 
estadd scalar dmean = `r(mean)' 
estadd local year "1992-94" 
estadd local ex_dk "No" 
estadd local stfe "Yes" 
estadd local demog "Yes" 

esttab , drop(_cons *dummy* white_1992 black_1992 male_1992 yrs_educ age_1992 ln_fam_inc_1992 rural CC*) se brackets star(* .1 ** .05 *** .01) stats(dmean ex_dk demog stfe r2 N, label("Dept. var. mean" "Ex. DK"  "Demog. covars" "State FE" "R-squared" "Observations")) nomtitles label wrap nogaps

esttab using "$results/panel_limits_move_right_92_94_100.tex", ///
replace fragment booktabs se brackets nostar ///
drop(_cons *dummy* white_1992 black_1992 male_1992 yrs_educ age_1992 ln_fam_inc_1992 rural CC*) ///
label wrap varwidth(25) stats(dmean ex_dk demog stfe r2 N, label("Dept. var. mean" "Ex. DK"  "Demog. covars" "State FE" "R-squared" "Observations")) ///
mgroups( "Move in Repub direction dummy x 100", pattern(1 0 0 0 0 0) prefix(\multicolumn{@span}{c}{) suffix(}) span erepeat(\cmidrule(lr){@span})) nomtitles nogaps 

  


