/*----------------------------------------------------*/
   /* [>   Appendix Figure 20   <] */ 
/*----------------------------------------------------*/
use "$working_data/master_county_year_final", clear 

// Sample sample as Figure 4
levelsof year, local(year_list)
foreach year of local year_list {
	if `year' != 1993 gen init_vul_`year' = (year == `year') * county_vul_own_1990  / vul_scale_factor
}
qui: reghdfe n_petitions_pc_ctyr init_vul_* [weight = cty_pop_1990], absorb(county year i.fipstate#year ///
	 c.d_tradeotch_pw_lag#i.year c.share_colgrad_1990#i.year c.manu_share_1990#i.year) cluster(fipstate) 
qui: bys county: egen cty_tot = total(e(sample))
qui: unique year if e(sample) == 1 
qui: gen samp = 1 if cty_tot == r(unique)

// Quartiles
keep if year == 1990
xtile county_quartile=county_vul_own, n(4)
keep if samp==1
unique county

keep county county_quartile
merge 1:m county using "$working_data/master_county_year_final", keep(matched) nogen
collapse (mean) n_petitions_pc_ctyr, by(county_quartile year)
keep if inrange(year,1986,2008)
bysort county_quartile : egen n_petitions_pc_ctyr_baseyr = max(n_petitions_pc_ctyr / (year == 1993))
gen normalized_n_petitions_pc_ctyr = n_petitions_pc_ctyr - n_petitions_pc_ctyr_baseyr 

* simple var version 
raw_plot normalized_n_petitions_pc_ctyr county_quartile 
graph export "$results/normalized_n_petitions_pc_ctyr_match_series_by_cty_quartile.pdf", replace 
  

