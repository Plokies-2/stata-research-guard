use "$working_data/master_county_year_final", clear 
keep if year == 1990
xtile county_quartile=county_vul_own, n(4)
keep county county_quartile
merge 1:m county using "$working_data/master_county_year_final", nogen
collapse (mean) county_vul_own, by(county_quartile year)
* keeping upto 2005 only 
keep if inrange(year,1990,2005)

* simple var version 
raw_plot county_vul_own county_quartile 
graph export "$results/county_vulnerability_timeseries.pdf", replace 

  
