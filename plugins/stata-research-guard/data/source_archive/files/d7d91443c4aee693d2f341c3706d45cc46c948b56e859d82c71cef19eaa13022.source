/*----------------------------------------------------*/
  /* [>   Appendix Figure 37   <] */ 
/*----------------------------------------------------*/
use "$working_data/anes_92_97.dta", clear
order st*
//destring state, replace force
replace fipstate = state_1996 if missing(fipstate)
replace fipstate = state_1994 if missing(fipstate)
replace fipstate = state_1992 if missing(fipstate)

*****Table 
eststo clear 
local controls_demog "white_1992 black_1992 male_1992 yrs_ed age_1992 ln_fam_inc_1992 ln_fam_inc_1992_dummy rural CC " 
local controls_issues_classic "help_blacks_1992_clean role_gov_1992_clean abortion_1992_clean weekly_relig inc_imm_1992" 
local controls_issues_recent "oppose_gays_military health_reform_1992_clean favor_term_limit" 

recode  help_blacks_1992_clean (5 6 7=1) (0 1 2 3 4=0)
recode  role_gov_1992_clean (5 6 7=1) (0 1 2 3 4=0)
recode  abortion_1992_clean (4=1) (0 1 2 3=0)
recode  health_reform_1992_clean (5 6 7=1) (0 1 2 3 4=0)

***Label vars for the table 
label var favor_limits_1992_dk "Favor import limits" 
label var coll_grad_1992 "College grad" 
label var union_hh_1992 "Union household (dummy)" 

gen move_right_92_94_100=move_right_92_94*100 
label var move_right_92_94_100 "Moved right between 1992, 1993 (x 100)" 

*****Paper version (import-limits for main table, NAFTA for appendix table) ;
eststo clear 
eststo: reg move_right_92_94_100 favor_limits_1992_dk `controls_demog' `controls_issues_classic' `controls_issues_recent' [pw = V923008]  if move_right_92_94<.  , robust cluster(fipstate) 
local baseline_beta_limits = _b[favor_limits_1992_dk] 

***Gen South 
destring fipstate, replace 
gen south=inlist(fipstate, 10, 11, 12, 13, 24, 37, 45, 51, 54, 1, 21, 28, 47, 5, 22, 40, 48) 

****Heterogeneity by demographic & other political views ;
****Take the col. (5) spec and split by various political views ;
gen graph_cat=_n  if _n<35 
gen coeff=. 
gen upper=. 
gen lower=. 
local counter=0 
local counter2=0 

foreach cond in "white==1" "white==1 & male==1" "white==1 & coll_grad_1992==0" "south==1" "weekly_relig_1992==1" "abortion_1992_clean==0" "help_blacks_1992_clean==1" "oppose_gays_military_1992==1"  { 
  local counter=`counter' + 1  
  local counter2=30 - 3*`counter' 
  
  reg move_right_92_94_100 favor_limits_1992_dk `controls_demog' `controls_issues_classic' `controls_issues_recent' [pw = V923008] if (`cond'==1), robust cl(fipstate) 
  
  replace coeff=_b[favor_limits_1992_dk] if graph_cat>`counter2' - .001 & graph_cat<`counter2' + .0001 
  replace upper=_b[favor_limits_1992_dk] + 2*_se[favor_limits_1992_dk] if graph_cat>`counter2' - .001 & graph_cat<`counter2' + .0001 
  replace lower=_b[favor_limits_1992_dk] - 2*_se[favor_limits_1992_dk] if graph_cat>`counter2' - .001 & graph_cat<`counter2' + .0001 
  
  reg move_right_92_94_100 favor_limits_1992_dk `controls_demog' `controls_issues_classic' `controls_issues_recent' [pw = V923008] if ~(`cond'==1), robust cl(fipstate) 
  
  replace coeff=_b[favor_limits_1992_dk] if graph_cat>`counter2' - 1 - .001 & graph_cat<`counter2' - 1 + .0001 
  replace upper=_b[favor_limits_1992_dk] + 2*_se[favor_limits_1992_dk] if graph_cat>`counter2' -1 - .001 & graph_cat<`counter2' -1 + .0001 
  replace lower=_b[favor_limits_1992_dk] - 2*_se[favor_limits_1992_dk] if graph_cat>`counter2' -1  - .001 & graph_cat<`counter2' -1 + .0001 
} 

****Label categories ;
label define graph_cat 15 "White men" 14 "Others"  12 "Oppose abortion" 11 "Others" 9 "Gov't sd not help blacks" 8 "Others" 6 "Oppose gays in military" 5 "Others"  

label values graph_cat graph_cat 

#d ;
 twoway 

/**white v others**/
(rcap upper lower graph_cat if graph_cat==27, horizontal color(red) lw(medium)) 
(scatter  graph_cat coeff  if graph_cat==27,  color(red) m(circle_hollow) mlw(medium) msize(small))
(rcap upper lower graph_cat if graph_cat==26, horizontal color(midblue) lw(medium)) 
(scatter  graph_cat coeff  if graph_cat==26,  color(midblue) m(circle_hollow) mlw(medium) msize(small))
  
/**white men v others**/
(rcap upper lower graph_cat if graph_cat==24, horizontal color(red) lw(medium)) 
(scatter  graph_cat coeff  if graph_cat==24,  color(red) m(circle_hollow) mlw(medium) msize(small))
(rcap upper lower graph_cat if graph_cat==23, horizontal color(midblue) lw(medium)) 
(scatter  graph_cat coeff  if graph_cat==23,  color(midblue) m(circle_hollow) mlw(medium) msize(small))

/**white no coll v others**/
(rcap upper lower graph_cat if graph_cat==21, horizontal color(red) lw(medium)) 
(scatter  graph_cat coeff  if graph_cat==21,  color(red) m(circle_hollow) mlw(medium) msize(small))
(rcap upper lower graph_cat if graph_cat==20, horizontal color(midblue) lw(medium)) 
(scatter  graph_cat coeff  if graph_cat==20,  color(midblue) m(circle_hollow) mlw(medium) msize(small))
 
/**Southerners v others**/
(rcap upper lower graph_cat if graph_cat==18, horizontal color(red) lw(medium)) 
(scatter  graph_cat coeff  if graph_cat==18,  color(red) m(circle_hollow) mlw(medium) msize(small))
(rcap upper lower graph_cat if graph_cat==17, horizontal color(midblue) lw(medium)) 
(scatter  graph_cat coeff  if graph_cat==17,  color(midblue) m(circle_hollow) mlw(medium) msize(small))
 
/**Relig attendence v others**/
(rcap upper lower graph_cat if graph_cat==15, horizontal color(red) lw(medium)) 
(scatter  graph_cat coeff  if graph_cat==15,  color(red) m(circle_hollow) mlw(medium) msize(small))
(rcap upper lower graph_cat if graph_cat==14, horizontal color(midblue) lw(medium) ) 
(scatter  graph_cat coeff  if graph_cat==14,  color(midblue) m(circle_hollow) mlw(medium) msize(small))

/***Oppose abortion v others****/
(rcap upper lower graph_cat if graph_cat==12, horizontal color(red) lw(medium)) 
(scatter graph_cat coeff if graph_cat==12, mlw(medium) color(red) m(circle_hollow) msize(small)) 
(rcap upper lower graph_cat if graph_cat==11, horizontal color(midblue) lw(medium)) 
(scatter graph_cat coeff if graph_cat==11, mlw(medium) color(midblue) m(circle_hollow) msize(small)) 

/***Oppose govt help to blacks v others ***/   
(rcap upper lower graph_cat if graph_cat==9, horizontal color(red) lw(medium)) 
(scatter graph_cat coeff if graph_cat==9, mlw(medium) color(red) m(circle_hollow) msize(small)) 
(rcap upper lower graph_cat if graph_cat==8, horizontal color(midblue) lw(medium))
(scatter graph_cat coeff if graph_cat==8, mlw(medium) color(midblue) m(circle_hollow) msize(small)) 

/***Oppose gays in military v others ***/  
(rcap upper lower graph_cat if graph_cat==6, horizontal color(red) lw(medium)) 
(scatter graph_cat coeff if graph_cat==6, mlw(medium) color(red) m(circle_hollow)  msize(small)) 
(rcap upper lower graph_cat if graph_cat==5, horizontal color(midblue) lw(medium)) 
(scatter graph_cat coeff if graph_cat==5, mlw(medium) color(midblue) m(circle_hollow) lw(medthick) msize(small)) 
  
 if graph_cat>3 & graph_cat<28, 
 xline(`baseline_beta_limits') xline(0, lc(gray) lp(shortdash)) ysize(10) xsize(9)

/* ylabel(15 14 12 11 9 8 6 5, valuelabel angle(35))*/ ylabel(none) yscale(range(4 12.5))  xti("Point-estimate and 95% conf interval for coeff. on {it:Favor Limits}") yti("")  xlabel(-20(5)25)

/***text***/

text(26.6 17 "Whites", place(e) justification(left) size(small))
text(25.6 10 "Others", place(e) justification(left) size(small))

text(23.6 19 "White men", place(e) justification(left) size(small))
text(22.6 -6 "Others", place(e) justification(left) size(small))

text(20.6 17 "White, no col. deg.", place(e) justification(left) size(small))
text(19.6 16 "Others", place(e) justification(left) size(small))

text(17.6 21 "Southerners", place(e) justification(left) size(small))
text(16.6 10.5 "Others", place(e) justification(left) size(small))

text(14.6 -14 "Weekly rel. attendence", place(e) justification(left) size(small))
text(13.6 13 "Others", place(e) justification(left) size(small))

text(11.6 17 "Oppose abortion", place(e) justification(left) size(small))
text(10.6 13 "Others", place(e) justification(left) size(small))

text(8.6  21 "Oppose gov. aid for Blacks", place(c) justification(left) size(small))
text(7.6  -4 "Others", place(c) justification(left) size(small))
text(5.6  21 "Oppose gays in military", place(c) justification(left) size(small))
text(4.6  -3 "Others", place(c) justification(left) size(small))

text(18.6 -11 "Solid, red vertical" "line is point-estimate" "from full sample", place(c) justification(left) size(small))
 ;

