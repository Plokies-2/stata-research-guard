 /*----------------------------------------------------*/
    /* [>   Appendix Figure 1   <] */ 
 /*----------------------------------------------------*/
  * Colors
local c1 "green"
local c2 "pink" 
local c3 "midblue"

use "$working_data/fred_exports.dta", clear
tsline import_china_real  import_mexico_real, lcolor(`c1' `c2' `c3') lpattern(longdash_dot solid) ytitle("In million dollars, 2000 as base year") xtitle("") /// 
legend(on order(1 "China" 2 "Mexico") col(3)) /// 
xline(134, lpattern(dash) lwidth(thin) lcolor(gray)) /// 
xlabel(100(8)191, noticks angle(30) format(%tqCY)) 
graph export "$results/US_Import_from_China_Mexico.pdf", replace
  

 
/*----------------------------------------------------*/
   /* [>   Appendix Figure 2   <] */ 
/*----------------------------------------------------*/
use "$working_data/imports_sic_year.dta", clear 
collapse (sum) tot_sic4_import_usitc, by(t_category year) 
preserve 
import excel "$raw_data/fred_graph_data_anual.xls", sheet("FRED Graph") cellrange(D19:D29) clear
rename (D) (pce)
keep pce 
gen year = _n+1989
tempfile pce
save `pce'
restore
merge m:1 year using `pce'
replace tot_sic4_import_usitc = tot_sic4_import_usitc * (78.0905/pce)

  * Colors
local c1 "green"
local c2 "pink" 
local c3 "midblue"
replace tot_sic4_import_usitc = tot_sic4_import_usitc /1000
twoway (connected tot_sic4_import_usitc year if t_category == 1, lwidth(medthin) lpattern(dash) lcolor(`c1') msymbol(+) mcolor(`c1') msize(medsmall)) /// 
(connected tot_sic4_import_usitc year if t_category == 2, lwidth(medthin) lpattern(dash) lcolor(`c2') msymbol(Dh) mcolor(`c2') msize(medsmall)) /// 
(line tot_sic4_import_usitc year if t_category == 3, msymbol(T) lwidth(medthin) lpattern(dash) lcolor(`c3') mcolor(`c3') msize(medsmall)), /// 
ytitle("Total import values in millions of 2000 dollars") xtitle("") ylabel(,labsize(small)) xline(1993.5, lstyle(dot)) /// 
legend(on label(1 "zero tariff") label(2 "below-med. positive tariff") label(3 "above-med. positive tariff")) scheme(aspen)

graph export "$results/import_total_sum_by_tcategory_usitc.pdf", replace
  
 
/*----------------------------------------------------*/
   /* [>   Appendix Figure 3   <] */ 
/*----------------------------------------------------*/
foreach dataname in usitc com { 
use "$working_data/imports_sic_year.dta", clear
foreach year of numlist 1990/2000 {
  gen year_`year' = year==`year'
  gen init_w_wtariff_`year' = year_`year' * w_wtariff
}
drop init_w_wtariff_1993
replace tot_sic4_import_`dataname' = tot_sic4_import_`dataname' /1000
replace mex_to_row_tot = mex_to_row_tot /1000
replace row_to_usa_tot = row_to_usa_tot /1000

reghdfe tot_sic4_import_`dataname' init_w_wtariff_* mex_to_row_tot row_to_usa_tot, absorb(i.sic i.year) vce(cluster sic)
tempfile row_usa_mex_row
parmest, saving(`row_usa_mex_row', replace) format(parm estimate min95 max95)

* save and create plot 
use `row_usa_mex_row', clear
rename (estimate min95 max95) (estimate_row_usa_mex_row min95_row_usa_mex_row max95_row_usa_mex_row )

drop if parm == "mex_to_row_tot" | parm == "row_to_usa_tot"
gen year = .
local year_list 1990 1991 1992 1993 1994 1995 1996 1997 1998 1999 2000
* sorting results and including reference year  
foreach year of local year_list {
  replace year = `year' if strpos(parm, "`year'")>0
}
set obs `=_N+1'
replace year = 1993 if estimate_row_usa_mex_row == .
replace estimate_row_usa_mex_row  = 0 if year == 1993

sort year

  forval i = 1/4 { 
  gen year`i' = year+0.15*`i'
  }
  set scheme aspen

  * common graph style
    essty_main
    
  ** replace constant as missing for graph
  foreach v of varlist estimate* min95* max95* {
    replace `v' = . if parm == "_cons"
  }
  * plot 

format estimate* min95* max95* %10.1e
  * Legend Position 
local pos 11
local size vsmall
set scheme aspen

      * Graph
  #d ; 
  twoway  /* Scatter */
      (scatter estimate_row_usa_mex_row year, `r(es_sct1_sty)')

      /* Confidence intervals */
      (rcap min95_row_usa_mex_row max95_row_usa_mex_row year if year~=1993, `r(es_ci1_sty)')

  , scheme(aspen) 
  legend(off)
    /*legend(label(1 "US Imports from ROW, Mex Exports to ROW")*/
  /*    cols(1) pos(`pos') ring(0) size(`size') )*/

  /* Axis titles/labels */
  ylabel(,format(%5.0f) labsize(small)) 
  ytitle("Coeff. on Weighted 1990 Tariff x Year" "In millions of dollars", size(medsmall)) 
  xlabel(1990(2)2000, angle(30)) 
  xtitle("")
  /* Lines, etc. */
  yline(0, lstyle(dot)) 
  xline(1993, lcolor(dot)) 
  /* ysc(r(`min' `max')) */
  /* ylabel(`min'(`gap')`max') */
  xsize(20) ysize(11)
  ;
  #d cr
  graph export "$results/ES_mex_imports_1990_tarrifs_`dataname'.pdf", replace
}

  

 
/*----------------------------------------------------*/
   /* [>   Appendix Figure 4   <] */ 
/*----------------------------------------------------*/
foreach dataname in usitc com { 
use "$working_data/imports_sic_year.dta", clear
foreach year of numlist 1990/2000 {
  gen year_`year' = year==`year'
  gen init_log_w_wtariff_`year' = year_`year' * log_w_wtariff
}
drop init_log_w_wtariff_1993
gen log_tot_sic4_import_`dataname' = log(tot_sic4_import_`dataname') 
gen log_mex_to_row_tot = log(mex_to_row_tot) 
gen log_row_to_usa_tot = log(row_to_usa_tot) 


reghdfe log_tot_sic4_import_`dataname' init_log_w_wtariff_* log_mex_to_row_tot log_row_to_usa_tot, absorb(i.sic i.year) vce(cluster sic)
tempfile row_usa_mex_row
parmest, saving(`row_usa_mex_row', replace) format(parm estimate min95 max95)

* save and create plot 
use `row_usa_mex_row', clear
rename (estimate min95 max95) (estimate_row_usa_mex_row min95_row_usa_mex_row max95_row_usa_mex_row )


gen year = .
local year_list 1990 1991 1992 1993 1994 1995 1996 1997 1998 1999 2000
* sorting results and including reference year  
foreach year of local year_list {
  replace year = `year' if strpos(parm, "`year'")>0
}
  set obs `=_N+1'
  replace year = 1993 if estimate_row_usa_mex_row == .
  replace estimate_row_usa_mex_row  = 0 if year == 1993

    sort year

  forval i = 1/4 { 
  gen year`i' = year+0.15*`i'
  }
  set scheme aspen

  * common graph style
    essty_main
    
  ** replace constant as missing for graph
  foreach v of varlist estimate* min95* max95* {
    replace `v' = . if parm == "_cons"
  }
  * plot 

format estimate* min95* max95* %10.1e
  * Legend Position 
local pos 11
local size vsmall
set scheme aspen

      * Graph
  #d ; 
  twoway  /* Scatter */
      (scatter estimate_row_usa_mex_row year, `r(es_sct1_sty)')

      /* Confidence intervals */
      (rcap min95_row_usa_mex_row max95_row_usa_mex_row year if year~=1993, `r(es_ci1_sty)')

  , scheme(aspen) 
  legend(off)
    /*legend(label(1 "US Imports from ROW, Mex Exports to ROW")*/
  /*    cols(1) pos(`pos') ring(0) size(`size') )*/

  /* Axis titles/labels */
  ylabel(,format(%5.0f) labsize(small)) 
  ytitle("Coeff. on Weighted 1990 Tariff x Year" "In millions of dollars", size(medsmall)) 
  xlabel(1990(2)2000, angle(30)) 
  xtitle("")
  /* Lines, etc. */
  yline(0, lstyle(dot)) 
  xline(1993, lcolor(dot)) 
  /* ysc(r(`min' `max')) */
  /* ylabel(`min'(`gap')`max') */
  xsize(20) ysize(11)
  ;
  #d cr
  graph export "$results/ES_log_mex_imports_1990_log_tarrifs_`dataname'.pdf", replace
}
  
 
/*----------------------------------------------------*/
   /* [>   Appendix Figure 5    <] */ 
/*----------------------------------------------------*/
use "$working_data/master_county_year_final", clear 
keep if year == 1990
xtile county_quartile=county_vul_own, n(4)
keep county county_quartile
merge 1:m county using "$working_data/master_county_year_final", nogen keep(matched)
keep if inrange(year, 1986,2008)
collapse (mean) log_emptot, by(county_quartile year)

bysort county_quartile : egen log_emptot_baseyr = max(log_emptot / (year == 1993))

gen normalized_log_emptot = log_emptot - log_emptot_baseyr 

* normalized var version    
raw_plot normalized_log_emptot county_quartile
graph export "$results/normalized_log_emp_series_by_cty_quartile_extended.pdf", replace
 

/*----------------------------------------------------*/
   /* [>   Appendix Figure 6   <] */ 
/*----------------------------------------------------*/
use "$working_data/master_county_year_final.dta", clear
keep if inrange(year,1986,2008)
keep if !missing(county_vul_own_imp_1990)
ES log_emptot , indvar(county_vul_own_1990) version("baseline") spec("two") scaled("no") baseyear(1993) pos(7)
rename (estimate_styr min95_styr max95_styr) (estimate_styr_orig min95_styr_orig max95_styr_orig)
tempfile orig 
save `orig'
use "$working_data/master_county_year_final.dta", clear
keep if inrange(year,1986,2008)
ES log_emptot , indvar(county_vul_own_imp_1990) version("baseline") spec("two") scaled("no") baseyear(1993) pos(7)
merge 1:1 year using `orig', nogen

gen year1 = year+.15
#d ;
  twoway  (connected estimate_styr_orig year1,  mcolor(dkorange) lcolor(dkorange) msize(small) msymbol(circle) lpattern(dash) yline(0, lstyle(dot)) ) 
    (rcap min95_styr_orig max95_styr_orig year1 if year~=1993, lcolor(dkorange))  
    (connected estimate_styr year , yaxis(2) mcolor(green) lcolor(green) msymbol(plus) msize(small) lpattern(solid) yline(0, lstyle(dot)) xline(1993, lstyle(dot))) 
    (rcap min95_styr max95_styr year if year~=1993, yaxis(2) lcolor(green)) 
  , scheme(aspen)   
  legend(on order(1 "Vul. measure : Log Employment, State x Yr. FE" 3 "Vul. imputed measure  : Log Employment, State x Yr. FE") cols(1) ring(2) size(small)) 
  //xlabel(`=`ymin'-1'(2)`=`ymax'+1' ,  labsize(small) angle(30))  ylabel(,labsize(small))
  xlabel(1986(2)2008 ,  labsize(small) angle(30))  ylabel(,labsize(small)) ylabel(,axis(2) labsize(small))
  ytitle("Coeff. on Vul. index x Year", axis(1)) ytitle("Coeff. on imputed Vul. index x Year", axis(2))
  xtitle("")
    /* Lines, etc. */
  yline(0, lstyle(dot)) 
  xline(1993, lstyle(dot)) 
  ;
#d cr
graph export "$results/log_emp_init_vul_imp_interact_baseline_1by1_ext.pdf", replace 
  
 
