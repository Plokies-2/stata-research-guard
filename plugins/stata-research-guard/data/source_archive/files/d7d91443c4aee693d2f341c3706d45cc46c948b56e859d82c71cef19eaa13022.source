/**********************************************************************/
/*  SECTION 4: Appendix Tables        
    Notes: */
/**********************************************************************/
 
/*----------------------------------------------------*/
   /* [>   Appendix Table A1   <] */ 
/*----------------------------------------------------*/
  
use "$working_data/anes_cumul_cleaned.dta", clear

gen some_coll=hs_top==0 & coll_grad==0 if coll_grad<. 

label var some_coll "Some college, no BA degree" 
label var coll_grad "Has BA degree" 

**Create a list of demographic control variables that excludes educ vars so that they don't appear twice in the regressions 
local controls_demog_ex_ed "white hisp_yes male ln_fam_inc ln_fam_inc_dummy age" 
local controls_issues "abortion_clean abortion_dummy mostly_trust_gov bl_th_cumul bl_th_cumul_dummy" 
eststo clear 

eststo: reg favor_limits coll_grad if year<2016 , cl(state) robust 
sum `e(depvar)' if e(sample)==1 
estadd scalar dv_mean=`r(mean)' 
estadd local st_fe "No" 
estadd local drop_dk "No" 
estadd local demog "No" 
estadd local polit "No" 

eststo: reg favor_limits coll_grad some_coll if year<2016 , cl(state) robust 
sum `e(depvar)' if e(sample)==1 
estadd scalar dv_mean=`r(mean)' 
estadd local st_fe "No" 
estadd local drop_dk "No" 
estadd local demog "No" 
estadd local polit "No" 

eststo: reg favor_limits coll_grad `controls_demog_ex_ed'  if year<2016 , cl(state) robust 
sum `e(depvar)' if e(sample)==1 
estadd scalar dv_mean=`r(mean)' 
estadd local st_fe "No" 
estadd local drop_dk "No" 
estadd local demog "Yes" 
estadd local polit "No" 

eststo: reg favor_limits coll_grad `controls_demog_ex_ed' `controls_issues' if year<2016 , cl(state) robust 
sum `e(depvar)' if e(sample)==1 
estadd scalar dv_mean=`r(mean)' 
estadd local st_fe "No" 
estadd local drop_dk "No" 
estadd local demog "Yes" 
estadd local polit "Yes" 

eststo: areg favor_limits coll_grad `controls_demog_ex_ed' `controls_issues' if year<2016 , cl(state) robust abs(state)
sum `e(depvar)' if e(sample)==1 
estadd scalar dv_mean=`r(mean)' 
estadd local st_fe "Yes" 
estadd local drop_dk "No" 
estadd local demog "Yes" 
estadd local polit "Yes" 

eststo: areg favor_limits_ex_dk coll_grad `controls_demog_ex_ed' `controls_issues' if year<2016 , cl(state) robust abs(state)
sum `e(depvar)' if e(sample)==1 
estadd scalar dv_mean=`r(mean)' 
estadd local st_fe "No" 
estadd local drop_dk "Yes" 
estadd local demog "Yes" 
estadd local polit "Yes" 

#d ;
local esttab_cmd `"se brackets nostar stats(dv_mean demog polit st_fe drop_dk N, 
labels("Dept. var. mean" "Demog. covars" "Issue covars" "State FE" "Ex. DK" "Observations")) keep(coll_grad some_coll) nomtitles label wrap varwidth(22)"' ;

esttab, `esttab_cmd';
esttab using "$results/educ_protectionism.tex", replace booktabs fragment
`esttab_cmd'
mgroups("Dept. var: Favor more limits on trade", pattern(1 0 0 0 0 0) prefix(\multicolumn{@span}{c}{) suffix(}) span erepeat(\cmidrule(lr){@span})) ;
#d cr
  
 
/*----------------------------------------------------*/
   /* [>   Appendix Table A2   <] */ 
/*----------------------------------------------------*/

use "$working_data/master_county_year_final.dta", clear
keep if inlist(year, 1980,1984,1988,1992,1996,2000,2004,2008,2012,2016)
ES tot_pres_rep_share , indvar(county_vul_own_1990) version("pres") spec("full") scaled("no") baseyear(1992) pos(11)
tempfile coeff_tot_pres_rep_share 
save `coeff_tot_pres_rep_share', replace 

use "$working_data/master_county_year_final.dta", clear
keep if inlist(year, 1980,1984,1988,1992,1996,2000,2004,2008,2012,2016)
ES tot_pres_dem_share , indvar(county_vul_own_1990) version("pres") spec("full") scaled("no") baseyear(1992) pos(7)
tempfile coeff_tot_pres_dem_share 
save `coeff_tot_pres_dem_share', replace 


append using `coeff_tot_pres_rep_share' 
gen party = cond(_n < 11, "democrat", "republican")
drop estimate_dem_styr_manushare-max95_dem_styr_manushare

replace party="D" if party=="democrat" 
replace party="R" if party=="republican" 

**Reshape wide by party 
reshape wide estimate_did-max95_styr_colgrad , i(year) j(party) string  

sort year 

keep year estimate_styrD estimate_styrR
tempfile coeff_file
save `coeff_file', replace 

use "$working_data/master_county_year_final.dta", clear 
keep if inlist(year, 1980,1984,1988,1992,1996,2000,2004,2008,2012,2016)
levelsof year, local(year_list)
foreach year of local year_list {
  gen year_`year' = (year == `year')
  gen init_cty_vul_`year' = year_`year' * county_vul_own_1990 
}
*restrict to analysis sample 
qui: reghdfe tot_pres_rep_share tot_pres_dem_share county_vul_own_1990 [weight = cty_pop_1990], absorb(county year i.fipstate#year ///
   c.d_tradeotch_pw_lag#i.year c.share_colgrad_1990#i.year c.manu_share_1990#i.year) cluster(fipstate) 
qui: bys county: egen cty_tot = total(e(sample))
qui: unique year if e(sample) == 1 
qui: gen samp = 1 if cty_tot == r(unique)
keep if samp == 1
sort year 

merge m:1 year using `coeff_file' 

***Hand-fix Miami-Dade 
***It had FIPS code 12025 up through 1988 and then switches to 12086 
***Note that this is hard-coded for the moment!!!! 

**Change county code from 12025 to 12086 
replace county=12086 if county==12025 

egen dem_st = total(pres_dem_vote), by(fipstate year) 
egen rep_st = total(pres_rep_vote), by(fipstate year) 
 
gen d_won=dem_st>rep_st if dem_st<. & rep_st<. 

gen dem_margin=dem_st-rep_st 

gen dem_margin_pp=(dem_st-rep_st)/(dem_st + rep_st) 


***Merge crosswalk to get the names of each state for the final tables 

drop _merge 
rename fipstate state_fips
sort state_fips 
merge m:1 state_fips using "$working_data/state_cross.dta", keep(matched master) 


*********************************************************** 
****    Merge in electoral votes for relevant elections 
*********************************************************** 
cap drop _merge 

preserve 

import excel using "$raw_data/leip/Pres_Election_Data_1996.xls",  sheet("State") first clear cellrange(A2:B53)   

rename ElecVote EV_92_00 

rename A state_name 
replace state_name="Washington DC" if state_name=="District of Columbia" 
sort state_name 

tempfile EVs_92_00 
save `EVs_92_00' 

import excel using "$raw_data/leip/Pres_Election_Data_2000.xls",  sheet("State") first clear cellrange(A2:N53) 
keep A L N 
rename (A L N) (state_name dem_st_pres_votes_00 rep_st_pres_votes_00)
tempfile st_00 
save `st_00'

import excel using "$raw_data/leip/Pres_Election_Data_2004.xls",  sheet("State") first clear cellrange(A2:N53) 
keep A Democratic Republican
rename (A Democratic Republican) (state_name dem_st_pres_votes_04 rep_st_pres_votes_04)
tempfile st_04 
save `st_04'

import excel using "$raw_data/leip/Pres_Election_Data_2008.xls",  sheet("State") first clear cellrange(A2:N53)   
keep A ElecVote Democratic Republican 
rename (A ElecVote Democratic Republican) (state_name EV_02_10 dem_st_pres_votes_08 rep_st_pres_votes_08)
replace state_name="Washington DC" if state_name=="District of Columbia" 
sort state_name 
tempfile EVs_02_10 
save `EVs_02_10' 

import excel using "$raw_data/leip/Pres_Election_Data_2012.xlsx",  sheet("State") first clear cellrange(A2:N53)   
keep A ElecVote Democratic Republican 
rename (A ElecVote Democratic Republican) (state_name EV_12_20 dem_st_pres_votes_12 rep_st_pres_votes_12)
replace state_name="Washington DC" if state_name=="District of Columbia" 
sort state_name 
tempfile EVs_12_20 
save `EVs_12_20' 

restore 

sort state_name 

merge m:1 state_name using `EVs_92_00' 
tab _merge 
drop _merge 

merge m:1 state_name using `EVs_02_10' 
tab _merge 
drop _merge 

merge m:1 state_name using `EVs_12_20' 
tab _merge 
drop _merge 

merge m:1 state_name using `st_00' 
tab _merge 
drop _merge 

merge m:1 state_name using `st_04' 
tab _merge 
drop _merge 

drop if missing(county)
***Map each EV distribution to the appropriate election and state votes 

gen EVs=EV_92_00 if year>1991 & year<2001 
replace EVs=EV_02_10 if year>2001 & year<2011 
replace EVs=EV_12_20 if year>2011 & year<2021 

gen dem_st_pres_votes = dem_st_pres_votes_00 if year == 2000 
replace dem_st_pres_votes = dem_st_pres_votes_04 if year == 2004
replace dem_st_pres_votes = dem_st_pres_votes_08 if year == 2008
replace dem_st_pres_votes = dem_st_pres_votes_12 if year == 2012

gen rep_st_pres_votes = rep_st_pres_votes_00 if year == 2000 
replace rep_st_pres_votes = rep_st_pres_votes_04 if year == 2004
replace rep_st_pres_votes = rep_st_pres_votes_08 if year == 2008
replace rep_st_pres_votes = rep_st_pres_votes_12 if year == 2012

***Create a tag for state-year 
egen tag_st_yr=tag(state_fips year) 


***One thing we could do is examine effect on the entire South 

gen south_census=inlist(state_fips, 10, 12, 13, 24, 37, 45, 51, 54, 1, 21, 28, 47, 5, 22, 40, 48) 


********************************************************************************* 

****  Simulate effects if you could `remove' NAFTA effect for post-1992 elections 

********************************************************************************* 

***Simulate the change from year y relative to 1992, removing NAFTA 
gen sim_sh_cty_styr_d=tot_pres_dem_share - county_vul_own_1990*estimate_styrD 
gen sim_sh_cty_styr_r=tot_pres_rep_share - county_vul_own_1990*estimate_styrR 
***Translate to total predicted *votes* 
gen sim_v_cty_styr_d=sim_sh_cty_styr_d*pres_tot_vote 
gen sim_v_cty_styr_r=sim_sh_cty_styr_r*pres_tot_vote 
***Now, take these votes and sum to the state-year level 
egen sim_st_styr_d=total(sim_v_cty_styr_d), by(state_fips year) 
egen sim_st_styr_r=total(sim_v_cty_styr_r), by(state_fips year) 
***Simulate who wins the state ex. NAFTA effect 
gen d_win_styr_sim=sim_st_styr_d > sim_st_styr_r if sim_st_styr_d<. & sim_st_styr_r<. 
gen d_margin_styr_sim=sim_st_styr_d - sim_st_styr_r 
gen d_marg_styr_pp = (sim_st_styr_d - sim_st_styr_r)/(sim_st_styr_d + sim_st_styr_r) 
gen delta_margin_styr = d_margin_styr_sim - dem_margin 

di "List states that would have been flipped to WIN under styr in `y' " 
***Recall, hand-drop Virginia (fips 51) bc we are missing counties 
foreach y in 2000 2004 2008 2012 { 
tab state_fips if year==`y' & d_win_styr_sim==1 & d_won==0 , matrow(flip_`y')  
svmat flip_`y', name(flip_list_`y') 
di "How many EVs would have flipped?" 
sum EVs if year==`y' & d_win_styr_sim==1 & d_won==0  & tag_st_y==1, d  
local flip_ev_`y'=`r(sum)' 
di "List states that woudl have been Less than 2 pt loss under styr in `y' " 
tab state_fips if year==`y' & dem_margin_pp<-.025 & d_marg_styr_pp>-.025 & d_marg_styr_pp<0  , matrow(closer_`y') 
svmat closer_`y', name(closer_list_`y') 
di "How many EVs would have been made closer?" 
sum EVs if year==`y' & dem_margin_pp<-.025 & d_marg_styr_pp>-.025 & d_marg_styr_pp<0 & tag_st_y==1, d  
local closer_ev_`y'=`r(sum)' 
  } 

***Generate a table with these results 

***First, create state name labels so they look nicer instead of FIPS codes 

label define fips_postal_labels ///
1 "AL" ///
2 "AK" ///
4 "AZ" ///
5 "AR" ///
6 "CA" ///
8 "CO" ///
9 "CT" ///
10  "DE" ///
11  "DC" ///
12  "FL" ///
13  "GA" ///
15  "HI" ///
16  "ID" ///
17  "IL" ///
18  "IN" ///
19  "IA" ///
20  "KS" ///
21  "KY" ///
22  "LA" ///
23  "ME" ///
24  "MD" ///
25  "MA" ///
26  "MI" ///
27  "MN" ///
28  "MS" ///
29  "MO" ///
30  "MT" ///
31  "NE" ///
32  "NV" ///
33  "NH" ///
34  "NJ" ///
35  "NM" ///
36  "NY" ///
37  "NC" ///
38  "ND" ///
39  "OH" ///
40  "OK" ///
41  "OR" ///
42  "PA" ///
72  "PR" ///
44  "RI" ///
45  "SC" ///
46  "SD" ///
47  "TN" ///
48  "TX" ///
49  "UT" ///
50  "VT" ///
51  "VA" ///
78  "VI" ///
53  "WA" ///
54  "WV" ///
55  "WI" ///
56  "WY" 

***Relabel all the little lists i made 
***Then turn into string variables 
***Then tack on at the end the locals I created for the total EVs
forval y=2000(4)2012 {
label values flip_list_`y' fips_postal_labels 
label values closer_list_`y' fips_postal_labels 
decode flip_list_`y', gen(flip_list_`y'_str) 
decode closer_list_`y', gen(closer_list_`y'_str) 
***Tack on at end of this variable/list the EV total calculated above 
replace flip_list_`y'_str="`flip_ev_`y''" if _n==5 
replace closer_list_`y'_str="`closer_ev_`y''" if _n==5 
}  

***Latex table formattng 

gen and="&" 
gen end="\\" 
gen start=and 
replace start="Electoral votes &" if _n==5 

outsheet start flip_list_2000_str and closer_list_2000_str and flip_list_2004_str and closer_list_2004_str ///
  and flip_list_2008_str and closer_list_2008_str and flip_list_2012_str and closer_list_2012_str ///
  end if _n<6 using "$results/elex_sim.tex" , replace nonames noquote 


  
/*----------------------------------------------------*/
   /* [>   Appendix Table A3   <] */ 
/*----------------------------------------------------*/
use "$working_data/anes_cumul_cleaned.dta", clear

local controls_demog "white  hisp_yes male hs_top coll_grad ln_fam_inc ln_fam_inc_dummy age " 
local controls_issues "abortion_clean abortion_dummy mostly_trust_gov bl_th_cumul bl_th_cumul_dummy " 

lab var favor_limits "Favor import limits"

gen like_perot=. 
forval y=92(4)96 { 
replace like_perot=like_perot_`y' if year==19`y' 
} 

eststo clear 

eststo: reg like_perot favor_limits i.year , cl(state) 
sum `e(depvar)' if e(sample)==1 
estadd scalar dv_mean=`r(mean)' 
estadd local yr_fe "No" 
estadd local samp "None" 
estadd local dem_controls "Yes" 
estadd local issue_controls "No" 
estadd local st_fe "No" 

eststo: reg like_perot favor_limits `controls_demog' i.year , cl(state) 
sum `e(depvar)' if e(sample)==1 
estadd scalar dv_mean=`r(mean)' 
estadd local yr_fe "Yes" 
estadd local samp "None" 
estadd local dem_controls "Yes" 
estadd local issue_controls "No" 
estadd local st_fe "No" 

eststo: reg like_perot favor_limits `controls_demog' `controls_issues' i.year , cl(state) 
sum `e(depvar)' if e(sample)==1 
estadd scalar dv_mean=`r(mean)' 
estadd local yr_fe "Yes" 
estadd local samp "None" 
estadd local dem_controls "Yes" 
estadd local issue_controls "Yes" 
estadd local st_fe "No" 

eststo: areg like_perot favor_limits `controls_demog' `controls_issues' i.year , cl(state) abs(state) 
sum `e(depvar)' if e(sample)==1 
estadd scalar dv_mean=`r(mean)' 
estadd local yr_fe "Yes" 
estadd local samp "None" 
estadd local dem_controls "Yes" 
estadd local issue_controls "Yes" 
estadd local st_fe "Yes" 

eststo: reg like_perot favor_limits `controls_demog' `controls_issues' i.year if year==1992 , cl(state) 
sum `e(depvar)' if e(sample)==1 
estadd scalar dv_mean=`r(mean)' 
estadd local yr_fe "No" 
estadd local samp "1992 only" 
estadd local dem_controls "Yes" 
estadd local issue_controls "Yes" 
estadd local st_fe "No" 

eststo: reg like_perot favor_limits `controls_demog' `controls_issues' i.year if year==1996 , cl(state)  
sum `e(depvar)' if e(sample)==1 
estadd scalar dv_mean=`r(mean)' 
estadd local yr_fe "No" 
estadd local samp "1996 only" 
estadd local dem_controls "Yes" 
estadd local issue_controls "Yes" 
estadd local st_fe "No" 

#d ;
local esttab_cmd "se brackets keep(favor_limits ) nostar nomtitles label wrap varwidth(18)
stats(dv_mean dem_controls issue_controls st_fe samp N, labels("Dept. var. mean" "Demog. covars" "Issue covars" "State FE" "Sample criteria" "Observations")) " ;

esttab, `esttab_cmd' ;

esttab using "$results/perot_tab.tex", replace fragment booktabs `esttab_cmd'
mgroups("Dept. variable: Approves of Perot", pattern(1 0 0  0 0 0) prefix(\multicolumn{@span}{c}{) suffix(}) span erepeat(\cmidrule(lr){@span}))   ;
#d cr
  
 

/*----------------------------------------------------*/
   /* [>   Appendix Table A4   <] */ 
/*----------------------------------------------------*/
use "$working_data/anes_92_97.dta", clear
order st*
//destring state, replace force
replace fipstate = state_1996 if missing(fipstate)
replace fipstate = state_1994 if missing(fipstate)
replace fipstate = state_1992 if missing(fipstate)

*****Table 
eststo clear 
local controls_demog "white_1992 black_1992 male_1992 yrs_ed age_1992 ln_fam_inc_1992 ln_fam_inc_1992_dummy rural CC " 
local controls_issues_classic "help_blacks_1992_clean role_gov_1992_clean abortion_1992_clean weekly_relig inc_imm_1992" 
local controls_issues_recent "oppose_gays_military health_reform_1992_clean favor_term_limit" 

tab   help_blacks_1992 help_blacks_1992_clean, m
recode  help_blacks_1992_clean (5 6 7=1) (0 1 2 3 4=0)

tab   role_gov_1992 role_gov_1992_clean, m
recode  role_gov_1992_clean (5 6 7=1) (0 1 2 3 4=0)

tab   abortion_1992 abortion_1992_clean, m
recode  abortion_1992_clean (4=1) (0 1 2 3=0)

tab   health_reform_1992 health_reform_1992_clean, m
recode  health_reform_1992_clean (5 6 7=1) (0 1 2 3 4=0)

***Label vars for the table 
label var dislike_nafta_dk "Oppose NAFTA" 
label var coll_grad_1992 "College grad" 
label var union_hh_1992 "Union household (dummy)" 

gen move_right_92_94_100=move_right_92_94*100 
label var move_right_92_94_100 "Moved right between 1992, 1993 (x 100)" 

eststo clear 

eststo: reg move_right_92_94_100 dislike_nafta_dk  [pw = V923008] if move_right_92_94<. , robust cluster(fipstate) 
sum `e(depvar)' if e(sample)==1 
estadd scalar dmean = `r(mean)' 
estadd local year "1992-94" 
estadd local ex_dk "No" 
estadd local stfe "No" 
estadd local demog "No" 

eststo: reg move_right_92_94_100 dislike_nafta_dk  [pw = V923008] if move_right_92_94<. & dk_nafta==0 , robust cluster(fipstate) 
sum `e(depvar)' if e(sample)==1 
estadd scalar dmean = `r(mean)' 
estadd local year "1992-94" 
estadd local ex_dk "Yes" 
estadd local stfe "No" 
estadd local demog "No" 

eststo: reg move_right_92_94_100 dislike_nafta_dk `controls_demog'  [pw = V923008] if move_right_92_94<.  , robust cluster(fipstate) 
sum `e(depvar)' if e(sample)==1 
estadd scalar dmean = `r(mean)' 
estadd local year "1992-94" 
estadd local ex_dk "No" 
estadd local stfe "No" 
estadd local demog "Yes" 

eststo: reg move_right_92_94_100 dislike_nafta_dk `controls_demog' `controls_issues_classic'  [pw = V923008] if move_right_92_94<.  , robust cluster(fipstate) 
sum `e(depvar)' if e(sample)==1 
estadd scalar dmean = `r(mean)' 
estadd local year "1992-94" 
estadd local ex_dk "No" 
estadd local stfe "No" 
estadd local demog "Yes" 

eststo: reg move_right_92_94_100 dislike_nafta_dk `controls_demog' `controls_issues_classic' `controls_issues_recent' [pw = V923008]  if move_right_92_94<.  , robust cluster(fipstate) 
sum `e(depvar)' if e(sample)==1 
estadd scalar dmean = `r(mean)' 
estadd local year "1992-94" 
estadd local ex_dk "No" 
estadd local stfe "No" 
estadd local demog "Yes" 

local baseline_beta_nafta = _b[dislike_nafta_dk] 

eststo: areg move_right_92_94_100 dislike_nafta_dk `controls_demog' `controls_issues_classic' `controls_issues_recent' [pw = V923008]  if move_right_92_94<.  , absorb(fipstate) robust cluster(fipstate) 
sum `e(depvar)' if e(sample)==1 
estadd scalar dmean = `r(mean)' 
estadd local year "1992-94" 
estadd local ex_dk "No" 
estadd local stfe "Yes" 
estadd local demog "Yes" 

esttab , drop(_cons *dummy* white_1992 black_1992 male_1992 yrs_educ age_1992 ln_fam_inc_1992 rural CC*) se brackets nostar stats(dmean ex_dk demog stfe r2 N, label("Dept. var. mean" "Ex. DK"  "Demog. covars" "State FE" "R-squared" "Observations")) nomtitles label wrap nogaps

esttab using "$results/panel_nafta_move_right_92_94_100.tex", ///
replace fragment booktabs nostar se brackets ///
drop(_cons *dummy* white_1992 black_1992 male_1992 yrs_educ age_1992 ln_fam_inc_1992 rural CC*) ///
label wrap varwidth(25) stats(dmean ex_dk demog stfe r2 N, label("Dept. var. mean" "Ex. DK"  "Demog. covars" "State FE" "R-squared" "Observations")) ///
mgroups( "Move in Repub direction dummy x 100", pattern(1 0 0 0 0 0) prefix(\multicolumn{@span}{c}{) suffix(}) span erepeat(\cmidrule(lr){@span})) nomtitles nogaps 
  

  

/*------------------------------------ End of SECTION 4 ------------------------------------*/


/**********************************************************************/
/*  SECTION 5: Appendix C Randomization Inference and AKM SE Robustness        
    Notes: */
/**********************************************************************/
 
/*----------------------------------------------------*/
   /* [>   Appendix Figures C 1-8   <] */ 
/*----------------------------------------------------*/
set seed $myseed 
use "$working_data/vulnerability_sim.dta", clear

local dep_var_list tp_pres_rsh log_emptot
local reps 1000
//local var tp_pres_rep_share
foreach var in `dep_var_list' {
  di "`var'"
if "`var'" == "tp_pres_rsh" {
  use "$working_data/master_county_year_final.dta", clear 
  merge m:1 county using "$working_data/vulnerability_sim.dta"
  rename tp_pres_rep_share tp_pres_rsh
  keep if inlist(year, 1980,1984,1988,1992,1996,2000,2004,2008,2012,2016)
  qui: reghdfe tot_pres_rep_share tot_pres_dem_share county_vul_own_1990 [weight = cty_pop_1990], absorb(county year i.fipstate#year ///
     c.d_tradeotch_pw_lag#i.year c.share_colgrad_1990#i.year c.manu_share_1990#i.year) cluster(fipstate) 
  qui: bys county: egen cty_tot = total(e(sample))
  qui: unique year if e(sample) == 1 
  qui: gen samp = 1 if cty_tot == r(unique)
  keep if samp == 1
  keep if inlist(year, 1984,1992,2000)
  local pre 1992
  local post 2000
}
else {
  use "$working_data/master_county_year_final.dta", clear 
  merge m:1 county using "$working_data/vulnerability_sim.dta"
  rename tp_pres_rep_share tp_pres_rsh
  keep if inrange(year,1986,2008) 
  reghdfe log_emptot county_vul_own_1990 [weight = cty_pop_1990], absorb(county year i.fipstate#year ///
   c.d_tradeotch_pw_lag#i.year c.share_colgrad_1990#i.year c.manu_share_1990#i.year) cluster(fipstate)
  qui: bys county: egen cty_tot = total(e(sample))
  qui: unique year if e(sample) == 1 
  qui: gen samp = 1 if cty_tot == r(unique)
  keep if samp == 1
  //bysort county: keep if _N == 23
  keep if inlist(year, 1986,1993, 2000)
  local pre 1993
  local post 2000
}
di "hello there"

rename (share_colgrad_1990 manu_share_1990)  (_scol _smnf)


keep `dep_var_list' county year cty_pop_1990 county_vul_own* fipstate _scol _smnf
bysort county (year) : gen `var'_diff = `var' - `var'[_n-1]

local cntrl_list "" "_smnf"
local year_list `pre' `post' 

foreach cntrl in `cntrl_list' {
  di "`cntrl'"
foreach yr in `year_list' {
    di "`year'"

  *original
  reghdfe `var'_diff county_vul_own_1990 `cntrl' if year == `yr' [weight=cty_pop_1990], absorb(fipstate) cluster(fipstate)
  local `var'_orig_coef_`yr'`cntrl' = round(_b[county_vul_own_1990], 0.001)
  local `var'_orig_se_`yr'`cntrl'   = round(_se[county_vul_own_1990], 0.001)
  di ``var'_orig_coef_`yr'`cntrl''
  di ``var'_orig_se_`yr'`cntrl''
  
  *matrices
  matrix coef_vec_ad = J(`reps',1,.)
  matrix coef_vec_uni = J(`reps',1,.)
  matrix coef_vec_au = J(`reps',1,.)
  
  forvalues r = 1/`reps' {
    di "`r'"
    preserve
    * randomizing sample
    bsample, cluster(fipstate) idcluster(newclust)  
    
    reghdfe `var'_diff county_vul_own_f`r' `cntrl' if year==`yr' [weight=cty_pop_1990],  ///
      absorb(newclust) cluster(newclust)
    matrix coef_vec_ad[`r',1] = _b[county_vul_own_f`r']
  
    reghdfe `var'_diff county_vul_own_funi`r' `cntrl' if year==`yr' [weight=cty_pop_1990], ///
      absorb(newclust)   cluster(newclust)
    matrix coef_vec_uni[`r',1] = _b[county_vul_own_funi`r']
  
    reghdfe `var'_diff county_vul_own_fau`r' `cntrl' if year==`yr' [weight=cty_pop_1990], ///
      absorb(newclust)  cluster(newclust)
    matrix coef_vec_au[`r',1] = _b[county_vul_own_fau`r']
    
  
  svmat double coef_vec_ad, name(coef_vec_ad)
  svmat double coef_vec_uni, name(coef_vec_uni)
  svmat double coef_vec_au, name(coef_vec_au)
  
  summarize coef_vec_ad
  local coef_ad_`var'_`yr'`cntrl' = round(`r(mean)', 0.001)
  local sd_ad_`var'_`yr'`cntrl' = round(`r(sd)' , 0.001)
  summarize coef_vec_uni
  local coef_uni_`var'_`yr'`cntrl' = round(`r(mean)', 0.001)
  local sd_uni_`var'_`yr'`cntrl' = round(`r(sd)' , 0.001)
  summarize coef_vec_au 
  local coef_au_`var'_`yr'`cntrl' = round(`r(mean)', 0.001)
  local sd_au_`var'_`yr'`cntrl' = round(`r(sd)' , 0.001)

  restore
  }
}
}
}
 

