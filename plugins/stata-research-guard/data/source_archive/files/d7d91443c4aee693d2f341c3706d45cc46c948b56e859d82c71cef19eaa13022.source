/*----------------------------------------------------*/
   /* [>   Appendix Figures C9   <] */ 
/*----------------------------------------------------*/

use "$working_data/akm_se.dta", replace
keep if inrange(year, 1986,2008) 
reghdfe log_emptot county_vul_own_1990 [weight = cty_pop_1990], absorb(county year i.fipstate#year ///
 c.d_tradeotch_pw_lag#i.year c.share_colgrad_1990#i.year c.manu_share_1990#i.year) cluster(fipstate)
qui: bys county: egen cty_tot = total(e(sample))
qui: unique year if e(sample) == 1 
qui: gen samp = 1 if cty_tot == r(unique)
keep if samp == 1
keep if inlist(year, 1986, 1993)
bysort county (year): gen log_emptot_diff = log_emptot - log_emptot[_n-1]

 
*make sample the same. 

keep if year == 1993 
reg log_emptot_diff county_vul_own_1990 dstate1-dstate49 manu_share_1990 [weight = cty_pop_1990]
keep if e(sample) ==1
local N = `e(N)'

*base
reg log_emptot_diff county_vul_own_1990 [weight = cty_pop_1990], vce(cluster fipstate)
local se_clus = round(_se[county_vul_own_1990], .001)

reg_ss log_emptot_diff, shiftshare_var(county_vul_own_1990) share_varlist(emp_sh1041-emp_sh3999) ///
  weight_var(cty_pop_1990) akmtype(1) ///
  path_cluster("$working_data/sic_3d.dta") cluster_var(sic_3d)

local coef_regss = round(_b[county_vul_own_1990], .001)
local se_akm = round(`e(se)', 0.001)
local se_rob = round(_se[county_vul_own_1990], .001)

*state FE
reg log_emptot_diff county_vul_own_1990 dstate1-dstate49 [weight = cty_pop_1990], vce(cluster fipstate)
local se_clus_stfe = round(_se[county_vul_own_1990], .001)

reg_ss log_emptot_diff, shiftshare_var(county_vul_own_1990) share_varlist(emp_sh1041-emp_sh3999) ///
  weight_var(cty_pop_1990) control_varlist(dstate1-dstate49) akmtype(1) ///
  path_cluster("$working_data/sic_3d.dta") cluster_var(sic_3d)

local coef_regss_stfe = round(_b[county_vul_own_1990], .001)
local se_akm_stfe = round(`e(se)', 0.001)
local se_rob_stfe = round(_se[county_vul_own_1990], .001)

*share colgrad 
