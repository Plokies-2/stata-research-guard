
// Controls	
	global Xs "ShPoor_11 matricula_total_11 prom_lect4b_rbd_11 prom_mate4b_rbd_11"
	global Xm "hm_extpoor_rate_11 h_ypchtot_11 unempl_rate_11 esc_11 literacy_rate_11"
	
// Scheme for figures	
	set scheme modern
	
*******************
** Figure 4: Principal Selection and Principal Effectiveness 
*******************	
{
	use "Data/clean/DataForRegressionsADP.dta", clear
	
	g d_4_t = EverADP * t == -4
	g d_3_t = EverADP * t == -3
	g d_2_t = EverADP * t == -2
	g d_1_t = EverADP * t == -1
	g d0_t = EverADP * t == 0
	g d1_t = EverADP * t == 1
	g d2_t = EverADP * t == 2
	g d3_t = EverADP * t == 3

	global T "d_4_t d_3_t d_2_t d0_t d1_t d2_t d3_t"
	
	* Panel A: No controls
		reghdfe SDall_fe_prin_2wayfe $T if t>=-4 & t <= 3 & year >= 2009 & year <= 2016 & sample == 1 , a(year rbd t) vce(cluster rbd)
		test d_4_t = d_3_t = d_2_t = 0
		preserve
				estimate store coef 
							
			* Create data set of reg coefficients and confidence intervals 
				parmest, norestore

			* Keep parameters of interest
				drop if _n > 7		
				rename t tstat

			* Time variable from and since event
	
				g       t = _n - 5 if _n <= 3
				replace t = _n - 4 if _n > 3								
								
			* Add coefficient in t == -1
				local tot = 1 + _N
				set obs `tot'
				replace t = -1 if _n == `tot'
				replace estimate = 0 if estimate == .
				replace min95 = 0 if min95 == .
				replace max95 = 0 if max95 == .
				sort t
							
			* Figure
				twoway (scatter estimate t, mc(navy)) (rcap min95 max95 t, lc(gs12) fc(gs12)), ///
					yline(0, lc(black) ) xline(-0.5, lc(navy) lw(medium) ) ///
					graphregion(color(white)) ///
					ylabel(-0.05(0.05)0.15, format(%9.2f)) /// 
					xlabel(-4(2)3) xtitle("Years since ADP") ///					
					graphregion(color(white)) /// 
					scale(1.3) ///
					legend(off)

			* Export 			
			graph export "Figures/Figure_4_A.pdf", replace
		restore
		
	* Panel B: Controls	
		reghdfe SDall_fe_prin_2wayfe $T if t>=-4 & t <= 3 & year >= 2009 & year <= 2016 & sample == 1 /*[aw=weight]*/, a(c.($Xs $Xm)#year year rbd t) vce(cluster rbd)
		test d_4_t = d_3_t = d_2_t = 0
			preserve
				estimate store coef 
							
			* Create data set of reg coefficients and confidence intervals 
				parmest, norestore

			* Keep parameters of interest
				drop if _n > 7	
				rename t tstat

			* Time variable from and since event

				g       t = _n - 5 if _n <= 3
				replace t = _n - 4 if _n > 3								
								
			* Add coefficient in t == -1
				local tot = 1 + _N
				set obs `tot'
				replace t = -1 if _n == `tot'
				replace estimate = 0 if estimate == .
				replace min95 = 0 if min95 == .
				replace max95 = 0 if max95 == .
				sort t
							
			* Figure
				twoway (scatter estimate t, mc(navy)) (rcap min95 max95 t, lc(gs12) fc(gs12)), ///
					yline(0, lc(black) ) xline(-0.5, lc(navy) lw(medium) ) ///
					graphregion(color(white)) ///
					ylabel(-0.05(0.05)0.15, format(%9.2f)) /// 
					xlabel(-4(2)3) xtitle("Years since ADP") ///					
					graphregion(color(white)) /// 
					scale(1.3) ///
					legend(off)
					
			* Export 			
			graph export "Figures/Figure_4_B.pdf", replace
			restore	
	
	* Panel C: Pre-Reform
	****** DATASET: Keep public
	use "Data/clean/Base_ADPAnalysis.dta", clear

	global contS "ShPoor matricula_total prom_lect4b_rbd prom_mate4b_rbd liquido_pago_student"
	global contM "hm_extpoor_rate h_ypchtot unempl_rate esc literacy_rate"	
		
	* Placebo treatment	
	rename PostChangePpal PostChangePpal_pre
	rename t_pla t_pla_pre
	rename MinYearPpalChange MinYearPpalChange_pre
	
	keep cod_com_rbd rbd year id_prin SDall_fe_prin_2wayfe fe_prin_2wayfe adp EverADP t Dmun $contS $contM ///
		PostChangePpal_pre t_pla_pre ///
		MinYearPpalChange_pre 
	
	rename adp PostChangePpal
	
	tempfile temp0
	save `temp0'.dta, replace
	
	
	****** DATASET: Keep private	
	use "Data/clean/ADPREG_TEMP.dta", clear	
	
	keep if Dmun == 0

	xtset rbd year
	g change_ppal = 1 if id_prin != l.id_prin
	g YearPpalChange = year if change_ppal == 1 & year >= 2010 & year <= 2011
	bys rbd: egen MinYearPpalChange = min(YearPpalChange)
	spread MinYearPpalChange, by(rbd)
	g t_pla_pre = year - MinYearPpalChange
	
	g EverChange = (MinYearPpalChange != .)
 
	g PostChangePpal_pre = 1 if (year >= MinYearPpalChange) 
	replace PostChangePpal_pre = 0 if PostChangePpal_pre == .
	cap drop t
	g t = year - MinYearPpalChange
	replace t = 0 if EverChange == 0
		
	keep cod_com_rbd rbd year id_prin SDall_fe_prin_2wayfe fe_prin_2wayfe PostChangePpal_pre t EverADP Dmun $contS $contM  ///
	 t_pla_pre 
	
// Append public and private
	append using `temp0'.dta
	
// Main treatment	
	g PostChangePpal_ADP = PostChangePpal * EverADP
	
	* Only Public: PLACEBO
	rename PostChangePpal aux
	rename PostChangePpal_pre PostChangePpal
	
	g PostChangePpal_Mun = PostChangePpal * Dmun
	
	reghdfe SDall_fe_prin_2wayfe PostChangePpal_Mun PostChangePpal if t_pla_pre>=-4 & t_pla_pre <= 3 & year >= 2009 & year <= 2012 , a(year rbd)  vce(cluster rbd)
	g sample = 1 if e(sample) == 1
	
	g t_4 = (t_pla_pre == -4) * Dmun
	g t_3 = (t_pla_pre == -3) * Dmun
	g t_2 = (t_pla_pre == -2) * Dmun
	g t0 = (t_pla_pre == 0) * Dmun
	g t1 = (t_pla_pre == 1) * Dmun
	g t2 = (t_pla_pre == 2) * Dmun
	g t3 = (t_pla_pre == 3) * Dmun
		
	global T "t_2 t0 t1"	
		
	reghdfe SDall_fe_prin_2wayfe $T if sample == 1 , abs(year rbd t_pla_pre)
	preserve
				estimate store coef 
						
				//Create data set of reg coefficients and confidence intervals 
				parmest, norestore

				//Keep parameters of interest
				drop if _n > 3
				rename t tstat
				
				g t = _n - (2+ 1) if _n <= (2 - 1)
				replace t = _n - 2 if _n > (2 - 1)
				
							
				//Add coefficient in t == -1
				local tot = 1 + _N
				set obs `tot'
				replace t = -1 if _n == `tot'
				replace estimate = 0 if estimate == .
				replace min95 = 0 if min95 == .
				replace max95 = 0 if max95 == .
				sort t
				
				//Figure
				twoway (scatter estimate t, mc(navy)) (rcap min95 max95 t, lc(gs12) fc(gs12)), ///
					yline(0, lc(black) ) xline(-0.5, lc(navy) lw(medium) ) ///
					graphregion(color(white)) ///
					ylabel(-0.05(0.05)0.15, format(%9.2f)) /// 
					xlabel(-2(1)1) xtitle("Years since ADP") ///					
					graphregion(color(white)) /// 
					scale(1.3) ///
					legend(off)
	
		graph export "Figures/Figure_4_C.pdf", replace
	restore
	
	
	* Panel D: Controls		
	use "Data/clean/Base_ADPAnalysis.dta", clear
	
	global contS "ShPoor matricula_total prom_lect4b_rbd prom_mate4b_rbd liquido_pago_student"
	global contM "hm_extpoor_rate h_ypchtot unempl_rate esc literacy_rate"	
		
	* Placebo treatment	
	rename PostChangePpal PostChangePpal_pre
	rename t_pla t_pla_pre
	rename MinYearPpalChange MinYearPpalChange_pre
	
	keep cod_com_rbd rbd year id_prin SDall_fe_prin_2wayfe fe_prin_2wayfe adp EverADP t Dmun $contS $contM ///
		ShareAttend prom_lect4b_rbd prom_mate4b_rbd churn_teach churn_teach_young denuncias_total ///
		EverTeacher EverSupportWorker EverAdministrative EverPrincipal ///
		EverPrivate mat_prekinder mat_kinder mat_basica_1 rural_rbd PostChangePpal_pre t_pla_pre ///
		MinYearPpalChange_pre matricula_total liquido_pago_student rural_rbd  porc_conc_DatosAbiertos ///
		hm_extpoor_rate h_ypchtot unempl_rate ///
		esc EverTeacher EverSupportWorker EverAdministrative EverPrivate CollegeDegree Edad Female	
		
	keep if year >= 2009 & year <= 2016	
	
	g t_4 = (t == -4)
	g t_3 = (t == -3)
	g t_2 = (t == -2)
	g t0 = (t == 0)
	g t1 = (t == 1)
	g t2 = (t == 2)
	g t3 = (t == 3)
	replace t0 = 0 if EverADP == 0	
	
	
	global T "t_4 t_3 t_2 t0 t1 t2 t3" 
	reghdfe SDall_fe_prin_2wayfe $T if t >=-4 & t <=3, abs(year rbd)
	test t_4 = t_3 = t_2 = 0 
	preserve
				estimate store coef 
						
				//Create data set of reg coefficients and confidence intervals 
				parmest, norestore

				//Keep parameters of interest
				drop if _n > 7
				rename t tstat
				
				g t = _n - (4+ 1) if _n <= (4 - 1)
				replace t = _n - 4 if _n > (4 - 1)
				
							
				//Add coefficient in t == -1
				local tot = 1 + _N
				set obs `tot'
				replace t = -1 if _n == `tot'
				replace estimate = 0 if estimate == .
				replace min95 = 0 if min95 == .
				replace max95 = 0 if max95 == .
				sort t
				
				//Figure
				twoway (scatter estimate t, mc(navy)) (rcap min95 max95 t, lc(gs12) fc(gs12)), ///
				yline(0, lc(black) ) xline(-0.7, lc(navy) lw(medium) ) ///
				graphregion(color(white)) /// 
				scale(1.3) ///
				ylabel(-0.05(0.05)0.15, format(%9.2f)) /// 
				xlabel(-4(2)3) xtitle("Year since event") ///
				graphregion(color(white)) /// 
				legend(off) 
	
		graph export "Figures/Figure_4_D.pdf", replace
	restore		
}			
	
