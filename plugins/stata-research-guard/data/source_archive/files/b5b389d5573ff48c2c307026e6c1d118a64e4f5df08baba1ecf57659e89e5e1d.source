	reghdfe attendance_grado9_12 d_2_t d0_t d1_t d2_t d3_t if t>=-2 & t <= 3 & year >= 2011 & year <= 2016 & sample == 1, a(year rbd t) vce(cluster rbd)
		test d_2_t = 0
		preserve
			estimate store coef 
							
			* Create data set of reg coefficients and confidence intervals 
				parmest, norestore

			* Keep parameters of interest
				drop if _n > 5		
				rename t tstat

			* Time variable from and since event
	
				g       t = _n - 3 if _n <= 1
				replace t = _n - 2 if _n > 1								
								
			* Add coefficient in t == -1
				local tot = 1 + _N
				set obs `tot'
				replace t = -1 if _n == `tot'
				replace estimate = 0 if estimate == .
				replace min95 = 0 if min95 == .
				replace max95 = 0 if max95 == .
				sort t
							
			* Figure
				twoway (scatter estimate t, mc(navy)) (rcap min95 max95 t, lc(gs12) fc(gs12)), ///
					yline(0, lc(black) ) xline(-0.5, lc(navy) lw(medium) ) ///
					graphregion(color(white)) ///
					ylabel( , format(%9.2f)) /// 
					xlabel(-2(2)3) xtitle("Years since ADP") ///					
					graphregion(color(white)) /// 
					scale(1.3) ///
					legend(off)

			* Export 			
				graph export "Figures/Figure_A_10_D.pdf", replace
		restore		
		
		
		
}

