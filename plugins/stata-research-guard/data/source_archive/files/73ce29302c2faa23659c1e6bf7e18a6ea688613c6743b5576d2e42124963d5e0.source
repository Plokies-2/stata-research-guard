/////////////////////////////////////////////////////////////////////////////////////////////////////////
*												TIME UPDATE RESULTS										*
/////////////////////////////////////////////////////////////////////////////////////////////////////////			
* 
use `prepdata', clear
					
	* Sample consistency
		drop if timeupdate==. 	

	* Variables for loops
		gen savexbeta=.
		gen savexdelta=.
			
	local onum = 1		
	foreach oc in lmp_maxtix {		
	
			sum `oc' if saveprime==0 & lumpyprime==0
			local c = r(mean)
			local ctrmean = round(`c', .0001)	
			
			reg `oc' lumpyprime saveprime `covars', robust
			estadd loc tp = "Yes"
			estadd loc ed = "Yes"
			estadd loc pr = "Yes"	
			estadd loc cm = "0`ctrmean'"				
			estadd ysumm
			estimates store m0

			reg `oc' lumpyprime savexpoa_time timeupdate saveprime `covars', robust
			estadd loc tp = "Yes"
			estadd loc ed = "Yes"		
			estadd loc pr = "Yes"	
			estadd loc cm = "0`ctrmean'"				
			estadd ysumm
			estimates store m1
			
			replace savexbeta = saveprime * beta
			replace savexdelta = saveprime * delta
			
			reg `oc' lumpyprime saveprime savexpoa_time timeupdate poa_timexbeta savexpoa_timexbeta savexbeta `covars', robust
			estadd loc tp = "Yes"
			estadd loc ed = "Yes"
			estadd loc pr = "Yes"	
			estadd loc cm = "0`ctrmean'"	
			estadd ysumm
			estimates store m2
			
			reg `oc' lumpyprime saveprime savexpoa_time timeupdate poa_timexdelta savexpoa_timexdelta savexdelta `covars', robust
			estadd loc tp = "Yes"
			estadd loc ed = "Yes"	
			estadd loc pr = "Yes"
			estadd loc cm = "0`ctrmean'"				
			estadd ysumm
			estimates store m3

		# delimit ;
			esttab m0 m1 m2 m3 using "${latex}AT30.tex", replace b(%10.3f) se 
			scalars("cm Control Group Mean" "ymean Mean Dep Var" "tp Full Set of Covariates" "N Num Obs" "r2 R2" "r2_a Adj R2") 
			sfmt(%10.4f %10.4f %10.0f %10.4f %10.4f) nostar
			keep(lumpyprime saveprime savexpoa_time timeupdate poa_timexbeta savexpoa_timexbeta poa_timexdelta savexpoa_timexdelta savexbeta savexdelta beta delta)
			order(lumpyprime saveprime savexpoa_time timeupdate savexpoa_timexbeta poa_timexbeta  savexbeta   savexpoa_timexdelta poa_timexdelta savexdelta beta delta)
			varlabels(lumpyprime "Lumpy Good Prime" saveprime "Betting Exercise (BE)" savexpo_time "BE x Time Update" timeupdate "Time Update" 
			poa_timexbeta "Time Update x Beta" poa_timexdelta "Time Update x Delta" savexbeta "BE x Beta" savexdelta "BE x Delta"
			savexpoa_timexbeta "BE x Time Update x Beta" savexpoa_time "BE x Time Update" beta "Beta" delta "Delta" savexpoa_timexdelta "BE x Time Update x Delta" ) 
			mlabel(Max Max Max Max)
			align(cccccc) width() 
			note(Time update is in logs.)
			title(APPENDIX TABLE 30: Effect of Saving Prime Time Update on Betting Demand - Maximum Tickets Demanded \label{sptime} ) ;
		# delimit cr	
		
		local onum = `onum' + 1
		}
*/

/////////////////////////////////////////////////////////////////////////////////////////////////////////
*								NON-PARAMETRIC RESULTS	WITH PROPORTIONATE UPDATE						*
/////////////////////////////////////////////////////////////////////////////////////////////////////////	

	use `prepdata', clear
	
	cap drop flag
	
	local bwidth = 1.645										// set confidence interval bandwidth for figure
			
		gen actoverperc_prop = 	actoverperc_usd / (incnorm / 3500)
		gen savxactoperc_prop = saveprime * actoverperc_prop
		
			reg lmp_maxtix lumpyprime saveprime actoverperc_prop `covars', robust		
			predict resids3, residuals
			
			reg savxactoperc_prop lumpyprime saveprime actoverperc_prop `covars', robust	
			predict resids4, residuals
			
			sum resids4 , detail
			drop if resids4 <r(p1) | resids4 > r(p99)
			
			gen pr4 = resids4 > 0
			gen posresids4 = resids4 * pr4
			reg resids3 resids4 posresids4, robust
			
			matrix ests = J(1, 5, .)
			local k = -.25
			while `k' < 0{
				lincom (`k')*(resids4) + _cons
				matrix temp0 = `k'
				matrix temp1 = r(se)
				matrix temp2 = r(estimate) 			
				matrix fulltemp = temp0[1,1], temp1[1,1], temp2[1,1], temp2[1,1] - `bwidth' * temp1[1,1], temp2[1,1] + `bwidth' * temp1[1,1]					
				matrix ests = (ests \ fulltemp)
				local k = `k' + .01
			}
			
				lincom (-.0001)*(resids4) + _cons
				matrix temp0 = -.0001
				matrix temp1 = r(se)
				matrix temp2 = r(estimate) 		
				matrix fulltemp = temp0[1,1], temp1[1,1], temp2[1,1], temp2[1,1] - `bwidth' * temp1[1,1], temp2[1,1] + `bwidth' * temp1[1,1]				
				matrix ests = (ests \ fulltemp)			
			
		
			local k = 0
			while `k' <=.21{
				lincom (`k')*(resids4+posresids4) + _cons
				matrix temp0 = `k'
				matrix temp1 = r(se)
				matrix temp2 = r(estimate)			
				matrix fulltemp = temp0[1,1], temp1[1,1], temp2[1,1], temp2[1,1] - `bwidth' * temp1[1,1], temp2[1,1] + `bwidth' * temp1[1,1]					
				matrix ests = (ests \ fulltemp)
				local k = `k' + .01
			}		
			
			matrix list ests
			
			putexcel set "$latex/lincom_prop.xlsx", replace 
			putexcel A1=("resids4") B1=("ses") C1=("betax") D1=("cimin") E1=("cimax")			
			putexcel A2=matrix(ests)
			
			preserve
			clear all
			import excel "$latex/lincom_prop.xlsx", first
			tempfile lincomfit
			save `lincomfit'
			restore
		
			append using `lincomfit'
			
			reg resids3 resids4, robust
			
			drop if resids4 < -.2 | resids4 > .2			// set range so graph is more intelligible
			
			# delimit ;				
			twoway  (rarea cimin cimax resids4 if resids4, color(gs14)) (line betax resids4 if resids4 , lpattern(dash) lwidth(medthick) color(gs6) xline(0) yline(0)) 
			(lowess resids3 resids4 if resids4, bwidth(.8) lcolor(black) lwidth(thick) astyle(foreground)),
				graphregion(color(white)) bgcolor(white) xtitle(Saving Ability Update / Weekly Income)
				scheme(fb, perm) ytitle(Effect of Update) ylabel( , angle(0)) yscale(titlegap(*-38)) title() xlabel(-.2 -.1 0 .1 .2)
				note(Top and Bottom 1% of x-var and updates trimmed. Update = Assisted - Naive) legend(label(1 "CI-90%") label(2 "Linear Fit") label(3 "Lowess Estimate") );
				graph export "$latex/F3.pdf", replace;
			# delimit cr
				
* ROBUSTNESS TABLE FOR REVERSE CAUSALITY

use `prepdata', clear
			drop if actoverperc_usd==.
			gen posupdate = actoverperc_usd < 0
			gen negupdate = actoverperc_usd > 0
			gen noupdate = actoverperc_usd ==0	
			gen aop_prop2 = actoverperc_usd / (incnorm / 3500)
			
			reg actoverperc_usd saveprime, robust
			estadd ysumm
			estimates store m1	
			
			reg aop_prop2 saveprime, robust
			estadd ysumm
			estimates store m2
			
			reg posupdate saveprime, robust
			estadd ysumm
			estimates store m3	
			
			reg negupdate saveprime, robust
			estadd ysumm
			estimates store m4	
			
			reg noupdate saveprime, robust
			estadd ysumm
			estimates store m5	
			
		# delimit ;
			esttab m1 m2 m3 m4 m5 using "${latex}AT31.tex", replace b(%10.3f) se 
			scalars("ymean Mean Dep Var" "N Num Obs" "r2 R2") 
			sfmt(%10.4f %10.0f %10.4f)  nostar 
			keep(saveprime)
			order()
			varlabels(saveprime "Saving Prime Treatment Group")
			mlabel("USD" "Prop" "Positive" "Negative" "None")
			align(cccccc) width() 
			note( )
			title(APPENDIX TABLE 31 - Robustness: Effect of Saving Prime on Saving Update) ;
