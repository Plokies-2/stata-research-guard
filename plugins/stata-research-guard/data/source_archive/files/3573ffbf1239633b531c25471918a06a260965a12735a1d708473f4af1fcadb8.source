


*******************************************************************************
*******************************************************************************
****                                  WID                                  ****
*******************************************************************************
*******************************************************************************


*Run this first to install the wid package
*ssc install wid
*cd "C:\Users\oconn\Dropbox\Robots\Revision RESTUD\Replication\"

*Download data
wid, area(US) year(2000) indicator(spllin apllin) age(992) population(j) clear 

*We now eliminate all of the percentiles except the steps of 1
gen from = regexs(2) if regexm(percentile, "(p)([0-9]+)(p)([0-9]+)")
gen to = regexs(4) if regexm(percentile, "(p)([0-9]+)(p)([0-9]+)")
destring to , replace
destring from , replace
gen diff = to - from
keep if diff == 1
*Combine into 5s
sort variable to
egen per = cut(to), group(20)
gen p = (per+1)*5
collapse (sum) value , by(variable p)

*Reshape and rename
reshape wide value, i(p) j(variable) string
rename valuespllin992j labor_share
rename valueapllin992j labor_income
rename p percentile

*Save
save "Table 1 Section 5/RawData/Income_Shares.dta", replace

*********************************************************************
*We now create the income shares for deciles
wid, area(US) year(2000) indicator(spllin apllin) age(992) population(j) clear 

*We now eliminate all of the percentiles except the steps of 1
gen from = regexs(2) if regexm(percentile, "(p)([0-9]+)(p)([0-9]+)")
gen to = regexs(4) if regexm(percentile, "(p)([0-9]+)(p)([0-9]+)")
destring to , replace
destring from , replace
gen diff = to - from
keep if diff == 1
*Combine into 10s
sort variable to
egen per = cut(to), group(10)
gen p = (per+1)*10
collapse (sum) value , by(variable p)

*Reshape and rename
reshape wide value, i(p) j(variable) string
rename valuespllin992j labor_share
rename valueapllin992j labor_income
rename p percentile

*Save
save "Table 1 Section 5/RawData/Income_Shares_deciles.dta", replace

************************************************************************
* also want the percentiles*Download data
wid, area(US) year(2000) indicator(spllin apllin) age(992) population(j) clear 

*We now eliminate all of the percentiles except the steps of 1
gen from = regexs(2) if regexm(percentile, "(p)([0-9]+)(p)([0-9]+)")
gen to = regexs(4) if regexm(percentile, "(p)([0-9]+)(p)([0-9]+)")
destring to , replace
destring from , replace
gen diff = to - from
keep if diff == 1
sort variable to
drop percentile year pop from diff age country

*Reshape and rename
reshape wide value, i(to) j(variable) string
rename valuespllin992j labor_share
rename valueapllin992j labor_income
rename to percentile

*Save
save "Table 1 Section 5/RawData/Income_Shares_percentile.dta", replace

