****                                 Guner                                 ****
*******************************************************************************
*******************************************************************************

*Run this code to extract the correct tax information from the Guner sheets

import excel "Table 1 Section 5\RawData\gkv_Figures_RED_USTaxes_2013.xls", sheet("Figures 5&6 -- Data") cellrange(A20:D59) clear
drop B
export excel using "Table 1 Section 5\CleanedData\StatutoryTaxes.xls", firstrow(variables) replace



*******************************************************************************
*******************************************************************************
****                              CLP and AR                               ****
*******************************************************************************
*******************************************************************************

*This do-file prepares the estimates

use "Table 1 Section 5/RawData/results_by_percentile.dta" , clear
* beta is reduced form, we have to divide by 2 (first stage coefficient) to have the IV estimate
* IV is the percent change in wages resulting from an increase in robots of 1 per thousand 
* workers---roughly the increase observed in the US between 1993-2007.
gen semielast_w_r = beta/2

forval i = 1/7 {
    local estim_number`i' "`=estimator[`i']'"
    display "`estim_number`i''"
}

keep category estim_number semielast_w_r serror
reshape wide semielast_w_r serror, i(category) j(estim_number)

forval i = 1/7 {
    label var semielast_w_r`i' "`estim_number`i''"
}

gen percentile = real(substr(category,1,2))
order percentile, first

export excel "Table 1 Section 5/CleanedData/AR_estimates.xls" , replace first(varl) sheet("AR_semielas")

*We then do the trade estimates
import excel "Table 1 Section 5/RawData/fig1 point estimates for arnaud.xlsx", sheet("Sheet1") firstrow clear
gen percentile = quantile*100
order percentile, first

export excel "Table 1 Section 5/CleanedData/CLP_estimates.xls" , replace first(varl) sheet("CLP_elas")
