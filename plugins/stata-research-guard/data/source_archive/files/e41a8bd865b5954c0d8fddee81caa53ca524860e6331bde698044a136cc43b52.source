clear all
clear matrix
clear mata
set maxvar 10000
set matsize 10000

use "${outputdata}\new_donors_MAIN", clear

*********************************************************************************************
*** MAIN REGRESSION RESULTS *****************************************************************
*********************************************************************************************

****************************************************************************************
*** Table 2: Baseline results: OLS and IV **********************************************
****************************************************************************************
*** 1. No internation **************************************************
				
** OLS with FE:
	xtreg  dummy_inst  acemoglu_democ_1 lg_rgdpna_percap_1 d d2 d3 i.t, fe cluster(cid) 
		outreg2 using "${results}\table2", tex noaster dec(4) nocons replace e( r2_a) label keep(acemoglu_democ_1 lg_rgdpna_percap_1) addtext(Country FE and year FE, Yes, Duration dependence, Yes)

** IV 
	 xi: xtivreg2  dummy_inst lg_rgdpna_percap_1 (acemoglu_democ_1 =Z_democracy_2 ) d d2 d3 i.t, fe cluster(cid) endog(acemoglu_democ_1) first savefirst savefprefix(fstage_) 
		outreg2 using "${results}\table2", tex noaster dec(4) nocons label addstat("Kleibergen-Paap", e(widstat))  append keep(lg_rgdpna_percap_1 acemoglu_democ_1 ) addtext(Country FE and year FE, Yes, Duration dependence, Yes)	
		est restore fstage_acemoglu_democ_1
		outreg2 using "${results}\appendixB1", tex noaster dec(4) nocons label  replace keep(Z_democracy_2 lg_rgdpna_percap_1) addtext(Control variables, No, Country and year FE, Yes, Duration dependence, Yes)

***2. With interaction **************************************************

** OLS with FE:
	xtreg  dummy_inst  acemoglu_democ_1 lg_rgdpna_percap_1 democxgdp_1 d d2 d3 i.t, fe cluster(cid) 
		outreg2 using "${results}\table2", tex noaster nocons label dec(4) append e( r2_a) keep(acemoglu_democ_1 lg_rgdpna_percap_1 democxgdp_1) addtext(Country FE and year FE, Yes, Duration dependence, Yes)
**IV 
	 xi: xtivreg2  dummy_inst lg_rgdpna_percap_1 (acemoglu_democ_1 democxgdp_1=Z_democracy_2 Z_democxgdp_2) d d2 d3 i.t, fe cluster(cid)  first savefirst savefprefix(fstage_) 
		outreg2 using "${results}\table2", tex noaster dec(4) nocons label addstat("Kleibergen-Paap", e(widstat))  append keep(lg_rgdpna_percap_1 acemoglu_democ_1 democxgdp_1) addtext(Country FE and year FE, Yes, Duration dependence, Yes)
		est restore fstage_acemoglu_democ_1
		outreg2 using "${results}\appendixB1", tex noaster dec(4) nocons label  append keep(Z_democracy_2 Z_democxgdp_2 lg_rgdpna_percap_1) addtext(Control variables, No, Country and year FE, Yes, Duration dependence, Yes)
		est restore fstage_democxgdp_1
		outreg2 using "${results}\appendixB1", tex noaster dec(4) nocons label  append keep(Z_democracy_2 Z_democxgdp_2 lg_rgdpna_percap_1) addtext(Control variables, No, Country and year FE, Yes, Duration dependence, Yes)

*** 3. With interaction and controls *************************************	
		

** OLS with FE and controls
	xtreg  dummy_inst  acemoglu_democ_1 lg_rgdpna_percap_1 democxgdp_1 kg_1 US_idealpoint_1  lgpop_1 lg_rgdpna_percap_1  openness_pwt_1 dummy_terr_conflict_1  d d2 d3 i.t, fe cluster(cid) 
		outreg2 using "${results}\table2", tex noaster dec(4) nocons label append e( r2_a) keep(acemoglu_democ_1 lg_rgdpna_percap_1 democxgdp_1 kg_1 US_idealpoint_1  lgpop_1 lg_rgdpna_percap_1  openness_pwt_1 dummy_terr_conflict_1)  addtext(Country FE and year FE, Yes, Duration dependence, Yes)
		
**IV with controls
	 xi: xtivreg2  dummy_inst lg_rgdpna_percap_1 kg_1 US_idealpoint_1  lgpop_1   openness_pwt_1 dummy_terr_conflict_1  (acemoglu_democ_1 democxgdp_1=Z_democracy_2 Z_democxgdp_2) d d2 d3 i.t, fe cluster(cid) endog(acemoglu_democ_1 democxgdp_1) first savefirst savefprefix(fstage_) 
		outreg2 using "${results}\table2", tex noaster dec(4) nocons label addstat("Kleibergen-Paap", e(widstat)) append keep(lg_rgdpna_percap_1 acemoglu_democ_1 democxgdp_1 lg_rgdpna_percap_1 kg_1 US_idealpoint_1  lgpop_1  openness_pwt_1 dummy_terr_conflict_1 ) addtext(Country FE and year FE, Yes, Duration dependence, Yes)
		est restore fstage_acemoglu_democ_1
		outreg2 using "${results}\appendixB1", tex noaster dec(4) nocons label  append keep(Z_democracy_2 Z_democxgdp_2 lg_rgdpna_percap_1) addtext(Control variables, Yes, Country and year FE, Yes, Duration dependence, Yes)
		est restore fstage_democxgdp_1
		outreg2 using "${results}\appendixB1", tex noaster dec(4) nocons label  append keep(Z_democracy_2 Z_democxgdp_2 lg_rgdpna_percap_1) addtext(Control variables, Yes, Country and year FE, Yes, Duration dependence, Yes)
		
*** 4. First aid project (broad definition) ************************************

	*OLS with FE and controls
	xtreg  dummy_first_aid acemoglu_democ_1 lg_rgdpna_percap_1 democxgdp_1 kg_1 US_idealpoint_1  lgpop_1  openness_pwt_1 dummy_terr_conflict_1  d d2 d3 i.t, fe cluster(cid)  
		outreg2 using "${results}\table2", tex noaster dec(4) nocons label  append e( r2_a) keep(acemoglu_democ_1   lg_rgdpna_percap_1 democxgdp_1 kg_1 US_idealpoint_1  lgpop_1   openness_pwt_1 dummy_terr_conflict_1 ) addtext(Country FE and year FE, Yes, Duration dependence, Yes)
		
**IV with controls
	* IV with controls
	 xi: xtivreg2  dummy_first_aid lg_rgdpna_percap_1 kg_1 US_idealpoint_1  lgpop_1   openness_pwt_1 dummy_terr_conflict_1  (acemoglu_democ_1 democxgdp_1=Z_democracy_2 Z_democxgdp_2) d d2 d3 i.t, fe cluster(cid) first savefirst savefprefix(fstage_) 
		outreg2 using "${results}\table2", tex noaster dec(4) nocons label addstat("Kleibergen-Paap", e(widstat)) append keep(lg_rgdpna_percap_1 acemoglu_democ_1 democxgdp_1 lg_rgdpna_percap_1 kg_1 US_idealpoint_1  lgpop_1   openness_pwt_1 dummy_terr_conflict_1 ) addtext(Country FE and year FE, Yes, Duration dependence, Yes)
		est restore fstage_acemoglu_democ_1
		outreg2 using "${results}\appendixB1", tex noaster dec(4) nocons label  append keep(Z_democracy_2 Z_democxgdp_2 lg_rgdpna_percap_1) addtext(Control variables, Yes, Country and year FE, Yes, Duration dependence, Yes)
		est restore fstage_democxgdp_1
		outreg2 using "${results}\appendixB1", tex noaster dec(4) nocons label  append keep(Z_democracy_2 Z_democxgdp_2 lg_rgdpna_percap_1) addtext(Control variables, Yes, Country and year FE, Yes, Duration dependence, Yes)
			
********************************************************************************
*** Table 1: Summary Statistics ************************************************
********************************************************************************
use "${outputdata}\new_donors_MAIN", clear

outreg2 using "${results}\table1a" if sample==1, tex label sum(log) keep(dummy_first_aid dummy_inst  coldwar_1 lg_colony_penn_1 acemoglu_democ_1 Democ_dummy_1 v2x_polyarchy_1 W_epr_1 Z_democracy_1 polity2_1 W_BdM_1 d lg_rgdpna_percap_1 kg_1 dummy_terr_conflict_1 dummy_midb_1 openness_pwt_1 RUS_idealpoint_1 US_idealpoint_1  lgpop_1  SL_prox_inst_1 Z_dummy_inst_1 lg_SL_prox_gdp_1 Z_lg_gdp_percap_1) replace ///
	sortvar(dummy_first_aid dummy_inst lg_ODA_disbursements lg_ODA_commitments_aiddata coldwar_1 lg_colony_penn_1 acemoglu_democ_1 Democ_dummy_1 v2x_polyarchy_1 W_epr_1 Z_democracy_1 polity2_1 W_BdM_1 d lg_rgdpna_percap_1 kg_1 dummy_terr_conflict_1 dummy_midb_1 openness_pwt_1 RUS_idealpoint_1 US_idealpoint_1  lgpop_1  SL_prox_inst_1 Z_dummy_inst_1 lg_SL_prox_gdp_1 Z_lg_gdp_percap_1) auto(3)

qui xtreg lg_ODA_disbursements  acemoglu_democ_1##c.lg_rgdpna_percap_1 kg_1 US_idealpoint_1 lgpop_1 lg_rgdpna_percap_1  openness_pwt_1 dummy_terr_conflict_1  d d2 d3 i.t if t>1970, fe cluster(cid) 
outreg2 using "${results}\table1b" if e(sample), tex label sum(log) auto(3) keep(lg_ODA_disbursements) replace ///

qui xtreg lg_ODA_commitments_aiddata  acemoglu_democ_1##c.lg_rgdpna_percap_1 kg_1 US_idealpoint_1 lgpop_1 lg_rgdpna_percap_1  openness_pwt_1 dummy_terr_conflict_1  d d2 d3 i.t if t>1970, fe cluster(cid) 
outreg2 using "${results}\table1c" if e(sample), tex label sum(log) auto(3) keep(lg_ODA_commitments_aiddata) replace ///

********************************************************************************
*** Table 3: Robustness Test - Controlled for spatial lags *********************
********************************************************************************
use "${outputdata}\new_donors_MAIN", clear

** A Donor spatial lag (by geographic distance)

		xtreg  dummy_inst  acemoglu_democ_1 lg_rgdpna_percap_1 democxgdp_1 kg_1 US_idealpoint_1  lgpop_1  openness_pwt_1 dummy_terr_conflict_1  SL_prox_inst_1 d d2 d3 i.t if sample==1, fe cluster(cid)
			outreg2 using "${results}\table3", tex noaster dec(4) nocons replace e(r2_w) label keep(acemoglu_democ_1 lg_rgdpna_percap_1  democxgdp_1 SL_prox_inst_1) addtext(Control variables, Yes, Country FE and year FE, Yes, Duration dependence, Yes)
		xi: xtivreg2  dummy_inst lg_rgdpna_percap_1 kg_1 US_idealpoint_1  lgpop_1   openness_pwt_1 dummy_terr_conflict_1  SL_prox_inst_1 (acemoglu_democ_1 democxgdp_1=Z_democracy_2 Z_democxgdp_2) d d2 d3 i.t, fe cluster(cid) first savefirst savefprefix(fstage_) 
			outreg2 using "${results}\table3", tex noaster dec(4) nocons label addstat("Kleibergen-Paap", e(widstat)) append keep(lg_rgdpna_percap_1 acemoglu_democ_1 democxgdp_1  SL_prox_inst_1) addtext(Control variables, Yes, Country FE and year FE, Yes, Duration dependence, Yes)

** B Donor spatial (by democracy peer group)

		xtreg  dummy_inst  acemoglu_democ_1 lg_rgdpna_percap_1 democxgdp_1 kg_1 US_idealpoint_1  lgpop_1 openness_pwt_1 dummy_terr_conflict_1 Z_dummy_inst_1 d d2 d3 i.t if sample==1, fe cluster(cid)
			outreg2 using "${results}\table3", tex noaster dec(4) nocons append e( r2_w) label keep(acemoglu_democ_1 lg_rgdpna_percap_1  democxgdp_1 Z_dummy_inst_1) addtext(Control variables, Yes, Country FE and year FE, Yes, Duration dependence, Yes)
		 xi: xtivreg2  dummy_inst lg_rgdpna_percap_1 kg_1 US_idealpoint_1  lgpop_1   openness_pwt_1 dummy_terr_conflict_1 Z_dummy_inst_1 (acemoglu_democ_1 democxgdp_1=Z_democracy_2 Z_democxgdp_2) d d2 d3 i.t, fe cluster(cid) first savefirst savefprefix(fstage_) 
			outreg2 using "${results}\table3", tex noaster dec(4) nocons label addstat("Kleibergen-Paap", e(widstat)) append keep(lg_rgdpna_percap_1 acemoglu_democ_1 democxgdp_1 Z_dummy_inst_1) addtext(Control variables, Yes, Country FE and year FE, Yes, Duration dependence, Yes)

			
** C GDP spatial lag (by geographic distance)

		xtreg  dummy_inst  acemoglu_democ_1 lg_rgdpna_percap_1 democxgdp_1 kg_1 US_idealpoint_1  lgpop_1  openness_pwt_1 dummy_terr_conflict_1 lg_SL_prox_gdp_1 d d2 d3 i.t if sample==1, fe cluster(cid)
			outreg2 using "${results}\table3", tex noaster dec(4) nocons append e(r2_w) label keep(acemoglu_democ_1 lg_rgdpna_percap_1  democxgdp_1 lg_SL_prox_gdp_1) addtext(Control variables, Yes, Country FE and year FE, Yes, Duration dependence, Yes)
		 xi: xtivreg2  dummy_inst lg_rgdpna_percap_1 kg_1 US_idealpoint_1  lgpop_1   openness_pwt_1 dummy_terr_conflict_1  lg_SL_prox_gdp_1 (acemoglu_democ_1 democxgdp_1=Z_democracy_2 Z_democxgdp_2) d d2 d3 i.t, fe cluster(cid) first savefirst savefprefix(fstage_) 
			outreg2 using "${results}\table3", tex noaster dec(4) nocons label addstat("Kleibergen-Paap", e(widstat)) append keep(lg_rgdpna_percap_1 acemoglu_democ_1 democxgdp_1  lg_SL_prox_gdp_1) addtext(Control variables, Yes, Country FE and year FE, Yes, Duration dependence, Yes)

** D GDP spatial lag (by democracy peer group)

		xtreg  dummy_inst  acemoglu_democ_1 lg_rgdpna_percap_1 democxgdp_1 kg_1 US_idealpoint_1  lgpop_1  openness_pwt_1 dummy_terr_conflict_1 Z_lg_gdp_percap_1 d d2 d3 i.t if sample==1, fe cluster(cid)
			outreg2 using "${results}\table3", tex noaster dec(4) nocons append e(r2_w) label keep(acemoglu_democ_1 lg_rgdpna_percap_1 democxgdp_1  Z_lg_gdp_percap_1) addtext(Control variables, Yes, Country FE and year FE, Yes, Duration dependence, Yes)
		 xi: xtivreg2  dummy_inst lg_rgdpna_percap_1 kg_1 US_idealpoint_1  lgpop_1   openness_pwt_1 dummy_terr_conflict_1  Z_lg_gdp_percap_1 (acemoglu_democ_1 democxgdp_1=Z_democracy_2 Z_democxgdp_2) d d2 d3 i.t, fe cluster(cid) first savefirst savefprefix(fstage_) 
