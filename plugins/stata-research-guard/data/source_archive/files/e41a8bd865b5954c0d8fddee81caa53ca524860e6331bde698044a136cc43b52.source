	use "${outputdata}\new_donors_sample_firstaid", clear

	** a) Russia ideal point

** Panel D: Donor spatial lag

		xtreg  dummy_first_aid  acemoglu_democ_1 lg_rgdpna_percap_1 democxgdp_1 kg_1 US_idealpoint_1  lgpop_1  openness_pwt_1 dummy_terr_conflict_1  SL_prox_aid_1 d d2 d3 i.t if sample==1, fe cluster(cid)
			outreg2 using "${results}\appendixC2", tex noaster dec(4) nocons replace e(r2_w) label keep(acemoglu_democ_1 lg_rgdpna_percap_1 democxgdp_1 SL_prox_aid_1) addtext(Control variables, Yes, Country FE and year FE, Yes, Duration dependence, Yes)
		 xi: xtivreg2  dummy_first_aid lg_rgdpna_percap_1 kg_1 US_idealpoint_1  lgpop_1   openness_pwt_1 dummy_terr_conflict_1  SL_prox_aid_1 (acemoglu_democ_1 democxgdp_1=Z_democracy_2 Z_democxgdp_2) d d2 d3 i.t if sample==1, fe cluster(cid) first savefirst savefprefix(fstage_) 
			outreg2 using "${results}\appendixC2", tex noaster dec(4) nocons label addstat("Kleibergen-Paap", e(widstat)) append keep(lg_rgdpna_percap_1 acemoglu_democ_1 democxgdp_1  SL_prox_aid_1) addtext(Control variables, Yes, Country FE and year FE, Yes, Duration dependence, Yes)

** Panel D2: Donor spatial lag but with peer groupe as democracy inst

