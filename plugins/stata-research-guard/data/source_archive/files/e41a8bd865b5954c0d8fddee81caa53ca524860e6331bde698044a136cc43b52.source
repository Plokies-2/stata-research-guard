********************************************************************************
*** Appnedix Table A4: Correlation matrix **************************************
********************************************************************************

cd "${results}"

corrtex dummy_first_aid dummy_inst  coldwar_1 lg_colony_penn_1 acemoglu_democ_1 ///
Democ_dummy_1 v2x_polyarchy_1 W_epr_1 Z_democracy_1 polity2_1 W_BdM_1 d lg_rgdpna_percap_1 ///
kg_1 dummy_terr_conflict_1 dummy_midb_1 openness_pwt_1 RUS_idealpoint_1 US_idealpoint_1  ///
lgpop_1  SL_prox_inst_1 Z_dummy_inst_1 lg_SL_prox_gdp_1 Z_lg_gdp_percap_1 if sample==1 ///
, file("appendixA4") replace digits(2)

cd "${basepath}"

********************************************************************************
*** Appnedix Table B2: Robustness - Democracy **********************************
********************************************************************************
	
use "${outputdata}\new_donors_MAIN", clear

*** Average effect

		**a) First inst: Baseline
	 xi: xtivreg2  dummy_inst  lg_rgdpna_percap_1 kg_1 US_idealpoint_1  lgpop_1   openness_pwt_1 dummy_terr_conflict_1  d d2 d3 i.t (acemoglu_democ_1 =Z_democracy_2), fe cluster(cid)
			outreg2 using "${results}\appendixB2a", tex noaster dec(4) replace  addstat("Kleibergen-Paap", e(widstat)) label	keep(acemoglu_democ_1 lg_rgdpna_percap_1) addtext(Controls, Yes, Country and year FE, Yes, Duration dependence, Yes)
		**b) First inst: Polity IV
	 xi: xtivreg2  dummy_inst  lg_rgdpna_percap_1 kg_1 US_idealpoint_1  lgpop_1   openness_pwt_1 dummy_terr_conflict_1  d d2 d3 i.t (polity2_1 = Z2_polity2_2), fe cluster(cid)
			outreg2 using "${results}\appendixB2a", tex noaster dec(4) append addstat("Kleibergen-Paap", e(widstat)) label	keep(polity2_1 lg_rgdpna_percap_1) addtext(Controls, Yes, Country and year FE, Yes, Duration dependence, Yes)
		**c) First inst: Democracy Dummy
	 xi: xtivreg2  dummy_inst   lg_rgdpna_percap_1 kg_1 US_idealpoint_1  lgpop_1   openness_pwt_1 dummy_terr_conflict_1  d d2 d3 i.t (Democ_dummy_1 = Z2_cheibob_2 ), fe cluster(cid)
			outreg2 using "${results}\appendixB2a", tex noaster dec(4) append addstat("Kleibergen-Paap", e(widstat)) label	keep(Democ_dummy_1 lg_rgdpna_percap_1) addtext(Controls, Yes, Country and year FE, Yes, Duration dependence, Yes)
		**d) First aid: Baseline
	 xi: xtivreg2  dummy_first_aid  lg_rgdpna_percap_1 kg_1 US_idealpoint_1  lgpop_1   openness_pwt_1 dummy_terr_conflict_1  d d2 d3 i.t (acemoglu_democ_1 =Z_democracy_2), fe cluster(cid)
			outreg2 using "${results}\appendixB2a", tex noaster dec(4) append addstat("Kleibergen-Paap", e(widstat)) label	keep(acemoglu_democ_1 lg_rgdpna_percap_1) addtext(Controls, Yes, Country and year FE, Yes, Duration dependence, Yes)
		**e) First aid: Polity IV
	 xi: xtivreg2  dummy_first_aid  lg_rgdpna_percap_1 kg_1 US_idealpoint_1  lgpop_1   openness_pwt_1 dummy_terr_conflict_1  d d2 d3 i.t (polity2_1 = Z2_polity2_2), fe cluster(cid)
			outreg2 using "${results}\appendixB2a", tex noaster dec(4) append addstat("Kleibergen-Paap", e(widstat)) label	keep(polity2_1 lg_rgdpna_percap_1) addtext(Controls, Yes, Country and year FE, Yes, Duration dependence, Yes)
		**f) First aid: Democracy Dummy
	 xi: xtivreg2  dummy_first_aid   lg_rgdpna_percap_1 kg_1 US_idealpoint_1  lgpop_1  openness_pwt_1 dummy_terr_conflict_1  d d2 d3 i.t (Democ_dummy_1 = Z2_cheibob_2 ), fe cluster(cid)
			outreg2 using "${results}\appendixB2a", tex noaster dec(4) append addstat("Kleibergen-Paap", e(widstat)) label	keep(Democ_dummy_1 lg_rgdpna_percap_1) addtext(Controls, Yes, Country and year FE, Yes, Duration dependence, Yes)

*** Heterogenous effect

use "${outputdata}\new_donors_MAIN", clear

* Generate mean income
sum lg_rgdpna_percap_1 if sample==1, detail
global mean_income = `r(mean)' - 4 /*Since the plot starts at 5 instead of 1 need to adjust this */
global median_income = `r(p50)' - 4 /*Since the plot starts at 5 instead of 1 need to adjust this */

		**a)Original specification: First Institution
	 xi: xtivreg2  dummy_inst lg_rgdpna_percap_1 kg_1 US_idealpoint_1  lgpop_1   openness_pwt_1 dummy_terr_conflict_1 	(acemoglu_democ_1 democxgdp_1=Z_democracy_2 Z_democxgdp_2) d d2 d3 i.t, fe cluster(cid) first savefirst savefprefix(fstage_) 
			outreg2 using "${results}\appendixB2b", tex dec(4) replace noaster addstat("Kleibergen-Paap", e(widstat)) label	keep(acemoglu_democ_1 democxgdp_1 lg_rgdpna_percap_1) addtext(Controls, Yes, Country and year FE, Yes, Duration dependence, Yes)
				local replace replace
				local append
				matrix M=J(9,4,.)
				matrix coln M = x coeff ll95 ul95
				matrix rown M = 5 6 7 8 9 10 11 12 13
				local n 1
			forvalues x=5(1)13 {
				nlcom _b[acemoglu_democ_1] + _b[democxgdp_1]*(`x')
					local tvalue= invttail(e(df_m),0.025)
					matrix b = r(b)
					local bw = b[1,1]
					matrix v = r(V)
					local vw = v[1,1]
					local se = sqrt(`vw')
					local lbx1 = `bw' - `tvalue'*`se'
					local ubx1 = `bw' + `tvalue'*`se' 
					cap matrix M[`n',1]= `x', `bw', `lbx1' , `ubx1'
					local replace
					local append append
					local n `n'+1
			}
	coefplot (matrix(M[,2]), ci((M[,3] M[,4]))),  vertical graphregion( color(white))  ///
	xtitle((log) GDP per capita)  ytitle(Narrow definition) recast(connected) /// 
	yscale(range(-0.4 0.8))  ytick(-0.4(0.1)0.8)  ylabel(-0.4(0.1)0.8) ciopts(recast(rcap))  xline($median_income) title(Democracy (Baseline))
	graph export "${figures}\figure3a1.png", replace
	graph export "${figures}\figure3a1.wmf", as(wmf) replace

		**b) First inst: Polity IV
	 xi: xtivreg2  dummy_inst lg_rgdpna_percap_1 kg_1 US_idealpoint_1  lgpop_1   openness_pwt_1 dummy_terr_conflict_1 (polity2_1 polity2xgdp_1=Z2_polity2_2 Z2_polity2xgdp_2) d d2 d3 i.t, fe cluster(cid) first savefirst savefprefix(fstage_) 
			outreg2 using "${results}\appendixB2b", tex dec(4) append noaster addstat("Kleibergen-Paap", e(widstat)) label	keep(polity2_1 polity2xgdp_1 lg_rgdpna_percap_1) addtext(Controls, Yes, Country and year FE, Yes, Duration dependence, Yes)
				local replace replace
				local append
				matrix M=J(9,4,.)
				matrix coln M = x coeff ll95 ul95
				matrix rown M = 5 6 7 8 9 10 11 12 13
				local n 1
			forvalues x=5(1)13 {
				nlcom _b[polity2_1] + _b[polity2xgdp_1]*(`x')
					local tvalue= invttail(e(df_m),0.025)
					matrix b = r(b)
					local bw = b[1,1]
					matrix v = r(V)
					local vw = v[1,1]
					local se = sqrt(`vw')
					local lbx1 = `bw' - `tvalue'*`se'
					local ubx1 = `bw' + `tvalue'*`se' 
					cap matrix M[`n',1]= `x', `bw', `lbx1' , `ubx1'
					local replace
					local append append
					local n `n'+1
			}
	coefplot (matrix(M[,2]), ci((M[,3] M[,4]))),  vertical  graphregion( color(white))  ///
	xtitle((log) GDP per capita)  ytitle(Narrow definition) recast(connected) /// 
	yscale(range(-0.4 0.8))  ytick(-0.4(0.1)0.8)  ylabel(-0.4(0.1)0.8) ciopts(recast(rcap))  xline($median_income) title(Democracy (Polity IV))
	graph export "${figures}\figure3a2.png", replace
	graph export "${figures}\figure3a2.wmf", as(wmf) replace


		
		**c) First inst: Cheibob Democracy Dummy
	 xi: xtivreg2  dummy_inst lg_rgdpna_percap_1 kg_1 US_idealpoint_1  lgpop_1   openness_pwt_1 dummy_terr_conflict_1 (Democ_dummy_1 Cheibobxgdp_1=Z2_cheibob_2 Z2_cheibobxgdp_2) d d2 d3 i.t, fe cluster(cid) first savefirst savefprefix(fstage_) 
			outreg2 using "${results}\appendixB2b", tex dec(4) append noaster  addstat("Kleibergen-Paap", e(widstat)) label	keep(Democ_dummy_1 Cheibobxgdp_1 lg_rgdpna_percap_1) addtext(Controls, Yes, Country and year FE, Yes, Duration dependence, Yes)
				local replace replace
				local append
				matrix M=J(9,4,.)
				matrix coln M = x coeff ll90 ul90
				matrix rown M = 5 6 7 8 9 10 11 12 13
				local n 1
			forvalues x=5(1)13 {
				nlcom _b[Democ_dummy_1] + _b[Cheibobxgdp_1]*(`x')
					local tvalue= invttail(e(df_m),0.05)
					matrix b = r(b)
					local bw = b[1,1]
					matrix v = r(V)
					local vw = v[1,1]
					local se = sqrt(`vw')
					local lbx1 = `bw' - `tvalue'*`se'
					local ubx1 = `bw' + `tvalue'*`se' 
					cap matrix M[`n',1]= `x', `bw', `lbx1' , `ubx1'
					local replace
					local append append
					local n `n'+1
			}
	coefplot (matrix(M[,2]), ci((M[,3] M[,4]))),  vertical  graphregion( color(white))  ///
	xtitle((log) GDP per capita)  ytitle(Narrow definition) recast(connected) /// 
	yscale(range(-0.4 0.8))  ytick(-0.4(0.1)0.8)  ylabel(-0.4(0.1)0.8) ciopts(recast(rcap))  xline($median_income) title(Democracy (DD))
	graph export "$figures\figure3a3.png", replace
	graph export "${figures}\figure3a3.wmf", as(wmf) replace


		**d)Original specification: First Institution
	 xi: xtivreg2  dummy_first_aid lg_rgdpna_percap_1 kg_1 US_idealpoint_1  lgpop_1   openness_pwt_1 dummy_terr_conflict_1 	(acemoglu_democ_1 democxgdp_1=Z_democracy_2 Z_democxgdp_2) d d2 d3 i.t, fe cluster(cid) first savefirst savefprefix(fstage_) 
			outreg2 using "${results}\appendixB2b", tex dec(4) append noaster  addstat("Kleibergen-Paap", e(widstat)) label	keep(acemoglu_democ_1 democxgdp_1 lg_rgdpna_percap_1) addtext(Controls, Yes, Country and year FE, Yes, Duration dependence, Yes)
				local replace replace
				local append
				matrix M=J(9,4,.)
				matrix coln M = x coeff ll95 ul95
				matrix rown M = 5 6 7 8 9 10 11 12 13
				local n 1
			forvalues x=5(1)13 {
				nlcom _b[acemoglu_democ_1] + _b[democxgdp_1]*(`x')
					local tvalue= invttail(e(df_m),0.025)
					matrix b = r(b)
					local bw = b[1,1]
					matrix v = r(V)
					local vw = v[1,1]
					local se = sqrt(`vw')
					local lbx1 = `bw' - `tvalue'*`se'
					local ubx1 = `bw' + `tvalue'*`se' 
					cap matrix M[`n',1]= `x', `bw', `lbx1' , `ubx1'
					local replace
					local append append
					local n `n'+1
			}
	coefplot (matrix(M[,2]), ci((M[,3] M[,4]))),  vertical graphregion( color(white))  ///
	xtitle((log) GDP per capita)  ytitle(Broad definition) recast(connected) /// 
	yscale(range(-0.4 0.8))  ytick(-0.4(0.1)0.8)  ylabel(-0.4(0.1)0.8) ciopts(recast(rcap))  xline($median_income) title(Democracy (Baseline))
