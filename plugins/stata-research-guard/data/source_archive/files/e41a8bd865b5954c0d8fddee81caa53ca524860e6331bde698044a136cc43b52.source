********************************************************************************
****Figure 2 *******************************************************************
********************************************************************************

********************************************************************************
*** Bar graph donor-income by regime type

*** NARROW DEFINITION
use "${outputdata}\new_donors_MAIN", clear

keep if dummy_inst == 1

egen income_group = cut(lg_rgdpna_percap_1), at(6.5, 7, 7.5, 8, 8.5, 9, 9.5, 10, 10.5, 11, 11.5, 12, 12.5)

gen acemoglu_autoc = 1 if acemoglu_democ == 0
replace acemoglu_democ = . if acemoglu_democ == 0

graph bar (count) acemoglu_autoc acemoglu_democ, over(income_group) scheme(s1mono) ///
legend(label(1 "Autocracies") label(2 "Democracies")) ///
ytitle("First time donor (narrow definition)") ///
title("") yscale(range(0 18)) ///
saving("${figures}\figure2a.png", replace)
	graph export "${figures}\figure2a.wmf", as(wmf) replace



*** WIDE DEFINITION
use "${outputdata}\new_donors_MAIN", clear

keep if dummy_first_aid == 1

egen income_group = cut(lg_rgdpna_percap_1), at(6.5, 7, 7.5, 8, 8.5, 9, 9.5, 10, 10.5, 11, 11.5, 12, 12.5)

gen acemoglu_autoc = 1 if acemoglu_democ == 0
replace acemoglu_democ = . if acemoglu_democ == 0

graph bar (count) acemoglu_autoc acemoglu_democ, over(income_group) scheme(s1mono) ///
legend(label(1 "Autocracies") label(2 "Democracies")) ///
ytitle("First time donor (wide definition)") ///
title("") yscale(range(0 18)) ///
saving("${figures}\figure2b.png", replace)
	graph export "${figures}\figure2b.wmf", as(wmf) replace
	
********************************************************************************
****Figure A3 ******************************************************************
********************************************************************************

* Convert shapefile
shp2dta using "${inputdata}\cshapes_0.6\cshapes.shp" , database(hist_world) coordinates(worldcoord) genid(id) replace

*** b) Maps Democracies vs autocracies
	foreach num of numlist 1955 1985 2015 {
		use "${outputdata}\acemoglu_democ.dta", clear
		keep if t==`num'
		keep country_i t acemoglu_democ
		save "${tempdata}\democ_first_aid_`num'.dta", replace
		
		use "hist_world.dta", clear
		ren ISO1AL3 country_i
		replace country_i="ISR" if CNTRY_NAME=="Israel"
		replace country_i="EGY" if CNTRY_NAME=="Egypt"
		replace country_i="SYR" if CNTRY_NAME=="Syria"
		replace country_i="IDN" if CNTRY_NAME=="Indonesia"
		replace country_i="PAK" if CNTRY_NAME=="Pakistan"
		replace country_i="BRA" if CNTRY_NAME=="Brazil"
		replace country_i="CAN" if CNTRY_NAME=="Canada"
		replace country_i="MAR" if CNTRY_NAME=="Morocco"
		replace country_i="LBY" if CNTRY_NAME=="Libya"
		replace country_i="TCD" if CNTRY_NAME=="Chad"
		replace country_i="CHN" if CNTRY_NAME=="China"
		replace country_i="EGY" if CNTRY_NAME=="Egypt (United Arab Republic)"
		replace country_i="MYS" if CNTRY_NAME=="Malaysia"
		replace country_i="MLI" if CNTRY_NAME=="Mali Federation"
		replace country_i="CMR" if CNTRY_NAME=="Cameroon"
		replace country_i="NGA" if CNTRY_NAME=="Nigeria"
		replace country_i="IND" if CNTRY_NAME=="India"
		replace country_i="TZA" if CNTRY_NAME=="Tanzania"
		replace country_i="RUS" if country_i=="SUN"
		drop if mi(country_i)
		
		replace country_i="Papua" if country_i=="IDN" & COWSYEAR==2002 & `num'==1955
		replace country_i="Westsahara" if country_i=="MAR" & COWSYEAR==1976 & `num'==1955

		replace COWSYEAR=1972 if country_i=="LBY" & COWSYEAR==1973
		replace COWSYEAR=1972 if country_i=="TCD" & COWSYEAR==1973

		
		sort country_i COWSYEAR
				
		bysort country_i: gen begin=_n
		replace COWSYEAR=1945 if begin==1	
			keep if COWSYEAR<`num' & COWEYEAR>=`num'
		
		merge 1:1 country_i using "${tempdata}\democ_first_aid_`num'.dta", keep(master match) nogen

		/* Generate maps for year of first aid */
		spmap acemoglu_democ using worldcoord, id(id) clnumber(3) legtitle("Legend:") ndlabel("No data") ndocolor(gs8) ndfcolor(gs8) clmethod(unique) fcolor(white ebblue) ///
		legend(size(medium) symysize(*2.5) symxsize(*2.5) forcesize) title("Democratic vs. autocratic donors: `num' ") legend(label(3 "Democracy") label(2 "Autocracy"))

		graph export "${figures}\figureA3_`num'.png", as(png) replace width(1400) height(600)
}

