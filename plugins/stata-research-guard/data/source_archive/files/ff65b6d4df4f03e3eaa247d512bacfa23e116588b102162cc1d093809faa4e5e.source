		gen `i'_temp=.
		replace `i'_temp=1 if `i'==4
		replace `i'_temp=2 if `i'==3
		replace `i'_temp=3 if `i'==2
		replace `i'_temp=4 if `i'==1
		drop `i'
		rename `i'_temp `i'
}
