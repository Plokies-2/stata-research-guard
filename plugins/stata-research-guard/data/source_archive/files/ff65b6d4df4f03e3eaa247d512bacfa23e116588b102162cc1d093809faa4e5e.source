label var simce_educpadre_5 "Padre_Superior Incompleta"
label var simce_educpadre_6 "Padre_Superior Completa"

label var simce_poriginario_pad "Padre de pueblo originario"
label var simce_poriginario_mad "Madre de pueblo originario"
label var simce_poriginario_algunpad "Padre o Madre de pueblo originario"

compress
save "Data/clean/SocioEcon_surveySimce", replace
	
}

