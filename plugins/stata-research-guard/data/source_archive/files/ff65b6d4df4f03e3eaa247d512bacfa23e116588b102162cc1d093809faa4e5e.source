keep agno rbd simce_educpadre simce_educmadre simce_poriginario_pad simce_poriginario_mad simce_ingresos idalumno
append using "Data/clean/SocioEcon_surveySimce", force

save "Data/clean/SocioEcon_surveySimce_Students", replace


* Create school level data

tab simce_ingresos if simce_ingresos!=., gen(simce_ingresos_) 
tab simce_educpadre if simce_educpadre!=., gen(simce_educpadre_) 
tab simce_educmadre if simce_educmadre!=., gen(simce_educmadre_)

gen simce_poriginario_algunpad =.
replace simce_poriginario_algunpad=1 if (simce_poriginario_mad==1 | simce_poriginario_pad==1)
replace simce_poriginario_algunpad=0 if (simce_poriginario_mad==0 & simce_poriginario_pad==0)

collapse (mean) simce_ingresos_* simce_educpadre_* simce_educmadre_* ///
	simce_poriginario_pad simce_poriginario_mad simce_poriginario_algunpad, by (rbd agno)

label var simce_ingresos_1 "ing_<100.000" 
label var simce_ingresos_2 "ing_100.001-200.000" 
label var simce_ingresos_3 "ing_200.001-300.000" 
label var simce_ingresos_4 "ing_300.001-400.000" 
label var simce_ingresos_5 "ing_400.001-500.000" 
label var simce_ingresos_6 "ing_500.001-600.000" 
label var simce_ingresos_7 "ing_600.001-800.000" 
label var simce_ingresos_8 "ing_800.001-1.000.000" 
label var simce_ingresos_9 "ing_1.000.001-1.200.000" 
label var simce_ingresos_10 "ing_1.200.001-1.400.000" 
label var simce_ingresos_11 "ing_1.400.001-1.600.000" 
label var simce_ingresos_12 "ing_1.600.001-1.800.000" 
label var simce_ingresos_13 "ing_1.800.001-2.000.000" 
label var simce_ingresos_14 "ing_2.000.001-2.200.000" 
label var simce_ingresos_15 "ing_>2.200.000"

label var simce_educmadre_1 "Madre_Basica Incompleta"
label var simce_educmadre_2 " Madre_Basica Completa"
label var simce_educmadre_3 " Madre_Media Incompleta"
label var simce_educmadre_4 " Madre_Media Completa"
label var simce_educmadre_5 " Madre_Superior Incompleta"
label var simce_educmadre_6 " Madre_Superior Completa"

label var simce_educpadre_1 "Padre_Basica Incompleta"
label var simce_educpadre_2 "Padre_Basica Completa"
label var simce_educpadre_3 "Padre_Media Incompleta"
