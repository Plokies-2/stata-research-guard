preserve
use `data1', clear
append using `data2'
append using `data3'
append using `data4'
gen ADP=1
xtset rbd t
tsfill, full
replace ADP=0 if ADP==.
save "Data/temp/schools_ADP_1", replace
restore	

preserve
use `data2P', clear
append using `data3P'
append using `data4P'
gen ADP=1
append using `data0'
xtset rbd t
tsfill, full
replace ADP=0 if ADP==.

save "Data/temp/schools_ADP_2", replace
restore

use "Data/temp/schools_ADP_1", clear
append using "Data/temp/schools_ADP_2"

	
preserve	
use "Data/temp/base_concursos", clear

forval i=1(1)8{
gen n`i'=(date_cont`i'!=.)
gen fill_n`i'=(date_elec`i'!=.)
}

gen total_cont=n1+n2+n3+n4+n5+n6+n7+n8
gen total_cont_fill=fill_n1+fill_n2+fill_n3+fill_n4+fill_n5+fill_n6+fill_n7+fill_n8
gen success=total_cont_fill/total_cont
keep rbd success
tempfile success
save `success', replace
restore

merge m:1 rbd using `success'
drop _merge

gen date=t
gen date2=dofm(date)
format date2 %d

gen agno=year(date2)
gen mes=month(date2)
drop date date2

bysort rbd agno:egen monthsADP=total(ADP)

keep if mes==12
keep rbd agno ADP monthsADP success
gen  ADP2=(monthsADP>=1)

save "Data/clean/panel_ADP.dta", replace

}

** BUILD panel_principals.dta
******************************
{

use "Data/clean/panel_employeremployee.dta", clear	
	
preserve
	keep if Principal==1 
	
	bys rbd agno: egen maxHours=max(Hours)
	keep if Hours==maxHours

	bys rbd agno: egen maxTenure=max(SenioritySystem)
	keep if SenioritySystem==maxTenure

	bys rbd agno: egen maxEdad=max(Edad)
	keep if Edad==maxEdad
	
	sort mrun
	duplicates drop rbd agno, force
	
	gen id_prin=mrun
	
	keep rbd agno id_prin Public Edad Female Hours SenioritySystem Voucher Perm cod_com_rbd CollegeDegree EducDegree

	tempfile id1
	save `id1', replace
restore

preserve
	keep if Principal==1|Administrative==1
	merge m:1 rbd agno using `id1'
	keep if _merge==1

	bys rbd agno: egen maxHours=max(Hours)
	keep if Hours==maxHours

	bys rbd agno: egen maxTenure=max(SenioritySystem)
	keep if SenioritySystem==maxTenure

	bys rbd agno: egen maxEdad=max(Edad)
	keep if Edad==maxEdad

	sort mrun
	duplicates drop rbd agno, force
	
	drop id_prin
	gen id_prin=mrun
	keep rbd agno id_prin Public Edad Female Hours SenioritySystem Voucher Perm cod_com_rbd CollegeDegree EducDegree

	append using `id1'
    sort rbd agno
	
	tempfile id2
	save `id2', replace
restore

	
	keep if Principal==1|Administrative==1|Teacher==1
	merge m:1 rbd agno using `id2'
	keep if _merge==1

	bys rbd agno: egen maxHours=max(Hours)
	keep if Hours==maxHours

	bys rbd agno: egen maxTenure=max(SenioritySystem)
	keep if SenioritySystem==maxTenure

	bys rbd agno: egen maxEdad=max(Edad)
	keep if Edad==maxEdad
	
	drop if rbd==406 & (agno==2014|agno==2015) & mrun==6634423
	drop if rbd==4639 & agno==2013 & mrun==1060254
	drop if rbd==22635 & agno==2014 & mrun==8140242
	
	sort mrun
	duplicates drop rbd agno, force
	
	drop id_prin
	gen id_prin=mrun
	keep rbd agno id_prin Public Edad Female Hours SenioritySystem Voucher Perm cod_com_rbd CollegeDegree EducDegree
	
	append using `id2'
    sort rbd agno
			
merge 1:1 rbd agno using "Data/clean/panel_ADP.dta"
drop _merge

drop if id_prin==.
save "Data/clean/panel_principals.dta", replace

}

** BUILD SocioEcon_surveySimce and SocioEcon_surveySimce_Students.dta
**********************************************************************
{

use "Data/raw/simce/simce4b2011_cpad_publica_final", clear

label define educ 1 "Basica Incompleta" 2 "Basica Completa" 3 "Media Incompleta" 4 "Media Completa" 5 "Superior Incompleta" 6 "Superior Completa" 

gen simce_educpadre=.
replace simce_educpadre=1 if (cpad_p08_01==1 | cpad_p08_02==1 | cpad_p08_03==1 | cpad_p08_04==1 | cpad_p08_05==1 | cpad_p08_06==1 | cpad_p08_07==1 | cpad_p08_08==1) 
replace simce_educpadre=2 if cpad_p08_09==1
replace simce_educpadre=3 if (cpad_p08_10==1 | cpad_p08_11==1 | cpad_p08_12==1) 
replace simce_educpadre=4 if (cpad_p08_13==1 | cpad_p08_14==1) 
replace simce_educpadre=5 if (cpad_p08_15==1 | cpad_p08_17==1) 
replace simce_educpadre=6 if (cpad_p08_16==1 | cpad_p08_18==1 | cpad_p08_19==1 | cpad_p08_20==1) 
label values simce_educpadre educ

gen simce_educmadre=.
replace simce_educmadre=1 if (cpad_p09_01==1 | cpad_p09_02==1 | cpad_p09_03==1 | cpad_p09_04==1 | cpad_p09_05==1 | cpad_p09_06==1 | cpad_p09_07==1 | cpad_p09_08==1) 
replace simce_educmadre=2 if cpad_p09_09==1
replace simce_educmadre=3 if (cpad_p09_10==1 | cpad_p09_11==1 | cpad_p09_12==1) 
replace simce_educmadre=4 if (cpad_p09_13==1 | cpad_p09_14==1) 
replace simce_educmadre=5 if (cpad_p09_15==1 | cpad_p09_17==1) 
replace simce_educmadre=6 if (cpad_p09_16==1 | cpad_p09_18==1 | cpad_p09_19==1 | cpad_p09_20==1) 
label values simce_educmadre educ

gen simce_poriginario_pad=.
replace simce_poriginario_pad=1 if cpad_p12_01==1
replace simce_poriginario_pad=0 if cpad_p12_01==2

gen simce_poriginario_mad=.
replace simce_poriginario_mad=1 if cpad_p12_02==1
replace simce_poriginario_mad=0 if cpad_p12_02==2

label define ing 1 "< $100.000" 2 "$100.001 - $200.000" 3 "$200.001 - $300.000" 4 "$300.001 - $400.000" 5 "$400.001 - $500.000" 6 "$500.001 - $600.000" 7 "$600.001 - $800.000" 8 "$800.001 - $1.000.000" 9 "$1.000.001 - $1.200.000" 10 "$1.200.001 - $1.400.000" 11 "$1.400.001 - $1.600.000" 12 "$1.600.001 - $1.800.000" 13 "$1.800.001 - $2.000.000" 14 "$2.000.001 - $2.200.000" 15 "> $2.200.000"
gen simce_ingresos=.
forval i=1(1)9{
replace simce_ingresos=`i' if cpad_p10_0`i'==1
}
forval i=10(1)15{
replace simce_ingresos=`i' if cpad_p10_`i'==1
}
label values simce_ingresos ing
keep agno rbd simce_educpadre simce_educmadre simce_poriginario_pad simce_poriginario_mad simce_ingresos idalumno
save "Data/clean/SocioEcon_surveySimce", replace


use "Data/raw/simce/simce4b2012_cpad_publica_final", clear

gen simce_educpadre=.
replace simce_educpadre=1 if (cpad_p08==1 | cpad_p08==2 | cpad_p08==3 | cpad_p08==4 | cpad_p08==5 | cpad_p08==6 | cpad_p08==7 | cpad_p08==8) 
replace simce_educpadre=2 if cpad_p08==9
replace simce_educpadre=3 if (cpad_p08==10 | cpad_p08==11 | cpad_p08==12) 
replace simce_educpadre=4 if (cpad_p08==13 | cpad_p08==14) 
replace simce_educpadre=5 if (cpad_p08==15 | cpad_p08==17) 
replace simce_educpadre=6 if (cpad_p08==16 | cpad_p08==18 | cpad_p08==19 | cpad_p08==20) 

gen simce_educmadre=.
replace simce_educmadre=1 if (cpad_p09==1 | cpad_p09==2 | cpad_p09==3 | cpad_p09==4 | cpad_p09==5 | cpad_p09==6 | cpad_p09==7 | cpad_p09==8) 
replace simce_educmadre=2 if cpad_p09==9
replace simce_educmadre=3 if (cpad_p09==10 | cpad_p09==11 | cpad_p09==12) 
replace simce_educmadre=4 if (cpad_p09==13 | cpad_p09==14) 
replace simce_educmadre=5 if (cpad_p09==15 | cpad_p09==17) 
replace simce_educmadre=6 if (cpad_p09==16 | cpad_p09==18 | cpad_p09==19 | cpad_p09==20) 

gen simce_poriginario_pad=.
replace simce_poriginario_pad=1 if cpad_p12_01==1
replace simce_poriginario_pad=0 if cpad_p12_01==2

gen simce_poriginario_mad=.
replace simce_poriginario_mad=1 if cpad_p12_02==1
replace simce_poriginario_mad=0 if cpad_p12_02==2

rename cpad_p10 simce_ingresos
replace simce_ingresos=. if (simce_ingresos==99 | simce_ingresos==0)

keep agno rbd simce_educpadre simce_educmadre simce_poriginario_pad simce_poriginario_mad simce_ingresos idalumno
append using "Data/clean/SocioEcon_surveySimce", force
save "Data/clean/SocioEcon_surveySimce", replace


