
** BUILD panel_performance_student_2008_2017.dta
*************************************************
{
	
insheet using "Data/raw/students/Rendimiento por estudiante 2008.csv", clear delim(;)
keep agno rbd cod_ense cod_grado let_cur mrun fec_nac_alu prom_gral asistencia sit_fin sit_fin_r
destring mrun, replace
replace prom_gral= subinstr(prom_gral,",",".",.)
destring prom_gral, replace
save "Data/clean/panel_performance_student_2008_2017.dta", replace

forvalues i=2009/2017{
clear all
if `i'==2014 {
insheet using "Data/raw/students/Rendimiento por estudiante `i'.csv", clear delim(;)
rename sit_final_r sit_fin_r
keep agno rbd cod_ense cod_grado let_cur mrun fec_nac_alu prom_gral asistencia sit_fin sit_fin_r
destring mrun, replace
replace prom_gral= subinstr(prom_gral,",",".",.)
destring prom_gral, replace
compress
keep agno rbd cod_ense cod_grado let_cur mrun fec_nac_alu prom_gral asistencia sit_fin sit_fin_r
append using "Data/clean/panel_performance_student_2008_2017.dta", force
save "Data/clean/panel_performance_student_2008_2017.dta", replace
}
else {
insheet using "Data/raw/students/Rendimiento por estudiante `i'.csv", clear delim(;)
keep agno rbd cod_ense cod_grado let_cur mrun fec_nac_alu prom_gral asistencia sit_fin sit_fin_r
destring mrun, replace
replace prom_gral= subinstr(prom_gral,",",".",.)
destring prom_gral, replace
compress
keep agno rbd cod_ense cod_grado let_cur mrun fec_nac_alu prom_gral asistencia sit_fin sit_fin_r
append using "Data/clean/panel_performance_student_2008_2017.dta", force
save "Data/clean/panel_performance_student_2008_2017.dta", replace
}
}

drop if mrun==.
keep if cod_ense==110 | cod_ense==310 | cod_ense==410 | cod_ense==510 | cod_ense==610 | cod_ense==710 | cod_ense==810 | cod_ense==910 
gen grado=cod_grado
replace grado=9 if cod_grado==1 & (cod_ense==310 | cod_ense==410 | cod_ense==510 | cod_ense==610 | cod_ense==710 | cod_ense==810 | cod_ense==910)
replace grado=10 if cod_grado==2 & (cod_ense==310 | cod_ense==410 | cod_ense==510 | cod_ense==610 | cod_ense==710 | cod_ense==810 | cod_ense==910)
replace grado=11 if cod_grado==3 & (cod_ense==310 | cod_ense==410 | cod_ense==510 | cod_ense==610 | cod_ense==710 | cod_ense==810 | cod_ense==910)
replace grado=12 if cod_grado==4 & (cod_ense==310 | cod_ense==410 | cod_ense==510 | cod_ense==610 | cod_ense==710 | cod_ense==810 | cod_ense==910)

tabulate sit_fin_r, gen(temp_sit)
bys mrun agno grado: egen promovido=total(temp_sit1)
bys mrun agno grado: egen reprobado=total(temp_sit2)
bys mrun agno grado: egen transladado=total(temp_sit3)
bys mrun agno grado: egen retirado=total(temp_sit4)
drop temp_*

sort mrun agno grado sit_fin_r rbd
replace prom_gral=. if sit_fin_r=="T" | sit_fin_r=="Y"
replace asistencia=. if sit_fin_r=="T" | sit_fin_r=="Y"
bys mrun agno grado: egen GPA=max(prom_gral)
bys mrun agno grado: egen attendance=max(asistencia)
	
bys mrun: egen fec_nac_stud=max(fec_nac_alu)
tostring fec_nac_stud, replace
gen f_nac=substr(fec_nac_stud,1,4)
destring f_nac, replace
gen age_stud=agno-f_nac

bys mrun agno grado: gen n=_n
keep if n==1
rename mrun mrun_student
drop prom_gral asistencia fec_nac_alu fec_nac_stud sit_fin_r sit_fin cod_ense cod_grado n
compress
save "Data/clean/panel_performance_student_2008_2017.dta", replace

	
}

** BUILD panel_GPA_student_2011_2017.dta
*****************************************
{
	
import delimited "Data/raw/students/Notas_por_estudiante_y_subsector_2011.csv", clear delim(";")
keep agno rbd cod_ense cod_grado let_cur cod_subsector nom_subsector nota_num mrun 
compress
save "Data/clean/panel_GPA_student_2011_2017.dta", replace


forvalues i=2012/2017{
clear all
import delimited "Data/raw/students/Notas_por_estudiante_y_subsector_`i'.csv", clear delim(";")
keep agno rbd cod_ense cod_grado let_cur cod_subsector nom_subsector nota_num mrun 
compress
append using "Data/clean/panel_GPA_student_2011_2017.dta", force
save "Data/clean/panel_GPA_student_2011_2017.dta", replace
}

gen      math = 0
foreach cod in 5 15 2198 2687 2972 2802 85 10326 234 10157 6349 5813 9737 10060 9737 5533 4448 479 6349 4249 584 124 6899 6901 ///
			   5892 3886 5596 9047 3120 6615 8023 863 3712 4631 1796 5725{
replace  math = 1 if cod_subsector==`cod'
}

gen      lang = 0
foreach cod in 14 27 2265 2197 11224 2281 3072 1363 274 9736 6526 6662 10059 2756 5402 9890 9736 6757 9890 2823 6662 719 6758 ///
			   6452 141 662 5368 4489 5533 4681 4878 6587 6796 6000 6544 1934 867 866{

replace  lang = 1 if cod_subsector==`cod'
}
 

keep if math==1|lang==1
drop cod_ense cod_grado let_cur rbd

gen     subject=""
replace subject="Math" if math==1
replace subject="Language" if lang==1

sort mrun agno subject

gen gpa= subinstr(nota_num,",",".",.)
destring gpa, replace
replace gpa=gpa*10
drop if gpa==.
keep mrun agno subject gpa
 
save "Data/clean/panel_GPA_student_2011_2017_clean.dta", replace

}

** BUILD panel_docentes_curso.dta
**********************************
{

insheet using "Data/raw/teachers/Docentes_por_curso_y_subsector_2008.csv", clear delim (;)
keep clave agno rbd cod_ense cod_grado let_cur cod_subsector nom_subsector
order clave agno rbd cod_ense cod_grado let_cur cod_subsector nom_subsector
sort clave agno 
save "Data/clean/panel_docentes_curso.dta", replace

forval y=2009/2016{
	clear all
	insheet using "Data/raw/teachers/Docentes_por_curso_y_subsector_`y'.csv", clear delim (;)
	keep clave agno rbd cod_ense cod_grado let_cur cod_subsector nom_subsector
	order clave agno rbd cod_ense cod_grado let_cur cod_subsector nom_subsector
	sort clave agno 
	append using "Data/clean/panel_docentes_curso.dta", force
	save "Data/clean/panel_docentes_curso.dta", replace
	}

preserve

	use "Data/clean/panel_docentes_curso.dta", clear
	bys nom_subsector: gen n=_n
	bys nom_subsector: gen N=_N
	keep if n==1
	replace N=-N
	sort N
	
restore

gen      math = 0

foreach cod in 5 15 2198 2687 2972 2802 85 10326 234 10157 6349 5813 9737 10060 9737 5533 4448 479 6349 4249 584 124 6899 6901 ///
			   5892 3886 5596 9047 3120 6615 8023 863 3712 4631 1796 5725{
replace  math = 1 if cod_subsector==`cod'
}

gen      lang = 0

foreach cod in 14 27 2265 2197 11224 2281 3072 1363 274 9736 6526 6662 10059 2756 5402 9890 9736 6757 9890 2823 6662 719 6758 ///
			   6452 141 662 5368 4489 5533 4681 4878 6587 6796 6000 6544 1934 867 866{

replace  lang = 1 if cod_subsector==`cod'
}

gen grado=.

forvalues i=1(1)8{
replace grado=`i' if (cod_grado==`i' & cod_ense==110) 
}

forvalues i=1(1)4{
replace grado=`i'+8 if cod_grado==`i' & (cod_ense==310|cod_ense==410|cod_ense==510|cod_ense==610|cod_ense==710|cod_ense==810|cod_ense==910) 
}
 
keep if math==1|lang==1

gen     subject=""
replace subject="Math" if math==1
replace subject="Language" if lang==1

drop math lang
sort clave agno
 
save "Data/clean/panel_docentes_curso.dta", replace

}

** BUILD panel_docentes.dta
****************************
{

insheet using "Data/raw/teachers/Docentes_Cargos_2008_PUB.csv", clear delim (;)
sort mrun
destring ano_servicio_sistema id_ifp, replace
save "Data/clean/panel_docentes.dta", replace

forval y=2009/2017{
	clear all
	insheet using "Data/raw/teachers/Docentes_Cargos_`y'_PUB.csv", clear delim (;)
	sort mrun
	if agno>2010 {
		destring ano_servicio_sistema ano_servicio_ee id_ifp, replace
	}
	else {
		destring ano_servicio_sistema id_ifp, replace
	}
	append using "Data/clean/panel_docentes.dta", force
	save "Data/clean/panel_docentes.dta", replace
	}

use "Data/clean/panel_docentes.dta", clear
sort rbd dgv_rbd agno

tostring doc_fec_nac, replace
gen f_nac=substr(doc_fec_nac,1,4)
destring f_nac, replace
gen Edad=agno-f_nac
compress

save "Data/clean/panel_docentes.dta",replace
}

** BUILD panel_employeremployee.dta
************************************
{
use "Data/clean/panel_docentes.dta", clear

	drop if id_itc_corr == 103 | id_itc_corr == 108 | id_itc_corr == 112 | id_itc_corr == 304 | id_itc_corr == 309 | id_itc_corr == 310 | id_itc_corr == 404

	g Teacher = (id_ifp == 1)
	g SupportWorker_Law20501 = (id_ifp == 15 | id_ifp == 8 | id_ifp == 7)
	
	g SupportWorker = (id_ifp == 2 | id_ifp == 7 | id_ifp == 8 | id_ifp == 9 | id_ifp == 11 | id_ifp == 12)
	g Administrative = (id_ifp == 3 | id_ifp == 4 | id_ifp == 10 | id_ifp == 15 | id_ifp == 16)
	g Principal = (id_ifp == 4 | id_ifp == 16)
		
	drop if cod_depe==5 
	gen Public  = (cod_depe==1|cod_depe==2)
	gen Voucher = (cod_depe==3)
	gen Private = (cod_depe==4)
	gen Rural  = (rural_rbd==1)
	
	gen Perm = .
	replace Perm = (id_itc==1) if agno<2011 & Public==1
	replace Perm = (id_itc==3) if agno<2011 & Public==0
	
	replace Perm = (id_itc==1|id_itc==9|id_itc==13) if agno>=2011 & Public==1
	replace Perm = (id_itc==4|id_itc==16|id_itc==22) if agno>=2011 & Public==0
		
	gen Female = (doc_genero==2)
	rename horas_contrato Hours
	rename horas_direct   Hours_Admin
	rename horas_aula 	  Hours_Teach
	
	rename ano_servicio_sistema SenioritySystem
	rename ano_servicio_ee      SenioritySchool
	
	destring tit_id_2, replace
	destring tip_insti_id_1, replace
	destring tip_insti_id_2, replace
	gen aux_EducDegree    = (tit_id_1==1|tit_id_2==1) 
	gen aux_CollegeDegree = (tip_insti_id_1==1|tip_insti_id_2==1) 
	
	bys mrun: egen EducDegree=max(aux_EducDegree)
	bys mrun: egen CollegeDegree=max(aux_CollegeDegree)
	
keep agno rbd Public Voucher Private Rural clave mrun Edad Female Perm Hours Hours_Admin Hours_Teach SenioritySystem SenioritySchool /// 
EducDegree CollegeDegree Teacher SupportWorker_Law20501 SupportWorker Administrative Principal cod_com_rbd
order clave mrun agno rbd Public Rural Edad Female Hours Teacher SupportWorker SupportWorker_Law20501 Administrative Principal Hours_Admin Hours_Teach SenioritySystem SenioritySchool EducDegree CollegeDegree 
sort mrun agno rbd cod_com_rbd

compress
save "Data/clean/panel_employeremployee.dta", replace	

}

** BUILD panel_ADP.dta
***********************
{

import excel "Data/raw/adp/directores - ADP.xlsx", sheet("ESTADO") firstrow clear
rename ESTADO17042018 estado
rename COD_DEPE depe
rename RBD rbd
tempfile estado
save `estado', replace

import excel "Data/raw/adp/caracteristicas directores.xlsx", sheet("Resultados (2)") firstrow clear
rename NConcurso IDportal
keep IDportal Profesiónnombrado Sexonombrado Trabajoanteriornombrado Añosexperiencianombrado esprimeravezqueocupacargod Directorreelecto
rename Profesiónnombrado profesion
rename Sexonombrado sexo
rename Trabajoanteriornombrado trabpre
rename Añosexperiencianombrado exp
rename esprimeravezqueocupacargod primeravez
rename Directorreelecto reelecto
tempfile directores
save `directores', replace

import excel "Data/raw/adp/directores - ADP.xlsx", sheet("HISTORIA") firstrow clear
keep RBD IDportal FECHA_PUBLICACION FECHANOMBRAMIENTO
sort RBD IDportal
duplicates tag RBD IDportal, gen(tag)
drop if tag>0 
drop tag

merge 1:1 IDportal using `directores'
drop if _merge==2
drop _merge

rename FECHA_PUBLICACION date_cont
format date_cont  %d

gen date_elec=date(FECHANOMBRAMIENTO, "MDY") 
format date_elec %d
drop FECHANOMBRAMIENTO

rename RBD rbd
bys rbd (IDportal): gen n=_n
keep rbd n date_cont date_elec exp sexo profesion trabpre primeravez reelecto
reshape wide date_cont date_elec exp sexo profesion trabpre primeravez reelecto, i(rbd) j(n)

merge 1:1 rbd using `estado', keepusing(rbd depe estado)
drop _merge

save "Data/temp/base_concursos.dta", replace

forval	i=1(1)8{
local j=`i'+1
if `j'<=8{
replace date_elec`i'=date_cont`i'+31 if date_elec`i'==-21915  
replace date_elec`i'=date_cont`i'+31 if date_elec`i'<date_cont`i'  
replace date_cont`j'=. if (date_elec`i'>date_cont`j') & date_elec`i'!=. 
}
}

egen primer_adp_inicio=rowmin(date_elec*)
gen  primer_adp_termino=.          

	forval i=2(1)8{
	local j = `i'-1
	replace primer_adp_termino=date_cont`i' if date_elec`j'!=. & missing(primer_adp_termino)
	}	

format primer_adp_termino primer_adp_inicio %d

preserve 
	keep if primer_adp_inicio==.
	keep rbd 
	gen t=ym(2012,1) 
	format t %tm 
	gen Ndir=0
	tempfile data0
	save `data0', replace
restore

keep if primer_adp_inicio!=. 
	
preserve
keep if primer_adp_termino==. & primer_adp_inicio!=.
	forval	i=1(1)8{
	  if primer_adp_inicio==date_elec`i'{
		g profesion=profesion`i'  
		g sexo=sexo`i'            
		g trabpre=trabpre`i'     
		g exp=exp`i' 		    
		g reelecto=reelecto`i'    
		g primeravez=primeravez`i' 
		}
	}
			
replace primer_adp_inicio=mofd(primer_adp_inicio)
replace primer_adp_termino=mofd(primer_adp_termino)
format primer_adp_inicio primer_adp_termino %tm
	
rename primer_adp_inicio t0
rename primer_adp_termino t1
replace t1=ym(2018,4)

keep rbd t0 t1 profesion sexo trabpre exp reelecto primeravez
			
 reshape long t, i(rbd) j(aux)
 drop aux
 xtset rbd t
 tsfill
 
foreach var in profesion sexo trabpre reelecto primeravez{
	bys rbd: replace `var'=`var'[_n-1] if `var'==""
	}
	bys rbd: egen experiencia=min(exp)
	drop exp
	
gen Ndir=1
tempfile data1
save `data1', replace
restore	
			
keep if primer_adp_termino!=. & primer_adp_inicio!=. 

forval	i=1(1)8{
gen aux_date_cont`i'=date_cont`i'
gen aux_date_elec`i'=date_elec`i'

replace aux_date_elec`i'=. if primer_adp_inicio==aux_date_elec`i'
replace aux_date_cont`i'=. if primer_adp_termino==aux_date_cont`i'
}

egen segundo_adp_inicio=rowmin(aux_date_elec*)
gen segundo_adp_termino=.

forval i=2(1)8{
	local j = `i'-1
	replace segundo_adp_termino=aux_date_cont`i' if aux_date_elec`j'!=. & missing(segundo_adp_termino)
	}	

format segundo_adp_inicio segundo_adp_termino  %d

preserve 
keep if segundo_adp_termino==. & segundo_adp_inicio!=.	
	forval	i=1(1)8{
	  if primer_adp_inicio==date_elec`i'{
		g profesion=profesion`i'  
		g sexo=sexo`i'            
		g trabpre=trabpre`i'     
		g exp=exp`i' 		    
		g reelecto=reelecto`i'    
		g primeravez=primeravez`i' 
		}
	}
	
	
replace primer_adp_inicio=mofd(primer_adp_inicio)
replace primer_adp_termino=mofd(primer_adp_termino)
format primer_adp_inicio primer_adp_termino %tm

	rename primer_adp_inicio t0
	replace t0=ym(2012,1) if t0==ym(1899,12)
	rename primer_adp_termino t1

	
	keep rbd t0 t1 profesion sexo trabpre exp reelecto primeravez
			
	reshape long t, i(rbd) j(aux)
	drop aux
	xtset rbd t	
	tsfill
	foreach var in profesion sexo trabpre reelecto primeravez{
		bys rbd: replace `var'=`var'[_n-1] if `var'==""
		}
		bys rbd: egen experiencia=min(exp)
		drop exp
	gen Ndir=1
	tempfile data2_dir1
	save `data2_dir1', replace
restore	


preserve 
keep if segundo_adp_termino==. & segundo_adp_inicio!=.

	forval	i=1(1)8{
	  if segundo_adp_inicio==aux_date_elec`i'{
		g profesion=profesion`i'  
		g sexo=sexo`i'            
		g trabpre=trabpre`i'     
		g exp=exp`i' 		    
		g reelecto=reelecto`i'    
		g primeravez=primeravez`i' 
		}
	}
	
	
replace segundo_adp_inicio=mofd(segundo_adp_inicio)
replace segundo_adp_termino=mofd(segundo_adp_termino)
format segundo_adp_inicio segundo_adp_termino %tm


	rename segundo_adp_inicio t0
	rename segundo_adp_termino t1
	replace t1=ym(2018,4)

	keep rbd t0 t1 profesion sexo trabpre exp reelecto primeravez
			
	reshape long t, i(rbd) j(aux)
	drop aux
	xtset rbd t
	tsfill
	
	foreach var in profesion sexo trabpre reelecto primeravez{
		bys rbd: replace `var'=`var'[_n-1] if `var'==""
		}
		bys rbd: egen experiencia=min(exp)
		drop exp
	gen Ndir=2
	tempfile data2_dir2
	save `data2_dir2', replace
restore	

preserve
use `data2_dir1', clear
append using `data2_dir2'
tempfile data2
save `data2', replace
restore

preserve
keep if segundo_adp_termino==. & segundo_adp_inicio==.
	forval	i=1(1)8{
	  if primer_adp_inicio==date_elec`i'{
		g profesion=profesion`i'  
		g sexo=sexo`i'            
		g trabpre=trabpre`i'     
		g exp=exp`i' 		    
		g reelecto=reelecto`i'    
		g primeravez=primeravez`i' 
		}
	}
	
	
replace primer_adp_inicio=mofd(primer_adp_inicio)
replace primer_adp_termino=mofd(primer_adp_termino)
format  primer_adp_inicio primer_adp_termino %tm
	
	rename primer_adp_inicio t0
	rename primer_adp_termino t1
		
	keep rbd t0 t1 profesion sexo trabpre exp reelecto primeravez
			
	reshape long t, i(rbd) j(aux)
	drop aux
	xtset rbd t
	tsfill	
	
	foreach var in profesion sexo trabpre reelecto primeravez{
		bys rbd: replace `var'=`var'[_n-1] if `var'==""
		}
		bys rbd: egen experiencia=min(exp)
		drop exp
		
	gen Ndir=1
	tempfile data2P
	save `data2P', replace
restore	

keep if segundo_adp_inicio!=. & segundo_adp_termino!=. 
forval	i=1(1)8{
gen aux2_date_elec`i'=aux_date_elec`i'
gen aux2_date_cont`i'=aux_date_cont`i'
replace aux2_date_elec`i'=. if segundo_adp_inicio==aux2_date_elec`i'
replace aux2_date_cont`i'=. if segundo_adp_termino==aux2_date_cont`i'
}

egen tercer_adp_inicio=rowmin(aux2_date_elec*)
gen tercer_adp_termino=.

forval i=2(1)8{
	local j = `i'-1
	replace tercer_adp_termino=aux2_date_cont`i' if aux2_date_elec`j'!=. & missing(tercer_adp_termino)
	}	

format tercer_adp_inicio tercer_adp_termino  %d

preserve 
keep if tercer_adp_termino==. & tercer_adp_inicio!=.
	forval	i=1(1)8{
		if primer_adp_inicio==date_elec`i'{
		g profesion=profesion`i'  
		g sexo=sexo`i'            
		g trabpre=trabpre`i'     
		g exp=exp`i' 		    
		g reelecto=reelecto`i'    
		g primeravez=primeravez`i' 
		}
	}
	
replace primer_adp_inicio=mofd(primer_adp_inicio)
replace primer_adp_termino=mofd(primer_adp_termino)
format primer_adp_inicio primer_adp_termino %tm
	
	rename primer_adp_inicio t0
	rename primer_adp_termino t1

	keep rbd t0 t1 profesion sexo trabpre exp reelecto primeravez
			
	reshape long t, i(rbd) j(aux)
	drop aux
	xtset rbd t
	tsfill	
	
	foreach var in profesion sexo trabpre reelecto primeravez{
		bys rbd: replace `var'=`var'[_n-1] if `var'==""
		}
		bys rbd: egen experiencia=min(exp)
		drop exp
	gen Ndir=1
	tempfile data3_dir1
	save `data3_dir1', replace
restore	

preserve	
keep if tercer_adp_termino==. & tercer_adp_inicio!=.

	forval	i=1(1)8{
		if segundo_adp_inicio==aux_date_elec`i'{
		g profesion=profesion`i'  
		g sexo=sexo`i'            
		g trabpre=trabpre`i'     
		g exp=exp`i' 		    
		g reelecto=reelecto`i'    
		g primeravez=primeravez`i' 
		}
	}
	
replace segundo_adp_inicio=mofd(segundo_adp_inicio)
replace segundo_adp_termino=mofd(segundo_adp_termino)
format segundo_adp_inicio segundo_adp_termino %tm
	
	rename segundo_adp_inicio t0
	rename segundo_adp_termino t1

	keep rbd t0 t1 profesion sexo trabpre exp reelecto primeravez
			
	reshape long t, i(rbd) j(aux)
	drop aux
	xtset rbd t
	tsfill	
	
	foreach var in profesion sexo trabpre reelecto primeravez{
		bys rbd: replace `var'=`var'[_n-1] if `var'==""
		}
		bys rbd: egen experiencia=min(exp)
		drop exp
	gen Ndir=2
	tempfile data3_dir2
	save `data3_dir2', replace
restore	

preserve 
keep if tercer_adp_termino==. & tercer_adp_inicio!=.

	forval	i=1(1)8{
		if tercer_adp_inicio==aux2_date_elec`i'{
		g profesion=profesion`i'  
		g sexo=sexo`i'            
