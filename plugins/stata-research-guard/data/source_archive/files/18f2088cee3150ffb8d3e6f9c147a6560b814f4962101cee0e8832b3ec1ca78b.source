*==============================================================================*
**## Export to table 
*==============================================================================*

#delimit ;
esttab using "${main_tables_folder}/Table_5_Requests_Clientelism.tex", replace 
keep(treatment treat_freq rainfall_std_stacked rain_std_freq frequent_interactor) 
order(treatment treat_freq rainfall_std_stacked rain_std_freq frequent_interactor) 
substitute(_ _)

scalars("obs \midrule Observations" "mean_Y Mean of Y: Treatment Group" "mean_Y_control Mean of Y: Control Group" 
"mean_Y_control_freq Mean of Y: Clientelist Relationship in Control Group")
b("%9.3fc") se("%9.3fc") label nostar noobs nonumber nomtitle wrap varwidth(100)

prehead("\begin{landscape}" "\begin{table}[htbp] \centering \onehalfspacing" "\fontsize{10}{10}\selectfont"
"\def\sym#1{\ifmmode^{#1}\else\(^{#1}\)\fi}" "\begin{threeparttable}" 
"\captionsetup{justification=centering}"
"\caption{\textbf{Citizen Requests and Heterogeneity by Clientelist Relationship}}" 
"\begin{tabularx}{\linewidth}{l*{5}C}" "\toprule" 
"& \multicolumn{3}{c}{}             & Request Any  &              \\"
"& \multicolumn{3}{c}{}             & Private Good & Request and  \\"
"& \multicolumn{3}{c}{Request Any}  & Excluding    & Receive Any  \\"
"& \multicolumn{3}{c}{Private Good} & Water        & Private Good \\"
"\cmidrule(lr){2-4}" "& (1) & (2) & (3) & (4) & (5) \\")

posthead("\midrule")

prefoot("\midrule" "\multicolumn{6}{l}{\textit{Effect of Cisterns Treatment for Individuals in Clientelist Relationship:}} \\" "[1ex]"
"$\beta_1 + \beta_2$ & `treat_frequent_b1' & & `treat_frequent_b2' & `treat_frequent_b3' & `treat_frequent_b4' \\"
" & `treat_frequent_se1' & & `treat_frequent_se2' & `treat_frequent_se3' & `treat_frequent_se4' \\"

"\multicolumn{6}{l}{} \\" 
"\multicolumn{6}{l}{\textit{Effect of Positive 1 SD Rainfall Shock for Individuals in Clientelist Relationship:}} \\" "[1ex]"
"$\beta_3 + \beta_4$ & & `rain_frequent_b1' & `rain_frequent_b2' & `rain_frequent_b3' & `rain_frequent_b4' \\"
" & & `rain_frequent_se1' & `rain_frequent_se2' & `rain_frequent_se3' & `rain_frequent_se4' \\"
 
"\midrule" "Municipality Fixed Effects &Yes &Yes &Yes &Yes &Yes \\" 
"Year Fixed Effects &Yes &Yes &Yes &Yes &Yes \\")

postfoot("\bottomrule" "\end{tabularx}" "\end{threeparttable}" "\end{table}" "\end{landscape}");	


