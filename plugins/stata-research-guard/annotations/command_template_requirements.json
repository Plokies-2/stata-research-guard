{
  "schema_version": "1.0",
  "title": "Top 50 Stata command-template requirements",
  "objective": "Each Top 50 group is covered either by a declared direct-primitive policy or by one or more audited state-compatible templates. A user-written command needs a maintainer-guide mechanics variant before any researcher-code variant can be promoted.",
  "promotion_policy": {
    "legacy_status": "legacy_pre_policy",
    "template_statuses": ["audited_template", "reference_only", "uncovered"],
    "direct_status": "direct_primitive_policy",
    "required_for_audited_template": ["source_sha256", "runtime", "selector_positive", "selector_negative"],
    "forbidden_claim": "A legacy label or guide-only mechanics record is not an audited auto-selectable template."
  },
  "guide_absorption_policy": {
    "scope": "bounded_comprehensive_mechanics",
    "rule": "For every required variant, retain at least one bounded official-manual or maintainer-guide mechanics atom. Also retain a contract-adjacent guide variant only when it changes observable input state, output state, estimator, inference, weight, support, persistence, or output ownership.",
    "exclude": [
      "whole-guide copies or long narrative examples",
      "installation or dependency-probe commands",
      "duplicate examples with the same executable state transition",
      "guide-supplied sample, estimand, fixed-effect, cluster, instrument, sheet-placement, or interpretation decisions"
    ],
    "source_requirements": [
      "source kind and authority",
      "official URL and release or package version when available",
      "raw source and local snapshot SHA-256",
      "exact page, section, or line span",
      "six-field input profile and three-field state signature",
      "material variant distinction"
    ],
    "retrieval_tiers": {
      "guide_mechanics": "A noncompeting companion layer for syntax, options, and state mechanics; never auto-selectable by itself.",
      "research_usage": "A separately matched deposited-paper or other independent researcher-code example; it cannot replace command authority.",
      "implementation": "Use an audited exact usage template when compatible, otherwise a guide-informed fallback that supplies no unresolved research decision."
    },
    "context_budget": {
      "primary_guide_cards": 1,
      "guide_alternative_metadata": 2,
      "research_usage_examples": 1,
      "guide_excerpt_max_lines": 12,
      "guide_excerpt_max_characters": 600
    }
  },
