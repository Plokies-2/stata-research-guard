{
  "schema_version": "1.0",
  "title": "Stata command and package family registry",
  "scope": "Common official Stata command families and widely used community packages. This is a retrieval and coverage index, not an endorsement of every command use or a dependency installer.",
  "global_template_policy": {
    "selection_rule": "Add a command index entry and a small state-compatible atomic template; do not add estimator-specific detector branches merely because a new estimator appears.",
    "outputs": ["Excel", "PDF", ".ster"],
    "forbidden_output": ["TeX"],
    "forbidden_runtime_behavior": ["dependency installation", "package presence probes"],
    "quarantine": ["manual coefficient or standard-error reconstruction", "manual result transfer into final tables"]
  },
  "families": [
    {"family_id":"official_data_io","display_name":"Official data import and export","ownership":"StataCorp official","category":"data_io","priority":"P0","commands":["sysuse","import","import_excel","import_delimited","export_excel","export_delimited","use","save"],"evidence":"StataCorp data-management manuals","template_policy":"atomic_template_candidate","notes":"Use declared file paths and schema contracts; sysuse and a plain declared use/save are harmless primitives."},
    {"family_id":"official_data_management","display_name":"Official data management","ownership":"StataCorp official","category":"data_management","priority":"P0","commands":["append","merge","reshape","collapse","contract"],"evidence":"StataCorp data-management manuals","template_policy":"atomic_template_candidate","notes":"Retained merge states and collapse output schemas are template-level contracts."},
    {"family_id":"official_integrity","display_name":"Official integrity diagnostics","ownership":"StataCorp official","category":"integrity","priority":"P0","commands":["isid","duplicates","assert","codebook","misstable"],"evidence":"StataCorp data-management manuals","template_policy":"direct_primitive_or_atomic_contract","notes":"Do not force templates for isolated diagnostics; bind consequential checks to the transition they protect."},
    {"family_id":"official_transformation_labels","display_name":"Official variable construction and labels","ownership":"StataCorp official","category":"transformation","priority":"P0","commands":["egen","generate","replace","recode","destring","tostring","encode","decode","label"],"evidence":"StataCorp data-management manuals","template_policy":"atomic_template_candidate","notes":"New persistent variables require nearby meaning and label evidence."},
    {"family_id":"official_panel_timeseries","display_name":"Official panel and time-series","ownership":"StataCorp official","category":"panel","priority":"P0","commands":["xtset","tsset","xtreg","xtivreg","tsfill"],"evidence":"StataCorp longitudinal-data manuals","template_policy":"atomic_template_candidate","notes":"Panel-key declaration and model specification remain separate transitions."},
    {"family_id":"official_descriptives","display_name":"Official descriptive statistics","ownership":"StataCorp official","category":"descriptives","priority":"P0","commands":["summarize","tabstat","tabulate","table","dtable","ttest"],"evidence":"StataCorp reporting and table manuals","template_policy":"atomic_template_candidate","notes":"Plain summarize/tabstat is direct; grouped materialization and shared summary data are atomic templates."},
    {"family_id":"official_table_collect","display_name":"Official table and collect framework","ownership":"StataCorp official","category":"exports","priority":"P1","commands":["etable","collect_get","collect_style","collect_export","putexcel"],"evidence":"StataCorp table, collect, and putexcel manuals","template_policy":"atomic_template_candidate","notes":"Excel export is allowed; TeX export is not."},
    {"family_id":"official_postestimation","display_name":"Official postestimation","ownership":"StataCorp official","category":"postestimation","priority":"P1","commands":["margins","marginsplot","lincom","test","testparm","predict"],"evidence":"StataCorp postestimation manuals","template_policy":"atomic_template_candidate","notes":"Only template an explicit estimand-to-output transition."},
    {"family_id":"official_graphics","display_name":"Official graphics","ownership":"StataCorp official","category":"figures","priority":"P1","commands":["graph","twoway","graph_bar","histogram"],"evidence":"StataCorp graphics manuals","template_policy":"atomic_template_candidate","notes":"Final figures are PDF; graph styling is not a generic estimator detector."},
    {"family_id":"official_linear_models","display_name":"Official linear models","ownership":"StataCorp official","category":"estimation","priority":"P0","commands":["regress","areg"],"evidence":"StataCorp regression manuals","template_policy":"atomic_template_candidate","notes":"Visible specification, fixed effects, and inference form the reusable atom."},
    {"family_id":"official_iv","display_name":"Official instrumental variables","ownership":"StataCorp official","category":"estimation","priority":"P1","commands":["ivregress"],"evidence":"StataCorp IV regression manuals","template_policy":"atomic_template_candidate","notes":"Identification choices must be declared; never manually reconstruct first-stage coefficients."},
    {"family_id":"official_glm","display_name":"Official nonlinear count and binary models","ownership":"StataCorp official","category":"estimation","priority":"P2","commands":["logit","logistic","probit","poisson","nbreg"],"evidence":"StataCorp base-reference manuals","template_policy":"atomic_template_candidate","notes":"Method-specific input and estimand contracts are required."},
    {"family_id":"official_survival","display_name":"Official survival analysis","ownership":"StataCorp official","category":"estimation","priority":"P2","commands":["stset","stcox"],"evidence":"StataCorp survival-analysis manuals","template_policy":"reference_until_contract","notes":"Index for discovery; add templates only with explicit failure, time, and censoring contracts."},
    {"family_id":"estout","display_name":"estout / esttab / estpost / eststo","ownership":"Community (Ben Jann)","category":"exports","priority":"P0","commands":["estpost","eststo","estadd","esttab","estout"],"evidence":"Maintainer documentation and SSC/RePEc package record","template_policy":"atomic_template_candidate","notes":"Separate summary-statistics storage from table export; do not emit TeX."},
    {"family_id":"outreg2","display_name":"outreg2","ownership":"Community (Roy Wada)","category":"exports","priority":"P0","commands":["outreg2"],"evidence":"Maintainer documentation and SSC/RePEc package record","template_policy":"atomic_template_candidate","notes":"Preserve raw coefficient, standard-error, and omitted/base rows; manual reconstruction is quarantined."},
    {"family_id":"reghdfe","display_name":"reghdfe","ownership":"Community (Sergio Correia)","category":"estimation","priority":"P0","commands":["reghdfe"],"evidence":"Maintainer documentation and deposited research code","template_policy":"atomic_template_candidate","notes":"Absorbed fixed effects and clustered inference are explicit bindings."},
    {"family_id":"ppmlhdfe","display_name":"ppmlhdfe","ownership":"Community (Sergio Correia and coauthors)","category":"estimation","priority":"P1","commands":["ppmlhdfe"],"evidence":"Maintainer documentation and deposited research code","template_policy":"atomic_template_candidate","notes":"Template only when the count-model estimand and separation handling are declared."},
    {"family_id":"ivreg2","display_name":"ivreg2","ownership":"Community (Baum, Schaffer, Stillman)","category":"estimation","priority":"P1","commands":["ivreg2"],"evidence":"Maintainer documentation and SSC/RePEc package record","template_policy":"atomic_template_candidate","notes":"Kept distinct from ivreghdfe because their fixed-effect and dependency contracts differ."},
    {"family_id":"ivreghdfe","display_name":"ivreghdfe","ownership":"Community (Correia)","category":"estimation","priority":"P1","commands":["ivreghdfe"],"evidence":"Maintainer documentation and package repository","template_policy":"atomic_template_candidate","notes":"Kept distinct from ivreg2; require declared absorbed effects and clustered inference."},
    {"family_id":"cgmreg","display_name":"cgmreg","ownership":"Community","category":"estimation","priority":"P2","commands":["cgmreg"],"evidence":"Package documentation and deposited research code","template_policy":"atomic_template_candidate","notes":"Use only for an explicitly justified multiway-cluster specification."},
    {"family_id":"acreg","display_name":"acreg","ownership":"Community","category":"estimation","priority":"P2","commands":["acreg"],"evidence":"Package documentation and deposited research code","template_policy":"atomic_template_candidate","notes":"Require an explicit spatial or serial correlation contract."},
    {"family_id":"boottest","display_name":"boottest","ownership":"Community (Roodman et al.)","category":"robustness","priority":"P1","commands":["boottest"],"evidence":"Maintainer documentation and SSC/RePEc package record","template_policy":"atomic_template_candidate","notes":"Resampling seed, null, cluster level, and inference target must be declared."},
    {"family_id":"coefplot","display_name":"coefplot","ownership":"Community (Ben Jann)","category":"figures","priority":"P1","commands":["coefplot"],"evidence":"Maintainer documentation and SSC/RePEc package record","template_policy":"atomic_template_candidate","notes":"Use raw e(b) coefficient identities; no hand-built coefficient vectors."},
    {"family_id":"csdid","display_name":"csdid","ownership":"Community (Fernando Rios-Avila)","category":"staggered_did","priority":"P1","commands":["csdid","csdid_estat"],"evidence":"Maintainer documentation and deposited research code","template_policy":"method_specific_atomic_template","notes":"Require cohort, time, treatment, comparison, aggregation, and inference contracts."},
    {"family_id":"did_imputation","display_name":"did_imputation","ownership":"Community (Borusyak, Jaravel, Spiess)","category":"staggered_did","priority":"P1","commands":["did_imputation"],"evidence":"Author package documentation and deposited research code","template_policy":"method_specific_atomic_template","notes":"Require timing, untreated comparison, horizon, and pretrend conventions."},
    {"family_id":"did_multiplegt_dyn","display_name":"did_multiplegt_dyn","ownership":"Community (de Chaisemartin and D'Haultfoeuille)","category":"staggered_did","priority":"P1","commands":["did_multiplegt_dyn"],"evidence":"Author package documentation","template_policy":"method_specific_atomic_template","notes":"Indexed as a template family rather than an ever-growing estimator detector list."},
    {"family_id":"eventstudyinteract","display_name":"eventstudyinteract","ownership":"Community (Sun and Abraham)","category":"staggered_did","priority":"P1","commands":["eventstudyinteract"],"evidence":"Author package documentation and deposited research code","template_policy":"method_specific_atomic_template","notes":"Require cohort interactions, control cohort, reference period, and raw e(b) output contract."},
    {"family_id":"eventdd","display_name":"eventdd","ownership":"Community","category":"staggered_did","priority":"P2","commands":["eventdd"],"evidence":"Package documentation","template_policy":"method_specific_atomic_template","notes":"Event-time construction and reference period are substantive inputs."},
    {"family_id":"event_plot","display_name":"event_plot","ownership":"Community","category":"figures","priority":"P2","commands":["event_plot"],"evidence":"Package documentation and deposited research code","template_policy":"method_specific_atomic_template","notes":"Plot raw event-study estimates without hand-built coefficient vectors."},
    {"family_id":"jwdid","display_name":"jwdid and jwdidstacked","ownership":"Community","category":"staggered_did","priority":"P2","commands":["jwdid","jwdidstacked"],"evidence":"Package documentation and deposited research code","template_policy":"method_specific_atomic_template","notes":"Keep stacked and nonstacked designs as separate variants."},
    {"family_id":"jregress","display_name":"jregress","ownership":"Community","category":"estimation","priority":"P2","commands":["jregress"],"evidence":"Package documentation and deposited research code","template_policy":"method_specific_atomic_template","notes":"Require a declared joint-estimation and inference contract."},
    {"family_id":"sdid","display_name":"sdid","ownership":"Community (Arkhangelsky et al.)","category":"synthetic_did","priority":"P2","commands":["sdid"],"evidence":"Author package documentation","template_policy":"method_specific_atomic_template","notes":"Require unit, time, treatment adoption, and bootstrap/inference contracts."},
    {"family_id":"stackedev","display_name":"stackedev","ownership":"Community","category":"staggered_did","priority":"P2","commands":["stackedev"],"evidence":"Package documentation","template_policy":"method_specific_atomic_template","notes":"Stack construction and cohort windows are explicit method choices."},
    {"family_id":"rdrobust","display_name":"rdrobust suite","ownership":"Community (Cattaneo, Idrobo, Titiunik)","category":"regression_discontinuity","priority":"P1","commands":["rdrobust","rdbwselect","rdplot"],"evidence":"Author documentation and SSC/RePEc package record","template_policy":"method_specific_atomic_template","notes":"Cutoff, running variable, bandwidth, kernel, and inference must be declared."},
    {"family_id":"ritest","display_name":"ritest","ownership":"Community","category":"robustness","priority":"P2","commands":["ritest"],"evidence":"Package documentation and deposited research code","template_policy":"method_specific_atomic_template","notes":"Randomization mechanism, null, repetitions, and seed are required."},
    {"family_id":"gtools","display_name":"gtools","ownership":"Community","category":"data_management","priority":"P2","commands":["gegen","gcollapse","greshape","gstats","gquantiles"],"evidence":"Maintainer documentation","template_policy":"atomic_template_candidate","notes":"Keep the same input/output schema as the official data-management counterpart."},
    {"family_id":"winsor2","display_name":"winsor2","ownership":"Community","category":"transformation","priority":"P2","commands":["winsor2"],"evidence":"Package documentation and deposited research code","template_policy":"method_specific_atomic_template","notes":"Tail rule and overwrite/new-variable choice must be explicit."},
    {"family_id":"rangestat","display_name":"rangestat","ownership":"Community","category":"data_management","priority":"P2","commands":["rangestat"],"evidence":"Package documentation","template_policy":"method_specific_atomic_template","notes":"Window endpoints and panel-key conditions are required."},
    {"family_id":"psmatch2","display_name":"psmatch2 and pstest","ownership":"Community (Leuven and Sianesi)","category":"matching","priority":"P1","commands":["psmatch2","pstest"],"evidence":"Author-maintained help and SSC/RePEc package record","template_policy":"method_specific_atomic_template","notes":"Treatment, estimand, propensity-score source, overlap, caliper, and generated-state contracts must be declared."},
    {"family_id":"xtabond2","display_name":"xtabond2","ownership":"Community (David Roodman)","category":"dynamic_panel","priority":"P1","commands":["xtabond2"],"evidence":"Author guide and package help","template_policy":"method_specific_atomic_template","notes":"Difference versus system GMM, instrument roles, lag limits, collapse, step, and diagnostics must be explicit."},
    {"family_id":"asdoc","display_name":"asdoc","ownership":"Community","category":"exports","priority":"P2","commands":["asdoc"],"evidence":"Author guide","template_policy":"reference_until_output_policy","notes":"Word and RTF output remain reference-only under the Excel/PDF/.ster project policy."},
    {"family_id":"ftools_commands","display_name":"fcollapse and fmerge","ownership":"Community (Sergio Correia)","category":"data_management","priority":"P2","commands":["fcollapse","fmerge"],"evidence":"Maintainer documentation","template_policy":"atomic_template_candidate","notes":"ftools itself is a dependency, not a template; only direct data commands are indexed and unsafe fmerge options are excluded."},
    {"family_id":"ddml","display_name":"ddml / qddml","ownership":"Community","category":"machine_learning","priority":"P2","commands":["ddml","qddml","crossfit"],"evidence":"Maintainer documentation","template_policy":"reference_until_contract","notes":"Index for discovery; add writable templates only with explicit learners, folds, seed, and estimand contracts."}
  ],
