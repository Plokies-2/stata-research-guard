{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|PowerShell)$",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('node:path').join(process.env.PLUGIN_ROOT||process.env.CLAUDE_PLUGIN_ROOT,'hooks','stata-diff.cjs'))\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(apply_patch|exec|Bash|exec_command|Edit|Write|MultiEdit|PowerShell)$",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('node:path').join(process.env.PLUGIN_ROOT||process.env.CLAUDE_PLUGIN_ROOT,'hooks','stata-diff.cjs'))\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('node:path').join(process.env.PLUGIN_ROOT||process.env.CLAUDE_PLUGIN_ROOT,'hooks','stata-diff.cjs'))\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
